#Область СлужебныеПроцедурыИФункции

// См. кфкОбработкаСобытийСлужебный.ПараметрыРегистрации
&Around("ПараметрыРегистрации")
Функция ют_ПараметрыРегистрации(Продюсеры = Неопределено, ПакетныйРежимЗаписи = Ложь)

	Аргументы = Новый Массив; // Массив Из Произвольный
	Аргументы.Добавить(Продюсеры);
	Аргументы.Добавить(ПакетныйРежимЗаписи);
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		кфкОбработкаСобытийСлужебный,
		"ПараметрыРегистрации",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = ПродолжитьВызов(Продюсеры, ПакетныйРежимЗаписи);
	Возврат Результат;

КонецФункции

