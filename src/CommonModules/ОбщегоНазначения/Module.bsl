//@strict-types

#Область СлужебныйПрограммныйИнтерфейс

// Подменяет только фабрику Kafka и только внутри явно настроенного теста.
// Параметры:
//  Идентификатор - Строка - идентификатор внешней компоненты.
//  ПолноеИмяМакета - Строка - имя макета внешней компоненты.
//  Изолированно - Булево, Null - исходный режим загрузки.
// Возвращаемое значение:
//  ОбъектВнешнейКомпоненты, ОбщийМодуль, Неопределено - компонента либо тестовый ответ.
&Around("ПодключитьКомпонентуИзМакета")
Функция ют_ПодключитьКомпонентуДляТестовИнтеграции(
		Знач Идентификатор, Знач ПолноеИмяМакета, Знач Изолированно = Null)

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст <> Неопределено
		И Идентификатор = "simpleKafka1C"
		И ПолноеИмяМакета = "ОбщийМакет.кфкАдаптерKafka"
		И Контекст.Свойство("ют_КоннекторИнтеграции") Тогда

		Состояние = Контекст["ют_КоннекторИнтеграции"]; // см. ют_КоннекторИнтеграцииДляТестов.НовоеСостояние
		Состояние.ПараметрыПодключения = ЮТМетоды.МассивПараметров(
			Идентификатор, ПолноеИмяМакета, Изолированно);
		Если Состояние.ПодключениеОтказано Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат ют_КоннекторИнтеграцииДляТестов;

	КонецЕсли;

	Результат = ПродолжитьВызов(Идентификатор, ПолноеИмяМакета, Изолированно);
	Возврат Результат;

КонецФункции

#КонецОбласти
