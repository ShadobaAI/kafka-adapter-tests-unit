	Правило.Свойства.Очистить();
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Наименование";
	ПКС.СвойствоФормата = "name";
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Ключ";
	ПКС.СвойствоФормата = "key";
	Если ВложеннаяСтруктура Тогда
		ПКС = Правило.Свойства.Добавить();
		ПКС.СвойствоКонфигурации = "Общее";
		ПКС.СвойствоФормата = "general";
	КонецЕсли;
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "ОбщееИзКорня";
	ПКС.СвойствоФормата = "shared";
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "РезервноеИзКорня";
	ПКС.СвойствоФормата = "fallback";
	Источник = Новый Структура;
	Источник.Вставить("Наименование", "Корень");
	Источник.Вставить("Ключ", Новый Структура("name", "Ключевой"));
	Источник.Вставить("ОбщееИзКорня", "Общее корня");
	Источник.Вставить("РезервноеИзКорня", "Резерв корня");
	Если ВложеннаяСтруктура Тогда
		Источник.Вставить("Общее",
			Новый Структура("shared,fallback", "Общее вложенное", "Резерв вложенный"));
	КонецЕсли;

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	ЮТест.ОжидаетЧто(Результат, СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС))
		.ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Результат["name"]).Равно("Корень");
	ЮТест.ОжидаетЧто(Результат["key"]["name"]).Равно("Ключевой");
	Если ВложеннаяСтруктура Тогда
		ЮТест.ОжидаетЧто(Результат["general"]["shared"]).Равно("Общее вложенное");
		ЮТест.ОжидаетЧто(Результат["general"]["fallback"]).Равно("Резерв вложенный");
	Иначе
		ЮТест.ОжидаетЧто(Результат["general"]["shared"]).Равно("Общее корня");
		ЮТест.ОжидаетЧто(Результат["general"]["fallback"]).Равно("Резерв корня");
