Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкПараметрыКонтроляИнтеграции. Модуль менеджера. ПолучитьПараметры()")
			.Тег("Модульные")
			.Тег("кфкПараметрыКонтроляИнтеграции")
			.Тег("ПолучитьПараметры")
			.ДобавитьСерверныйТест("ПолучитьПараметры_ВозвращаетЗначенияПоУмолчанию",
				"ПолучитьПараметры(). Возвращает значения по умолчанию")
				.Тег("ВозвращаетЗначенияПоУмолчанию")
				.Перед("ОчиститьДанные")
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкПараметрыКонтроляИнтеграции. Модуль менеджера. ОбновитьПараметры()")
			.Тег("Модульные")
			.Тег("кфкПараметрыКонтроляИнтеграции")
			.Тег("ОбновитьПараметры")
			.ДобавитьСерверныйТест("ОбновитьПараметры_СохраняетВсеЗначения",
				"ОбновитьПараметры(). Сохраняет все значения")
				.Тег("СохраняетВсеЗначения")
				.Перед("ОчиститьДанные");
	
КонецПроцедуры

Процедура ОчиститьДанные() Экспорт
	РегистрыСведений.кфкПараметрыКонтроляИнтеграции.СоздатьНаборЗаписей().Записать();
КонецПроцедуры



Процедура ПолучитьПараметры_ВозвращаетЗначенияПоУмолчанию() Экспорт
	
	Параметры = РегистрыСведений.кфкПараметрыКонтроляИнтеграции.ПолучитьПараметры();
	
	ЮТест.ОжидаетЧто(Параметры, "Параметры контроля интеграции")
		.Равно(ПараметрыПоУмолчанию());
	
КонецПроцедуры

Процедура ОбновитьПараметры_СохраняетВсеЗначения() Экспорт
	
	ОжидаемыеПараметры = Новый Структура;
	ОжидаемыеПараметры.Вставить("ВремяSLAИсходящих", 21);
	ОжидаемыеПараметры.Вставить("ВремяSLAВходящих", 22);
	ОжидаемыеПараметры.Вставить("ИдентификаторЧатаТГ", "chat-id");
	ОжидаемыеПараметры.Вставить("ТокенБотаТГ", "bot-token");
	
	РегистрыСведений.кфкПараметрыКонтроляИнтеграции.ОбновитьПараметры(ОжидаемыеПараметры);
	ФактическиеПараметры = РегистрыСведений.кфкПараметрыКонтроляИнтеграции.ПолучитьПараметры();
	
	ЮТест.ОжидаетЧто(ФактическиеПараметры, "Сохраненные параметры контроля интеграции")
		.Равно(ОжидаемыеПараметры);
	
КонецПроцедуры

Функция ПараметрыПоУмолчанию()
	
	Результат = Новый Структура;
	Результат.Вставить("ВремяSLAИсходящих", 10);
	Результат.Вставить("ВремяSLAВходящих", 10);
	Результат.Вставить("ИдентификаторЧатаТГ", "");
	Результат.Вставить("ТокенБотаТГ", "");
	
	Возврат Результат;
	
КонецФункции
