// Проверяет реальную запись сообщений подписки независимого регистра.
//
// Параметры:
//  КоличествоЗаписей - Число - число исходных строк.
//  Режим - Строка - Добавление или Удаление.
//  Отказ - Булево - запретить регистрацию обработчиком.
Процедура ЗарегистрироватьИзмененияНабораПриЗаписи_ЗаписываетНезависимыйРегистр(
		Знач КоличествоЗаписей, Знач Режим, Знач Отказ) Экспорт

	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию")).Равно(Истина);
	Источник = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьНаборЗаписей();
	КлючСтроки = Строка(Новый УникальныйИдентификатор);
	Источник.Отбор.Строка.Установить(КлючСтроки);
	Для Номер = 1 По КоличествоЗаписей Цикл

		СтрокаИсточника = Источник.Добавить();
		СтрокаИсточника.Строка = КлючСтроки;
		СтрокаИсточника.Число = Номер;
		СтрокаИсточника.Комментарий = "Проверка регистрации набора";

	КонецЦикла;
	ТипОбъекта = Источник.Метаданные().ПолноеИмя();
	Продюсер = НовыйПродюсерДляРегистрации(ТипОбъекта);
	ОбновитьПовторноИспользуемыеЗначения();
	Замещение = ?(Режим = "Удаление", РежимЗамещения.Удаление, РежимЗамещения.Добавление);

	кфкОбработкаСобытийСлужебный.ЗарегистрироватьИзмененияНабораПриЗаписи(Источник, Отказ, Замещение);

	ПерваяСтрока = ?(КоличествоЗаписей = 0, 0, 1);
	Для Номер = ПерваяСтрока По КоличествоЗаписей Цикл

		ПоляКлюча = Новый Структура("Период,Строка,Число", Дата(1, 1, 1), КлючСтроки, Номер);
		КлючЗаписи = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьКлючЗаписи(ПоляКлюча);
		КлючОбъекта = кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючЗаписи, Истина);
		Отбор = ЮТест.Предикат()
			.Реквизит("КлючОбъекта").Равно(КлючОбъекта)
			.Реквизит("Продюсер").Равно(Продюсер);
		Если Отказ Тогда

			ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
				.НеСодержитЗаписи(Отбор);
			Продолжить;

		КонецЕсли;
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.СодержитНесколькоЗаписей(1, Отбор);
		ПоляЗаписи = ЮТест.Предикат()
			.Реквизит("КлючОбъекта").Равно(КлючОбъекта)
			.Реквизит("Продюсер").Равно(Продюсер)
			.Реквизит("ТипОбъект").Равно(ТипОбъекта)
			.Реквизит("ЭтоУдаление").Равно(Режим = "Удаление" Или КоличествоЗаписей = 0)
			.Реквизит("СобытиеРегистрации").Равно(Перечисления.кфкСобытияРегистрации.ПриЗаписи)
			.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Новое);
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.СодержитНесколькоЗаписей(1, ПоляЗаписи);
		Записи = ЮТЗапросы.Записи("РегистрСведений.кфкИсходящиеСообщения", Отбор);
		Для Каждого Запись Из Записи Цикл

			Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
			ЮТест.ОжидаетЧто(Данные.Строка).Равно(КлючСтроки);
			ЮТест.ОжидаетЧто(Данные.Число).Равно(Номер);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Проверяет сообщение регистратора независимо от числа строк движений.
//
// Параметры:
//  ЭтоРегистрНакопления - Булево - иначе подчиненный регистр сведений.
//  КоличествоЗаписей - Число - число исходных движений.
//  ЗаполнитьРегистратор - Булево - установить отбор регистратора.
//  Режим - Строка - Добавление или Удаление.
Процедура ЗарегистрироватьИзмененияНабораПриЗаписи_ЗаписываетПодчиненныйРегистр(
		Знач ЭтоРегистрНакопления,
		Знач КоличествоЗаписей,
		Знач ЗаполнитьРегистратор,
		Знач Режим) Экспорт

	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию")).Равно(Истина);
	Если ЭтоРегистрНакопления Тогда
		Источник = РегистрыНакопления.кфк_т_ТестовыйРегистрНакопления.СоздатьНаборЗаписей();
	Иначе
		Источник = РегистрыСведений.кфк_т_ТестовыйРегистрСведенийПР.СоздатьНаборЗаписей();
	КонецЕсли;
	Регистратор = Документы.кфк_т_ТестовыйДокумент.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Если ЗаполнитьРегистратор Тогда
		Источник.Отбор.Регистратор.Установить(Регистратор);
	КонецЕсли;
	Для Номер = 1 По КоличествоЗаписей Цикл

		СтрокаИсточника = Источник.Добавить();
		СтрокаИсточника.Идентификатор = "ORDER-" + Строка(Номер);
		СтрокаИсточника.Значение = Номер;

	КонецЦикла;
	ТипОбъекта = Источник.Метаданные().ПолноеИмя();
	Продюсер = НовыйПродюсерДляРегистрации(ТипОбъекта);
	ОбновитьПовторноИспользуемыеЗначения();
	Отказ = Ложь;
	Замещение = ?(Режим = "Удаление", РежимЗамещения.Удаление, РежимЗамещения.Добавление);

	кфкОбработкаСобытийСлужебный.ЗарегистрироватьИзмененияНабораПриЗаписи(Источник, Отказ, Замещение);

	ЮТест.ОжидаетЧто(Отказ).Равно(Ложь);
	Отбор = ЮТест.Предикат()
		.Реквизит("Продюсер").Равно(Продюсер);
	Если Не ЗаполнитьРегистратор Тогда

		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.НеСодержитЗаписи(Отбор);
		Возврат;

	КонецЕсли;
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитНесколькоЗаписей(1, Отбор);
	ПоляЗаписи = ЮТест.Предикат()
		.Реквизит("Продюсер").Равно(Продюсер)
		.Реквизит("ТипОбъект").Равно(ТипОбъекта)
		.Реквизит("ЭтоУдаление").Равно(Режим = "Удаление" Или КоличествоЗаписей = 0)
		.Реквизит("СобытиеРегистрации").Равно(Перечисления.кфкСобытияРегистрации.ПриЗаписи)
		.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Новое);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитНесколькоЗаписей(1, ПоляЗаписи);
	Записи = ЮТЗапросы.Записи("РегистрСведений.кфкИсходящиеСообщения", Отбор);
	Для Каждого Запись Из Записи Цикл

		Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
		ЮТест.ОжидаетЧто(Данные.Регистратор).Равно(Регистратор);

	КонецЦикла;

КонецПроцедуры

