// Регистрирует серверные сценарии проверки модуля и их теги для запуска YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ОписаниеКонсьюмера()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ОписаниеКонсьюмера")
			.ДобавитьСерверныйТест("ОписаниеКонсьюмера_ВозвращаетПодготовленныеНастройки",
				"ОписаниеКонсьюмера(). Возвращает подготовленные настройки")
				.Тег("ВозвращаетПодготовленныеНастройки")
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ОписаниеКонсьюмеров()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ОписаниеКонсьюмеров")
			.ДобавитьСерверныйТест("ОписаниеКонсьюмеров_ВозвращаетОписанияПереданныхКонсьюмеров",
				"ОписаниеКонсьюмеров(). Возвращает описания переданных консьюмеров")
				.Тег("ВозвращаетОписанияПереданныхКонсьюмеров")
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ПравилаДесериализации()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ПравилаДесериализации")
			.ДобавитьСерверныйТест("ПравилаДесериализации_ВозвращаетПодготовленноеПравило",
				"ПравилаДесериализации(). Возвращает подготовленное правило")
				.Тег("ВозвращаетПодготовленноеПравило")
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ИдемпотентнаяОбработка()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ИдемпотентнаяОбработка")
			.ДобавитьСерверныйТест("ИдемпотентнаяОбработка_ВозвращаетТолькоКонсьюмеровСВключеннымФлагом",
				"ИдемпотентнаяОбработка(). Возвращает только консьюмеров с включенным флагом")
				.Тег("ВозвращаетТолькоКонсьюмеровСВключеннымФлагом");
	

	ЮТТесты
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. ПравилаДесериализации(). По умолчанию")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ПравилаДесериализации")
			.Перед("ОчиститьПодменуПространствИменXDTO")
			.После("ОчиститьПодменуПространствИменXDTO")
			.ДобавитьСерверныйТест("ПравилаДесериализации_ПрименяетНастройкиПоПолям",
				"ПравилаДесериализации(). Приоритет полей и сохранность строки")
				.СПараметрами(Ложь, Ложь, Ложь, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Ложь, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Ложь, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Истина, Ложь, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Истина, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Истина, Истина, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Истина, Истина, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Истина, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Истина, Истина, Истина, Ложь)
				.СПараметрами(Истина, Истина, Истина, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Ложь, Ложь, Ложь, Ложь)
				.СПараметрами(Ложь, Истина, Ложь, Ложь, Ложь, Ложь)
				.СПараметрами(Ложь, Ложь, Ложь, Ложь, Истина, Истина)
				.СПараметрами(Истина, Истина, Истина, Истина, Истина, Истина);

