#Область СлужебныеПроцедурыИФункции

// См. кфкОбщегоНазначенияСлужебный.ПодсистемаДоступна
&Around("ПодсистемаДоступна")
Функция ют_ПодсистемаДоступна()

	Аргументы = Новый Массив; // Массив Из Произвольный
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		кфкОбщегоНазначенияСлужебный,
		"ПодсистемаДоступна",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = ПродолжитьВызов();
	Возврат Результат;

КонецФункции

// Подменяет паузу для тестов, в том числе в отдельных сеансах фоновых заданий.
// Параметры:
//  Интервал - Число - длительность паузы в миллисекундах.
&Around("Пауза")
Процедура ют_Пауза(Интервал)

	КонтекстТеста = ЮТест.КонтекстТеста();
	Если КонтекстТеста <> Неопределено И КонтекстТеста.Свойство("ют_ПаузаПлатформы") Тогда

		ПродолжитьВызов(Интервал);
		Возврат;

	КонецЕсли;

	ЮТест.Пауза(Интервал / 1000);

КонецПроцедуры



#КонецОбласти
