// Проверяет повторное применение, добавление и удаление консьюмера без изменения чужих назначений.
Процедура ОбновитьРаспределениеКонсьюмеров_СохраняетРабочееСостояние() Экспорт

	Первый = НоваяСсылкаКонсьюмера();
	Второй = НоваяСсылкаКонсьюмера();
	Поток = Новый УникальныйИдентификатор;
	ЧужойПоток = Новый УникальныйИдентификатор;
	Потоки = Новый Массив; // Массив Из УникальныйИдентификатор
	Потоки.Добавить(Поток);
	ПамятьОчереди = Новый Соответствие;
	Добавление = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	Удаление = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	ЧужаяЗапись = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
	ЧужаяЗапись.ИдентификаторПотока = ЧужойПоток;
	ЧужаяЗапись.Ключ = XMLСтрока(Первый);
	ЧужаяЗапись.ВременнаяМетка = 0;
	ЧужаяЗапись.Записать();
	Распределение = НовоеРаспределениеКонсьюмеров();
	Распределение.Добавить().Консьюмер = Первый;
	Распределение[0].НомерПотока = 1;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьРаспределениеКонсьюмеров(
		Распределение, Потоки, Добавление, Удаление, ПамятьОчереди);
	кфкФоновыеОперацииСлужебный.ют_ОбновитьРаспределениеКонсьюмеров(
		Распределение, Потоки, Добавление, Удаление, ПамятьОчереди);

	ЮТест.ОжидаетЧто(Добавление.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Удаление.Количество()).Равно(0);
	Текущие = ПамятьОчереди.Получить(Поток); // Массив Из СправочникСсылка.кфкКонсьюмеры
	ЮТест.ОжидаетЧто(Текущие.Количество()).Равно(1);
	Распределение.Добавить().Консьюмер = Второй;
	Распределение[1].НомерПотока = 1;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьРаспределениеКонсьюмеров(
		Распределение, Потоки, Добавление, Удаление, ПамятьОчереди);

	ПроверитьКонсьюмераВОчереди(Поток, Первый, Истина);
	ПроверитьКонсьюмераВОчереди(Поток, Второй, Истина);
	Распределение.Удалить(0);

	кфкФоновыеОперацииСлужебный.ют_ОбновитьРаспределениеКонсьюмеров(
		Распределение, Потоки, Добавление, Удаление, ПамятьОчереди);

	ПроверитьКонсьюмераВОчереди(Поток, Первый, Ложь);
	ПроверитьКонсьюмераВОчереди(Поток, Второй, Истина);
	ПроверитьКонсьюмераВОчереди(ЧужойПоток, Первый, Истина);
	Текущие = ПамятьОчереди.Получить(Поток); // Массив Из СправочникСсылка.кфкКонсьюмеры
	ЮТест.ОжидаетЧто(Текущие.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Текущие[0]).Равно(Второй);

КонецПроцедуры

#КонецОбласти

