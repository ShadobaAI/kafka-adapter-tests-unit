&Перед("ОтправитьЛоги")
Процедура ют_ПодставитьHTTPСессиюЛогирования(ПараметрыЛогирования, События, Сессия)

	ТестоваяСессия = Неопределено; // ОбщийМодуль, Неопределено
	Если ЮТест.КонтекстТеста().Свойство("ют_HTTPСессияЛогирования", ТестоваяСессия) Тогда
		Сессия = ТестоваяСессия;
	КонецЕсли;

