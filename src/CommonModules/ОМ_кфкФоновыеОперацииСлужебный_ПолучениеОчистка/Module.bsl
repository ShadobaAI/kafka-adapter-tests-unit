	Параметры = НовыеПараметрыОчистки();
	ЗаписатьПозицииЛогов();
	Если Входящие Тогда
		Параметры.СрокХраненияОбработанных = -2;
		Менеджер = РегистрыСведений.кфкВходящиеСообщения;
		Статус = Перечисления.кфкСтатусыСообщений.Обработано;
	Иначе
		Параметры.СрокХраненияОтправленных = -2;
		Менеджер = РегистрыСведений.кфкИсходящиеСообщения;
		Статус = Перечисления.кфкСтатусыСообщений.Выгружено;
	КонецЕсли;
	Первый = НоваяЗаписьОчереди(Входящие, 100, Статус);
	Второй = НоваяЗаписьОчереди(Входящие, 200, Статус);
	Хвост = НоваяЗаписьОчереди(Входящие, 300, Статус);
	Контроль = НоваяЗаписьОчереди(Входящие, 3000000, Статус);
	Выборка = ВыборкаОчистки(Входящие, Параметры, 3);

	кфкФоновыеОперацииСлужебный.ют_УдалитьЗаписи(Выборка, Менеджер, 2);

	ПроверитьОтсутствиеЗаписи(Входящие, Первый);
	ПроверитьОтсутствиеЗаписи(Входящие, Второй);
	ПроверитьНаличиеЗаписи(Входящие, Хвост);

	кфкФоновыеОперацииСлужебный.ют_УдалитьЗаписи(Выборка, Менеджер, 2);

	ПроверитьОтсутствиеЗаписи(Входящие, Хвост);
	ПроверитьНаличиеЗаписи(Входящие, Контроль);

