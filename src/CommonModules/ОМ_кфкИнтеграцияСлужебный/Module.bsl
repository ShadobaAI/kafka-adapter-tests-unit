// Проверяет статусы узла, отсутствующего брокера и исключение координатора группы.
// Параметры:
//  ИдентификаторУзла - Число - идентификатор из статистики Kafka.
//  Источник - Строка - источник сведений об узле.
//  Доступен - Булево - ожидаемый статус узла.
Процедура ПроверитьПодключениеКБрокеруВФоне_РазбираетСтатистику(
	Знач ИдентификаторУзла, Знач Источник, Знач Доступен) Экспорт

	Статистика = НоваяСтрокаСтатистики(ИдентификаторУзла, Источник);
	Компонента = КомпонентаСЖурналами(Статистика);
	Брокеры = СтрРазделить("node1:9092,missing:9092", ",");
	Параметры = Новый Соответствие;
	Параметры.Вставить("client.id", "unit-probe");

	Результат = кфкИнтеграцияСлужебный.ПроверитьПодключениеКБрокеруВФоне(Брокеры, Параметры);

	ЮТест.ОжидаетЧто(Результат.Статусы.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Результат.Статусы["node1:9092"]).Равно(Доступен);
	ЮТест.ОжидаетЧто(Результат.Статусы["missing:9092"]).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.Статусы.Получить("GroupCoordinator")).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.ТекстЖурнала, "producer log") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.ТекстЖурнала, Статистика) > 0).Равно(Истина);
	ПроверитьПараметрКомпоненты(Компонента, "client.id", "unit-probe");
	ПроверитьПараметрКомпоненты(Компонента, "statistics.interval.ms", "5000");
	ПроверитьПараметрКомпоненты(Компонента, "debug", "all");
	ПроверитьВызовы(Компонента, "УстановитьПараметр", 3);
	ПроверитьВызовы(Компонента, "ИнициализироватьПродюсера", 1,
		ЮТМетоды.МассивПараметров("node1:9092,missing:9092"));
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 1, Новый Массив);
	ЮТест.ОжидаетЧто(Компонента.ФорматИмениФайловЛога).Равно("");
	Каталог = Новый Файл(Компонента.КаталогЛогов);
	ЮТест.ОжидаетЧто(Каталог.Существует()).Равно(Ложь);
	ПроверитьФабрику(1);

КонецПроцедуры

// Проверяет накопление статуса по нескольким строкам статистики.
// Параметры:
//  ПервыйУзел - Число - идентификатор узла в первом измерении.
//  ВторойУзел - Число - идентификатор узла во втором измерении.
//  Доступен - Булево - ожидаемый суммарный статус.
Процедура ПроверитьПодключениеКБрокеруВФоне_УчитываетВсеИзмерения(
	Знач ПервыйУзел, Знач ВторойУзел, Знач Доступен) Экспорт

	Статистика = "prefix " + НоваяСтрокаСтатистики(ПервыйУзел, "learned")
		+ Символы.ПС + "prefix " + НоваяСтрокаСтатистики(ВторойУзел, "learned");
	Компонента = КомпонентаСЖурналами(Статистика);

	Результат = кфкИнтеграцияСлужебный.ПроверитьПодключениеКБрокеруВФоне(
		СтрРазделить("node1:9092", ","), Новый Соответствие);

	ЮТест.ОжидаетЧто(Результат.Статусы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Статусы["node1:9092"]).Равно(Доступен);
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 1, Новый Массив);
	ПроверитьФабрику(1);

КонецПроцедуры

// Проверяет пустые циклы статистики и заполнение отсутствующих узлов.
// Параметры:
//  ЕстьЗапрошенныйБрокер - Булево - передавать отсутствующий в статистике узел.
Процедура ПроверитьПодключениеКБрокеруВФоне_ОбрабатываетПустойСписок(
	Знач ЕстьЗапрошенныйБрокер) Экспорт

	Компонента = КомпонентаСЖурналами("{""brokers"":{}}");
	Брокеры = Новый Массив; // Массив Из Строка
	Если ЕстьЗапрошенныйБрокер Тогда
		Брокеры.Добавить("missing:9092");
	КонецЕсли;

	Результат = кфкИнтеграцияСлужебный.ПроверитьПодключениеКБрокеруВФоне(Брокеры, Новый Соответствие);

	ЮТест.ОжидаетЧто(Результат.Статусы.Количество()).Равно(?(ЕстьЗапрошенныйБрокер, 1, 0));
	Если ЕстьЗапрошенныйБрокер Тогда
		ЮТест.ОжидаетЧто(Результат.Статусы["missing:9092"]).Равно(Ложь);
	КонецЕсли;
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 1, Новый Массив);
	ПроверитьФабрику(1);

КонецПроцедуры

// Проверяет отказ при отсутствии файла и при пустом содержимом найденного файла.
// Параметры:
//  Продюсер - Булево - проверять журнал продюсера, иначе статистику.
//  СоздатьПустойФайл - Булево - создать пустой файл вместо отсутствующего.
Процедура ПроверитьПодключениеКБрокеруВФоне_ОтклоняетНеполныеЖурналы(
	Знач Продюсер, Знач СоздатьПустойФайл) Экспорт

	Компонента = НоваяКомпонента();
	Файлы = Новый Соответствие; // Соответствие Из КлючИЗначение: Ключ - Строка, Значение - Строка
	Файлы.Вставить("producer_unit_.log", "producer log");
	Файлы.Вставить("statistics_unit_.log", "{""brokers"":{}}");
	ИмяФайла = ?(Продюсер, "producer_unit_.log", "statistics_unit_.log");
	Если СоздатьПустойФайл Тогда
		Файлы.Вставить(ИмяФайла, "");
	Иначе
		Файлы.Удалить(ИмяФайла);
	КонецЕсли;
	Компонента.НастроитьОтвет("ФайлыЖурнала", Файлы);
	ТекстОшибки = ?(Продюсер, "Не удалось получить логи продюсера.", "Не удалось получить статистику.");
	Аргументы = ЮТМетоды.МассивПараметров(СтрРазделить("node1:9092", ","), Новый Соответствие);

	ЮТест.ОжидаетЧто(кфкИнтеграцияСлужебный)
		.Метод("ПроверитьПодключениеКБрокеруВФоне", Аргументы)
		.ВыбрасываетИсключение(ТекстОшибки);

	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 1, Новый Массив);
	ПроверитьФабрику(1);

КонецПроцедуры

// Проверяет ошибку разбора после получения файлов внешней компоненты.
// Параметры:
//  Статистика - Строка - поврежденный JSON или неполное описание брокера.
Процедура ПроверитьПодключениеКБрокеруВФоне_ОтклоняетНекорректнуюСтатистику(
