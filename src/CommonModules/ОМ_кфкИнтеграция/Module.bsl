// Сбрасывает подмены и кэш зависимостей после каждого сценария.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Проверяет: УстанавливаетФлагИСохраняетОстальныеСвойства.
Процедура Отключить_УстанавливаетФлагИСохраняетОстальныеСвойства() Экспорт

	Источник = Справочники.кфкПродюсеры.СоздатьЭлемент();
	Источник.ДополнительныеСвойства.Вставить("кфкПропуститьРегистрацию", Ложь);
	Источник.ДополнительныеСвойства.Вставить("Сохранить", "исходное значение");

	кфкИнтеграция.Отключить(Источник);
	кфкИнтеграция.Отключить(Источник);

	ЮТест.ОжидаетЧто(Источник.ДополнительныеСвойства.кфкПропуститьРегистрацию).Равно(Истина);
	ЮТест.ОжидаетЧто(Источник.ДополнительныеСвойства.Сохранить).Равно("исходное значение");

КонецПроцедуры

#Область ПоместитьВОчередьИсходящих

// Проверяет: НеРегистрируетПриОтключеннойОпции.
Процедура ПоместитьВОчередьИсходящих_НеРегистрируетПриОтключеннойОпции() Экспорт

	ИспользоватьИнтеграцию = Константы.кфкИспользоватьИнтеграцию.Получить();
	Попытка
		Константы.кфкИспользоватьИнтеграцию.Установить(Ложь);
		ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию")).Равно(Ложь);
		Мокито.Обучение(кфкОбработкаСобытийСлужебный)
			.Когда("ПараметрыРегистрации")
				.Вернуть(Новый Структура);
		Мокито.Прогон();

		кфкИнтеграция.ПоместитьВОчередьИсходящих(Новый Структура);

		Мокито.Проверить(кфкОбработкаСобытийСлужебный)
			.КоличествоВызовов("ПараметрыРегистрации").Равно(0);
	Исключение
		Константы.кфкИспользоватьИнтеграцию.Установить(ИспользоватьИнтеграцию);
		ВызватьИсключение;
	КонецПопытки;
	Константы.кфкИспользоватьИнтеграцию.Установить(ИспользоватьИнтеграцию);

КонецПроцедуры

// Проверяет: ПередаетОдиночныйОбъект.
Процедура ПоместитьВОчередьИсходящих_ПередаетОдиночныйОбъект() Экспорт

	Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию")).Равно(Истина);
	Источник = Новый Структура("Сообщение", "одиночное");
	Продюсер = Справочники.кфкПродюсеры.ПустаяСсылка();
	ТипОбъекта = "ПроизвольноеСообщение";
	Параметры = НовыеПараметрыРегистрации();
	НастроитьРегистрацию(Параметры);

	кфкИнтеграция.ПоместитьВОчередьИсходящих(Источник, ТипОбъекта, Продюсер);

	Аргументы = ЮТМетоды.МассивПараметров(Продюсер, Ложь);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("ПараметрыРегистрации", Аргументы).Равно(1);
	Аргументы = ЮТМетоды.МассивПараметров(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		ТипОбъекта,
		Ложь,
		Параметры);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("ПоместитьВОчередьИсходящих", Аргументы).Равно(1)
		.КоличествоВызовов("ЗавершитьРегистрацию").Равно(0);

КонецПроцедуры

// Проверяет: ПередаетЗначенияПоУмолчанию.
Процедура ПоместитьВОчередьИсходящих_ПередаетЗначенияПоУмолчанию() Экспорт

	Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
	Источник = Новый Структура("Сообщение", "по умолчанию");
	Параметры = НовыеПараметрыРегистрации();
	НастроитьРегистрацию(Параметры);

	кфкИнтеграция.ПоместитьВОчередьИсходящих(Источник);

	Аргументы = ЮТМетоды.МассивПараметров(Неопределено, Ложь);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("ПараметрыРегистрации", Аргументы).Равно(1);
	Аргументы = ЮТМетоды.МассивПараметров(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		Ложь,
		Параметры);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("ПоместитьВОчередьИсходящих", Аргументы).Равно(1);

