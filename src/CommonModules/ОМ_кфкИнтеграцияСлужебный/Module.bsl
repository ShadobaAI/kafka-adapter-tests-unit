	ЮТест.ОжидаетЧто(Заголовки).ИмеетДлину(2);

КонецПроцедуры

// Проверяет сохранение бинарных данных без преобразования.
Процедура ТелоСообщения_СохраняетДвоичныеДанные() Экспорт

	Данные = Base64Значение("AAEC/w==");
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);

	Результат = кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение);

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("ДвоичныеДанные");
	ЮТест.ОжидаетЧто(Base64Строка(Результат)).Равно("AAEC/w==");

КонецПроцедуры

// Проверяет сериализацию каждого разрешенного типа коллекции.
// Параметры:
//  ИмяТипа - Строка - изменяемый тип коллекции.
//  Фиксировать - Булево - использовать неизменяемую коллекцию.
Процедура ТелоСообщения_СериализуетКоллекции(Знач ИмяТипа, Знач Фиксировать) Экспорт

	Данные = НоваяКоллекцияСообщения(ИмяТипа, Фиксировать);
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);
	ТекстОшибки = "";

	Результат = кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение, ТекстОшибки);

	ЮТест.ОжидаетЧто(Результат).Равно(?(ИмяТипа = "Массив", "[]", "{}"));
	ЮТест.ОжидаетЧто(ТекстОшибки).Равно("");

КонецПроцедуры

// Проверяет исключение реального сериализатора на вложенном неподдерживаемом значении.
Процедура ТелоСообщения_ВозвращаетОшибкуСериализации() Экспорт

	Данные = Новый Структура("Документ", Новый ТекстовыйДокумент);
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);
	ТекстОшибки = "";

	Результат = кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение, ТекстОшибки);

	ЮТест.ОжидаетЧто(Результат).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(ПустаяСтрока(ТекстОшибки)).Равно(Ложь);

КонецПроцедуры

#КонецОбласти


#Область ПубликацияСообщений

// Проверяет результат отправки и отсутствие автоматического закрытия сохраненной сессии.
// Параметры:
//  Статус - Число - ответ компоненты.
//  Успешно - Булево - ожидаемый результат операции.
Процедура Отправить_ПередаетАргументыВКэшированнуюСессию(Знач Статус, Знач Успешно) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ОтправитьСообщениеСОжиданиемРезультата", Статус);
	Коннектор = Обработки.кфкИнтеграция.Создать();
	Продюсер = Справочники.кфкПродюсеры.ПустаяСсылка();
	Сессии = Новый Соответствие;
	Сессии.Вставить(Продюсер, Коннектор);
	Сообщение = кфкИнтеграция.ПараметрыСообщения("данные");
	Сообщение.Ключ = "ключ";
	Сообщение.Заголовки.Вставить("заголовок", "значение");

	Результат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение, 3, Сессии);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Успешно);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Равно(?(Успешно, "", "ошибка компоненты"));
	ПроверитьВызовы(Компонента, "ОтправитьСообщениеСОжиданиемРезультата", 1,
		ЮТМетоды.МассивПараметров("данные", "unit-topic", 3, "ключ", "заголовок,значение"));
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 0);
	ПроверитьВызовы(Компонента, "ПолучитьСообщениеОбОшибке", ?(Успешно, 0, 1));
	ЮТест.ОжидаетЧто(Сессии.Получить(Продюсер)).Равно(Коннектор);
	ПроверитьФабрику(1);

КонецПроцедуры

// Проверяет отказ до обращения к компоненте при недопустимом теле сообщения.
Процедура Отправить_ОтклоняетТелоДоВызоваКомпоненты() Экспорт

	Компонента = НоваяКомпонента();
	Коннектор = Обработки.кфкИнтеграция.Создать();
	Продюсер = Справочники.кфкПродюсеры.ПустаяСсылка();
	Сессии = Новый Соответствие;
	Сессии.Вставить(Продюсер, Коннектор);
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Истина);

	Результат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение, -1, Сессии);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Равно("Неподдерживаемый тип передачи данных!");
	ЮТест.ОжидаетЧто(Компонента.ИсторияВызовов()).ИмеетДлину(0);

КонецПроцедуры

// Проверяет пустой цикл и закрытие каждого элемента коллекции.
// Параметры:
//  Количество - Число - число сессий.
Процедура ЗакрытьСессииПродюсера_ЗакрываетВсеСессии(Знач Количество) Экспорт

	Компонента = НоваяКомпонента();
	Сессии = Новый Соответствие;
	Для Индекс = 1 По Количество Цикл
		Сессии.Вставить(Индекс, Обработки.кфкИнтеграция.Создать());
	КонецЦикла;

	кфкИнтеграцияСлужебный.ЗакрытьСессииПродюсера(Сессии);

	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", Количество);
	ЮТест.ОжидаетЧто(Сессии).ИмеетДлину(Количество);

КонецПроцедуры

// Проверяет реальную загрузку настроек, аргументы по умолчанию и закрытие одноразовой сессии.
Процедура Отправить_СоздаетИЗакрываетОдноразовуюСессию() Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ОтправитьСообщениеСОжиданиемРезультата", 2);
	Компонента.НастроитьОтвет("ОтправитьСообщение", 2);
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Настройки = Справочники.кфкПродюсеры.ОписаниеПродюсера(Продюсер);
	Сообщение = кфкИнтеграция.ПараметрыСообщения("данные");

	Результат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Истина);
	ПроверитьВызовы(Компонента, "ИнициализироватьПродюсера", 1,
		ЮТМетоды.МассивПараметров(Настройки.АдресБрокера));
	МетодОтправки = ?(Настройки.РежимАсинх, "ОтправитьСообщение", "ОтправитьСообщениеСОжиданиемРезультата");
	Аргументы = ЮТМетоды.МассивПараметров("данные", "unit-topic", -1, "", "");
	ПроверитьВызовы(Компонента, МетодОтправки, 1, Аргументы);
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 1);
	ПроверитьФабрику(1);

КонецПроцедуры

// Проверяет создание сессии один раз при повторной публикации.
Процедура Отправить_ПовторноИспользуетСозданнуюСессию() Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ОтправитьСообщениеСОжиданиемРезультата", 2);
	Компонента.НастроитьОтвет("ОтправитьСообщение", 2);
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Сообщение = кфкИнтеграция.ПараметрыСообщения("данные");
	Сессии = Новый Соответствие;

	ПервыйРезультат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение, -1, Сессии);
	Сессия = Сессии.Получить(Продюсер);
	ВторойРезультат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение, -1, Сессии);

	ЮТест.ОжидаетЧто(ПервыйРезультат.Успешно).Равно(Истина);
	ЮТест.ОжидаетЧто(ВторойРезультат.Успешно).Равно(Истина);
	ЮТест.ОжидаетЧто(Сессии.Получить(Продюсер)).Равно(Сессия);
	ПроверитьВызовы(Компонента, "ИнициализироватьПродюсера", 1);
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 0);
	ПроверитьФабрику(1);
	кфкИнтеграцияСлужебный.ЗакрытьСессииПродюсера(Сессии);
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 1);

КонецПроцедуры

// Проверяет ранний отказ при недоступном продюсере и сбое инициализации.
// Параметры:
//  Отключен - Булево - использовать пустую ссылку.
Процедура Отправить_ВозвращаетОшибкуСозданияСессии(Знач Отключен) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ИнициализироватьПродюсера", Ложь);
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Если Отключен Тогда
		Продюсер = Справочники.кфкПродюсеры.ПустаяСсылка();
	КонецЕсли;
	Сообщение = кфкИнтеграция.ПараметрыСообщения("данные");
	Сессии = Новый Соответствие;

	Результат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение, -1, Сессии);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Равно(?(Отключен, "Продюсер отключён!", "ошибка компоненты"));
	ЮТест.ОжидаетЧто(Сессии.Получить(Продюсер)).ЭтоНеопределено();
	ПроверитьФабрику(?(Отключен, 0, 1));
	ПроверитьВызовы(Компонента, "ОтправитьСообщениеСОжиданиемРезультата", 0);

КонецПроцедуры

// Проверяет счетчики, пустой цикл и ошибки отдельных сообщений.
// Параметры:
//  Ответ - Строка - JSON компоненты.
//  Количество - Число - число исходных сообщений.
//  Успешно - Булево - общий результат.
//  Ошибок - Число - число ошибок отдельных сообщений.
Процедура ОтправитьПакетСообщений_РазбираетРезультат(
		Знач Ответ,
		Знач Количество,
		Знач Успешно,
		Знач Ошибок) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ОтправитьПакетСРезультатом", Ответ);
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Сообщения = НовыеПакетныеСообщения(Количество);

	Результат = кфкИнтеграцияСлужебный.ОтправитьПакетСообщений(Продюсер, Сообщения, "unit-topic", 3210);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Успешно);
	ЮТест.ОжидаетЧто(Результат.Ошибки).ИмеетДлину(Ошибок);
	Если Ошибок > 0 Тогда

		ЮТест.ОжидаетЧто(Результат.Ошибки.Получить(1)).Равно("Неизвестная ошибка");
		ЮТест.ОжидаетЧто(Результат.Ошибки.Получить(2)).Равно("отказ брокера");
		ЮТест.ОжидаетЧто(Результат.Ошибки.Получить(0)).ЭтоНеопределено();

	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Равно(?(ПустаяСтрока(Ответ), "ошибка компоненты", ""));
	ПроверитьВызовы(Компонента, "ОтправитьПакетСРезультатом", 1,
		ЮТМетоды.МассивПараметров(кфкОбщегоНазначенияСлужебный.ЗначениеВJSON(Сообщения), "unit-topic", 3210));
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", ?(ПустаяСтрока(Ответ), 0, 1));

КонецПроцедуры

// Проверяет обе причины несогласованности счетчиков пакета.
// Параметры:
//  Ответ - Строка - некорректные счетчики компоненты.
Процедура ОтправитьПакетСообщений_ОтклоняетНесогласованныеСчетчики(Знач Ответ) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ОтправитьПакетСРезультатом", Ответ);
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Сообщения = НовыеПакетныеСообщения(1);
	Параметры = ЮТМетоды.МассивПараметров(Продюсер, Сообщения, "unit-topic", 123);

	ЮТест.ОжидаетЧто(кфкИнтеграцияСлужебный)
		.Метод("ОтправитьПакетСообщений", Параметры)
		.ВыбрасываетИсключение("Некорректный результат отправки сообщений.");

	ПроверитьВызовы(Компонента, "ОтправитьПакетСРезультатом", 1);
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 0);

КонецПроцедуры

// Проверяет отказ до отправки пакета и сохранение открытой сессии.
// Параметры:
//  Отказ - Булево - моделировать отказ инициализации.
Процедура ОтправитьПакетСообщений_УправляетСессией(Знач Отказ) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ИнициализироватьПродюсера", Не Отказ);
	Компонента.НастроитьОтвет("ОтправитьПакетСРезультатом",
		"{""total"":""0"",""success_count"":""0"",""failed_count"":""0"",""results"":[]}");
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Сессии = Новый Соответствие;
	Сообщения = НовыеПакетныеСообщения(0);

	Результат = кфкИнтеграцияСлужебный.ОтправитьПакетСообщений(
		Продюсер,
		Сообщения,
		"unit-topic",
		3210,
		Сессии);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Не Отказ);
	ПроверитьВызовы(Компонента, "ОтправитьПакетСРезультатом", ?(Отказ, 0, 1));
	ПроверитьВызовы(Компонента, "ОстановитьПродюсера", 0);
	Если Не Отказ Тогда
		кфкИнтеграцияСлужебный.ЗакрытьСессииПродюсера(Сессии);
	КонецЕсли;

КонецПроцедуры

// Проверяет ранние возвраты одноразовой отправки и освобождает тестовую сессию.
// Параметры:
//  НеверноеТело - Булево - отказ преобразования вместо отказа отправки.
Процедура Отправить_ВозвращаетОшибкуОдноразовойОтправки(Знач НеверноеТело) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ОтправитьСообщение", 0);
	Компонента.НастроитьОтвет("ОтправитьСообщениеСОжиданиемРезультата", 0);
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	Данные = ?(НеверноеТело, Истина, "данные");
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);

	Результат = кфкИнтеграцияСлужебный.Отправить(Продюсер, "unit-topic", Сообщение);

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Ложь);
