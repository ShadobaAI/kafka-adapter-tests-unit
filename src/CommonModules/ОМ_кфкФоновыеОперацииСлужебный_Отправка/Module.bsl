	Правило.Вставить("КомпонентыОбмена", Компоненты);
	Правило.Вставить("ИмяПОД", "unit");
	Правила = Новый Соответствие;
	Правила.Вставить(НРег(XMLСтрока(Пакет.Продюсер) + Запись.ТипОбъект), Правило);
	История = Новый Массив; // Массив Из Структура
	ЮТест.КонтекстТеста().Вставить("ют_ВызовыКД", История);
	ЮТест.КонтекстТеста().Вставить("ют_ПропуститьКД", Ложь);
	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаСериализацииВПотоке(Пакет.Поток, 100);

	кфкФоновыеОперацииСлужебный.ют_СериализоватьПакет(
		Выборка, кфкФоновыеОперацииСлужебный.ют_ОчередиИсходящих(), Пакет.Поток, Правила);

	ЮТест.ОжидаетЧто(История).ИмеетДлину(1);
	ПроверитьИсходящее(Запись, Перечисления.кфкСтатусыСообщений.ОшибкаОбработки, 3);
