// Вложенный путь создает дерево и сохраняет соседнее свойство.
// Параметры:
//  Путь - Строка - имя поля формата из двух, трех или четырех сегментов.
Процедура ПроизвестиВыгрузкуДанных_ВложенныйПуть_СохраняетДеревоИСоседа(Путь) Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	Компоненты.МенеджерОбмена = ют_МенеджерОбменаXDTOДляВыбораПравил;
	Правило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	СоседнееСвойство = Правило.Свойства.Добавить();
	СоседнееСвойство.СвойствоКонфигурации = "Наименование";
	СоседнееСвойство.СвойствоФормата = "nested.keep";
	ВложенноеСвойство = Правило.Свойства.Добавить();
	ВложенноеСвойство.СвойствоКонфигурации = "Комментарий";
	ВложенноеСвойство.СвойствоФормата = Путь;
	Правило.ПриОтправкеДанных = "СохранитьВложенноеДерево";
	Правило.ЕстьОбработчикПриОтправкеДанных = Истина;
	Источник = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "Соседнее значение")
		.Установить("Комментарий", "Целевое значение")
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина);

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	ЮТест.ОжидаетЧто(Результат, СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС))
		.ЭтоНеНеопределено();
	Дерево = Компоненты.СвойстваСообщения.ТестовоеДерево;
	ЮТест.ОжидаетЧто(ТипЗнч(Дерево)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Дерево["keep"]).Равно("Соседнее значение");
	Сегменты = СтрРазделить(Путь, ".", Ложь);
	ТекущийУзел = Дерево;
	Для Уровень = 1 По Сегменты.Количество() - 1 Цикл
