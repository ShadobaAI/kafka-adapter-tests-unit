#Область СлужебныйПрограммныйИнтерфейс

// Отмечает вызов тестового обработчика перед конвертацией.
// Параметры:
//  КомпонентыОбмена - Структура - компоненты обмена.
//  Источник - СправочникОбъект, Неопределено - источник выгрузки для менеджера КФК.
Процедура ПередКонвертацией(КомпонентыОбмена, Источник = Неопределено) Экспорт

	Если КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестоваяОшибкаДо") = Истина Тогда
		ВызватьИсключение "Тестовая ошибка до результата";
	КонецЕсли;
	Если КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестовыйПропускДо") = Истина Тогда
		КомпонентыОбмена.ФлагПропустить = Истина;
		КомпонентыОбмена.ПротоколКонвертации.Добавить("Тестовый отказ до результата");
	КонецЕсли;
	КоличествоВызовов = 0;
	Если Не КомпонентыОбмена.СвойстваСообщения.Свойство("ТестовоеКоличествоДо", КоличествоВызовов) Тогда
		КоличествоВызовов = 0;
	КонецЕсли;
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовоеКоличествоДо", КоличествоВызовов + 1);
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыйИсточникДо", Источник);
	Если КомпонентыОбмена.ЗаголовкиСообщения.Получить("СохранятьПустые") = Истина Тогда
		КомпонентыОбмена.ОтключитьПреобразованиеВNull = Истина;
	КонецЕсли;
	Если КомпонентыОбмена.ЗаголовкиСообщения.Получить("БезТранзакции") = Истина Тогда
		КомпонентыОбмена.ИспользоватьТранзакции = Ложь;
	КонецЕсли;
	Если КомпонентыОбмена.ЗаголовкиСообщения.Получить("УдалятьСозданныеПоКлючевымСвойствам") = Истина Тогда
		КомпонентыОбмена.УдалятьСозданныеПоКлючевымСвойствам = Истина;
	КонецЕсли;
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыйОбработчикДо", Истина);

КонецПроцедуры

// Отмечает вызов тестового обработчика после конвертации.
// Параметры:
//  КомпонентыОбмена - Структура - компоненты обмена.
//  Источник - СправочникОбъект - источник выгрузки.
//  Результат - Структура, Неопределено - сформированное сообщение для менеджера КФК.
Процедура ПослеКонвертации(КомпонентыОбмена, Источник = Неопределено, Результат = Неопределено) Экспорт

	Если КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестоваяОшибкаПосле") = Истина Тогда
		ВызватьИсключение "Тестовая ошибка после результата";
	КонецЕсли;
	КоличествоВызовов = 0;
	Если Не КомпонентыОбмена.СвойстваСообщения.Свойство("ТестовоеКоличествоПосле", КоличествоВызовов) Тогда
		КоличествоВызовов = 0;
	КонецЕсли;
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовоеКоличествоПосле", КоличествоВызовов + 1);
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыйИсточникПосле", Источник);
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыйРезультатПосле", Результат);
	КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыйОбработчикПосле", Истина);

КонецПроцедуры

// Отключает первое ПКО для проверки выбора следующего активного правила.
// Параметры:
//  ИмяПроцедуры - Строка - имя тестового обработчика.
//  СтруктураПараметров - Структура - параметры обработчика ПОД.
Процедура ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, СтруктураПараметров) Экспорт

	Если ПустаяСтрока(ИмяПроцедуры) Тогда
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ОтключитьПервоеПКО" Тогда
		СтруктураПараметров.ИспользованиеПКО.Вставить("ПервоеПКО", Ложь);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ПодменитьИсточникПОД" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		КомпонентыОбмена.СвойстваСообщения.Вставить("КоличествоПолейПОД",
			СтруктураПараметров.Количество());
		КомпонентыОбмена.СвойстваСообщения.Вставить("ИсходнаяСсылкаПОД",
			СтруктураПараметров.ОбъектОбработки.Ссылка);
		СтруктураПараметров.ОбъектОбработки =
			КомпонентыОбмена.СвойстваСообщения.ТестовыйНовыйИсточник;
		СтруктураПараметров.ИспользованиеПКО.Вставить("ОтсутствующееПКО", Ложь);
		КомпонентыОбмена.СвойстваСообщения.Вставить("ПОДИзменилКомпоненты", Истина);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ИзменитьДанныеОтправки" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		КомпонентыОбмена.СвойстваСообщения.Вставить("КоличествоПолейОтправки",
			СтруктураПараметров.Количество());
		КомпонентыОбмена.СвойстваСообщения.Вставить("СсылкаИсточникаОтправки",
			СтруктураПараметров.ДанныеИБ.Ссылка);
		КомпонентыОбмена.СвойстваСообщения.Вставить("ДлинаСтекаОтправки",
			СтруктураПараметров.СтекВыгрузки.Количество());
		НовыеДанныеXDTO = Новый Структура;
		Для Каждого Поле Из СтруктураПараметров.ДанныеXDTO Цикл
			НовыеДанныеXDTO.Вставить(Поле.Ключ, Поле.Значение);
		КонецЦикла;
		НовыеДанныеXDTO.Вставить("comment", "Из обработчика отправки");
		СтруктураПараметров.ДанныеXDTO = НовыеДанныеXDTO;
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "УстановитьИнструкцииСтрокТЧ" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		ИсходныеСтроки = Новый Массив;
		НомерСтроки = 0;
		Для Каждого СтрокаТЧ Из СтруктураПараметров.ДанныеXDTO["tabularSection"] Цикл
			НомерСтроки = НомерСтроки + 1;
			ИсходныеСтроки.Добавить(СтрокаТЧ["string"]);
			СтрокаТЧ["string"] = Новый Структура("ИмяПКО,Значение",
				"", "После " + Строка(НомерСтроки));
		КонецЦикла;
		КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыеИсходныеСтроки", ИсходныеСтроки);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ЗафиксироватьВложенныйСтек" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		Глубина = СтруктураПараметров.СтекВыгрузки.Количество();
		Если Глубина > 5 Тогда
			ВызватьИсключение "Тестовая граница глубины рекурсии";
		КонецЕсли;
		Глубины = Неопределено;
		Если Не КомпонентыОбмена.СвойстваСообщения.Свойство("ТестовыеГлубины", Глубины) Тогда
			Глубины = Новый Массив;
			КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыеГлубины", Глубины);
		КонецЕсли;
		Глубины.Добавить(Глубина);
		Если Глубина > 1 Тогда
			КомпонентыОбмена.СвойстваСообщения.Вставить("ТестоваяГлубина", Глубина);
			КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыеВложенныеДанные",
				СтруктураПараметров.ДанныеXDTO);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ЗадатьИнструкциюВторогоЭтапа" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		Вариант = КомпонентыОбмена.ЗаголовкиСообщения.Получить("ВариантВторогоЭтапа");
		Если Вариант = "Оба" Тогда
			Инструкция = Новый Структура;
			Инструкция.Вставить("ИмяПКО", "");
			Инструкция.Вставить("Значение", "Из второго этапа");
			СтруктураПараметров.ДанныеXDTO.Вставить("comment", Инструкция);
		ИначеЕсли Вариант = "ТолькоЗначение" Тогда
			СтруктураПараметров.ДанныеXDTO.Вставить("comment",
				Новый Структура("Значение", "Из второго этапа"));
		ИначеЕсли Вариант = "ТолькоИмя" Тогда
			СтруктураПараметров.ДанныеXDTO.Вставить("comment",
				Новый Структура("ИмяПКО", ""));
		Иначе
			СтруктураПараметров.ДанныеXDTO.Вставить("comment", "Обычное значение");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "СохранитьИнструкцию" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		КомпонентыОбмена.СвойстваСообщения.Вставить("ТестоваяИнструкция",
			СтруктураПараметров.ДанныеXDTO["comment"]);
		СтруктураПараметров.ДанныеXDTO.Вставить("comment", "Восстановлено");
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "СохранитьВложенноеДерево" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		Дерево = Неопределено;
		СтруктураПараметров.ДанныеXDTO.Свойство("nested", Дерево);
		КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовоеДерево", Дерево);
		СтруктураПараметров.ДанныеXDTO.Удалить("nested");
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ПодменитьПустоеЗначение" Тогда
		Вариант = СтруктураПараметров.КомпонентыОбмена.ЗаголовкиСообщения
			.Получить("ВариантПустогоЗначения");
		Если Вариант = "НетПоля" Тогда
			СтруктураПараметров.ДанныеXDTO.Удалить("comment");
		ИначеЕсли Вариант = "Неопределено" Тогда
			СтруктураПараметров.ДанныеXDTO.Вставить("comment", Неопределено);
		ИначеЕсли Вариант = "Null" Тогда
			СтруктураПараметров.ДанныеXDTO.Вставить("comment", Null);
		ИначеЕсли Вариант = "ПустаяСтрока" Тогда
			СтруктураПараметров.ДанныеXDTO.Вставить("comment", "");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "УстановитьЗначениеПеречисления" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		СтруктураПараметров.ДанныеXDTO.Вставить("enum",
			КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестовоеЗначениеПеречисления"));
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "УстановитьНедопустимоеПоле" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		Поле = КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестовоеПоле");
		Значение = КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестовоеЗначение");
		СтруктураПараметров.ДанныеXDTO.Вставить(Поле, Значение);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "УстановитьНесовпадающиеСписки" Тогда
		Заголовки = СтруктураПараметров.КомпонентыОбмена.ЗаголовкиСообщения;
		КоличествоЗначений = Заголовки.Получить("ТестовоеКоличествоЗначений");
		КоличествоСтрок = Заголовки.Получить("ТестовоеКоличествоСтрок");
		Значения = Новый Массив;
		Для Номер = 1 По КоличествоЗначений Цикл
			Значения.Добавить("Значение " + Строка(Номер));
		КонецЦикла;
		Строки = Новый ТаблицаЗначений;
		Строки.Колонки.Добавить("name");
		Для Номер = 1 По КоличествоСтрок Цикл
			Строка = Строки.Добавить();
			Строка.name = "Строка " + Строка(Номер);
		КонецЦикла;
		СтруктураПараметров.ДанныеXDTO.Вставить("values", Значения);
		СтруктураПараметров.ДанныеXDTO.Вставить("table", Строки);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "УстановитьТаблицуОбщихСвойств" Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("name");
		Таблица.Колонки.Добавить("general");
		Таблица.Колонки.Добавить("shared");
		Таблица.Колонки.Добавить("fallback");
		Строка = Таблица.Добавить();
		Строка.name = "Первая";
		Строка.general = Новый Структура("shared,fallback", "Вложенное первое", "Вложенный резерв");
		Строка.shared = "Корень первой";
		Строка.fallback = "Резерв первой";
		Строка = Таблица.Добавить();
		Строка.name = "Вторая";
		Если СтруктураПараметров.КомпонентыОбмена.ЗаголовкиСообщения
			.Получить("ТестовоеОшибкаИмениСтроки") = Истина Тогда
			Строка.name = Неопределено;
		КонецЕсли;
		Строка.general = "Скаляр вместо структуры";
		Строка.shared = "Строка вторая";
		Строка.fallback = "Резерв второй";
		КоличествоСтрок = СтруктураПараметров.КомпонентыОбмена.ЗаголовкиСообщения
			.Получить("ТестовоеКоличествоСтрок");
		Если КоличествоСтрок = 0 Тогда
			Таблица.Очистить();
		ИначеЕсли КоличествоСтрок = 1 Тогда
			Таблица.Удалить(Таблица[1]);
		КонецЕсли;
		СтруктураПараметров.ДанныеXDTO.Вставить("table", Таблица);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ОбнулитьДанныеОтправки" Тогда
		СтруктураПараметров.ДанныеXDTO = Неопределено;
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ИзменитьПолученныеДанные" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		КомпонентыОбмена.СвойстваСообщения.Вставить("КоличествоПолейКонвертации",
			СтруктураПараметров.Количество());
		КомпонентыОбмена.СвойстваСообщения.Вставить("ИмяДоКонвертации",
			СтруктураПараметров.ДанныеXDTO["name"]);
		СтруктураПараметров.ДанныеXDTO.Вставить("name", "Из обработчика конвертации");
		СтруктураПараметров.ПолученныеДанные.Наименование =
			"Из обработчика конвертации";
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ЗаполнитьДатуДокумента" Тогда
		СтруктураПараметров.ПолученныеДанные.Дата = Дата(2026, 2, 3, 12, 0, 0);
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ЗафиксироватьКонтекстТабличнойЧасти" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовыйКонтекстТЧ", Истина);
		КомпонентыОбмена.СвойстваСообщения.Вставить("ТестоваяНастройкаТЧ",
			КомпонентыОбмена.ЗаголовкиСообщения.Получить("ТестоваяНастройкаТЧ"));
		КомпонентыОбмена.СвойстваСообщения.Вставить("ТестовоеЧислоПКС",
			СтруктураПараметров.КонвертацияСвойств.Количество());
		Возврат;
	КонецЕсли;
	Если ИмяПроцедуры = "ОтказПередЗаписью" Тогда
		КомпонентыОбмена = СтруктураПараметров.КомпонентыОбмена;
		КомпонентыОбмена.СвойстваСообщения.Вставить("КоличествоПолейПередЗаписью",
			СтруктураПараметров.Количество());
		СтруктураПараметров.КонвертацияСвойств = Ложь;
		КомпонентыОбмена.ФлагПропустить = Истина;
		КомпонентыОбмена.ПротоколКонвертации.Добавить("Тестовый отказ перед записью");
		Возврат;
	КонецЕсли;
	ВызватьИсключение "Неизвестный тестовый обработчик ПОД: " + ИмяПроцедуры;

КонецПроцедуры

#КонецОбласти
