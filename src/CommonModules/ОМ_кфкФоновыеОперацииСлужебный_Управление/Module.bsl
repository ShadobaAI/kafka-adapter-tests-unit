// Проверяет межсеансовые назначения и непрерывный префикс при обратном завершении реальных заданий.
Процедура ОбновитьУказательНачалаВыборки_РеальныеПотокиЗавершаютсяВОбратномПорядке() Экспорт

	ЮТест.ОжидаетЧто(СтрНайти(СтрокаСоединенияИнформационнойБазы(), "Srvr=") > 0,
		"Для обратного завершения потоков требуется серверная ИБ: файловая ИБ не выполняет два фоновых задания одновременно").Равно(Истина);
	ПервыйСигнал = Новый УникальныйИдентификатор;
	ВторойСигнал = Новый УникальныйИдентификатор;
	Операция = Новый УникальныйИдентификатор;
	Задания = Новый Массив; // Массив Из ФоновоеЗадание
	Сигналы = ЮТМетоды.МассивПараметров(ПервыйСигнал, ВторойСигнал, Операция);
	Раздел = Новый Структура("Значение,Представление", "ют_ПозицияСтенда", "Позиция стендового теста");
	Позиция = 1000000;
	Попытка
		Первое = ЗапуститьТестовоеЗадание(ПервыйСигнал, Ложь);
		Задания.Добавить(Первое);
		Второе = ЗапуститьТестовоеЗадание(ВторойСигнал, Ложь);
		Задания.Добавить(Второе);
		ОжидатьСигнал(ПервыйСигнал, "ют_Старт", Первое);
		ОжидатьСигнал(ВторойСигнал, "ют_Старт", Второе);
		Потоки = Новый Массив; // Массив Из УникальныйИдентификатор
		Потоки.Добавить(Первое.УникальныйИдентификатор);
		Потоки.Добавить(Второе.УникальныйИдентификатор);
		Указатели = кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков();
		ДобавитьНазначениеСтенда(Первое, Указатели, 2000000);
		ДобавитьНазначениеСтенда(Второе, Указатели, 3000000);
		РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Операция, Позиция, Раздел);

		ЗаписатьСигнал(ВторойСигнал, "ют_Разрешение");
		ОжидатьСигнал(ВторойСигнал, "ют_Завершение", Второе);
		кфкФоновыеОперацииСлужебный.ют_ОбновитьСтатусУказателей(Указатели, Потоки);
		кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
			Позиция, Указатели, 0, Потоки, Операция, Раздел);

		ЮТест.ОжидаетЧто(Позиция).Равно(1000000);
		ПроверитьНазначениеСтенда(Первое.УникальныйИдентификатор, Истина);
		ПроверитьНазначениеСтенда(Второе.УникальныйИдентификатор, Ложь);
		ПроверитьПозициюСтенда(Операция, 1000000);

		ЗаписатьСигнал(ПервыйСигнал, "ют_Разрешение");
		ОжидатьСигнал(ПервыйСигнал, "ют_Завершение", Первое);
		кфкФоновыеОперацииСлужебный.ют_ОбновитьСтатусУказателей(Указатели, Потоки);
		кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
			Позиция, Указатели, 0, Потоки, Операция, Раздел);

		ЮТест.ОжидаетЧто(Позиция).Равно(2100000);
		ЮТест.ОжидаетЧто(Указатели.Количество()).Равно(0);
		ПроверитьНазначениеСтенда(Первое.УникальныйИдентификатор, Ложь);
		ПроверитьПозициюСтенда(Операция, 2100000);
	Исключение
		ОчиститьСтендЗаданий(Задания, Сигналы);
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьСтендЗаданий(Задания, Сигналы);

