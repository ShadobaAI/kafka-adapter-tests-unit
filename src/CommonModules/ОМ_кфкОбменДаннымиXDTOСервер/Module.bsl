// Формирует JSON каталога с обязательными свойствами готового XDTO-пакета.
// Параметры:
//  Ссылка - СправочникСсылка.кфк_т_ТестовыйСправочник - ссылка объекта.
//  Наименование - Строка - наименование в сообщении.
//  Число - Число - значение числового поля.
//  Булево - Булево - значение логического поля.
//  Комментарий - Строка - значение строкового поля.
// Возвращаемое значение:
//  Строка - тело сообщения JSON.
Функция ТелоКаталогаДляЧтения(Ссылка, Наименование, Число = 1, Булево = Ложь, Комментарий = "")

	Данные = Новый Структура;
	Данные.Вставить("ref", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("name", Наименование);
	Данные.Вставить("dateTime", "2026-01-01T00:00:00");
	Данные.Вставить("number", Число);
	Данные.Вставить("boolean", Булево);
	Данные.Вставить("enum", "Значение1");
	Данные.Вставить("comment", Комментарий);
	Данные.Вставить("tabularSection", Новый Структура);
	Возврат кфкОбщегоНазначенияСлужебный.ЗначениеВJSON(Данные);

КонецФункции
// Проверяет согласованные результат, флаг и текст ошибки выбора.
Процедура ПроверитьОшибкуВыбораПравила(Компоненты, Результат, ФрагментОшибки)

	ЮТест.ОжидаетЧто(Результат).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Компоненты.ФлагОшибки).Равно(Истина);
	ЮТест.ОжидаетЧто(Компоненты.ПротоколКонвертации.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(СтрНайти(Компоненты.ПротоколКонвертации[0], ФрагментОшибки) > 0)
		.Равно(Истина);

