// Проверяет УчитываетВерсиюИПередаетНастройки.
// Параметры:
//  СравнениеВерсий - Число - ответ зависимости сравнения версий.
//  Ожидается - Булево - результат вычисления настройки темы.
Процедура ЭтоТемнаяТема_УчитываетВерсиюИПередаетНастройки(Знач СравнениеВерсий, Знач Ожидается) Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;
	АргументыВерсий = ЮТМетоды.МассивПараметров(СистемнаяИнформация.ВерсияПриложения, "8.5.1.0");
	Настройки = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиКлиентскогоПриложения");
	АргументыВычисления = ЮТМетоды.МассивПараметров(
		"Параметры.ТемаКлиентскогоПриложения = ТемаКлиентскогоПриложения.Темная", Настройки);
	Мокито.Обучение(ОбщегоНазначенияКлиентСервер)
		.Когда("СравнитьВерсии", АргументыВерсий)
			.Вернуть(СравнениеВерсий);
	Мокито.Обучение(ОбщегоНазначения)
		.Когда("ВычислитьВБезопасномРежиме", АргументыВычисления)
			.Вернуть(Ожидается);
	Мокито.Прогон();

	Первый = кфкИнтеграцияСлужебныйПовтИсп.ЭтоТемнаяТема();
	Второй = кфкИнтеграцияСлужебныйПовтИсп.ЭтоТемнаяТема();

	ЮТест.ОжидаетЧто(Первый).Равно(Ожидается);
	ЮТест.ОжидаетЧто(Второй).Равно(Ожидается);
	Мокито.Проверить(ОбщегоНазначенияКлиентСервер)
		.КоличествоВызовов("СравнитьВерсии", АргументыВерсий).Равно(1);
	Мокито.Проверить(ОбщегоНазначения)
		.КоличествоВызовов("ВычислитьВБезопасномРежиме", АргументыВычисления)
			.Равно(?(СравнениеВерсий < 0, 0, 1));

КонецПроцедуры

