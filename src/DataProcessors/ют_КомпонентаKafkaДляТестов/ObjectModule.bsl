// Имитирует только файлы внешней компоненты; чтение и разбор остаются в оригинальном коде.
Процедура ЗаписатьФайлыЖурнала()

	ФайлыЖурнала = ОтветыКомпоненты.Получить("ФайлыЖурнала"); // Соответствие Из КлючИЗначение: Ключ - Строка, Значение - Строка
	Если ФайлыЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_КаталогПроверкиKafka", КаталогЛогов);
	Для Каждого ОписаниеФайла Из ФайлыЖурнала Цикл

		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(ОписаниеФайла.Значение);
		Документ.Записать(КаталогЛогов + ОписаниеФайла.Ключ, КодировкаТекста.UTF8);

	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Метод - Строка - имя операции.
//  Параметры - Массив Из Произвольный - аргументы компоненты.
// Возвращаемое значение:
//  Произвольный - явно настроенный ответ.
Функция ОтветНаВызов(Знач Метод, Знач Параметры)

	ВызовыКомпоненты.Добавить(Новый Структура("Метод,Параметры", Метод, Параметры));
	Результат = ОтветыКомпоненты.Получить(Метод);
	Возврат Результат;

КонецФункции

