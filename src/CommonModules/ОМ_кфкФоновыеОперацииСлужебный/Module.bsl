	Результат.Вставить("message_key", "message-17");
	Результат.Вставить("msg_headers", "trace=unit-log");
	Результат.Вставить("msg_body", "тело сообщения");
	Результат.Вставить("log_text", "исходный журнал");
	Результат.Вставить("change_mark_ms", "2100-01-01T00:00:00.100Z");
	Результат.Вставить("processing_duration_ms", 123);
	Результат.Вставить("processing_count", 2);
	ДатаСобытия = ЗаписатьДатуJSON(
