	Если Входящие Тогда
		Результат.Вставить("consumer_id", XMLСтрока(Данные.Настройка));
		Результат.Вставить("consumer_name", "Имя настройки");
		Результат.Вставить("topic", "unit-log-topic");
		Результат.Вставить("load_date_ms", Данные.Начало);
		Результат.Вставить("partition", 2);
		Результат.Вставить("offset", 17);
		Результат.Вставить("status", "Обработано");
		Результат.Вставить("write_date", ДатаСобытия);
		Результат.Вставить("load_date", ДатаСобытия);
	Иначе
		Результат.Вставить("producer_id", XMLСтрока(Данные.Настройка));
		Результат.Вставить("producer_name", "Имя настройки");
		Результат.Вставить("object_type", "Документ.Заказ");
		Результат.Вставить("source_type", "Строка");
		Результат.Вставить("object_key", "object-17");
		Результат.Вставить("trigger", "");
		Результат.Вставить("status", "Выгружено");
		Результат.Вставить("registration_date", ДатаСобытия);
		Результат.Вставить("export_count", 3);
		Результат.Вставить("source", "<x>данные</x>");
		Результат.Вставить("is_delete", Истина);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Создает принадлежащую тесту исходную очередь.
// Параметры:
//  Источник - УникальныйИдентификатор - изолированный владелец исходных строк.
//  Количество - Число - число строк.
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.кфкОчередьПотоков - исходные ключи и метки.
Функция НоваяОчередьПакетов(Источник, Количество)

	Результат = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	Для Номер = 1 По Количество Цикл
		СтрокаОчереди = Результат.Добавить();
		СтрокаОчереди.Ключ = Строка(Источник) + ":" + Формат(Номер, "ЧГ=0");
		СтрокаОчереди.ВременнаяМетка = 1000000 + Номер;
		СтрокаОчереди.ИдентификаторПотока = Источник;
	КонецЦикла;
	Результат.Записать(РежимЗамещения.Добавление);

	Возврат Результат;

КонецФункции

// Возвращает настоящую выборку строк изолированного источника.
// Параметры:
//  Источник - УникальныйИдентификатор - владелец исходных строк.
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - ключи и метки в порядке возрастания времени.
Функция ВыборкаОчередиПакетов(Источник)

	// Читаем только исходные строки текущего теста в порядке меток.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.Текст = "ВЫБРАТЬ
	|	Очередь.Ключ КАК КлючЗаписи,
	|	Очередь.ВременнаяМетка КАК ВременнаяМетка,
	|	Очередь.ВременнаяМетка КАК МеткаИзмененияМС
	|ИЗ
	|	РегистрСведений.кфкОчередьПотоков КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторПотока = &Источник
	|УПОРЯДОЧИТЬ ПО
	|	ВременнаяМетка";

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Сопоставляет сохраненные назначения с независимым эталоном пакетов.
// Параметры:
//  Исходные - РегистрСведенийНаборЗаписей.кфкОчередьПотоков - исходные строки.
//  Потоки - Массив Из УникальныйИдентификатор - назначенные исполнители.
//  Размеры - Строка - размеры пакетов через запятую.
//  Указатели - см. кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков
Процедура ПроверитьНазначенияПакетов(Исходные, Потоки, Размеры, Указатели)

	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков")
		.СодержитНесколькоЗаписей(Исходные.Количество(),
			ЮТест.Предикат().Реквизит("ИдентификаторПотока").ВСписке(Потоки));
	Для Каждого СтрокаИсточника Из Исходные Цикл
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков")
			.СодержитТолькоОднуЗапись(
				ЮТест.Предикат().Реквизит("Ключ").Равно(СтрокаИсточника.Ключ)
					.Реквизит("ВременнаяМетка").Равно(СтрокаИсточника.ВременнаяМетка)
					.Реквизит("ИдентификаторПотока").ВСписке(Потоки));
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков")
			.СодержитТолькоОднуЗапись(
				ЮТест.Предикат().Реквизит("Ключ").Равно(СтрокаИсточника.Ключ)
					.Реквизит("ВременнаяМетка").Равно(СтрокаИсточника.ВременнаяМетка)
					.Реквизит("ИдентификаторПотока").Равно(СтрокаИсточника.ИдентификаторПотока));
	КонецЦикла;

	ОжидаемыеРазмеры = Новый Массив; // Массив Из Строка
	Если Размеры <> "" Тогда
		ОжидаемыеРазмеры = СтрРазделить(Размеры, ",");
	КонецЕсли;
	ЮТест.ОжидаетЧто(Указатели.Количество(), "число полных пакетов и хвостов")
		.Равно(ОжидаемыеРазмеры.Количество());
	КонецПакета = 0;
	Для Индекс = 0 По ОжидаемыеРазмеры.Количество() - 1 Цикл
		КонецПакета = КонецПакета + Число(ОжидаемыеРазмеры[Индекс]);
		ЮТест.ОжидаетЧто(Указатели[Индекс].ВременнаяМетка, "граница каждого пакета")
			.Равно(Исходные[КонецПакета - 1].ВременнаяМетка);
	КонецЦикла;

КонецПроцедуры

// Создает принадлежащую тесту настройку; запись откатывается транзакцией YAxUnit.
//
// Параметры:
//  Наименование - Строка - роль настройки в проверяемом составе.
//
// Возвращаемое значение:
//  СправочникСсылка.кфкПродюсеры - новая настройка.
Функция НовыйПродюсер(Знач Наименование)

	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.кфкПродюсеры)
		.Установить("Наименование", Наименование)
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Записать(Ложь, Истина);

КонецФункции

// Возвращает упорядоченные входные настройки операции.
//
// Параметры:
//  Первая - СправочникСсылка.кфкПродюсеры - первая настройка.
//  Вторая - СправочникСсылка.кфкПродюсеры - вторая настройка.
//
// Возвращаемое значение:
//  Массив Из СправочникСсылка.кфкПродюсеры - настройки в заданном порядке.
Функция НастройкиОперации(Первая, Вторая)

	Настройки = Новый Массив; // Массив Из СправочникСсылка.кфкПродюсеры
	Настройки.Добавить(Первая);
	Настройки.Добавить(Вторая);

	Возврат Настройки;

КонецФункции
// Создает два пакета и собственные позиции; данные откатываются транзакцией теста.
//
// Параметры:
//  ПервыйЗавершен - Число - статус первого пакета.
//  ВторойЗавершен - Число - статус второго пакета.
//
// Возвращаемое значение:
//  Структура - состояние проверки:
//   * Операция - УникальныйИдентификатор - проверяемая операция.
//   * ЧужаяОперация - УникальныйИдентификатор - контрольная операция.
//   * Раздел - см. кфкФоновыеОперацииСлужебный.ют_РазделОперации
//   * Позиция - Число - текущая граница.
//   * Указатели - см. кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков
//   * Потоки - Массив Из УникальныйИдентификатор - действующие потоки.
Функция НовыйСценарийПозиции(ПервыйЗавершен, ВторойЗавершен)

	Операция = Новый УникальныйИдентификатор;
	ЧужаяОперация = Новый УникальныйИдентификатор;
	ПервыйПоток = Новый УникальныйИдентификатор;
	ВторойПоток = Новый УникальныйИдентификатор;
	Раздел = Новый Структура("Значение,Представление", "ПроверкаПрефикса", "Проверка префикса");
	Позиция = 1000000;

	Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Операция;
	Запись.Раздел = Раздел.Значение;
	Запись.ВременнаяМетка = Позиция;
	Запись.Записать();

	ЧужаяЗапись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
	ЧужаяЗапись.Идентификатор = ЧужаяОперация;
	ЧужаяЗапись.Раздел = Раздел.Значение;
	ЧужаяЗапись.ВременнаяМетка = 777000;
	ЧужаяЗапись.Записать();

	Указатели = кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков();
	Первый = Указатели.Добавить();
	Первый.ИдентификаторПотока = ПервыйПоток;
	Первый.ВременнаяМетка = 2000000;
	Первый.СтатусПотока = ПервыйЗавершен;
	Второй = Указатели.Добавить();
	Второй.ИдентификаторПотока = ВторойПоток;
	Второй.ВременнаяМетка = 3000000;
	Второй.СтатусПотока = ВторойЗавершен;

	Потоки = Новый Массив; // Массив Из УникальныйИдентификатор
	Потоки.Добавить(ПервыйПоток);
	Потоки.Добавить(ВторойПоток);

	Сценарий = Новый Структура;
	Сценарий.Вставить("Операция", Операция);
	Сценарий.Вставить("ЧужаяОперация", ЧужаяОперация);
	Сценарий.Вставить("Раздел", Раздел);
	Сценарий.Вставить("Позиция", Позиция);
	Сценарий.Вставить("Указатели", Указатели);
	Сценарий.Вставить("Потоки", Потоки);

	Возврат Сценарий;

КонецФункции
// Проверяет позицию операции, остаток пакетов и неизменность чужой записи.
//
// Параметры:
//  Сценарий - см. НовыйСценарийПозиции
//  ОжидаемаяПозиция - Число - независимый эталон позиции.
//  ОсталосьПакетов - Число - ожидаемый остаток.
Процедура ПроверитьСценарийПозиции(Сценарий, ОжидаемаяПозиция, ОсталосьПакетов)

	ЮТест.ОжидаетЧто(Сценарий.Позиция, "граница непрерывного префикса").Равно(ОжидаемаяПозиция);
	ЮТест.ОжидаетЧто(Сценарий.Указатели.Количество(), "неучтенные пакеты сохранены").Равно(ОсталосьПакетов);

	Условие = ЮТест.Предикат()
		.Реквизит("Идентификатор").Равно(Сценарий.Операция)
		.Реквизит("Раздел").Равно(Сценарий.Раздел.Значение)
		.Реквизит("ВременнаяМетка").Равно(ОжидаемаяПозиция);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций")
		.СодержитЗаписи(Условие, "сохраненная позиция совпадает с результатом");

	УсловиеЧужой = ЮТест.Предикат()
		.Реквизит("Идентификатор").Равно(Сценарий.ЧужаяОперация)
		.Реквизит("Раздел").Равно(Сценарий.Раздел.Значение)
		.Реквизит("ВременнаяМетка").Равно(777000);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций")
		.СодержитЗаписи(УсловиеЧужой, "позиция чужой операции не изменена");

КонецПроцедуры

#КонецОбласти
