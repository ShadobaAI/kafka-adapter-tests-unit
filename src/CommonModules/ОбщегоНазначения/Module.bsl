//@strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Подменяет только фабрику Kafka и только внутри явно настроенного теста.
// Параметры:
//  Идентификатор - Строка - идентификатор внешней компоненты.
//  ПолноеИмяМакета - Строка - имя макета внешней компоненты.
//  Изолированно - Булево, Null - исходный режим загрузки.
// Возвращаемое значение:
//  ОбъектВнешнейКомпоненты, ОбщийМодуль, Неопределено - компонента либо прежний тестовый ответ.
//  ОбработкаОбъект.ют_КомпонентаKafkaДляТестов - двойник внешней компоненты.
&Around("ПодключитьКомпонентуИзМакета")
Функция ют_ПодключитьКомпонентуДляТестовИнтеграции(
		Знач Идентификатор, Знач ПолноеИмяМакета, Знач Изолированно = Null)

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст <> Неопределено
		И Идентификатор = "simpleKafka1C"
		И ПолноеИмяМакета = "ОбщийМакет.кфкАдаптерKafka"
		И Контекст.Свойство("ют_КомпонентаKafka") Тогда

		ВызовыФабрики = Контекст["ют_ВызовыФабрикиKafka"]; // Массив Из Массив Из Произвольный
		ВызовыФабрики.Добавить(ЮТМетоды.МассивПараметров(
			Идентификатор, ПолноеИмяМакета, Изолированно));
		Возврат Контекст["ют_КомпонентаKafka"]; // ОбработкаОбъект.ют_КомпонентаKafkaДляТестов

	КонецЕсли;
	Если Контекст <> Неопределено
		И Идентификатор = "simpleKafka1C"
		И ПолноеИмяМакета = "ОбщийМакет.кфкАдаптерKafka"
		И Контекст.Свойство("ют_КоннекторИнтеграции") Тогда

		Состояние = Контекст["ют_КоннекторИнтеграции"]; // см. ют_КоннекторИнтеграцииДляТестов.НовоеСостояние
		Состояние.ПараметрыПодключения = ЮТМетоды.МассивПараметров(
			Идентификатор, ПолноеИмяМакета, Изолированно);
		Если Состояние.ПодключениеОтказано Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат ют_КоннекторИнтеграцииДляТестов;

	КонецЕсли;

	Результат = ПродолжитьВызов(Идентификатор, ПолноеИмяМакета, Изолированно);
	Возврат Результат;

КонецФункции

// См. ОбщегоНазначения.ВычислитьВБезопасномРежиме
&Around("ВычислитьВБезопасномРежиме")
Функция ют_ВычислитьВБезопасномРежиме(Знач Выражение, Знач Параметры = Неопределено)

	Аргументы = ЮТМетоды.МассивПараметров(Выражение, Параметры); // Массив Из Произвольный
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		ОбщегоНазначения,
		"ВычислитьВБезопасномРежиме",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = ПродолжитьВызов(Выражение, Параметры);
	Возврат Результат;

КонецФункции

// См. ОбщегоНазначения.ВызватьФункциюКонфигурации
&Around("ВызватьФункциюКонфигурации")
Функция ют_ВызватьФункциюКонфигурации(Знач ИмяМетода, Знач Параметры = Неопределено)

	Аргументы = ЮТМетоды.МассивПараметров(ИмяМетода, Параметры); // Массив Из Произвольный
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		ОбщегоНазначения,
		"ВызватьФункциюКонфигурации",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = ПродолжитьВызов(ИмяМетода, Параметры);
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
