// Проверяет полный внешний эталон события и успешное продвижение позиции.
// Параметры:
//  Входящие - Булево - направление логирования.
Процедура Логирование_СохраняетСобытие(Входящие) Экспорт

	Начало = (Дата(2100, 1, 1) - Дата(1, 1, 1)) * 1000;
	Данные = НовоеСообщениеЛога(Входящие, Начало + 100);
	Представления = Новый Соответствие; // Соответствие Из Строка
	Представления.Вставить(Данные.Настройка, "Имя настройки");
	ЗафиксироватьЧасыЛога(Начало + 1000);
	Выборка = ВыборкаЛогаТеста(Входящие, 1, Начало);
	Позиция = Начало;

	ОбработатьЛогиТеста(Входящие, Выборка, Представления, Позиция);

	События = СобытияПерехваченногоЛога();
	ЮТест.ОжидаетЧто(События.Количество(), "одно событие для одной записи").Равно(1);
	Ожидаемый = ЭталонСобытияЛога(Входящие, Данные);
	Фактический = События[0];
	ЮТест.ОжидаетЧто(Фактический.Количество(), "точный состав полей")
		.Равно(Ожидаемый.Количество());
	Для Каждого Поле Из Ожидаемый Цикл
		ЮТест.ОжидаетЧто(Фактический.Получить(Поле.Ключ), "" + Поле.Ключ).Равно(Поле.Значение);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Позиция, "успех продвигает позицию").Равно(Начало + 100);
	ЮТест.ОжидаетЧто(ЮТест.КонтекстТеста().ют_HTTPМетод).Равно("POST");
	Запрос = ЮТест.КонтекстТеста().ют_HTTPЗапрос; // HTTPЗапрос
	ЮТест.ОжидаетЧто(Запрос.АдресРесурса).Равно("unit/logs/component");
	ЮТест.ОжидаетЧто(Запрос.Заголовки.Получить("Content-Type")).Равно("application/json");
	ЮТест.ОжидаетЧто(Запрос.Заголовки.Получить("Content-encoding")).Равно("gzip");

КонецПроцедуры

// Проверяет сохраненную позицию и повтор события после отказа HTTP.
// Параметры:
//  Входящие - Булево - направление.
//  Код - Число - код ответа тестовой HTTP-сессии.
//  Разрыв - Булево - выбросить исключение на транспортной границе.
Процедура Логирование_ОшибкаУдерживаетПозицию(Входящие, Код, Разрыв) Экспорт

	ПрежнееЛогирование = РегистрыСведений.кфкПараметрыЛогирования.СоздатьНаборЗаписей();
	ПрежнееЛогирование.Прочитать();
	ПрежняяБлокировка = Константы.кфкБлокировкаИнтеграции.Получить();
	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_HTTPКод", Код);
	Контекст.Вставить("ют_HTTPИсключение", Разрыв);
	Контекст.Вставить("ют_HTTPСессияЛогирования", ОМ_кфкФоновыеОперацииСлужебный);

	Попытка
		// Функциональная опция должна видеть настройки до начала транзакции фикстуры.
		Настройки = РегистрыСведений.кфкПараметрыЛогирования.СоздатьМенеджерЗаписи();
		Настройки.Прочитать();
		Настройки.Использовать = Истина;
		Настройки.АдресСервиса = "http://127.0.0.1:18769/unit/logs/component";
		Настройки.Записать();
		Константы.кфкБлокировкаИнтеграции.Установить(Ложь);
		ОбновитьПовторноИспользуемыеЗначения();

		НачатьТранзакцию();
		Попытка
			Начало = (Дата(2100, 1, 1) - Дата(1, 1, 1)) * 1000;
			Данные = НовоеСообщениеЛога(Входящие, Начало + 100);
			ИДОперации = Новый УникальныйИдентификатор(?(Входящие,
				"00000000-0001-0000-0000-222222222222", "00000000-0001-0000-0000-111111111111"));
			РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(ИДОперации, Начало);
			ЗафиксироватьЧасыЛога(Начало + 1000);
			ИмяОперации = ?(Входящие, "ВыгрузкаЛоговВходящихСообщений", "ВыгрузкаЛоговИсходящихСообщений");
			ОжидаемаяОшибка = ?(Разрыв, "unit: разрыв HTTP-соединения", Строка(Код));

			ЮТест.ОжидаетЧто(кфкФоновыеОперацииСлужебный)
				.Метод(ИмяОперации)
				.ВыбрасываетИсключение(ОжидаемаяОшибка);

			Условие = ЮТест.Предикат()
				.Реквизит("Идентификатор").Равно(ИДОперации)
				.Реквизит("Раздел").Равно("")
				.Реквизит("ВременнаяМетка").Равно(Начало);
			ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций")
				.СодержитЗаписи(Условие);
			Позиция = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(ИДОперации);
			Повтор = ВыборкаЛогаТеста(Входящие, 1, Позиция);
			ЮТест.ОжидаетЧто(Повтор.Количество(), "событие доступно для повтора").Равно(1);
			Повтор.Следующий();
			ЮТест.ОжидаетЧто(Повтор.КлючЗаписи, "повторяется неподтвержденное событие").Равно(Данные.Ключ);
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		ОтменитьТранзакцию();
	Исключение
		ПрежнееЛогирование.Записать();
		Константы.кфкБлокировкаИнтеграции.Установить(ПрежняяБлокировка);
		ОбновитьПовторноИспользуемыеЗначения();
		Контекст.Удалить("ют_HTTPСессияЛогирования");
		ВызватьИсключение;
	КонецПопытки;

	ПрежнееЛогирование.Записать();
	Константы.кфкБлокировкаИнтеграции.Установить(ПрежняяБлокировка);
	ОбновитьПовторноИспользуемыеЗначения();
	Контекст.Удалить("ют_HTTPСессияЛогирования");

КонецПроцедуры

// Проверяет сохранение хвоста при одинаковых метках на границе порции.
// Параметры:
//  Входящие - Булево - направление.
Процедура Логирование_НеПерескакиваетРавныеМетки(Входящие) Экспорт

	ЮТест.Пропустить("Ошибка продукта: теряется хвост логов с равной меткой времени на границе порции");

	Начало = (Дата(2100, 1, 1) - Дата(1, 1, 1)) * 1000;
	Первое = НовоеСообщениеЛога(Входящие, Начало + 100);
	Второе = НовоеСообщениеЛога(Входящие, Начало + 100);
	Представления = Новый Соответствие; // Соответствие Из Строка
	Представления.Вставить(Первое.Настройка, "Первая настройка");
	Представления.Вставить(Второе.Настройка, "Вторая настройка");
	ЗафиксироватьЧасыЛога(Начало + 1000);
	Позиция = Начало;
	Выборка = ВыборкаЛогаТеста(Входящие, 1, Позиция);

	ОбработатьЛогиТеста(Входящие, Выборка, Представления, Позиция);

	ПервыйПакет = СобытияПерехваченногоЛога();
	ЮТест.ОжидаетЧто(ПервыйПакет.Количество()).Равно(1);
	Хвост = ВыборкаЛогаТеста(Входящие, 1, Позиция);
	ЮТест.ОжидаетЧто(Хвост.Количество(), "второе событие с той же меткой осталось доступно").Равно(1);
	ОбработатьЛогиТеста(Входящие, Хвост, Представления, Позиция);
	ВторойПакет = СобытияПерехваченногоЛога();
	ЮТест.ОжидаетЧто(ВторойПакет.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ВторойПакет[0].Получить("record_key"), "хвост не повторяет первое событие")
		.НеРавно(ПервыйПакет[0].Получить("record_key"));

КонецПроцедуры

#КонецОбласти

