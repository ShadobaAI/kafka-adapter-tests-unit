// Создает сохраненную строку журнала с фиксированными единицами времени.
// Параметры:
//  Входящие - Булево - направление сообщения.
//  Метка - Число - время изменения от начала календаря в миллисекундах.
// Возвращаемое значение:
//  Структура - данные собственного события:
//   * Ключ - Строка - идентификатор записи.
//   * Настройка - СправочникСсылка.кфкПродюсеры, СправочникСсылка.кфкКонсьюмеры - адресат.
//   * Начало - Число - начало 2100 года в миллисекундах.
Функция НовоеСообщениеЛога(Входящие, Метка)

	Начало = (Дата(2100, 1, 1) - Дата(1, 1, 1)) * 1000;
	Ключ = Строка(Новый УникальныйИдентификатор);
	Заголовки = Новый Соответствие; // Соответствие Из Строка
	Заголовки.Вставить("trace", "unit-log");

	Если Входящие Тогда
		Настройка = Справочники.кфкКонсьюмеры.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
		Запись.Консьюмер = Настройка;
		Запись.ДатаЗагрузкиМС = Начало;
		Запись.ДатаЗагрузки = Дата(2100, 1, 1);
		Запись.ДатаЗаписи = Дата(2100, 1, 1);
		Запись.Топик = "unit-log-topic";
		Запись.Раздел = 2;
		Запись.Смещение = 17;
		Запись.Статус = Перечисления.кфкСтатусыСообщений.Обработано;
	Иначе
		Настройка = Справочники.кфкПродюсеры.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
		Запись.Продюсер = Настройка;
		Запись.ДатаРегистрацииМС = Начало;
		Запись.ДатаРегистрации = Дата(2100, 1, 1);
		Запись.ТипОбъект = "Документ.Заказ";
		Запись.ТипИсходныхДанных = "Строка";
		Запись.КлючОбъекта = "object-17";
		Запись.ИсходныеДанные = Новый ХранилищеЗначения("<x>данные</x>");
		Запись.ЭтоУдаление = Истина;
		Запись.Статус = Перечисления.кфкСтатусыСообщений.Выгружено;
		Запись.КоличествоВыгрузок = 3;
	КонецЕсли;
	Запись.КлючЗаписи = Ключ;
	Запись.КлючСообщения = "message-17";
	Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище("тело сообщения");
	Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
	Запись.МеткаИзмененияМС = Метка;
	Запись.ТекстЖурнала = "исходный журнал";
	Запись.ДлОбработкиМС = 123;
	Запись.КоличествоОбработок = 2;
	Запись.Записать();

	Возврат Новый Структура("Ключ,Настройка,Начало", Ключ, Настройка, Начало);

КонецФункции

