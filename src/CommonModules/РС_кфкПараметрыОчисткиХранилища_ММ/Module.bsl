#Область ПрограммныйИнтерфейс

// Регистрирует серверные сценарии проверки модуля и их теги для запуска YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкПараметрыОчисткиХранилища. Модуль менеджера. ПолучитьПараметры()")
			.Тег("Модульные")
			.Тег("кфкПараметрыОчисткиХранилища")
			.Тег("ПолучитьПараметры")
			.ДобавитьСерверныйТест("ПолучитьПараметры_ВозвращаетЗначенияПоУмолчанию",
				"ПолучитьПараметры(). Возвращает значения по умолчанию")
				.Тег("ВозвращаетЗначенияПоУмолчанию")
				.Перед("ОчиститьДанные")
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкПараметрыОчисткиХранилища. Модуль менеджера. ОбновитьПараметры()")
			.Тег("Модульные")
			.Тег("кфкПараметрыОчисткиХранилища")
			.Тег("ОбновитьПараметры")
			.ДобавитьСерверныйТест("ОбновитьПараметры_СохраняетВсеЗначения",
				"ОбновитьПараметры(). Сохраняет все значения")
				.Тег("СохраняетВсеЗначения")
				.Перед("ОчиститьДанные");
	
КонецПроцедуры

// Удаляет данные предыдущего сценария перед проверкой исходного состояния регистра.
Процедура ОчиститьДанные() Экспорт
	РегистрыСведений.кфкПараметрыОчисткиХранилища.СоздатьНаборЗаписей().Записать();
КонецПроцедуры



// Проверяет значения настроек при отсутствии записей в регистре.
Процедура ПолучитьПараметры_ВозвращаетЗначенияПоУмолчанию() Экспорт
	
	Параметры = РегистрыСведений.кфкПараметрыОчисткиХранилища.ПолучитьПараметры();
	
	ЮТест.ОжидаетЧто(Параметры, "Параметры очистки хранилища")
		.Равно(ПараметрыПоУмолчанию());
	
КонецПроцедуры

// Проверяет чтение всех переданных настроек после их записи в регистр.
Процедура ОбновитьПараметры_СохраняетВсеЗначения() Экспорт
	
	ОжидаемыеПараметры = Новый Структура;
	ОжидаемыеПараметры.Вставить("СрокХраненияНезавершенных", 11);
	ОжидаемыеПараметры.Вставить("СрокХраненияОшибкиОбработкиИсходящих", 12);
	ОжидаемыеПараметры.Вставить("СрокХраненияОтмененныхИсходящих", 13);
	ОжидаемыеПараметры.Вставить("СрокХраненияОшибкиОтправки", 14);
	ОжидаемыеПараметры.Вставить("СрокХраненияОтправленных", 15);
	ОжидаемыеПараметры.Вставить("СрокХраненияОшибкиОбработкиВходящих", 16);
	ОжидаемыеПараметры.Вставить("СрокХраненияОтмененныхВходящих", 17);
	ОжидаемыеПараметры.Вставить("СрокХраненияОбработанных", 18);
	ОжидаемыеПараметры.Вставить("СрокХраненияХэшСуммыСообщений", 19);
	
	РегистрыСведений.кфкПараметрыОчисткиХранилища.ОбновитьПараметры(ОжидаемыеПараметры);
	ФактическиеПараметры = РегистрыСведений.кфкПараметрыОчисткиХранилища.ПолучитьПараметры();
	
	ЮТест.ОжидаетЧто(ФактическиеПараметры, "Сохраненные параметры очистки хранилища")
		.Равно(ОжидаемыеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыПоУмолчанию()
	
	Результат = Новый Структура;
	Результат.Вставить("СрокХраненияНезавершенных", 7);
	Результат.Вставить("СрокХраненияОшибкиОбработкиИсходящих", 3);
	Результат.Вставить("СрокХраненияОтмененныхИсходящих", 1);
	Результат.Вставить("СрокХраненияОшибкиОтправки", 3);
	Результат.Вставить("СрокХраненияОтправленных", 1);
	Результат.Вставить("СрокХраненияОшибкиОбработкиВходящих", 3);
	Результат.Вставить("СрокХраненияОтмененныхВходящих", 1);
	Результат.Вставить("СрокХраненияОбработанных", 1);
	Результат.Вставить("СрокХраненияХэшСуммыСообщений", 3);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
