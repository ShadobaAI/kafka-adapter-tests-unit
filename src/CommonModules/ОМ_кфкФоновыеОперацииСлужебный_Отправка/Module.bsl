// Проверяет независимый эталон адресации и полезной нагрузки на внешней границе.
// Параметры:
//  КлючСообщения - Строка
//  ОжидаемыйКлюч - Строка
Процедура ПакетKafka_СохраняетАдресациюИТело(КлючСообщения, ОжидаемыйКлюч) Экспорт

	Пакет = НовыйПакет();
	Запись = НовоеСообщение(Пакет.Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 1000);
	Запись.КлючСообщения = КлючСообщения;
	Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище("данные: кириллица, ""кавычки""");
	Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Новый Структура("Источник", "эталон"));
	Запись.Записать();
	НазначитьСообщение(Запись, Пакет.Поток);
	Пакет.Компонента.НастроитьОтвет("ОтправитьПакетСРезультатом", УспешныйОтвет());

	ОтправитьПакет(Пакет);

	Вызовы = ВызовыОтправки(Пакет);
	ЮТест.ОжидаетЧто(Вызовы).ИмеетДлину(1);
	Аргументы = Вызовы[0].Параметры; // Массив Из Произвольный
	Сообщения = ОбщегоНазначения.JSONВЗначение(Аргументы[0], , Ложь); // Массив Из Структура
	ЮТест.ОжидаетЧто(Аргументы[1]).Равно("unit-topic");
	ЮТест.ОжидаетЧто(Аргументы[2]).Равно(30000);
	ЮТест.ОжидаетЧто(Сообщения).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Сообщения[0].key).Равно(ОжидаемыйКлюч);
	ЮТест.ОжидаетЧто(Сообщения[0].partition).Равно(-1);
	ЮТест.ОжидаетЧто(Сообщения[0].message).Равно("данные: кириллица, ""кавычки""");
	ЮТест.ОжидаетЧто(Сообщения[0].headers).Равно("Источник,эталон");
	ПроверитьИсходящее(Запись, Перечисления.кфкСтатусыСообщений.Выгружено, 4);
	ПроверитьНазначение(Запись, Пакет.Поток, Ложь);

КонецПроцедуры

// Проверяет отклонение сообщения до вызова транспорта при незаданном топике.
Процедура ПакетKafka_ОтклоняетОтсутствующийТопик() Экспорт

	Пакет = НовыйПакет();
	Запись = НовоеСообщение(Пакет.Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 1000);
	НазначитьСообщение(Запись, Пакет.Поток);

	ОтправитьПакет(Пакет, "");

	ПроверитьИсходящее(Запись, Перечисления.кфкСтатусыСообщений.ОшибкаВыгрузки, 4);
	ПроверитьХэш(Запись, Ложь);
	ЮТест.ОжидаетЧто(ВызовыОтправки(Пакет), "При отсутствии топика транспорт не вызывается").ИмеетДлину(0);
	Запись.Прочитать();
	ЮТест.ОжидаетЧто(СтрНайти(Запись.ТекстЖурнала, "Отсутствует имя топика") > 0).Равно(Истина);

КонецПроцедуры

