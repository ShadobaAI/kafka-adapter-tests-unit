Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкПозицииОпераций. Модуль менеджера. ПолучитьПозицию()")
			.ДобавитьСерверныйТест("ПолучитьПозицию_ВозвращаетНольДляОтсутствующейЗаписи",
				"ПолучитьПозицию(). Возвращает ноль для отсутствующей записи")
				.Перед("ОчиститьДанные")
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкПозицииОпераций. Модуль менеджера. ОбновитьПозицию()")
			.ДобавитьСерверныйТест("ОбновитьПозицию_СоздаетПозициюБезРаздела",
				"ОбновитьПозицию(). Создает позицию без раздела")
				.Перед("ОчиститьДанные")
			.ДобавитьСерверныйТест("ОбновитьПозицию_ОбновляетПозициюБезРаздела",
				"ОбновитьПозицию(). Обновляет позицию без раздела")
				.Перед("ОчиститьДанные")
			.ДобавитьСерверныйТест("ОбновитьПозицию_СохраняетРазделИПредставление",
				"ОбновитьПозицию(). Сохраняет раздел и его представление")
				.Перед("ОчиститьДанные");
	
КонецПроцедуры

Процедура ОчиститьДанные() Экспорт
	УдалитьПозицию(ИдентификаторБезРаздела(), "");
	УдалитьПозицию(ИдентификаторСРазделом(), "section");
КонецПроцедуры

Процедура ПолучитьПозицию_ВозвращаетНольДляОтсутствующейЗаписи() Экспорт
	
	Позиция = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(
		ИдентификаторБезРаздела());
	
	ЮТест.ОжидаетЧто(Позиция).Равно(0);
	
КонецПроцедуры

Процедура ОбновитьПозицию_СоздаетПозициюБезРаздела() Экспорт
	
	Идентификатор = ИдентификаторБезРаздела();
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 101);
	
	Позиция = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(Идентификатор);
	
	ЮТест.ОжидаетЧто(Позиция).Равно(101);
	
КонецПроцедуры

Процедура ОбновитьПозицию_ОбновляетПозициюБезРаздела() Экспорт
	
	Идентификатор = ИдентификаторБезРаздела();
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 101);
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 202);
	
	Позиция = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(Идентификатор);
	
	ЮТест.ОжидаетЧто(Позиция).Равно(202);
	
КонецПроцедуры

Процедура ОбновитьПозицию_СохраняетРазделИПредставление() Экспорт
	
	Идентификатор = ИдентификаторСРазделом();
	Раздел = Новый Структура("Значение,Представление", "section", "Тестовый раздел");
	
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 303, Раздел);
	
	Позиция = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(Идентификатор, Раздел.Значение);
	ЮТест.ОжидаетЧто(Позиция).Равно(303);
	
	Предикат = ЮТест.Предикат()
		.Реквизит("Идентификатор").Равно(Идентификатор)
		.Реквизит("Раздел").Равно(Раздел.Значение)
		.Реквизит("РазделПредставление").Равно(Раздел.Представление);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций")
		.СодержитЗаписи(Предикат);
	
КонецПроцедуры

Процедура УдалитьПозицию(Идентификатор, Раздел)
	
	Набор = РегистрыСведений.кфкПозицииОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.Идентификатор.Установить(Идентификатор);
	Набор.Отбор.Раздел.Установить(Раздел);
	Набор.Записать();
	
КонецПроцедуры

Функция ИдентификаторБезРаздела()
	Возврат Новый УникальныйИдентификатор("8f934cba-0d5b-4c76-9f6f-19615932ca10");
КонецФункции

Функция ИдентификаторСРазделом()
	Возврат Новый УникальныйИдентификатор("ef3062cc-30ce-4f3a-a1ed-2add17825231");
КонецФункции
