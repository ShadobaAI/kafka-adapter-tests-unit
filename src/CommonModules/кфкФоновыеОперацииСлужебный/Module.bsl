// При отсутствии настройки Мокито выполняет исходное ожидание.
&Вместо("ОжидатьСвободныеПотоки")
Функция ют_ОжидатьСвободныеПотоки(Диспетчер, Потоки, МаксПодпотоков, Параметры)

	Аргументы = Новый Массив; // Массив Из Произвольный
	Аргументы.Добавить(Диспетчер);
	Аргументы.Добавить(Потоки);
	Аргументы.Добавить(МаксПодпотоков);
	Аргументы.Добавить(Параметры);
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		кфкФоновыеОперацииСлужебный, "ОжидатьСвободныеПотоки", Аргументы, ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат ПродолжитьВызов(Диспетчер, Потоки, МаксПодпотоков, Параметры);

