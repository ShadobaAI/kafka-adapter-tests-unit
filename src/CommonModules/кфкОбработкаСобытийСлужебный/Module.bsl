// См. кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих
&Around("ПоместитьВОчередьИсходящих")
Процедура ют_ПоместитьВОчередьИсходящих(Источник, СобытиеРегистрации, ТипОбъект = "", ЭтоУдаление = Ложь,
		ПараметрыРегистрации = Неопределено)

	Аргументы = Новый Массив; // Массив Из Произвольный
	Аргументы.Добавить(Источник);
	Аргументы.Добавить(СобытиеРегистрации);
	Аргументы.Добавить(ТипОбъект);
	Аргументы.Добавить(ЭтоУдаление);
	Аргументы.Добавить(ПараметрыРегистрации);
	ПрерватьВыполнение = Ложь;
	МокитоПерехват.АнализВызова(
		кфкОбработкаСобытийСлужебный,
		"ПоместитьВОчередьИсходящих",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Источник, СобытиеРегистрации, ТипОбъект, ЭтоУдаление, ПараметрыРегистрации);

КонецПроцедуры

