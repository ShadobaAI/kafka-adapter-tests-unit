#Область СлужебныеПроцедурыИФункции

#Если Сервер Тогда

// См. СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки
&Around("ПараметрыИзСтроки")
Функция ют_ПараметрыИзСтроки(Знач СтрокаПараметров, Знач Разделитель = ";")

	Аргументы = ЮТМетоды.МассивПараметров(СтрокаПараметров, Разделитель); // Массив Из Произвольный
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		СтроковыеФункцииКлиентСервер,
		"ПараметрыИзСтроки",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат ПродолжитьВызов(СтрокаПараметров, Разделитель);

КонецФункции

#КонецЕсли

#КонецОбласти
