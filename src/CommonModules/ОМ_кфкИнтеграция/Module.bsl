// Создает параметры без реальной записи очереди.
//
// Возвращаемое значение:
//  Структура:
// * Продюсеры - Неопределено - продюсеры выбираются зависимостью.
// * ОчередьИсходящих - Неопределено - запись очереди подменена на границе зависимости.
Функция НовыеПараметрыРегистрации()

	Результат = Новый Структура("Продюсеры,ОчередьИсходящих", Неопределено, Неопределено);
	Возврат Результат;

КонецФункции

// Параметры:
//  Параметры - см. НовыеПараметрыРегистрации
Процедура НастроитьРегистрацию(Знач Параметры)

	РазмерПорции = 2;
	Мокито.Обучение(кфкОбработкаСобытийСлужебный)
		.Когда("ПараметрыРегистрации")
			.Вернуть(Параметры)
		.Когда("МаксРазмерПорцииРегистрации")
			.Вернуть(РазмерПорции)
		.Когда("ПоместитьВОчередьИсходящих")
			.Вернуть(Неопределено)
		.Когда("ЗавершитьРегистрацию")
			.Вернуть(Неопределено);
	Мокито.Прогон();

КонецПроцедуры

#КонецОбласти

#Область КомандыИстории

// Создает список источников подключаемой команды.
//
// Возвращаемое значение:
//  Структура:
// * Строки - ТаблицаЗначений:
// ** ПолноеИмя - Строка - полное имя источника формы.
Функция НовыеИсточники()

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Результат = Новый Структура("Строки", Строки);
	Возврат Результат;

КонецФункции

// Создает таблицу результата регистрации команд.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
// * Вид - Строка
// * Идентификатор - Строка
// * Представление - Строка
// * Важность - Строка
// * Картинка - Картинка
// * ТолькоВоВсехДействиях - Булево
// * ТипПараметра - ОписаниеТипов, Неопределено - ограничение типа параметра команды.
// * ФункциональныеОпции - Строка
// * МножественныйВыбор - Булево
// * РежимЗаписи - Строка
// * Обработчик - Строка
Функция НовыеКоманды()

	Результат = Новый ТаблицаЗначений;
	ТипСтроки = Новый ОписаниеТипов("Строка");
	ТипБулева = Новый ОписаниеТипов("Булево");
	Результат.Колонки.Добавить("Вид", ТипСтроки);
	Результат.Колонки.Добавить("Идентификатор", ТипСтроки);
	Результат.Колонки.Добавить("Представление", ТипСтроки);
	Результат.Колонки.Добавить("Важность", ТипСтроки);
	Результат.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
	Результат.Колонки.Добавить("ТолькоВоВсехДействиях", ТипБулева);
	Результат.Колонки.Добавить("ТипПараметра", Новый ОписаниеТипов("ОписаниеТипов,Неопределено"));
	Результат.Колонки.Добавить("ФункциональныеОпции", ТипСтроки);
	Результат.Колонки.Добавить("МножественныйВыбор", ТипБулева);
	Результат.Колонки.Добавить("РежимЗаписи", ТипСтроки);
	Результат.Колонки.Добавить("Обработчик", ТипСтроки);
	Возврат Результат;

КонецФункции

Процедура НастроитьКоманды()

	ОбновитьПовторноИспользуемыеЗначения();
	Объекты = Новый Соответствие; // Соответствие Из КлючИЗначение
	Объекты.Вставить("регистрсведений.кфквходящиесообщения", Истина);
	Мокито.Обучение(кфкОбщегоНазначенияСлужебный)
		.Когда("ПодсистемаДоступна")
			.Вернуть(Истина);
	Мокито.Обучение(кфкИнтеграцияСлужебныйПовтИсп)
		.Когда("ОбъектыИнтеграции")
			.Вернуть(Объекты)
		.Когда("ТипыОбъектовИнтеграции")
			.Вернуть(Новый ОписаниеТипов("СправочникСсылка.кфкПродюсеры"));
	Мокито.Прогон();

КонецПроцедуры

// Параметры:
//  Команды - см. НовыеКоманды
//  ТипПараметра - Неопределено, ОписаниеТипов - ожидаемое ограничение типа.
Процедура ПроверитьКомандуИстории(Знач Команды, Знач ТипПараметра)

	ЮТест.ОжидаетЧто(Команды.Количество()).Равно(1);
	Команда = Команды[0];
	ЮТест.ОжидаетЧто(Команда.Вид).Равно("КоманднаяПанель");
	ЮТест.ОжидаетЧто(Команда.Идентификатор).Равно("кфкИсторияВыгрузки");
	ЮТест.ОжидаетЧто(Команда.Представление).Равно("История выгрузки (Kafka)");
	ЮТест.ОжидаетЧто(Команда.Важность).Равно("СмТакже");
	ЮТест.ОжидаетЧто(Команда.Картинка).Равно(БиблиотекаКартинок.История);
	ЮТест.ОжидаетЧто(Команда.ТолькоВоВсехДействиях).Равно(Истина);
	ЮТест.ОжидаетЧто(Команда.ТипПараметра).Равно(ТипПараметра);
	ЮТест.ОжидаетЧто(Команда.ФункциональныеОпции).Равно("кфкИспользоватьИнтеграцию");
	ЮТест.ОжидаетЧто(Команда.МножественныйВыбор).Равно(Ложь);
	ЮТест.ОжидаетЧто(Команда.РежимЗаписи).Равно("ЗаписыватьТолькоНовые");
	ЮТест.ОжидаетЧто(Команда.Обработчик).Равно("кфкИнтеграцияКлиент.ВыполнитьПодключаемуюКоманду");

КонецПроцедуры

