// Проверяет сохранение описаний, адресов, партиций и истории при повторной инициализации.
Процедура ИнициализироватьКэшРаспределенияЧтения_СохраняетСостояние() Экспорт

	Консьюмеры = Новый Массив;
	Кэш = кфкФоновыеОперацииСлужебный.ют_КэшРаспределенияЧтения(Консьюмеры, Неопределено);
	Консьюмер = НоваяСсылкаКонсьюмера();
	Кэш.Коннекторы.Вставить("broker-a:9092", "сессия-a");
	Кэш.Коннекторы.Вставить("broker-b:9092", "сессия-b");
	Кэш.ПартицииКонсьюмеров.Вставить(Консьюмер, 3);
	СтрокаИстории = Кэш.ИсторияОчереди.Добавить();
	СтрокаИстории.Консьюмер = Консьюмер;
	СтрокаИстории.РазмерОчереди = 17;
	СтрокаИстории.ВремяЗамера = Дата(2026, 1, 1);

	Результат = кфкФоновыеОперацииСлужебный.ют_КэшРаспределенияЧтения(Консьюмеры, Кэш);

	ЮТест.ОжидаетЧто(Результат.Коннекторы.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Результат.Коннекторы.Получить("broker-a:9092")).Равно("сессия-a");
	ЮТест.ОжидаетЧто(Результат.Коннекторы.Получить("broker-b:9092")).Равно("сессия-b");
	ЮТест.ОжидаетЧто(Результат.ПартицииКонсьюмеров.Получить(Консьюмер)).Равно(3);
	ЮТест.ОжидаетЧто(Результат.ИсторияОчереди.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ИсторияОчереди[0].РазмерОчереди).Равно(17);
	ЮТест.ОжидаетЧто(Результат.ИсторияОчереди[0].ВремяЗамера).Равно(Дата(2026, 1, 1));

КонецПроцедуры

// Проверяет порог нагрузки, ограничение партициями и лимит потоков.
// Параметры:
//  СреднийРазмер - Число - Нагрузка на партицию.
//  ЛимитПотоков - Число - Максимальное число потоков.
//  ЧислоНазначений - Число - Ожидаемая кратность назначения.
//  МаксимальныйПоток - Число - Ожидаемый максимальный номер потока.
Процедура РаспределитьКонсьюмеровПоПотокам_УчитываетНагрузку(
		СреднийРазмер, ЛимитПотоков, ЧислоНазначений, МаксимальныйПоток) Экспорт

	Консьюмер = НоваяСсылкаКонсьюмера();
	Статистика = кфкФоновыеОперацииСлужебный.ют_НоваяСтатистикаРаспределенияЧтения();
	ДобавитьНагрузку(Статистика, Консьюмер, СреднийРазмер, 3);

	Результат = кфкФоновыеОперацииСлужебный.ют_РаспределитьКонсьюмеров(
		Статистика, 100, ЛимитПотоков);

	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(ЧислоНазначений);
	Результат.Сортировать("НомерПотока");
	ЮТест.ОжидаетЧто(Результат[Результат.Количество() - 1].НомерПотока).Равно(МаксимальныйПоток);
	Для Каждого Назначение Из Результат Цикл
		ЮТест.ОжидаетЧто(Назначение.Консьюмер).Равно(Консьюмер);
	КонецЦикла;

КонецПроцедуры

// Проверяет строгое сравнение суммарной нагрузки и сохранение обоих владельцев.
// Параметры:
//  ПерваяНагрузка - Число - Нагрузка первого консьюмера.
//  ВтораяНагрузка - Число - Нагрузка второго консьюмера.
//  ЛимитПотоков - Число - Максимальное число потоков.
//  МаксимальныйПоток - Число - Ожидаемый максимальный номер потока.
Процедура РаспределитьКонсьюмеровПоПотокам_УчитываетГраницуОбъединения(
		ПерваяНагрузка, ВтораяНагрузка, ЛимитПотоков, МаксимальныйПоток) Экспорт

	Первый = НоваяСсылкаКонсьюмера();
	Второй = НоваяСсылкаКонсьюмера();
	Статистика = кфкФоновыеОперацииСлужебный.ют_НоваяСтатистикаРаспределенияЧтения();
	ДобавитьНагрузку(Статистика, Первый, ПерваяНагрузка, 1);
	ДобавитьНагрузку(Статистика, Второй, ВтораяНагрузка, 1);

	Результат = кфкФоновыеОперацииСлужебный.ют_РаспределитьКонсьюмеров(Статистика, 100, ЛимитПотоков);

	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Результат.НайтиСтроки(Новый Структура("Консьюмер", Первый)).Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.НайтиСтроки(Новый Структура("Консьюмер", Второй)).Количество()).Равно(1);
	Результат.Сортировать("НомерПотока");
	ЮТест.ОжидаетЧто(Результат[0].НомерПотока).Равно(1);
	ЮТест.ОжидаетЧто(Результат[1].НомерПотока).Равно(МаксимальныйПоток);

КонецПроцедуры

