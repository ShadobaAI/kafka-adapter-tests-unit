КонецПроцедуры

// Проверяет фактическую регистрацию ссылки и согласованность ключей с записанными сообщениями.
//
// Параметры:
//  ЭтоУдаление - Булево - ожидаемый признак удаления.
Процедура ПоместитьВОчередьИсходящих_ЗаписываетСсылкуБезПараметров(Знач ЭтоУдаление) Экспорт

	Источник = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ТипОбъекта = "Справочник.кфк_т_ТестовыйСправочник";
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	ДополнительныйПродюсер = НовыйПродюсерДляРегистрации(ТипОбъекта);
	ОбновитьПовторноИспользуемыеЗначения();

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		ЭтоУдаление);

	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(XMLСтрока(Источник));
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитНесколькоЗаписей(2, Отбор);
	Продюсеры = Новый Массив; // Массив Из СправочникСсылка.кфкПродюсеры
	Продюсеры.Добавить(Продюсер);
	Продюсеры.Добавить(ДополнительныйПродюсер);
	Для Каждого Адресат Из Продюсеры Цикл

		ПоляЗаписи = ЮТест.Предикат()
			.Реквизит("КлючОбъекта").Равно(XMLСтрока(Источник))
			.Реквизит("Продюсер").Равно(Адресат)
			.Реквизит("ТипОбъект").Равно(ТипОбъекта)
			.Реквизит("ЭтоУдаление").Равно(ЭтоУдаление)
			.Реквизит("ТипИсходныхДанных").Равно("CatalogRef.кфк_т_ТестовыйСправочник")
			.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Новое)
			.Реквизит("СобытиеРегистрации").Равно(Перечисления.кфкСобытияРегистрации.Программно);
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.СодержитНесколькоЗаписей(1, ПоляЗаписи);

	КонецЦикла;
	Записи = ЮТЗапросы.Записи("РегистрСведений.кфкИсходящиеСообщения", Отбор);
	Для Каждого Запись Из Записи Цикл

		Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
		ЮТест.ОжидаетЧто(Данные.Данные).Равно(Источник);
		ЮТест.ОжидаетЧто(Данные.ДополнительныеСвойства).ЭтоНеопределено();

	КонецЦикла;

КонецПроцедуры

// Параметры:
//  НомерВарианта - Число - тип дополнительного свойства.
Процедура ПоместитьВОчередьИсходящих_ПодготавливаетДополнительныеСвойства(Знач НомерВарианта) Экспорт

	Источник = Справочники.кфк_т_ТестовыйСправочник.СоздатьЭлемент();
	ГраничнаяДлина = 1000;
	ГраничнаяСтрока = "";
	Для НомерСимвола = 1 По ГраничнаяДлина Цикл
		ГраничнаяСтрока = ГраничнаяСтрока + "a";
	КонецЦикла;
	НеподдерживаемоеЗначение = "<Значение не поддерживается>";
	ИсходноеЗначение = Неопределено; // Произвольный
	ОжидаемоеЗначение = Неопределено; // Произвольный
	Если НомерВарианта = 1 Тогда

		ИсходноеЗначение = Null;

	ИначеЕсли НомерВарианта = 2 Тогда

		ИсходноеЗначение = Новый ХранилищеЗначения("ORDER-17");
		ОжидаемоеЗначение = НеподдерживаемоеЗначение;

	ИначеЕсли НомерВарианта = 3 Тогда

		ИсходноеЗначение = ПолучитьДвоичныеДанныеИзСтроки("ORDER-17");
		ОжидаемоеЗначение = НеподдерживаемоеЗначение;

	ИначеЕсли НомерВарианта = 4 Тогда

		ИсходноеЗначение = ГраничнаяСтрока + "a";
		ОжидаемоеЗначение = НеподдерживаемоеЗначение;

	ИначеЕсли НомерВарианта = 5 Тогда

		ИсходноеЗначение = ГраничнаяСтрока;
		ОжидаемоеЗначение = ИсходноеЗначение;

	ИначеЕсли НомерВарианта = 6 Тогда

		ИсходноеЗначение = Новый Структура("Заказ", "ORDER-17");
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 7 Тогда

		ИсходноеЗначение = Новый ФиксированнаяСтруктура("Заказ", "ORDER-17");
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 8 Тогда

		ИсходноеЗначение = Новый Соответствие;
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 9 Тогда

		ИсходноеЗначение = Новый ФиксированноеСоответствие(Новый Соответствие);
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 10 Тогда

		ИсходноеЗначение = Новый Массив;
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 11 Тогда

		ИсходноеЗначение = Новый ФиксированныйМассив(Новый Массив);
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 12 Тогда

		ИсходноеЗначение = Новый ТаблицаЗначений;
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 13 Тогда

		ИсходноеЗначение = Новый ДеревоЗначений;
		ОжидаемоеЗначение = ОбщегоНазначения.ЗначениеВСтрокуXML(ИсходноеЗначение);

	ИначеЕсли НомерВарианта = 14 Тогда

		ИсходноеЗначение = Новый Структура("Заказ", ГраничнаяСтрока);
		ОжидаемоеЗначение = НеподдерживаемоеЗначение;

	ИначеЕсли НомерВарианта = 15 Тогда

		ИсходноеЗначение = Новый Структура("Запрос", Новый Запрос);
		ОжидаемоеЗначение = НеподдерживаемоеЗначение;

	ИначеЕсли НомерВарианта = 16 Тогда

		ИсходноеЗначение = Новый Запрос;
		ОжидаемоеЗначение = НеподдерживаемоеЗначение;

	ИначеЕсли НомерВарианта = 17 Тогда

		ИсходноеЗначение = "ORDER-17";
		ОжидаемоеЗначение = ИсходноеЗначение;

	КонецЕсли;
	Источник.ДополнительныеСвойства.Вставить("ТестовоеСвойство", ИсходноеЗначение);
	Источник.ДополнительныеСвойства.Вставить("НомерЗаказа", "ORDER-18");
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(1), Истина);

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		Ложь,
		Параметры);

	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(1);
	Запись = Параметры.ОчередьИсходящих[0];
	Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
	ЮТест.ОжидаетЧто(Данные.ДополнительныеСвойства.ТестовоеСвойство).Равно(ОжидаемоеЗначение);
	ЮТест.ОжидаетЧто(Данные.ДополнительныеСвойства.НомерЗаказа).Равно("ORDER-18");
	ЮТест.ОжидаетЧто(Источник.ДополнительныеСвойства.ТестовоеСвойство).Равно(ИсходноеЗначение);
	ЮТест.ОжидаетЧто(Запись.ТипИсходныхДанных).Равно("CatalogObject.кфк_т_ТестовыйСправочник");

КонецПроцедуры

// Параметры:
//  КоличествоЗаписей - Число - число записей независимого регистра.
Процедура ПоместитьВОчередьИсходящих_РегистрируетНезависимыйРегистр(Знач КоличествоЗаписей) Экспорт

	Источник = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьНаборЗаписей();
	Источник.Отбор.Строка.Установить("ORDER-17");
	Для Номер = 1 По КоличествоЗаписей Цикл

		ЗаписьИсточника = Источник.Добавить();
		ЗаписьИсточника.Период = Дата(2026, 9, 10);
		ЗаписьИсточника.Строка = "ORDER-" + Строка(Номер);
		ЗаписьИсточника.Число = Номер;
		ЗаписьИсточника.Комментарий = "Проверка строки регистра";

	КонецЦикла;
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(2), Истина);
	ТипОбъекта = "РегистрСведений.кфк_т_ТестовыйРегистрСведений";
	ЭтоУдаление = КоличествоЗаписей = 0;

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		ЭтоУдаление,
		Параметры);

	ОжидаемоеКоличество = ?(ЭтоУдаление, 2, КоличествоЗаписей * 2);
	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(ОжидаемоеКоличество);
	Для Каждого Запись Из Параметры.ОчередьИсходящих Цикл

		ПроверитьОбщиеПоляОчереди(Запись, ТипОбъекта);
		ЮТест.ОжидаетЧто(Запись.ЭтоУдаление).Равно(ЭтоУдаление);
		ЮТест.ОжидаетЧто(Запись.ТипИсходныхДанных)
			.Равно("InformationRegisterRecordSet.кфк_т_ТестовыйРегистрСведений");
		Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
		Если ЭтоУдаление Тогда

			ЮТест.ОжидаетЧто(Данные.Строка).Равно("ORDER-17");

		Иначе

			ЮТест.ОжидаетЧто(Данные.Комментарий).Равно("Проверка строки регистра");
			ЮТест.ОжидаетЧто(Данные.Строка).Равно("ORDER-" + Строка(Данные.Число));

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Параметры:
//  ЗаполнитьРегистратор - Булево - пустой отбор не создает сообщение.
//  ЭтоУдаление - Булево - признак удаления.
//  ЭтоРегистрНакопления - Булево - выбор вида подчиненного регистра.
Процедура ПоместитьВОчередьИсходящих_РегистрируетПодчиненныйРегистр(
		Знач ЗаполнитьРегистратор, Знач ЭтоУдаление, Знач ЭтоРегистрНакопления) Экспорт

	Регистратор = Документы.кфк_т_ТестовыйДокумент.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Если ЭтоРегистрНакопления Тогда
		Источник = РегистрыНакопления.кфк_т_ТестовыйРегистрНакопления.СоздатьНаборЗаписей();
	Иначе
		Источник = РегистрыСведений.кфк_т_ТестовыйРегистрСведенийПР.СоздатьНаборЗаписей();
	КонецЕсли;
	Если ЗаполнитьРегистратор Тогда
		Источник.Отбор.Регистратор.Установить(Регистратор);
	КонецЕсли;
	ТипОбъекта = Источник.Метаданные().ПолноеИмя();
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(2), Истина);

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		ЭтоУдаление,
		Параметры);

	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(?(ЗаполнитьРегистратор, 2, 0));
	Для Каждого Запись Из Параметры.ОчередьИсходящих Цикл

		ПроверитьОбщиеПоляОчереди(Запись, ТипОбъекта);
		ЮТест.ОжидаетЧто(Запись.ЭтоУдаление).Равно(ЭтоУдаление);
		Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
		ЮТест.ОжидаетЧто(Данные.Регистратор).Равно(Регистратор);

	КонецЦикла;

КонецПроцедуры

// Параметры:
//  ЭтоУдаление - Булево - признак удаления передается в каждую запись.
Процедура ПоместитьВОчередьИсходящих_РегистрируетСсылку(Знач ЭтоУдаление) Экспорт

	Источник = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(2), Истина);
	ТипОбъекта = "Справочник.кфк_т_ТестовыйСправочник";

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Источник,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		ЭтоУдаление,
		Параметры);

	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(2);
	Для Каждого Запись Из Параметры.ОчередьИсходящих Цикл

		ПроверитьОбщиеПоляОчереди(Запись, ТипОбъекта);
		ЮТест.ОжидаетЧто(Запись.ЭтоУдаление).Равно(ЭтоУдаление);
		ЮТест.ОжидаетЧто(Запись.КлючОбъекта).Равно(XMLСтрока(Источник));
		ЮТест.ОжидаетЧто(Запись.ТипИсходныхДанных).Равно("CatalogRef.кфк_т_ТестовыйСправочник");
		Данные = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные); // Структура
		ЮТест.ОжидаетЧто(Данные.Данные).Равно(Источник);
		ЮТест.ОжидаетЧто(Данные.ДополнительныеСвойства).Равно(Неопределено);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

