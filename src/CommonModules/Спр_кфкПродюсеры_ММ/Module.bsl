// Проверяет адреса и параметры подключения продюсера из тестовых данных.
Процедура ОписаниеПродюсера_ВозвращаетПодготовленныеНастройки() Экспорт
	
	Продюсер = ПродюсерСправочника();
	
	Описание = Справочники.кфкПродюсеры.ОписаниеПродюсера(Продюсер);
	
	ОжидаемыеСвойства = Новый Структура;
	ОжидаемыеСвойства.Вставить("Ссылка", Продюсер);
	ОжидаемыеСвойства.Вставить("Наименование", "Продюсер: ТестовыйСправочник");
	ОжидаемыеСвойства.Вставить("АдресБрокера", "localhost:29091,localhost:29092");
	ОжидаемыеСвойства.Вставить("РежимАсинх", Ложь);
	
	ЮТест.ОжидаетЧто(Описание, "Описание продюсера")
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	ЮТест.ОжидаетЧто(
		Описание.ПараметрыПодключения.Получить("message.timeout.ms"),
		"Параметр message.timeout.ms")
		.Равно("5000");
	
КонецПроцедуры

// Проверяет группировку продюсеров по полным именам объектов метаданных в нижнем регистре.
Процедура ОбъектыИнтеграции_ГруппируетПродюсеровПоТипамОбъектов() Экспорт
	
	Продюсер = ПродюсерСправочника();
	
	ОбъектыИнтеграции = Справочники.кфкПродюсеры.ОбъектыИнтеграции();
	ПродюсерыСправочника = ОбъектыИнтеграции.Получить(
		НРег("Справочник.кфк_т_ТестовыйСправочник"));
	
	ЮТест.ОжидаетЧто(ОбъектыИнтеграции, "Объекты интеграции")
		.ИмеетДлину(5);
	ЮТест.ОжидаетЧто(ПродюсерыСправочника, "Продюсеры тестового справочника")
		.ИмеетДлину(1)
		.Содержит(Продюсер);
	
КонецПроцедуры

// Проверяет исключение продюсера с заблокированной регистрацией из объектов интеграции.
Процедура ОбъектыИнтеграции_НеВозвращаетЗаблокированногоПродюсера() Экспорт
	
	Продюсер = ПродюсерСправочника();
	Объект = Продюсер.ПолучитьОбъект();
	Объект.БлокироватьРегистрацию = Истина;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	ОбъектыИнтеграции = Справочники.кфкПродюсеры.ОбъектыИнтеграции();
	ПродюсерыСправочника = ОбъектыИнтеграции.Получить(
		НРег("Справочник.кфк_т_ТестовыйСправочник"));
	
	ЮТест.ОжидаетЧто(ОбъектыИнтеграции, "Объекты интеграции без заблокированного продюсера")
		.ИмеетДлину(4);
	ЮТест.ОжидаетЧто(ПродюсерыСправочника)
		.ЭтоНеопределено();
	
КонецПроцедуры

// Проверяет имена объектов интеграции из тестовых данных, включая документ.
Процедура ИменаОбъектовИнтеграции_ВозвращаетПодготовленныеТипыОбъектов() Экспорт
	
	ИменаОбъектов = Справочники.кфкПродюсеры.ИменаОбъектовИнтеграции();
	
	ЮТест.ОжидаетЧто(ИменаОбъектов, "Имена объектов интеграции")
		.ИмеетДлину(5)
		.Содержит(НРег("Справочник.кфк_т_ТестовыйСправочник"))
		.Содержит(НРег("Документ.кфк_т_ТестовыйДокумент"))
		.Содержит(НРег("РегистрСведений.кфк_т_ТестовыйРегистрСведений"))
		.Содержит(НРег("РегистрСведений.кфк_т_ТестовыйРегистрСведенийПР"))
		.Содержит(НРег("РегистрНакопления.кфк_т_ТестовыйРегистрНакопления"));
	
КонецПроцедуры

// Исключает влияние подмен и кэша списка пакетов на следующий сценарий.
Процедура ОчиститьПодменуПространствИменXDTO() Экспорт

	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры
// Проверяет независимый приоритет каждого поля и отсутствие физического заполнения строки.
// Параметры:
//  ТипВСтроке - Булево - переопределить тип обработчика в строке.
//  МетодВСтроке - Булево - переопределить метод в строке.
//  МодульВСтроке - Булево - переопределить менеджер обмена в строке.
//  ФорматВСтроке - Булево - переопределить формат в строке.
//  ЕстьНастройкиПоУмолчанию - Булево - заполнить общие настройки.
//  ИспользоватьМаску - Булево - подобрать URI из маски заполненного поля формата.
Процедура ПравилаСериализации_ПрименяетНастройкиПоПолям(
	ТипВСтроке, МетодВСтроке, МодульВСтроке, ФорматВСтроке,
	ЕстьНастройкиПоУмолчанию, ИспользоватьМаску) Экспорт

	Ссылка = ПродюсерСправочника();
	Объект = Ссылка.ПолучитьОбъект();
	СтрокаНастроек = Объект.ОбъектыМетаданных[0];
	Объект.ТипСериализации = Перечисления.кфкТипыОбработчиков.ПустаяСсылка();
	Объект.ИмяМетодаСериализации = "";
	Объект.ИмяМодуляСериализации = "";
	Объект.ФорматСериализации = "";

	ФорматПоУмолчанию = "http://v8.fsk.ru/kfk/test/1.2.10";
	ФорматСтроки = "http://v8.fsk.ru/kfk/row/2.0";
	Если ЕстьНастройкиПоУмолчанию Тогда

		Объект.ТипСериализации = Перечисления.кфкТипыОбработчиков.КонвертацияДанных;
		Объект.ИмяМетодаСериализации = "кфк_т_ОбработчикиСообщений.Сериализация";
		Объект.ИмяМодуляСериализации = "кфк_т_МенеджерОбменаЧерезУниверсальныйФормат";
		Объект.ФорматСериализации = ?(ИспользоватьМаску, "http://v8.fsk.ru/kfk/test/*", ФорматПоУмолчанию);

	КонецЕсли;

	СтрокаНастроек.ТипСериализации = ?(ТипВСтроке,
		Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик,
		Перечисления.кфкТипыОбработчиков.ПустаяСсылка());
	СтрокаНастроек.ИмяМетодаСериализации = ?(МетодВСтроке,
		"Справочники.кфк_т_ТестовыйСправочник.Сериализация", "");
	СтрокаНастроек.ИмяМодуляСериализации = ?(МодульВСтроке, "ют_МенеджерОбменаXDTOДляВыбораПравил", "");
	СтрокаНастроек.ФорматСериализации = "";
	Если ФорматВСтроке Тогда
		СтрокаНастроек.ФорматСериализации = ?(ИспользоватьМаску, "http://v8.fsk.ru/kfk/row/*", ФорматСтроки);
	КонецЕсли;

	ОжидаемыеСвойства = кфкФоновыеОперацииСлужебный.НовоеОписаниеПравилОбмена();
	ОжидаемыеСвойства.Тип = ?(ТипВСтроке, СтрокаНастроек.ТипСериализации, Объект.ТипСериализации);
	ОжидаемыеСвойства.ИмяМетода = ?(МетодВСтроке,
		СтрокаНастроек.ИмяМетодаСериализации, Объект.ИмяМетодаСериализации);
	ОжидаемыеСвойства.ИмяМодуля = ?(МодульВСтроке,
		СтрокаНастроек.ИмяМодуляСериализации, Объект.ИмяМодуляСериализации);
	ОжидаемыеСвойства.ИмяПОД = СтрокаНастроек.ИмяПОДСериализации;
	ОжидаемыеСвойства.Формат = "";
	Если ФорматВСтроке Тогда
		ОжидаемыеСвойства.Формат = ФорматСтроки;
	ИначеЕсли ЕстьНастройкиПоУмолчанию Тогда
		ОжидаемыеСвойства.Формат = ФорматПоУмолчанию;
	КонецЕсли;

	НеизмененнаяСтрока = ЮТест.Предикат()
		.Реквизит("Ссылка").Равно(Ссылка)
		.Реквизит("ТипОбъект").Равно(СтрокаНастроек.ТипОбъект)
		.Реквизит("ТипСериализации").Равно(СтрокаНастроек.ТипСериализации)
		.Реквизит("ИмяМетодаСериализации").Равно(СтрокаНастроек.ИмяМетодаСериализации)
		.Реквизит("ИмяМодуляСериализации").Равно(СтрокаНастроек.ИмяМодуляСериализации)
		.Реквизит("ФорматСериализации").Равно(СтрокаНастроек.ФорматСериализации)
		.Реквизит("ИмяПОДСериализации").Равно(СтрокаНастроек.ИмяПОДСериализации);
	КлючПравила = НРег(XMLСтрока(Ссылка) + СтрокаНастроек.ТипОбъект);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

	ПространстваИмен = СтрРазделить(
		"http://v8.fsk.ru/kfk/test/1.2.2,http://v8.fsk.ru/kfk/test/1.2.10,"
		+ "http://v8.fsk.ru/kfk/row/1.0,http://v8.fsk.ru/kfk/row/2.0", ",");
	Мокито.Обучение(кфкИнтеграцияСлужебныйПовтИсп, Ложь)
		.Когда("ПространстваИменПакетовXDTO")
			.Вернуть(Новый ФиксированныйМассив(ПространстваИмен));
	Мокито.Прогон();

	Правила = Справочники.кфкПродюсеры.ПравилаСериализации(ЮТМетоды.МассивПараметров(Ссылка));

	ЮТест.ОжидаетЧто(Правила).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Правила.Получить(КлючПравила))
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.кфкПродюсеры.ОбъектыМетаданных")
		.СодержитЗаписи(НеизмененнаяСтрока);

КонецПроцедуры
// Проверяет состав правила сериализации и его поиск по продюсеру и типу объекта.
Процедура ПравилаСериализации_ВозвращаетПодготовленноеПравило() Экспорт
	
	Продюсер = ПродюсерСправочника();
	Продюсеры = Новый Массив;
	Продюсеры.Добавить(Продюсер);
	
	Правила = Справочники.кфкПродюсеры.ПравилаСериализации(Продюсеры);
	ТипОбъекта = "Справочник.кфк_т_ТестовыйСправочник";
	КлючПравила = НРег(XMLСтрока(Продюсер) + ТипОбъекта);
	Правило = Правила.Получить(КлючПравила);
	
	ОжидаемыеСвойства = Новый Структура;
	ОжидаемыеСвойства.Вставить(
		"Тип", Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	ОжидаемыеСвойства.Вставить(
		"ИмяМетода", "Справочники.кфк_т_ТестовыйСправочник.Сериализация");
	ОжидаемыеСвойства.Вставить(
		"ИмяМодуля", "кфк_т_МенеджерОбменаЧерезУниверсальныйФормат");
	ОжидаемыеСвойства.Вставить("ИмяПОД", "Справочник_ТестовыйСправочник_Отправка");
	ОжидаемыеСвойства.Вставить("Формат", "http://v8.fsk.ru/kfk/test/1.0");
	
	ЮТест.ОжидаетЧто(Правила, "Правила сериализации")
		.ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Правило, "Правило сериализации тестового справочника")
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	
КонецПроцедуры

// Проверяет выбор топика по составному ключу продюсера и справочника.
Процедура Топики_ВозвращаетПодготовленныйТопик() Экспорт
	
	Продюсер = ПродюсерСправочника();
	Продюсеры = Новый Массив;
	Продюсеры.Добавить(Продюсер);
	
	Топики = Справочники.кфкПродюсеры.Топики(Продюсеры);
	КлючТопика = НРег(
		XMLСтрока(Продюсер) + "Справочник.кфк_т_ТестовыйСправочник");
	
	ЮТест.ОжидаетЧто(Топики, "Топики продюсера")
		.ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Топики.Получить(КлючТопика))
		.Равно("1c.test-catalogs");
	
КонецПроцедуры

// Проверяет отбор продюсеров по флагу идемпотентной отправки.
Процедура ИдемпотентнаяОтправка_ВозвращаетТолькоПродюсеровСВключеннымФлагом() Экспорт
	
	ИдемпотентныйПродюсер = ПродюсерСправочника();
	ОбычныйПродюсер = ПродюсерРегистра();
	
	Объект = ИдемпотентныйПродюсер.ПолучитьОбъект();
	Объект.ИдемпотентнаяОтправка = Истина;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Продюсеры = Новый Массив;
	Продюсеры.Добавить(ИдемпотентныйПродюсер);
	Продюсеры.Добавить(ОбычныйПродюсер);
	
	Результат = Справочники.кфкПродюсеры.ИдемпотентнаяОтправка(Продюсеры);
	
	ЮТест.ОжидаетЧто(Результат, "Идемпотентные продюсеры")
		.ИмеетДлину(1)
		.Содержит(ИдемпотентныйПродюсер);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПродюсерСправочника()
	Возврат кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
КонецФункции

Функция ПродюсерРегистра()
	Возврат кфк_т_ТестовыеДанные.СсылкаПродюсераРегистра();
КонецФункции

#КонецОбласти
