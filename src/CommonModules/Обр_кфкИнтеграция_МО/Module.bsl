// Проверяет сохранение позиции отдельной тестовой группы на брокере.
Процедура ЗафиксироватьСмещение_СохраняетПозициюГруппы() Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "payload");
	ПодготовитьКонсьюмера(Фикстура);
	ДождатьсяСообщения(Фикстура.Интеграция);

	Результат = Фикстура.Интеграция.ЗафиксироватьСмещение(Фикстура.Топик, 1, 0);
	Фикстура.ГруппаЗафиксирована = Результат;
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Булево").Равно(Истина);
	Позиции = Фикстура.Интеграция.ПолучитьСмещенияГруппыКонсьюмеров(Фикстура.Брокеры);
	ЮТест.ОжидаетЧто(Позиции).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Позиции).Свойство("metadata").ИмеетТип("Массив");
	Найдено = 0;
	ПозицииПартиций = Позиции["metadata"]; // Массив Из Структура
	Для Каждого Позиция Из ПозицииПартиций Цикл
		ТопикПозиции = "";
		ПартицияПозиции = "";
		Позиция.Свойство("topic", ТопикПозиции);
		Позиция.Свойство("partition", ПартицияПозиции);
		Если ТопикПозиции = Фикстура.Топик И ПартицияПозиции = "0" Тогда
			ЮТест.ОжидаетЧто(Позиция).Свойство("topic").ИмеетТип("Строка").Равно(Фикстура.Топик);
			ЮТест.ОжидаетЧто(Позиция).Свойство("partition").ИмеетТип("Строка").Равно("0");
			ЮТест.ОжидаетЧто(Позиция).Свойство("offset").ИмеетТип("Строка").Равно("1");
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено).Равно(1);

КонецПроцедуры

