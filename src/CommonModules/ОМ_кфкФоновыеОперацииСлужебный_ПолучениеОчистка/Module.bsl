// Возвращает ключи результата проверяемого SQL API.
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса
// Возвращаемое значение:
//  Массив Из Строка
Функция КлючиВыборки(Выборка)

	Результат = Новый Массив; // Массив Из Строка
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.КлючЗаписи);
	КонецЦикла;
	Возврат Результат;

КонецФункции

