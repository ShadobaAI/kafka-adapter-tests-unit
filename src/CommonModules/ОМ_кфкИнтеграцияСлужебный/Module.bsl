// Проверяет отказ до создания компоненты при недоступном брокере.
// Параметры:
//  ПакетноеЧтение - Булево - использовать пакетный API.
Процедура Прочитать_ОтклоняетОтключенногоКонсьюмера(Знач ПакетноеЧтение) Экспорт

	Компонента = НоваяКомпонента();
	// Пустой брокер исключает существующую запись из доступных настроек без подмены запроса.
	Реквизиты = Новый Структура("Брокер", Справочники.кфкБрокеры.ПустаяСсылка());
	Консьюмер = ЮТест.Данные().СоздатьЭлемент(
		Справочники.кфкКонсьюмеры, "unit-disabled-consumer", Реквизиты); // СправочникСсылка.кфкКонсьюмеры
	Сессии = Новый Соответствие;
	Настройки = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмера(Консьюмер);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Настройки.Ссылка)).Равно(Ложь);
	Результат = кфкИнтеграция.РезультатИнтеграции();

	Если ПакетноеЧтение Тогда

		Результат = кфкИнтеграцияСлужебный.ПрочитатьПакетСообщений(Консьюмер, Ложь, 100, Сессии);
		ЮТест.ОжидаетЧто(Результат.Сообщения).ИмеетДлину(0);

	Иначе

		Результат = кфкИнтеграцияСлужебный.Прочитать(Консьюмер, Ложь, Сессии);
		ЮТест.ОжидаетЧто(Результат.Сообщение).ЭтоНеопределено();

	КонецЕсли;

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Равно("Консьюмер отключён!");
	ЮТест.ОжидаетЧто(Сессии.Получить(Консьюмер)).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Компонента.ИсторияВызовов()).ИмеетДлину(0);
	ПроверитьФабрику(0);

КонецПроцедуры

// Проверяет повторное создание консьюмера после неуспешной инициализации.
Процедура Прочитать_ПовторяетСозданиеПослеОтказа() Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ИнициализироватьКонсьюмера", Ложь);
	Консьюмер = кфк_т_ТестовыеДанные.СсылкаКонсьюмераСправочника();
	Настройки = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмера(Консьюмер);
	Сессии = Новый Соответствие;

