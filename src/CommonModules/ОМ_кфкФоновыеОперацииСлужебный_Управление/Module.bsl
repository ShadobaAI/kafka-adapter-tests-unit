// Исполняет тестовое задание по межсеансовому сигналу; не регистрируется как тест.
// Параметры:
//  Сигнал - УникальныйИдентификатор - Собственный идентификатор барьера.
//  Авария - Булево - Внедрить аварийное завершение до удаления назначения.
//  ПрежнийПоток - Неопределено, УникальныйИдентификатор - Остаток отменённого задания.
Процедура ют_ЗавершитьНазначениеПоСигналу(Сигнал, Авария, ПрежнийПоток) Экспорт

	ЗаписатьСигнал(Сигнал, "ют_Старт");
	ОжидатьСигнал(Сигнал, "ют_Разрешение");
	Если Авария Тогда
		ВызватьИсключение "Управляемая авария тестового фонового задания";
	КонецЕсли;
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Поток = Задание.УникальныйИдентификатор;
	Если ПрежнийПоток <> Неопределено Тогда
		Поток = ПрежнийПоток;
	КонецЕсли;
	УдалитьНазначенияСтенда(Поток);
	ЗаписатьСигнал(Сигнал, "ют_Завершение");

КонецПроцедуры
// Сбрасывает подмены и восстанавливает данные сценария с записью вне транзакции.
Процедура ПослеПроверкиНастроек() Экспорт

	Мокито.Сбросить();

	Контекст = ЮТест.КонтекстТеста(); // Структура
	ПозицияДоПроверки = РегистрыСведений.кфкПозицииОпераций.СоздатьНаборЗаписей();
	Если Контекст.Свойство("ПозицияДоПроверки", ПозицияДоПроверки) Тогда

		ПозицияДоПроверки.Записать();
		БлокировкаДоПроверки = Ложь;
		Контекст.Свойство("БлокировкаДоПроверки", БлокировкаДоПроверки);
		Константы.кфкБлокировкаИнтеграции.Установить(БлокировкаДоПроверки);

	КонецЕсли;

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает независимые флаги запуска.
// Параметры:
//  Сериализация - Булево - Флаг сериализации.
//  Десериализация - Булево - Флаг десериализации.
//  Выгрузка - Булево - Флаг отправки.
//  Загрузка - Булево - Флаг чтения.
// Возвращаемое значение:
//  Структура:
//   * Сериализация - Булево
//   * Десериализация - Булево
//   * Выгрузка - Булево
//   * Загрузка - Булево
Функция ФактЗапуска(Сериализация, Десериализация, Выгрузка, Загрузка)

	Результат = Новый Структура;
	Результат.Вставить("Сериализация", Сериализация);
	Результат.Вставить("Десериализация", Десериализация);
	Результат.Вставить("Выгрузка", Выгрузка);
	Результат.Вставить("Загрузка", Загрузка);
	Возврат Результат;

КонецФункции
// Записывает настройки через штатный API; справочник повторно использует ссылку текущего теста.
// Параметры:
//  ВидНастроек - Строка - имя отслеживаемого объекта метаданных.
//  Группа - Булево - создать диспетчер задач вместо элемента.
Процедура ЗаписатьНастройкиДляПроверки(ВидНастроек, Группа)

	Если Метаданные.Справочники.Найти(ВидНастроек) <> Неопределено Тогда

		Контекст = ЮТест.КонтекстТеста(); // Структура
		Если Не Контекст.Свойство("СсылкаНастроек") Тогда

			МенеджерСправочника = Справочники[ВидНастроек]; // СправочникМенеджер
			Если Группа Тогда

				СсылкаГруппы = ЮТест.Данные().СоздатьГруппу(
					МенеджерСправочника, "Диспетчер записи настроек"); // СправочникСсылка
				Контекст.Вставить("СсылкаНастроек", СсылкаГруппы);

			Иначе

				СсылкаЭлемента = ЮТест.Данные().СоздатьЭлемент(
					МенеджерСправочника, "Проверка записи настроек"); // СправочникСсылка
				Контекст.Вставить("СсылкаНастроек", СсылкаЭлемента);

			КонецЕсли;

		КонецЕсли;
		СсылкаНастроек = Контекст.СсылкаНастроек; // СправочникСсылка
		ОбъектНастроек = СсылкаНастроек.ПолучитьОбъект();
		ОбъектНастроек.Записать();
		Возврат;

	КонецЕсли;

	Если Метаданные.Константы.Найти(ВидНастроек) <> Неопределено Тогда

		МенеджерЗначения = Константы[ВидНастроек].СоздатьМенеджерЗначения(); // КонстантаМенеджерЗначения
		МенеджерЗначения.Прочитать();
		МенеджерЗначения.Записать();
		Возврат;

	КонецЕсли;

	НаборНастроек = РегистрыСведений[ВидНастроек].СоздатьНаборЗаписей(); // РегистрСведенийНаборЗаписей
	НаборНастроек.Прочитать();
	НаборНастроек.Записать();

КонецПроцедуры
// Возвращает два задания в обратном порядке возраста, чтобы проверить выбор самого старого.
// Параметры:
//  ВозрастСтарогоПотока - Число - секунды после старта старого задания.
//  ВозрастНовогоПотока - Число - секунды после старта нового задания.
//  ЕстьПотоки - Булево - заполнить коллекцию заданий.
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Дата - местное время старта задания.
Функция НовыеПотокиДляПроверки(ВозрастСтарогоПотока, ВозрастНовогоПотока, ЕстьПотоки)

	Потоки = Новый Массив; // Массив из Структура
	Если Не ЕстьПотоки Тогда
		Возврат Потоки;
	КонецЕсли;

	ВремяПодготовки = ТекущаяУниверсальнаяДата();
	Потоки.Добавить(Новый Структура("Начало", МестноеВремя(ВремяПодготовки - ВозрастНовогоПотока)));
	Потоки.Добавить(Новый Структура("Начало", МестноеВремя(ВремяПодготовки - ВозрастСтарогоПотока)));

	Возврат Потоки;

КонецФункции
// Изолирует платформенные задания; метка и общая блокировка остаются реальными данными базы.
// Параметры:
//  ВозрастЗаписи - Число - секунды после записи настроек.
//  Потоки - Массив из Структура - ответы границы заданий с полем Начало типа Дата.
//  ЕстьМетка - Булево - подготовить ненулевую метку записи.
Процедура ПодготовитьПроверкуПерезапуска(ВозрастЗаписи, Потоки, ЕстьМетка)

	Мокито.Сбросить();
	Константы.кфкБлокировкаИнтеграции.Установить(Ложь);
	ОбновитьПовторноИспользуемыеЗначения();
	ЮТест.КонтекстТеста().Вставить("КонтрольПерезапускаНастроек", Истина);

	Метка = 0;
	Если ЕстьМетка Тогда

		МиллисекундВСекунде = 1000;
		// Целая секунда исключает округление миллисекунд при проверке границы минутного интервала.
		ВремяПодготовки = Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / МиллисекундВСекунде);
		ВремяЗаписи = (ВремяПодготовки - ВозрастЗаписи) * МиллисекундВСекунде;
		Метка = кфкОбщегоНазначенияСлужебный.ГраничнаяКомбинированнаяМетка(ВремяЗаписи);

	КонецЕсли;
	Идентификатор = кфкФоновыеОперацииСлужебный.ют_ИДОперацииИзмененияНастроек();
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, Метка);

	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ПолучитьПотоки")
			.Вернуть(Потоки)
		.Когда("ОжидатьЗавершенияВыполнения")
			.Вернуть(Неопределено);
	Мокито.Прогон();

КонецПроцедуры

// Параметры:
//  Операции - СписокЗначений Из Строка - Проверяемый состав.
//  Ожидаемые - Строка - Имена операций через точку с запятой.
Процедура ПроверитьОперации(Операции, Ожидаемые)

	Эталон = СтрРазделить(Ожидаемые, ";");
	ЮТест.ОжидаетЧто(Операции.Количество()).Равно(Эталон.Количество());
	Для Индекс = 0 По Эталон.ВГраница() Цикл
		ЮТест.ОжидаетЧто(Операции[Индекс].Значение).Равно(Эталон[Индекс]);
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  СправочникСсылка.кфкКонсьюмеры - Собственный идентификатор для алгоритма в памяти.
Функция НоваяСсылкаКонсьюмера()

	Возврат Справочники.кфкКонсьюмеры.ПолучитьСсылку(Новый УникальныйИдентификатор);

КонецФункции
// Возвращает таблицу адресатов и независимых блокировок.
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Ссылка - СправочникСсылка - Диспетчер выбранного направления.
//   * Настройка - СправочникСсылка - Конкретная настройка направления.
//   * БлокироватьОбработку - Булево
//   * БлокироватьТранспорт - Булево
Функция НоваяТаблицаНастроекДиспетчера()

	Результат = Новый ТаблицаЗначений;
	ТипНастройки = Новый ОписаниеТипов("СправочникСсылка.кфкПродюсеры,СправочникСсылка.кфкКонсьюмеры");
	Результат.Колонки.Добавить("Ссылка", ТипНастройки);
	Результат.Колонки.Добавить("Настройка", ТипНастройки);
	Результат.Колонки.Добавить("БлокироватьОбработку", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("БлокироватьТранспорт", Новый ОписаниеТипов("Булево"));
	Возврат Результат;

КонецФункции
// Возвращает собственные назначения двух консьюмеров.
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Консьюмер - СправочникСсылка.кфкКонсьюмеры - Получатель.
//   * НомерПотока - Число - Индекс активного потока.
Функция НовоеРаспределениеКонсьюмеров()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Консьюмер", Новый ОписаниеТипов("СправочникСсылка.кфкКонсьюмеры"));
	Результат.Колонки.Добавить("НомерПотока", Новый ОписаниеТипов("Число"));
	Возврат Результат;

КонецФункции
// Параметры:
//  Поток - УникальныйИдентификатор - Владелец назначения.
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры - Ключ настройки.
//  ЕстьНазначение - Булево - Ожидаемое наличие.
Процедура ПроверитьКонсьюмераВОчереди(Поток, Консьюмер, ЕстьНазначение)

	Предикат = ЮТест.Предикат()
		.Реквизит("ИдентификаторПотока").Равно(Поток)
		.Реквизит("Ключ").Равно(XMLСтрока(Консьюмер));
	Если ЕстьНазначение Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").СодержитЗаписи(Предикат);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);
	КонецЕсли;

КонецПроцедуры
// Возвращает типизированный идентификатор настройки для алгоритма без чтения объекта.
// Параметры:
//  Продюсер - Булево - Исходящее направление.
//  Идентификатор - УникальныйИдентификатор - Собственный идентификатор.
// Возвращаемое значение:
//  СправочникСсылка - Ссылка настройки выбранного направления.
Функция СсылкаНастройкиНаправления(Продюсер, Идентификатор)

	Если Продюсер Тогда
		Возврат Справочники.кфкПродюсеры.ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Возврат Справочники.кфкКонсьюмеры.ПолучитьСсылку(Идентификатор);

КонецФункции

// Параметры:
//  Статистика - см. кфкФоновыеОперацииСлужебный.ют_НоваяСтатистикаРаспределенияЧтения
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры - Владелец нагрузки.
//  СреднийРазмер - Число - Нагрузка на партицию.
//  Партиций - Число - Число партиций.
Процедура ДобавитьНагрузку(Статистика, Консьюмер, СреднийРазмер, Партиций)

	СтрокаСтатистики = Статистика.Добавить();
	СтрокаСтатистики.Консьюмер = Консьюмер;
	СтрокаСтатистики.Партиций = Партиций;
	СтрокаСтатистики.СредРазмер = СреднийРазмер;
	СтрокаСтатистики.РазмерОчереди = СреднийРазмер * Партиций;

КонецПроцедуры
// Возвращает только наблюдаемые поля задания, не создавая фонового сеанса.
// Параметры:
//  Состояние - СостояниеФоновогоЗадания - Состояние снимка.
// Возвращаемое значение:
//  Структура:
//   * УникальныйИдентификатор - УникальныйИдентификатор - Уникальный поток теста.
//   * Состояние - СостояниеФоновогоЗадания - Состояние задания.
//   * ИнформацияОбОшибке - Неопределено - У успешно запущенного снимка ошибки нет.
Функция НовыйСнимокФоновогоЗадания(Состояние)

	Снимок = Новый Структура;
	Снимок.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
	Снимок.Вставить("Состояние", Состояние);
	Снимок.Вставить("ИнформацияОбОшибке", Неопределено);

	Возврат Снимок;

КонецФункции

// Возвращает реальное задание с собственным ключом тестового запуска.
// Параметры:
//  Сигнал - УникальныйИдентификатор - Ключ барьера.
//  Авария - Булево - Сбой после разрешения.
//  ПрежнийПоток - Неопределено, УникальныйИдентификатор - Остаток прерванного задания.
// Возвращаемое значение:
//  ФоновоеЗадание - Реальный worker.
Функция ЗапуститьТестовоеЗадание(Сигнал, Авария, ПрежнийПоток = Неопределено)

	Аргументы = ЮТМетоды.МассивПараметров(Сигнал, Авария, ПрежнийПоток);
	Возврат кфкФоновыеОперацииСлужебный.ют_ЗапуститьФЗ(
		"ют_" + Строка(Сигнал),
		"ОМ_кфкФоновыеОперацииСлужебный_Управление.ют_ЗавершитьНазначениеПоСигналу",
		"Проверка жизненного цикла фонового задания", Аргументы);

КонецФункции
// Параметры:
//  Сигнал - УникальныйИдентификатор - UUID текущего теста.
//  Раздел - Строка - Имя сигнала с префиксом ют_.
Процедура ЗаписатьСигнал(Сигнал, Раздел)

	Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Сигнал;
	Запись.Раздел = Раздел;
	Запись.РазделПредставление = "Межсеансовый барьер теста";
	Запись.КомбинированнаяМетка = 1;
	Запись.Записать();

КонецПроцедуры
// Ожидает конкретный барьер с конечным сроком, не подменяя порядок случайной паузой.
// Параметры:
//  Сигнал - УникальныйИдентификатор - UUID текущего теста.
//  Раздел - Строка - Ожидаемый этап worker.
//  Задание - Неопределено, ФоновоеЗадание - Задание, сигнал которого ожидает тестовый сеанс.
Процедура ОжидатьСигнал(Сигнал, Раздел, Задание = Неопределено)

	Срок = ТекущаяУниверсальнаяДата() + 30;
	Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
	Пока ТекущаяУниверсальнаяДата() < Срок Цикл

		Запись.Идентификатор = Сигнал;
		Запись.Раздел = Раздел;
		Запись.Прочитать();
		Если Запись.КомбинированнаяМетка = 1 Тогда
			Возврат;
		КонецЕсли;
		Если Задание = Неопределено Тогда
			кфкОбщегоНазначенияСлужебный.Пауза(100);
		Иначе
			Задание = Задание.ОжидатьЗавершенияВыполнения(1);
			Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	Если Задание <> Неопределено Тогда
		ЮТест.ОжидаетЧто(Задание.Состояние, "Фоновое задание не передало сигнал " + Раздел)
			.Равно(СостояниеФоновогоЗадания.Активно);
	КонецЕсли;
	ВызватьИсключение "Не получен межсеансовый сигнал теста: " + Раздел;

КонецПроцедуры





// Параметры:
//  Сигнал - УникальныйИдентификатор - Собственный UUID тестового запуска.
Процедура СброситьСигналы(Сигнал)

	Набор = РегистрыСведений.кфкПозицииОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.Идентификатор.Установить(Сигнал);
	Набор.Записать();

КонецПроцедуры
// Параметры:
//  Задание - ФоновоеЗадание, Структура - Получатель пакета, см. НовыйСнимокФоновогоЗадания.
//  Указатели - см. кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков
//  Метка - Число - Временная метка пакета.
Процедура ДобавитьНазначениеСтенда(Задание, Указатели, Метка)

	Запись = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторПотока = Задание.УникальныйИдентификатор;
	Запись.Ключ = "ют_" + Строка(Задание.УникальныйИдентификатор);
	Запись.КомбинированнаяМетка = Метка;
	Запись.Записать();
	Указатель = Указатели.Добавить();
	Указатель.ИдентификаторПотока = Задание.УникальныйИдентификатор;
	Указатель.СтатусПотока = 0;
	Указатель.КомбинированнаяМетка = Метка;

КонецПроцедуры
// Параметры:
//  Поток - УникальныйИдентификатор - Собственный worker.
Процедура УдалитьНазначенияСтенда(Поток)

	Набор = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторПотока.Установить(Поток);
	Набор.Записать();

КонецПроцедуры
// Параметры:
//  Поток - УникальныйИдентификатор - Владелец назначения.
//  ЕстьНазначение - Булево - Ожидаемое наличие остатка.
Процедура ПроверитьНазначениеСтенда(Поток, ЕстьНазначение)

	Предикат = ЮТест.Предикат().Реквизит("ИдентификаторПотока").Равно(Поток);
	Если ЕстьНазначение Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").СодержитЗаписи(Предикат);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);
	КонецЕсли;

КонецПроцедуры
// Параметры:
//  Операция - УникальныйИдентификатор - UUID позиции.
//  Позиция - Число - Ожидаемая сохранённая граница.
Процедура ПроверитьПозициюСтенда(Операция, Позиция)

	Предикат = ЮТест.Предикат()
		.Реквизит("Идентификатор").Равно(Операция)
		.Реквизит("Раздел").Равно("ют_ПозицияСтенда")
		.Реквизит("КомбинированнаяМетка").Равно(Позиция);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций").СодержитЗаписи(Предикат);

КонецПроцедуры
// Останавливает собственные задания до удаления их очереди и сигналов.
// Параметры:
//  Задания - Массив Из ФоновоеЗадание - Workers текущего теста.
//  Сигналы - Массив Из УникальныйИдентификатор - Собственные UUID сигналов и позиции.
Процедура ОчиститьСтендЗаданий(Задания, Сигналы)

	Для Каждого Задание Из Задания Цикл
		Текущее = Задание.ОжидатьЗавершенияВыполнения(1);
		Если Текущее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Текущее.Отменить();
			ТаймаутОтмены = 60;
			Текущее = Текущее.ОжидатьЗавершенияВыполнения(ТаймаутОтмены);
		КонецЕсли;
		Если Текущее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ВызватьИсключение "Тестовое фоновое задание не остановилось; очистка остановлена";
		КонецЕсли;
		УдалитьНазначенияСтенда(Текущее.УникальныйИдентификатор);
	КонецЦикла;
	Для Каждого Сигнал Из Сигналы Цикл
		СброситьСигналы(Сигнал);
	КонецЦикла;

КонецПроцедуры


// Параметры:
//  ВнешняяБлокировка - Булево - Ответ границы проверки внешних ресурсов.
//  ИспользоватьИнтеграцию - Булево - Значение функциональной опции.
//  Отмен - Число - Ожидаемое количество отмен.
//  Запусков - Число - Ожидаемое количество запусков потоков.
//  ИспользованиеПосле - Булево - Ожидаемый сохраненный флаг задания.
//  БлокировкаИнтеграции - Булево - Значение опции блокировки запуска потоков.
Процедура ПроверитьЗащитуРегламентногоЗадания(
		ВнешняяБлокировка, ИспользоватьИнтеграцию, Отмен, Запусков, ИспользованиеПосле,
		БлокировкаИнтеграции = Ложь)

	Состояние = СостояниеПередЗащитойРегламентногоЗадания();
	Попытка
		Мокито.Сбросить();
		Мокито.Обучение(БлокировкаРаботыСВнешнимиРесурсами)
			.Когда("РаботаСВнешнимиРесурсамиЗаблокирована")
				.Вернуть(ВнешняяБлокировка);
		Мокито.Обучение(РегламентныеЗаданияСервер)
			.Когда("ОтменитьВыполнениеЗадания")
				.Вернуть(Неопределено);
		Мокито.Обучение(кфкФоновыеОперацииСлужебный)
			.Когда("ЗапуститьПотоки")
				.Вернуть(Неопределено);
		Мокито.Прогон();

		ПодготовитьРегламентноеЗаданиеДляЗащиты(Состояние, ИспользоватьИнтеграцию, БлокировкаИнтеграции);
		Если Отмен = 0 Тогда

			ЮТест.ОжидаетЧто(кфкФоновыеОперацииСлужебный)
				.Метод("ЗапуститьРегламентноеЗадание")
					.НеВыбрасываетИсключение();

		Иначе

			ЮТест.ОжидаетЧто(кфкФоновыеОперацииСлужебный)
				.Метод("ЗапуститьРегламентноеЗадание")
					.ВыбрасываетИсключение("");

		КонецЕсли;

		Мокито.Проверить(БлокировкаРаботыСВнешнимиРесурсами)
			.КоличествоВызовов("РаботаСВнешнимиРесурсамиЗаблокирована").Равно(1);
		Мокито.Проверить(кфкФоновыеОперацииСлужебный)
			.КоличествоВызовов("ЗапуститьПотоки").Равно(Запусков);
		Мокито.Проверить(РегламентныеЗаданияСервер)
			.КоличествоВызовов("ОтменитьВыполнениеЗадания").Равно(Отмен);

		АргументыОтмены = ЮТМетоды.МассивПараметров(
			Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции, Мокито.ЛюбойПараметр()); // Массив из Произвольный
		Мокито.Проверить(РегламентныеЗаданияСервер)
			.КоличествоВызовов("ОтменитьВыполнениеЗадания", АргументыОтмены).Равно(Отмен);

		СохраненноеЗадание = СохраненноеЗаданиеДляЗащиты(Состояние.ТестовоеЗадание.УникальныйИдентификатор);
		ЮТест.ОжидаетЧто(СохраненноеЗадание.Использование, "Сохраненное использование после запуска")
			.Равно(ИспользованиеПосле);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ОшибкиОчистки = ВосстановитьСостояниеПослеЗащитыРегламентногоЗадания(Состояние);
		Если ОшибкиОчистки <> "" Тогда

			ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИсходнаяОшибка)
				+ Символы.ПС + ОшибкиОчистки;

		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	ОшибкиОчистки = ВосстановитьСостояниеПослеЗащитыРегламентногоЗадания(Состояние);
	ЮТест.ОжидаетЧто(ОшибкиОчистки, "Восстановление состояния регламентного задания").Равно("");

КонецПроцедуры

// Возвращаемое значение:
//  Структура:
//   * Задания - Массив из см. СнимокРегламентногоЗаданияДляЗащиты - Исходные экземпляры.
//   * ТестовоеЗадание - РегламентноеЗадание, Неопределено - Экземпляр под проверкой.
//   * СозданоЗадание - Булево - Требуется удалить созданный экземпляр.
//   * ИспользоватьИнтеграцию - Булево - Исходное значение константы.
//   * БлокировкаИнтеграции - Булево - Исходное значение константы.
//   * ПараметрыБлокировки - ХранилищеЗначения - Исходная константа БСП.
//   * РазрешениеЗапуска - ХранилищеЗначения - Снимок исходной системной настройки.
//   * ОписаниеРазрешения - Строка, Неопределено - Описание системной настройки.
Функция СостояниеПередЗащитойРегламентногоЗадания()

	Состояние = Новый Структура;
	СнимкиЗаданий = Новый Массив; // Массив из см. СнимокРегламентногоЗаданияДляЗащиты
	Состояние.Вставить("Задания", СнимкиЗаданий);
	Состояние.Вставить("ТестовоеЗадание", Неопределено);
	Состояние.Вставить("СозданоЗадание", Ложь);
	Состояние.Вставить("ИспользоватьИнтеграцию", Константы.кфкИспользоватьИнтеграцию.Получить());
	Состояние.Вставить("БлокировкаИнтеграции", Константы.кфкБлокировкаИнтеграции.Получить());
	Состояние.Вставить("ПараметрыБлокировки", Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами.Получить());

	ОписаниеРазрешения = Неопределено; // Строка, Неопределено
	ИмяМетода = Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции.ИмяМетода;
	Разрешение = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
		"РегламентныеЗадания", ИмяМетода, Неопределено, ОписаниеРазрешения);
	Состояние.Вставить("РазрешениеЗапуска", Новый ХранилищеЗначения(Разрешение));
	Состояние.Вставить("ОписаниеРазрешения", ОписаниеРазрешения);

	Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции);
	Задания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);
	Для Каждого Задание Из Задания Цикл
		СнимкиЗаданий.Добавить(СнимокРегламентногоЗаданияДляЗащиты(Задание));
	КонецЦикла;

	Возврат Состояние;

КонецФункции

// Параметры:
//  Задание - РегламентноеЗадание - Исходный экземпляр.
// Возвращаемое значение:
//  Структура:
//   * Задание - РегламентноеЗадание - Экземпляр для восстановления.
//   * Использование - Булево - Исходный флаг.
//   * Расписание - РасписаниеРегламентногоЗадания - Исходное расписание.
Функция СнимокРегламентногоЗаданияДляЗащиты(Задание)

	Возврат Новый Структура("Задание, Использование, Расписание",
		Задание, Задание.Использование, Задание.Расписание);

КонецФункции

// Параметры:
//  Состояние - см. СостояниеПередЗащитойРегламентногоЗадания - Снимок для очистки.
//  ИспользоватьИнтеграцию - Булево - Значение опции сценария.
//  БлокировкаИнтеграции - Булево - Значение опции блокировки запуска потоков.
Процедура ПодготовитьРегламентноеЗаданиеДляЗащиты(
		Состояние, ИспользоватьИнтеграцию, БлокировкаИнтеграции = Ложь)

	// Прошедший срок расписания исключает запуск планировщиком даже при Использование = Истина.
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = Дата(2000, 1, 1);
	Расписание.ДатаКонца = Расписание.ДатаНачала;
	Для Каждого Снимок Из Состояние.Задания Цикл

		Снимок.Задание.Расписание = Расписание;
		Снимок.Задание.Записать();

	КонецЦикла;

	Состояние.СозданоЗадание = Состояние.Задания.Количество() = 0;
	Состояние.ТестовоеЗадание = кфкФоновыеОперацииСлужебный.РегламентноеЗадание();
	Состояние.ТестовоеЗадание.Расписание = Расписание;
	Состояние.ТестовоеЗадание.Использование = Истина;
	Состояние.ТестовоеЗадание.Записать();

	// Системное разрешение Истина обходит реальную проверку внешней блокировки.
	ИмяМетода = Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции.ИмяМетода;
	ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить("РегламентныеЗадания", ИмяМетода, Ложь);
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить("РегламентныеЗадания", ИмяМетода))
		.Равно(Ложь);

	// Не позволяем ленивой инициализации БСП создать файл проверки файловой базы.
	Если Состояние.ПараметрыБлокировки.Получить() = Неопределено Тогда
		Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами.Установить(Новый ХранилищеЗначения(Новый Структура));
	КонецЕсли;
	Константы.кфкБлокировкаИнтеграции.Установить(БлокировкаИнтеграции);
	Константы.кфкИспользоватьИнтеграцию.Установить(ИспользоватьИнтеграцию);
	ОбновитьПовторноИспользуемыеЗначения();

	СохраненноеЗадание = СохраненноеЗаданиеДляЗащиты(Состояние.ТестовоеЗадание.УникальныйИдентификатор);
	ЮТест.ОжидаетЧто(СохраненноеЗадание.Использование, "До вызова задание сохранено включенным").Равно(Истина);
	ЮТест.ОжидаетЧто(СохраненноеЗадание.Расписание.ДатаКонца).Равно(Расписание.ДатаКонца);
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции")).Равно(БлокировкаИнтеграции);
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию")).Равно(ИспользоватьИнтеграцию);

КонецПроцедуры

// Параметры:
//  Идентификатор - УникальныйИдентификатор - Идентификатор сохраненного экземпляра.
// Возвращаемое значение:
//  РегламентноеЗадание - Заново прочитанный экземпляр.
Функция СохраненноеЗаданиеДляЗащиты(Идентификатор)

	Задания = РегламентныеЗаданияСервер.НайтиЗадания(Новый Структура("УникальныйИдентификатор", Идентификатор));
	ЮТест.ОжидаетЧто(Задания.Количество(), "Сохраненный экземпляр существует").Равно(1);
	Возврат Задания[0];

КонецФункции

// Параметры:
//  Состояние - см. СостояниеПередЗащитойРегламентногоЗадания - Снимок до изменений.
// Возвращаемое значение:
//  Строка - Все ошибки очистки; пустая строка при успешном восстановлении.
Функция ВосстановитьСостояниеПослеЗащитыРегламентногоЗадания(Состояние)

	// Ошибка одного действия не должна препятствовать остальной очистке.
	Ошибки = Новый Массив; // Массив из Строка
	Попытка
		Мокито.Сбросить();
	Исключение
		Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Для Каждого Снимок Из Состояние.Задания Цикл

		Попытка
			// Проверяемый код записывает другой экземпляр и меняет версию записи.
			Задание = СохраненноеЗаданиеДляЗащиты(Снимок.Задание.УникальныйИдентификатор);
			Задание.Использование = Снимок.Использование;
			Задание.Расписание = Снимок.Расписание;
			Задание.Записать();
		Исключение
			Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Если Состояние.СозданоЗадание И Состояние.ТестовоеЗадание <> Неопределено Тогда

		Попытка
			Задание = СохраненноеЗаданиеДляЗащиты(Состояние.ТестовоеЗадание.УникальныйИдентификатор);
			Задание.Удалить();
		Исключение
			Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЕсли;

	Попытка
		Константы.кфкИспользоватьИнтеграцию.Установить(Состояние.ИспользоватьИнтеграцию);
	Исключение
		Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Константы.кфкБлокировкаИнтеграции.Установить(Состояние.БлокировкаИнтеграции);
	Исключение
		Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами.Установить(Состояние.ПараметрыБлокировки);
	Исключение
		Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ИмяМетода = Метаданные.РегламентныеЗадания.кфкЗапускИнтеграции.ИмяМетода;
		РазрешениеЗапуска = Состояние.РазрешениеЗапуска.Получить();
		Если РазрешениеЗапуска = Неопределено Тогда

			ОбщегоНазначения.ХранилищеСистемныхНастроекУдалить("РегламентныеЗадания", ИмяМетода, Неопределено);

		Иначе

			ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить(
				"РегламентныеЗадания", ИмяМетода, РазрешениеЗапуска, Состояние.ОписаниеРазрешения);

		КонецЕсли;
	Исключение
		Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОбновитьПовторноИспользуемыеЗначения();

	Возврат СтрСоединить(Ошибки, Символы.ПС);

КонецФункции

#Область ПроверкиДиспетчера

// Регистрирует серверные проверки потери рабочего задания.
Процедура ЗарегистрироватьПроверкиДиспетчера()

	ЮТТесты
		.ДобавитьТестовыйНабор("Общий модуль кфкФоновыеОперацииСлужебный. Потеря рабочего задания")
			.Тег("CI")
			.Тег("ОбщийМодуль")
			.Тег("Модульные")
			.Тег("Компонентные")
			.Тег("кфкФоновыеОперацииСлужебный")
			.После("СброситьПодменуДиспетчера")
			.ДобавитьСерверныйТест("ОтправкаСообщенийВКафку_НеТеряетСообщениеПриИсчезновенииПотока")
				.Тег("ОтправкаСообщенийВКафку")
			.ДобавитьСерверныйТест("ДесериализацияСообщений_НеТеряетСообщениеПриИсчезновенииПотока")
				.Тег("ДесериализацияСообщений");

	ЮТТесты
		.ДобавитьТестовыйНабор("Общий модуль кфкФоновыеОперацииСлужебный. Сквозные циклы обмена")
			.Тег("CI")
			.Тег("ОбщийМодуль")
			.Тег("Модульные")
			.Тег("Компонентные")
			.Тег("кфкФоновыеОперацииСлужебный")
			.После("ЗавершитьСценарийОбмена")
			.ДобавитьСерверныйТест("ИсходящийЦикл_ВозобновляетОбменБезПовторнойОтправки")
				.Тег("СериализацияСообщений")
				.Тег("ОтправкаСообщенийВКафку")
			.ДобавитьСерверныйТест("ЗагрузкаСообщенийИзКафки_ПродолжаетЧтениеПослеСменыНазначения")
				.Тег("ЗагрузкаСообщенийИзКафки");

КонецПроцедуры

// Эмулирует исчезновение задания после подтверждения запуска платформой.
Процедура ПодготовитьИсчезновениеРабочегоПотока()

	// Диспетчер завершает текущую итерацию после запроса остановки обмена.
	Константы.кфкБлокировкаИнтеграции.Установить(Истина);
	ОбновитьПовторноИспользуемыеЗначения();
	РабочийПоток = НовыйСнимокФоновогоЗадания(СостояниеФоновогоЗадания.Активно);

	Мокито.Сбросить();
	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ют_ПолучитьФоновыеЗадания")
			.Вернуть(Новый Массив)
		.Когда("ют_ВыполнитьФоновоеЗадание")
			.Вернуть(РабочийПоток);
	Мокито.Прогон();

КонецПроцедуры

// Формирует адрес диспетчера. Уникальный ключ исключает совпадение с заданиями стенда.
//
// Параметры:
//	ИмяМетода - Строка - Полное имя операции.
//
// Возвращаемое значение:
//	Структура - Описание диспетчера:
// * Ключ - Строка - Ключ сценарного задания.
// * ИмяМетода - Строка - Имя операции диспетчера.
// * Наименование - Строка - Представление задания.
Функция НовоеОписаниеДиспетчера(ИмяМетода)

	Ключ = "ют_" + Строка(Новый УникальныйИдентификатор);
	Возврат Новый Структура("Ключ,ИмяМетода,Наименование", Ключ, ИмяМетода, "Проверка остановки");

КонецФункции

// Проверяет, что сообщение снова доступно для назначения и позиция не продвинулась.
//
// Параметры:
//	Ключ - Строка - Ключ сообщения.
//	Раздел - Строка - Идентификатор группы настроек диспетчера.
Процедура ПроверитьНезавершеннуюРаботуДиспетчера(Ключ, Раздел)

	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ют_ВыполнитьФоновоеЗадание").Равно(1);
	Предикат = ЮТест.Предикат().Реквизит("Ключ").Равно(Ключ);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);
	Предикат = ЮТест.Предикат()
		.Реквизит("Раздел").Равно(Раздел)
		.Реквизит("КомбинированнаяМетка").Больше(0);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций").НеСодержитЗаписи(Предикат);

КонецПроцедуры

#КонецОбласти

#Область ПодготовкаСквозныхЦиклов

// Готовит существующую тестовую Kafka-компоненту и состояние платформенного задания.
//
// Возвращаемое значение:
//	Структура - Состояние одного теста:
//	 * Компонента - ОбработкаОбъект.ют_КомпонентаKafkaДляТестов - Транспорт на внешней границе.
//	 * Поток - Структура - см. НовыйСнимокФоновогоЗадания
//	 * МетодПотока - Строка - Назначенный метод рабочего потока.
//	 * Исполнен - Булево - Плановое задание выполнено в текущем сеансе.
//	 * Остановить - Булево - Остановить обмен после назначения, до работы с данными.
//	 * ВРабочемПотоке - Булево - Исполняется назначенный метод.
//	 * Топик - Строка - Сценарный топик входящего цикла.
//	 * Оставшийся - СправочникСсылка.кфкКонсьюмеры - Сохраняет назначение.
//	 * Удаляемый - СправочникСсылка.кфкКонсьюмеры - Снимается с текущего потока.
//	 * СохраненнаяСессия - ОбработкаОбъект.кфкИнтеграция - Сессия оставшегося консьюмера.
//	 * ПрочитаноПорций - Число - Завершённые итерации потока чтения.
Функция НовыйСценарийОбмена()

	Компонента = Обработки.ют_КомпонентаKafkaДляТестов.Создать();
	Компонента.НастроитьОтвет("ПолучитьСообщениеОбОшибке", "");
	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_КомпонентаKafka", Компонента);
	Контекст.Вставить("ют_ВызовыФабрикиKafka", Новый Массив);
	Сценарий = Новый Структура;
	Сценарий.Вставить("Компонента", Компонента);
	Сценарий.Вставить("Поток", Неопределено);
	Сценарий.Вставить("ВРабочемПотоке", Ложь);
	Контекст.Вставить("ют_ФоновыйЦиклОбмена", Сценарий);

	Константы.кфкБлокировкаИнтеграции.Установить(Ложь);
	ОбновитьПовторноИспользуемыеЗначения();

	Возврат Сценарий;

КонецФункции

// Запускает штатный диспетчер с подменой платформенного создания одного задания.
//
// Параметры:
//	Сценарий - см. НовыйСценарийОбмена
//	ИмяОперации - Строка - Экспортная операция диспетчера.
//	Настройки - Массив Из СправочникСсылка.кфкПродюсеры, СправочникСсылка.кфкКонсьюмеры
//	Остановить - Булево - Установить блокировку после выдачи назначения.
Процедура ВыполнитьДиспетчерЦикла(Сценарий, ИмяОперации, Настройки, Остановить = Ложь)

	Операция = НовоеОписаниеДиспетчера("кфкФоновыеОперацииСлужебный." + ИмяОперации);
	Сценарий.Вставить("Поток", НовыйСнимокФоновогоЗадания(СостояниеФоновогоЗадания.Активно));
	Сценарий.Вставить("МетодПотока", Операция.ИмяМетода + "ВПотоке");
	Сценарий.Вставить("Исполнен", Ложь);
	Сценарий.Вставить("ВРабочемПотоке", Ложь);
	Сценарий.Вставить("Остановить", Остановить);
	Мокито.Сбросить();
	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ют_ПолучитьФоновыеЗадания")
			.Вернуть(Новый Массив)
		.Когда("ют_ВыполнитьФоновоеЗадание")
			.Вернуть(Сценарий.Поток);
	Мокито.Прогон();

	Если ИмяОперации = "СериализацияСообщений" Тогда
		кфкФоновыеОперацииСлужебный.СериализацияСообщений(Операция, Настройки, 1, Истина);
	ИначеЕсли ИмяОперации = "ОтправкаСообщенийВКафку" Тогда
		кфкФоновыеОперацииСлужебный.ОтправкаСообщенийВКафку(Операция, Настройки, 1, Истина);
	Иначе
		кфкФоновыеОперацииСлужебный.ЗагрузкаСообщенийИзКафки(Операция, Настройки, 1, Истина);
	КонецЕсли;

	ЮТест.ОжидаетЧто(Сценарий.Исполнен, "Диспетчер передал работу в назначенный поток").Равно(Истина);

КонецПроцедуры

// Параметры:
//	ТипОбъекта - Строка - Полное имя типа регистрируемых данных.
//	Топик - Строка - Сценарный топик.
// Возвращаемое значение:
//	СправочникСсылка.кфкПродюсеры
Функция НовыйПродюсерЦикла(ТипОбъекта, Топик)

	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.кфкПродюсеры)
		.Установить("Наименование", "Отправка двух порций")
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.ТабличнаяЧасть("ОбъектыМетаданных")
			.ДобавитьСтроку()
				.Установить("ТипОбъект", ТипОбъекта)
				.Установить("ИмяТопика", Топик)
				.Установить("ТипСериализации", Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик)
				.Установить("ИмяМетодаСериализации", "ОМ_кфкФоновыеОперацииСлужебный_Отправка.ют_Сериализовать")
		.Записать(Ложь, Истина);

КонецФункции

// Параметры:
//	Топик - Строка - Сценарный топик, общий для независимых групп.
// Возвращаемое значение:
//	СправочникСсылка.кфкКонсьюмеры
Функция НовыйКонсьюмерЦикла(Топик)

	Идентификатор = "unit-group-" + Строка(Новый УникальныйИдентификатор);
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.кфкКонсьюмеры)
		.Установить("Наименование", Идентификатор)
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Установить("Идентификатор", Идентификатор)
		.ТабличнаяЧасть("Топики")
			.ДобавитьСтроку(Новый Структура("Топик", Топик))
		.Записать(Ложь, Истина);

КонецФункции

// Создаёт одну зарегистрированную прикладную запись для реальной сериализации.
//
// Параметры:
//	Продюсер - СправочникСсылка.кфкПродюсеры
//	ТипОбъекта - Строка - Тип регистрируемого объекта в настройках продюсера.
//	Тело - Строка - Полезная нагрузка порции.
// Возвращаемое значение:
//	РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
Функция ЗарегистрироватьПорциюЦикла(Продюсер, ТипОбъекта, Тело)

	Ключ = Строка(Новый УникальныйИдентификатор);
	Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
	Данные = Новый Структура("Исход,Ключ,Тело", "Успех", Ключ, Тело);
	Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
	Запись.КлючЗаписи = Ключ;
	Запись.МеткаРегистрации = Метка;
	Запись.МеткаИзменения = Метка;
	Запись.Продюсер = Продюсер;
	Запись.ТипОбъект = ТипОбъекта;
	Запись.КлючОбъекта = Ключ;
	Запись.ТипИсходныхДанных = "CatalogRef.кфкПродюсеры";
	Запись.Статус = Перечисления.кфкСтатусыСообщений.Новое;
	Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Данные);
	Запись.Записать();

	Возврат Запись;

КонецФункции

// Параметры:
//	Продюсеры - Массив Из СправочникСсылка.кфкПродюсеры
// Возвращаемое значение:
//	Число - Сохранённая позиция отправки для сценарной группы настроек.
Функция ПозицияОтправкиЦикла(Продюсеры)

	Раздел = кфкФоновыеОперацииСлужебный.ют_РазделОперации(Продюсеры);
	ИдентификаторОтправки = Новый УникальныйИдентификатор("00000000-0003-0000-0000-666666666666");
	Возврат РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(ИдентификаторОтправки, Раздел.Значение);

КонецФункции

// Параметры:
//	Запись - РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
//	Статус - ПеречислениеСсылка.кфкСтатусыСообщений
//	КоличествоВыгрузок - Число - Число подтверждённых отправок.
Процедура ПроверитьИсходящееЦикла(Запись, Статус, КоличествоВыгрузок)

	Запись.Прочитать();
	ЮТест.ОжидаетЧто(Запись.Статус, Запись.ТекстЖурнала).Равно(Статус);
	ЮТест.ОжидаетЧто(Запись.КоличествоВыгрузок).Равно(КоличествоВыгрузок);
	Предикат = ЮТест.Предикат()
		.Реквизит("Ключ").Равно(Запись.КлючЗаписи)
		.Реквизит("КомбинированнаяМетка").Равно(Запись.МеткаРегистрации);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);

КонецПроцедуры

// Параметры:
//	Аргументы - Массив Из Произвольный - Вызов компоненты отправки.
//	Топик - Строка - Сценарный топик.
//	Ключ - Строка - Ключ, назначенный прикладным сериализатором.
Процедура ПроверитьОтправленнуюПорциюЦикла(Аргументы, Топик, Ключ)

	ЮТест.ОжидаетЧто(Аргументы[1]).Равно(Топик);
	Сообщения = ОбщегоНазначения.JSONВЗначение(Аргументы[0], , Ложь); // Массив Из Структура
	ЮТест.ОжидаетЧто(Сообщения).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Сообщения[0].key).Равно(Ключ);

КонецПроцедуры

// Параметры:
//	Компонента - ОбработкаОбъект.ют_КомпонентаKafkaДляТестов
//	Метод - Строка - Операция внешней компоненты.
// Возвращаемое значение:
//	Массив Из Структура - Вызовы указанного метода в исходном порядке.
Функция ВызовыКомпонентыЦикла(Компонента, Метод)

	Вызовы = Новый Массив; // Массив Из Структура
	Для Каждого Вызов Из Компонента.ИсторияВызовов() Цикл
		Если Вызов.Метод = Метод Тогда
			Вызовы.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;

	Возврат Вызовы;

КонецФункции

// Параметры:
//	Сценарий - см. НовыйСценарийОбмена
//	Смещение - Число - Позиция сообщения в тестовой партиции.
Процедура НастроитьОтветЧтенияЦикла(Сценарий, Смещение)

	Сообщение = Новый Структура("key,message,topic,partition,offset,timestamp",
		"cycle", "сообщение цикла", Сценарий.Топик, 0, Смещение, 1767312000000);
	Пакет = Новый Структура("messages", ЮТМетоды.МассивПараметров(Сообщение));
	Сценарий.Компонента.НастроитьОтвет("ЧитатьПакетСообщений", ОбщегоНазначения.ЗначениеВJSON(Пакет));

КонецПроцедуры

// Параметры:
//	Консьюмер - СправочникСсылка.кфкКонсьюмеры - Ожидаемый владелец входящей записи.
//	Смещение - Число - Смещение сообщения в партии.
//	ОжидатьЗапись - Булево - Пакет назначен этому консьюмеру.
Процедура ПроверитьВходящееЦикла(Консьюмер, Смещение, ОжидатьЗапись)

	Предикат = ЮТест.Предикат()
		.Реквизит("Консьюмер").Равно(Консьюмер)
		.Реквизит("Смещение").Равно(Смещение);
	Проверка = ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения");
	Если ОжидатьЗапись Тогда
		Проверка.СодержитЗаписи(Предикат);
	Иначе
		Проверка.НеСодержитЗаписи(Предикат);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//	Сценарий - см. НовыйСценарийОбмена
//	Консьюмеры - Массив Из СправочникСсылка.кфкКонсьюмеры - Текущее назначение.
Процедура СнятьНазначениеКонсьюмераЦикла(Сценарий, Консьюмеры)

	Поток = Сценарий.Поток.УникальныйИдентификатор;
	Статистика = кфкФоновыеОперацииСлужебный.ют_НоваяСтатистикаРаспределенияЧтения();
	Строка = Статистика.Добавить();
	Строка.Консьюмер = Сценарий.Оставшийся;
	Строка.Партиций = 1;
	Строка.СредРазмер = 1;
	СледующееНазначение = кфкФоновыеОперацииСлужебный.ют_РаспределитьКонсьюмеров(Статистика, 100, 1);
	ТекущееНазначение = Новый Соответствие;
	ТекущееНазначение.Вставить(Поток, Консьюмеры);
	ОчередьДобавления = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	ОчередьУдаления = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	кфкФоновыеОперацииСлужебный.ют_ОбновитьРаспределениеКонсьюмеров(СледующееНазначение,
		ЮТМетоды.МассивПараметров(Поток), ОчередьДобавления, ОчередьУдаления, ТекущееНазначение);

КонецПроцедуры

