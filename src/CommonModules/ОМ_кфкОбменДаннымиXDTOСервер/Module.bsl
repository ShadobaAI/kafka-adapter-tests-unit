// Поиск по полям различает отсутствие, несколько совпадений и приоритет вариантов.
// Параметры:
//  Вариант - Строка - режим поиска по полям.
Процедура ПроизвестиЧтениеДанных_ПоискПоПолям_РазличаетСовпаденияИПриоритет(Вариант) Экспорт

	Суффикс = Строка(Новый УникальныйИдентификатор());
	Имя = "Цель " + Суффикс;
	Ключ = "ED-" + Лев(Суффикс, 8);
	Компоненты = КомпонентыДляПоискаГруппыEnterpriseData();
	Правило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	Если Вариант = "Нет" Тогда
		Сосед = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
			.Установить("Наименование", Имя + " иной")
			.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
			.Записать(Истина, Истина);
	Иначе
		Первый = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
			.Установить("Наименование", Имя)
			.Установить("Комментарий", "первый")
			.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
			.Записать(Истина, Истина);
		Второй = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
			.Установить("Наименование", ?(Вариант = "Два", Имя, Имя + " иной"))
			.Установить("Комментарий", Ключ)
			.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
			.Записать(Истина, Истина);
	КонецЕсли;
	Если Вариант = "ПриоритетИмя" Или Вариант = "ПриоритетКомментарий" Тогда
		Правило.ПоляПоиска.Очистить();
		Если Вариант = "ПриоритетИмя" Тогда
			Правило.ПоляПоиска.Добавить("Наименование");
			Правило.ПоляПоиска.Добавить("Комментарий");
		Иначе
			Правило.ПоляПоиска.Добавить("Комментарий");
			Правило.ПоляПоиска.Добавить("Наименование");
		КонецЕсли;
	КонецЕсли;
	Тело = кфкОбщегоНазначенияСлужебный.ЗначениеВJSON(
		Новый Структура("КодВПрограмме,Наименование", Ключ, Имя));

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиЧтениеДанных(
		Компоненты, Тело, "TestCatalog_Получение");

	ТекстОшибки = СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС);
	ЮТест.ОжидаетЧто(Результат, ТекстОшибки).ЭтоНеНеопределено();
	Если Вариант = "Нет" Тогда
		ЮТест.ОжидаетЧто(Результат.Ссылка = Сосед.Ссылка).Равно(Ложь);
		ЮТест.ОжидаетЧто(Сосед.Ссылка.ПолучитьОбъект().Наименование).Равно(Имя + " иной");
	ИначеЕсли Вариант = "Два" Тогда
		ЮТест.ОжидаетЧто(Результат.Ссылка = Первый.Ссылка
			Или Результат.Ссылка = Второй.Ссылка).Равно(Истина);
	ИначеЕсли Вариант = "ПриоритетИмя" Тогда
		ЮТест.ОжидаетЧто(Результат.Ссылка).Равно(Первый.Ссылка);
	Иначе
		ЮТест.ОжидаетЧто(Результат.Ссылка).Равно(Второй.Ссылка);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.Ссылка.ПолучитьОбъект()).ЭтоНеНеопределено();

КонецПроцедуры
