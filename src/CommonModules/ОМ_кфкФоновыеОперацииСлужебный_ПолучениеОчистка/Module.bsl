// Сбрасывает настройки внешней границы после каждого теста.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();
	Контекст = ЮТест.КонтекстТеста();
	Очередь = Неопределено; // РегистрСведенийНаборЗаписей.кфкВходящиеСообщения, Неопределено
	Если Не Контекст.Свойство("ют_ОчередьОчисткиПослеСбоя", Очередь) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОчереди Из Очередь Цикл

		Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
		Запись.КлючЗаписи = СтрокаОчереди.КлючЗаписи;
		Запись.ДатаЗагрузкиМС = СтрокаОчереди.ДатаЗагрузкиМС;
		Запись.Удалить();

	КонецЦикла;
	Контекст.Удалить("ют_ОчередьОчисткиПослеСбоя");

КонецПроцедуры

#Область КонтрольSLA

// Проверяет минуты SLA и независимость верхней границы входящих от исходящих.
//
// Параметры:
//  ДлительностьМинут - Число - время обработки сообщения при SLA 10 минут.
//  СмещениеСообщенияМС - Число - метка изменения относительно начала суток.
//  СмещениеГраницыИсходящихМС - Число - верхняя граница исходящих относительно начала суток.
//  ОжидаемыйПрирост - Число - вклад нового сообщения в число нарушений входящих.
Процедура КонтрольSLA_УчитываетДлительностьИДиапазонВходящих(
		ДлительностьМинут, СмещениеСообщенияМС, СмещениеГраницыИсходящихМС, ОжидаемыйПрирост) Экспорт

	НачалоСутокМС = 1767225600000;
	ГраницаВходящихМС = НачалоСутокМС + 720000;
	ИндексПоказателяВходящих = 3;
	Параметры = Новый Структура;
	Параметры.Вставить("ВремяSLAВходящих", 10);
	Параметры.Вставить("ВремяSLAИсходящих", 20);
	Диапазон = Новый Структура;
	Диапазон.Вставить("ВхОт", НачалоСутокМС);
	Диапазон.Вставить("ВхДо", ГраницаВходящихМС);
	Диапазон.Вставить("ИсхОт", НачалоСутокМС);
	Диапазон.Вставить("ИсхДо", НачалоСутокМС + СмещениеГраницыИсходящихМС);

	// Приращение исключает влияние ранее существовавших сообщений в том же диапазоне.
	ДоЗаписи = кфкФоновыеОперацииСлужебный.ют_ПоказателиКонтроля(Параметры, Диапазон);
	НачальнаяВыборка = ДоЗаписи[ИндексПоказателяВходящих].Выбрать();
	ЮТест.ОжидаетЧто(НачальнаяВыборка.Следующий(), "начальный показатель присутствует").ЭтоИстина();
	ИсходноеКоличество = НачальнаяВыборка.Количество; // Число

	Ключ = НоваяЗаписьОчереди(Истина, НачалоСутокМС,
		Перечисления.кфкСтатусыСообщений.Обработано);
	Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
	Запись.КлючЗаписи = Ключ;
	Запись.ДатаЗагрузкиМС = НачалоСутокМС;
	Запись.Прочитать();
	Запись.ДатаЗагрузки = Дата(2026, 1, 1);
	Запись.МеткаИзмененияМС = НачалоСутокМС + СмещениеСообщенияМС;
	СекундВМинуте = 60;
	Запись.ДатаОбработки = Запись.ДатаЗагрузки + ДлительностьМинут * СекундВМинуте;
	Запись.Записать();
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения")
		.СодержитЗаписи(ЮТест.Предикат().Реквизит("КлючЗаписи").Равно(Ключ)
			.Реквизит("ДатаЗагрузкиМС").Равно(НачалоСутокМС)
			.Реквизит("МеткаИзмененияМС").Равно(НачалоСутокМС + СмещениеСообщенияМС)
			.Реквизит("ДатаЗагрузки").Равно(Запись.ДатаЗагрузки)
			.Реквизит("ДатаОбработки").Равно(Запись.ДатаОбработки)
			.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Обработано));

	ПослеЗаписи = кфкФоновыеОперацииСлужебный.ют_ПоказателиКонтроля(Параметры, Диапазон);
	После = ПослеЗаписи[ИндексПоказателяВходящих].Выбрать();

	ЮТест.ОжидаетЧто(После.Следующий(), "итоговый показатель присутствует").ЭтоИстина();
	ИтоговоеКоличество = После.Количество; // Число
	ЮТест.ОжидаетЧто(ИтоговоеКоличество - ИсходноеКоличество,
		"SLA входящих учитывает свой диапазон и превышение 10 минут").Равно(ОжидаемыйПрирост);

КонецПроцедуры
// Проверяет вклад каждого из четырех показателей контроля.
Процедура КонтрольSLA_УчитываетВсеПоказатели() Экспорт

	НачалоСутокМС = 1767225600000;
	Параметры = Новый Структура("ВремяSLAВходящих,ВремяSLAИсходящих", 10, 20);
	Диапазон = Новый Структура("ВхОт,ВхДо,ИсхОт,ИсхДо",
		НачалоСутокМС, НачалоСутокМС + 720000, НачалоСутокМС, НачалоСутокМС + 720000);
	ДоЗаписи = кфкФоновыеОперацииСлужебный.ют_ПоказателиКонтроля(Параметры, Диапазон);

	НоваяЗаписьОчереди(Ложь, НачалоСутокМС + 1000,
		Перечисления.кфкСтатусыСообщений.ОшибкаВыгрузки);
	НоваяЗаписьОчереди(Истина, НачалоСутокМС + 2000,
		Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);

	КлючИсходящего = НоваяЗаписьОчереди(Ложь, НачалоСутокМС + 3000,
		Перечисления.кфкСтатусыСообщений.Выгружено);
	Исходящее = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
	Исходящее.КлючЗаписи = КлючИсходящего;
	Исходящее.ДатаРегистрацииМС = НачалоСутокМС + 3000;
	Исходящее.Прочитать();
	Исходящее.ДатаРегистрации = Дата(2026, 1, 1);
	Исходящее.ДатаВыгрузки = Исходящее.ДатаРегистрации + 21 * 60;
	Исходящее.Записать();

	КлючВходящего = НоваяЗаписьОчереди(Истина, НачалоСутокМС + 4000,
		Перечисления.кфкСтатусыСообщений.Обработано);
	Входящее = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
	Входящее.КлючЗаписи = КлючВходящего;
	Входящее.ДатаЗагрузкиМС = НачалоСутокМС + 4000;
	Входящее.Прочитать();
	Входящее.ДатаЗагрузки = Дата(2026, 1, 1);
	Входящее.ДатаОбработки = Входящее.ДатаЗагрузки + 11 * 60;
	Входящее.Записать();

	ПослеЗаписи = кфкФоновыеОперацииСлужебный.ют_ПоказателиКонтроля(Параметры, Диапазон);
	Для Индекс = 0 По 3 Цикл
		До = ДоЗаписи[Индекс].Выбрать();
		После = ПослеЗаписи[Индекс].Выбрать();
		ЮТест.ОжидаетЧто(До.Следующий(), "начальный показатель " + Индекс).ЭтоИстина();
		ЮТест.ОжидаетЧто(После.Следующий(), "итоговый показатель " + Индекс).ЭтоИстина();
		ЮТест.ОжидаетЧто(После.Количество - До.Количество,
			"прирост показателя " + Индекс).Равно(1);
	КонецЦикла;

КонецПроцедуры
// Проверяет, что повторный контроль не учитывает уже обработанные изменения.
Процедура КонтрольSLA_ПовторНеУчитываетПрежниеОшибки() Экспорт

	Параметры = Новый Структура("ВремяSLAВходящих,ВремяSLAИсходящих", 10, 20);
	кфкФоновыеОперацииСлужебный.ют_КонтрольИнтеграции(Параметры);
	Диапазон = кфкФоновыеОперацииСлужебный.ют_ДиапазонКонтроля();
	МеткаИсходящего = ?(ТипЗнч(Диапазон.ИсхДо) = Тип("Null"), 1, Диапазон.ИсхДо + 1);
	МеткаВходящего = ?(ТипЗнч(Диапазон.ВхДо) = Тип("Null"), 1, Диапазон.ВхДо + 1);

	НоваяЗаписьОчереди(Ложь, МеткаИсходящего,
		Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);
	НоваяЗаписьОчереди(Истина, МеткаВходящего,
		Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);

	ПервыйКонтроль = кфкФоновыеОперацииСлужебный.ют_КонтрольИнтеграции(Параметры);
	ЮТест.ОжидаетЧто(ПервыйКонтроль.ОшибкиИсходящих, "ошибка исходящих").Равно(1);
	ЮТест.ОжидаетЧто(ПервыйКонтроль.ОшибкиВходящих, "ошибка входящих").Равно(1);
	ЮТест.ОжидаетЧто(ПервыйКонтроль.НарушенSLAИсходящих, "SLA исходящих").Равно(0);
	ЮТест.ОжидаетЧто(ПервыйКонтроль.НарушенSLAВходящих, "SLA входящих").Равно(0);

	ПовторныйКонтроль = кфкФоновыеОперацииСлужебный.ют_КонтрольИнтеграции(Параметры);
	ЮТест.ОжидаетЧто(ПовторныйКонтроль.ОшибкиИсходящих, "повтор исходящих").Равно(0);
	ЮТест.ОжидаетЧто(ПовторныйКонтроль.ОшибкиВходящих, "повтор входящих").Равно(0);
	ЮТест.ОжидаетЧто(ПовторныйКонтроль.НарушенSLAИсходящих, "повтор SLA исходящих").Равно(0);
	ЮТест.ОжидаетЧто(ПовторныйКонтроль.НарушенSLAВходящих, "повтор SLA входящих").Равно(0);

КонецПроцедуры
// Проверяет содержание и порядок сообщения контроля при наличии четырех показателей.
Процедура КонтрольSLA_ФормируетСообщениеПоПоказателям() Экспорт

	Параметры = Новый Структура("ВремяSLAВходящих,ВремяSLAИсходящих", 10, 20);
	Показатели = Новый Структура("НарушенSLAИсходящих,НарушенSLAВходящих,ОшибкиИсходящих,ОшибкиВходящих",
		1, 2, 3, 4);
	ТекстСообщения = кфкФоновыеОперацииСлужебный.ют_ТекстКонтроля(Показатели, Параметры);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстСообщения, "Исходящие сообщения"), "исходящая секция").НеРавно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстСообщения, "Входящие сообщения"), "входящая секция").НеРавно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстСообщения, "1 сообщений не завершили обработку или выгрузку более 20 минут"),
		"SLA исходящих в минутах").НеРавно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстСообщения, "2 сообщений не завершили обработку более 10 минут"),
		"SLA входящих в минутах").НеРавно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстСообщения, "3 сообщений завершились с ошибкой"),
		"ошибки исходящих").НеРавно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстСообщения, "4 сообщений завершились с ошибкой"),
		"ошибки входящих").НеРавно(0);
	ЮТест.ОжидаетЧто(
		СтрНайти(ТекстСообщения, "Исходящие сообщения") < СтрНайти(ТекстСообщения, "Входящие сообщения"),
		"порядок направлений").ЭтоИстина();

	ПустыеПоказатели = Новый Структура("НарушенSLAИсходящих,НарушенSLAВходящих,ОшибкиИсходящих,ОшибкиВходящих",
		0, 0, 0, 0);
	ЮТест.ОжидаетЧто(кфкФоновыеОперацииСлужебный.ют_ТекстКонтроля(ПустыеПоказатели, Параметры),
		"пустые показатели не формируют сообщение").Равно("");

