// Фиксирует только часы внешней границы выборки логов.
// Параметры:
//  ВерхняяГраница - Число - верхняя граница выборки.
Процедура ЗафиксироватьЧасыЛога(ВерхняяГраница)

	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ОграничениеУказательПередВыгрузкойЛогов")
			.Вернуть(ВерхняяГраница);
	Мокито.Прогон();

КонецПроцедуры

// Получает исходную выборку логов нужного направления.
// Параметры:
//  Входящие - Булево - направление.
//  Количество - Число - лимит.
//  Позиция - Число - нижняя граница.
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - исходный результат запроса продукта.
Функция ВыборкаЛогаТеста(Входящие, Количество, Позиция)

	Если Входящие Тогда
		Возврат кфкФоновыеОперацииСлужебный.ют_ВыборкаЛоговВходящих(Количество, Позиция);
	Иначе
		Возврат кфкФоновыеОперацииСлужебный.ют_ВыборкаЛоговИсходящих(Количество, Позиция);
	КонецЕсли;

КонецФункции

// Вызывает исходный обработчик с подставленной HTTP-сессией.
// Параметры:
//  Входящие - Булево - направление.
//  Выборка - ВыборкаИзРезультатаЗапроса - события.
//  Представления - Соответствие Из Строка - имена настроек.
//  Позиция - Число - изменяемый указатель.
Процедура ОбработатьЛогиТеста(Входящие, Выборка, Представления, Позиция)

	Параметры = ПараметрыЛогаТеста();
	Если Входящие Тогда
		кфкФоновыеОперацииСлужебный.ют_ОбработатьЛогиВходящих(
			Выборка, Представления, Параметры, ОМ_кфкФоновыеОперацииСлужебный, Позиция);
	Иначе
		кфкФоновыеОперацииСлужебный.ют_ОбработатьЛогиИсходящих(
			Выборка, Представления, Параметры, ОМ_кфкФоновыеОперацииСлужебный, Позиция);
	КонецЕсли;

КонецПроцедуры

// Читает массив событий из gzip-тела перехваченного HTTP-запроса.
// Возвращаемое значение:
//  Массив Из Соответствие Из Произвольный - десериализованные события.
Функция СобытияПерехваченногоЛога()

	Запрос = ЮТест.КонтекстТеста().ют_HTTPЗапрос; // HTTPЗапрос
	Данные = кфкОбщегоНазначенияСлужебный.ПрочитатьGZip(Запрос.ПолучитьТелоКакДвоичныеДанные());
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8));
	Результат = ПрочитатьJSON(Чтение, Истина); // Массив Из Соответствие Из Произвольный
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

// Формирует независимый эталон внешнего события из данных фикстуры.
// Параметры:
//  Входящие - Булево - направление события.
