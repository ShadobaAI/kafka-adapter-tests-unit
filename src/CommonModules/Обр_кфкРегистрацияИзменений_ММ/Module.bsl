#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор(
			"Обработка кфкРегистрацияИзменений. Модуль менеджера. ВыполнитьРегистрациюСсылочногоТипа()")
			.Тег("Модульные")
			.Тег("кфкРегистрацияИзменений")
			.Тег("ВыполнитьРегистрациюСсылочногоТипа")
			.ДобавитьСерверныйТест("ВыполнитьРегистрациюСсылочногоТипа_РегистрируетСсылку",
				"ВыполнитьРегистрациюСсылочногоТипа(). Регистрирует ссылку объекта")
				.Тег("РегистрируетСсылку")
			.ДобавитьСерверныйТест("ВыполнитьРегистрациюСсылочногоТипа_РегистрируетОбъект",
				"ВыполнитьРегистрациюСсылочногоТипа(). Регистрирует объект")
				.Тег("РегистрируетОбъект")
		.ДобавитьТестовыйНабор(
			"Обработка кфкРегистрацияИзменений. Модуль менеджера. ВыполнитьРегистрациюНезависимогоРегистра()")
			.Тег("Модульные")
			.Тег("кфкРегистрацияИзменений")
			.Тег("ВыполнитьРегистрациюНезависимогоРегистра")
			.ДобавитьСерверныйТест("ВыполнитьРегистрациюНезависимогоРегистра_РегистрируетЗапись",
				"ВыполнитьРегистрациюНезависимогоРегистра(). Регистрирует запись")
				.Тег("РегистрируетЗапись")
		.ДобавитьТестовыйНабор(
			"Обработка кфкРегистрацияИзменений. Модуль менеджера. ВыполнитьРегистрациюПодчиненногоРегистра()")
			.Тег("Модульные")
			.Тег("кфкРегистрацияИзменений")
			.Тег("ВыполнитьРегистрациюПодчиненногоРегистра")
			.ДобавитьСерверныйТест("ВыполнитьРегистрациюПодчиненногоРегистра_РегистрируетРегистратор",
				"ВыполнитьРегистрациюПодчиненногоРегистра(). Регистрирует регистратор")
				.Тег("РегистрируетРегистратор");
	
КонецПроцедуры

Процедура ВыполнитьРегистрациюСсылочногоТипа_РегистрируетСсылку() Экспорт
	
	Ссылка = СоздатьЭлементТестовогоСправочника();
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	ОписаниеЗапроса = ОписаниеЗапросаСсылочногоТипа(Ссылка);
	
	Обработки.кфкРегистрацияИзменений.ВыполнитьРегистрациюСсылочногоТипа(
		ОписаниеЗапроса, Продюсер, Ложь);
	
	ПроверитьСообщениеОчереди(
		Продюсер,
		"Справочник.кфк_т_ТестовыйСправочник",
		"CatalogRef.кфк_т_ТестовыйСправочник",
		XMLСтрока(Ссылка));
	
КонецПроцедуры

Процедура ВыполнитьРегистрациюСсылочногоТипа_РегистрируетОбъект() Экспорт
	
	Ссылка = СоздатьЭлементТестовогоСправочника();
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника();
	ОписаниеЗапроса = ОписаниеЗапросаСсылочногоТипа(Ссылка);
	
	Обработки.кфкРегистрацияИзменений.ВыполнитьРегистрациюСсылочногоТипа(
		ОписаниеЗапроса, Продюсер, Истина);
	
	ПроверитьСообщениеОчереди(
		Продюсер,
		"Справочник.кфк_т_ТестовыйСправочник",
		"CatalogObject.кфк_т_ТестовыйСправочник",
		XMLСтрока(Ссылка));
	
КонецПроцедуры

Процедура ВыполнитьРегистрациюНезависимогоРегистра_РегистрируетЗапись() Экспорт
	
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	ТестоваяСсылка = СоздатьЭлементТестовогоСправочника();
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераРегистра();
	
	Запись = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ТестоваяСсылка = ТестоваяСсылка;
	Запись.Булево = Истина;
	Запись.Строка = "Тестовая запись";
	Запись.Число = 42;
	Запись.ДатаИВремя = ТекущаяДатаСеанса();
	Запись.Идентификатор = Новый УникальныйИдентификатор;
	Запись.Комментарий = Идентификатор;
	Запись.Записать();
	
	ОписаниеЗапроса = ОписаниеЗапросаНезависимогоРегистра(Идентификатор);
	Обработки.кфкРегистрацияИзменений.ВыполнитьРегистрациюНезависимогоРегистра(
		ОписаниеЗапроса, Продюсер);
	
	ПроверитьСообщениеОчереди(
		Продюсер,
		"РегистрСведений.кфк_т_ТестовыйРегистрСведений",
		"InformationRegisterRecordSet.кфк_т_ТестовыйРегистрСведений");
	
КонецПроцедуры

Процедура ВыполнитьРегистрациюПодчиненногоРегистра_РегистрируетРегистратор() Экспорт
	
	Регистратор = ЮТест.Данные()
		.КонструкторОбъекта(Документы.кфк_т_ТестовыйДокумент)
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Комментарий", "Регистратор пакетной регистрации")
		.Записать();
	Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераРегистраПР();
	
	НаборЗаписей = РегистрыСведений.кфк_т_ТестовыйРегистрСведенийПР.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	Запись = НаборЗаписей.Добавить();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись.Значение = 84;
	НаборЗаписей.Записать();
	
	ОписаниеЗапроса = ОписаниеЗапросаПодчиненногоРегистра(Регистратор);
	Обработки.кфкРегистрацияИзменений.ВыполнитьРегистрациюПодчиненногоРегистра(
		ОписаниеЗапроса, Продюсер);
	
	ПроверитьСообщениеОчереди(
		Продюсер,
		"РегистрСведений.кфк_т_ТестовыйРегистрСведенийПР",
		"InformationRegisterRecordSet.кфк_т_ТестовыйРегистрСведенийПР");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЭлементТестовогоСправочника()
	
	Возврат ЮТест.Данные()
		.КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "Элемент для пакетной регистрации")
		.Записать();
	
КонецФункции

Функция ОписаниеЗапросаСсылочногоТипа(Ссылка)
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТестовыйСправочник.Ссылка
	|ИЗ
	|	Справочник.кфк_т_ТестовыйСправочник КАК ТестовыйСправочник
	|ГДЕ
	|	ТестовыйСправочник.Ссылка = &Ссылка";
	
	Возврат Новый Структура(
		"ИмяТаблицы,Текст,Параметры",
		"Справочник.кфк_т_ТестовыйСправочник",
		ТекстЗапроса,
		Новый Структура("Ссылка", Ссылка));
	
КонецФункции

Функция ОписаниеЗапросаНезависимогоРегистра(Комментарий)
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТестовыйРегистр.Период,
	|	ТестовыйРегистр.ТестоваяСсылка,
	|	ТестовыйРегистр.Булево,
	|	ТестовыйРегистр.Строка,
	|	ТестовыйРегистр.Число,
	|	ТестовыйРегистр.ДатаИВремя,
	|	ТестовыйРегистр.Идентификатор,
	|	ТестовыйРегистр.Комментарий
	|ИЗ
	|	РегистрСведений.кфк_т_ТестовыйРегистрСведений КАК ТестовыйРегистр
	|ГДЕ
	|	ТестовыйРегистр.Комментарий = &Комментарий";
	
	Возврат Новый Структура(
		"ИмяТаблицы,Текст,Параметры",
		"РегистрСведений.кфк_т_ТестовыйРегистрСведений",
		ТекстЗапроса,
		Новый Структура("Комментарий", Комментарий));
	
КонецФункции

Функция ОписаниеЗапросаПодчиненногоРегистра(Регистратор)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТестовыйРегистр.Регистратор
	|ИЗ
	|	РегистрСведений.кфк_т_ТестовыйРегистрСведенийПР КАК ТестовыйРегистр
	|ГДЕ
	|	ТестовыйРегистр.Регистратор = &Регистратор";
	
	Возврат Новый Структура(
		"ИмяТаблицы,Текст,Параметры",
		"РегистрСведений.кфк_т_ТестовыйРегистрСведенийПР",
		ТекстЗапроса,
		Новый Структура("Регистратор", Регистратор));
	
КонецФункции

Процедура ПроверитьСообщениеОчереди(
		Продюсер,
		ТипОбъекта,
		ТипИсходныхДанных,
		КлючОбъекта = Неопределено)
	
	Предикат = ЮТест.Предикат()
		.Реквизит("Продюсер").Равно(Продюсер)
		.Реквизит("ТипОбъект").Равно(ТипОбъекта)
		.Реквизит("ТипИсходныхДанных").Равно(ТипИсходныхДанных)
		.Реквизит("СобытиеРегистрации").Равно(
			Перечисления.кфкСобытияРегистрации.Принудительно)
		.Реквизит("Статус").Равно(
			Перечисления.кфкСтатусыСообщений.Новое);
	Если КлючОбъекта <> Неопределено Тогда
		Предикат.Реквизит("КлючОбъекта").Равно(КлючОбъекта);
	КонецЕсли;
	
	ЮТест.ОжидаетЧтоТаблицаБазы(
		"РегистрСведений.кфкИсходящиеСообщения",
		"Принудительно зарегистрированное исходящее сообщение")
		.СодержитТолькоОднуЗапись(Предикат);
	
КонецПроцедуры

#КонецОбласти
