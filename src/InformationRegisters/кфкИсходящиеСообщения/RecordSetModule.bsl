#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Создает контролируемый отказ только для собственного ключа текущего теста.
// Параметры:
//  Отказ - Булево
//  Замещение - Булево, РежимЗамещения
&Перед("ПередЗаписью")
Процедура ют_ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		// Отправка сохраняет очередь в режиме загрузки; контролируемый отказ действует и здесь.
		ют_ПроверитьКонтролируемыйОтказ();
		Возврат;
	КонецЕсли;

	ют_ПроверитьКонтролируемыйОтказ();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ют_ПроверитьКонтролируемыйОтказ()

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КлючОшибки = "";
	Если Не Контекст.Свойство("ют_ОшибкаЗаписиИсходящих", КлючОшибки) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.КлючЗаписи = КлючОшибки Тогда
			ВызватьИсключение "unit: ошибка сохранения исходящего";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
