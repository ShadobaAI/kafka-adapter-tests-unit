Процедура ИсходящийЦикл_ВозобновляетОбменБезПовторнойОтправки() Экспорт

	Сценарий = НовыйСценарийОбмена();
	Сценарий.Компонента.НастроитьОтвет("ИнициализироватьПродюсера", Истина);
	Сценарий.Компонента.НастроитьОтвет("ОтправитьПакетСРезультатом",
		"{""total"":""1"",""success_count"":""1"",""failed_count"":""0"",""results"":[]}");
	ТипОбъекта = "Справочник.кфкПродюсеры";
	Топик = "unit-send-" + Строка(Новый УникальныйИдентификатор);
	Продюсер = НовыйПродюсерЦикла(ТипОбъекта, Топик);
	Продюсеры = ЮТМетоды.МассивПараметров(Продюсер);
	Сериализация = "СериализацияСообщений";
	Отправка = "ОтправкаСообщенийВКафку";

	ПерваяПорция = ЗарегистрироватьПорциюЦикла(Продюсер, ТипОбъекта, "первая порция");
	ВыполнитьДиспетчерЦикла(Сценарий, Сериализация, Продюсеры);
	ПроверитьИсходящееЦикла(ПерваяПорция, Перечисления.кфкСтатусыСообщений.Обработано, 0);
	ВыполнитьДиспетчерЦикла(Сценарий, Отправка, Продюсеры);
	ПроверитьИсходящееЦикла(ПерваяПорция, Перечисления.кфкСтатусыСообщений.Выгружено, 1);

	ВтораяПорция = ЗарегистрироватьПорциюЦикла(Продюсер, ТипОбъекта, "вторая порция");
	ВыполнитьДиспетчерЦикла(Сценарий, Сериализация, Продюсеры);
	ОжидаемаяПозиция = ПозицияОтправкиЦикла(Продюсеры);
	ЮТест.ОжидаетЧто(ОжидаемаяПозиция, "Первая порция подтверждена в позиции отправки").Больше(0);
	ВыполнитьДиспетчерЦикла(Сценарий, Отправка, Продюсеры, Истина);
	ЮТест.ОжидаетЧто(Константы.кфкБлокировкаИнтеграции.Получить()).Равно(Истина);
	ПроверитьИсходящееЦикла(ВтораяПорция, Перечисления.кфкСтатусыСообщений.Обработано, 0);
	ЮТест.ОжидаетЧто(ПозицияОтправкиЦикла(Продюсеры), "Позиция после остановки").Равно(ОжидаемаяПозиция);
	МетодОтправки = "ОтправитьПакетСРезультатом";
	ЮТест.ОжидаетЧто(ВызовыКомпонентыЦикла(Сценарий.Компонента, МетодОтправки)).ИмеетДлину(1);

	Константы.кфкБлокировкаИнтеграции.Установить(Ложь);
	ОбновитьПовторноИспользуемыеЗначения();
	ВыполнитьДиспетчерЦикла(Сценарий, Отправка, Продюсеры);

	ПроверитьИсходящееЦикла(ПерваяПорция, Перечисления.кфкСтатусыСообщений.Выгружено, 1);
	ПроверитьИсходящееЦикла(ВтораяПорция, Перечисления.кфкСтатусыСообщений.Выгружено, 1);
	ОтправленныеПорции = ВызовыКомпонентыЦикла(Сценарий.Компонента, МетодОтправки);
	ЮТест.ОжидаетЧто(ОтправленныеПорции).ИмеетДлину(2);
	ПроверитьОтправленнуюПорциюЦикла(ОтправленныеПорции[0].Параметры, Топик, ПерваяПорция.КлючЗаписи);
	ПроверитьОтправленнуюПорциюЦикла(ОтправленныеПорции[1].Параметры, Топик, ВтораяПорция.КлючЗаписи);

КонецПроцедуры

// Проверяет чтение до и после снятия одного из двух назначений.
Процедура ЗагрузкаСообщенийИзКафки_ПродолжаетЧтениеПослеСменыНазначения() Экспорт

	Сценарий = НовыйСценарийОбмена();
	Сценарий.Вставить("Топик", "unit-load-" + Строка(Новый УникальныйИдентификатор));
	Сценарий.Вставить("Оставшийся", НовыйКонсьюмерЦикла(Сценарий.Топик));
	Сценарий.Вставить("Удаляемый", НовыйКонсьюмерЦикла(Сценарий.Топик));
	Сценарий.Вставить("ПрочитаноПорций", 0);
	Сценарий.Вставить("СохраненнаяСессия", Неопределено);
	Сценарий.Компонента.НастроитьОтвет("ИнициализироватьКонсьюмера", Истина);
	Сценарий.Компонента.НастроитьОтвет("Подписаться", Истина);
	Сценарий.Компонента.НастроитьОтвет("УстановитьТаймаутОжидания", Истина);
	Сценарий.Компонента.НастроитьОтвет("ПолучитьОтставаниеКонсьюмера",
		"{""partitions"":[{""partition"":""0"",""committed_offset"":""none""}]}");
	Сценарий.Компонента.НастроитьОтвет("ПолучитьГраницыПартиции", "{""message_count"":""2""}");
	НастроитьОтветЧтенияЦикла(Сценарий, 1);

	Консьюмеры = ЮТМетоды.МассивПараметров(Сценарий.Оставшийся, Сценарий.Удаляемый);
	ВыполнитьДиспетчерЦикла(Сценарий, "ЗагрузкаСообщенийИзКафки", Консьюмеры);

	ЮТест.ОжидаетЧто(Сценарий.ПрочитаноПорций).Равно(2);
	ЮТест.ОжидаетЧто(ВызовыКомпонентыЦикла(Сценарий.Компонента, "ЧитатьПакетСообщений")).ИмеетДлину(3);
	ЮТест.ОжидаетЧто(ВызовыКомпонентыЦикла(Сценарий.Компонента, "ИнициализироватьКонсьюмера")).ИмеетДлину(2);
	ЮТест.ОжидаетЧто(ВызовыКомпонентыЦикла(Сценарий.Компонента, "ОстановитьКонсьюмера")).ИмеетДлину(2);
	Предикат = ЮТест.Предикат()
		.Реквизит("ИдентификаторПотока").Равно(Сценарий.Поток.УникальныйИдентификатор);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);

КонецПроцедуры

// Исполняет назначенный платформе поток в текущей тестовой транзакции.
//
// Параметры:
//	Сценарий - см. НовыйСценарийОбмена
Процедура ВыполнитьРабочийПотокЦикла(Сценарий) Экспорт

	Мокито.Проверить(кфкФоновыеОперацииСлужебный);
	ВызовыЗапуска = МокитоПроверки.Вызовы("ют_ВыполнитьФоновоеЗадание");
	ЮТест.ОжидаетЧто(ВызовыЗапуска).ИмеетДлину(1);
	Аргументы = ВызовыЗапуска[0].Параметры; // Массив Из Произвольный
	Параметры = Аргументы[1]; // Массив Из Произвольный
	ИмяМетода = Аргументы[0]; // Строка
	ЮТест.ОжидаетЧто(ИмяМетода).Равно(Сценарий.МетодПотока);

	Сценарий.Исполнен = Истина;
	Сценарий.ВРабочемПотоке = Истина;
	Если Сценарий.Остановить Тогда
		Предикат = ЮТест.Предикат()
			.Реквизит("ИдентификаторПотока").Равно(Сценарий.Поток.УникальныйИдентификатор);
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").СодержитЗаписи(Предикат);
		Константы.кфкБлокировкаИнтеграции.Установить(Истина);
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;

	Если ИмяМетода = "кфкФоновыеОперацииСлужебный.СериализацияСообщенийВПотоке" Тогда
		кфкФоновыеОперацииСлужебный.СериализацияСообщенийВПотоке(Параметры[0]);
	ИначеЕсли ИмяМетода = "кфкФоновыеОперацииСлужебный.ОтправкаСообщенийВКафкуВПотоке" Тогда
		кфкФоновыеОперацииСлужебный.ОтправкаСообщенийВКафкуВПотоке(Параметры[0], Параметры[1]);
	Иначе
		кфкФоновыеОперацииСлужебный.ЗагрузкаСообщенийИзКафкиВПотоке(Параметры[0]);
	КонецЕсли;
	Сценарий.ВРабочемПотоке = Ложь;

КонецПроцедуры

// Вносит новое распределение между итерациями реального рабочего потока.
//
// Параметры:
//	Сценарий - см. НовыйСценарийОбмена
//	Консьюмеры - Массив Из СправочникСсылка.кфкКонсьюмеры - Список обработанных назначений.
//	Сессии - Соответствие Из КлючИЗначение - Открытые сессии по консьюмерам.
//
// Возвращаемое значение:
//	Булево - Продолжить тестовое чтение.
Функция ПослеЧтенияПорцииЦикла(Сценарий, Консьюмеры, Сессии) Экспорт

	Сценарий.ПрочитаноПорций = Сценарий.ПрочитаноПорций + 1;
	Если Сценарий.ПрочитаноПорций = 1 Тогда
		ЮТест.ОжидаетЧто(Сессии.Количество()).Равно(2);
		Сценарий.СохраненнаяСессия = Сессии.Получить(Сценарий.Оставшийся);
		ЮТест.ОжидаетЧто(Сессии.Получить(Сценарий.Удаляемый)).ЭтоНеНеопределено();
		ПроверитьВходящееЦикла(Сценарий.Оставшийся, 1, Истина);
		ПроверитьВходящееЦикла(Сценарий.Удаляемый, 1, Истина);
		СнятьНазначениеКонсьюмераЦикла(Сценарий, Консьюмеры);
		НастроитьОтветЧтенияЦикла(Сценарий, 2);
		Возврат Истина;
	КонецЕсли;

	ЮТест.ОжидаетЧто(Сценарий.ПрочитаноПорций).Равно(2);
	ЮТест.ОжидаетЧто(Сессии.Получить(Сценарий.Удаляемый)).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Сессии.Получить(Сценарий.Оставшийся) = Сценарий.СохраненнаяСессия).Равно(Истина);
	ЮТест.ОжидаетЧто(ВызовыКомпонентыЦикла(Сценарий.Компонента, "ОстановитьКонсьюмера")).ИмеетДлину(1);
	ПроверитьВходящееЦикла(Сценарий.Оставшийся, 2, Истина);
	ПроверитьВходящееЦикла(Сценарий.Удаляемый, 2, Ложь);
	Сценарий.Компонента.НастроитьОтвет("ПолучитьОтставаниеКонсьюмера", "{""partitions"":[]}");

	Возврат Ложь;

КонецФункции

