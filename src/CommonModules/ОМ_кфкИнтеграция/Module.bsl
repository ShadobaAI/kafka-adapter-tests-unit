// Проверяет: РазбиваетМассивНаПорции.
// Параметры:
//  Количество - Число - размер пакета относительно порции из двух сообщений.
Процедура ПоместитьВОчередьИсходящих_РазбиваетМассивНаПорции(Знач Количество) Экспорт

	Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
	Источник = Новый Массив; // Массив Из Строка
	Для Номер = 1 По Количество Цикл
		Источник.Добавить("сообщение-" + Строка(Номер));
	КонецЦикла;
	Параметры = НовыеПараметрыРегистрации();
	НастроитьРегистрацию(Параметры);

	кфкИнтеграция.ПоместитьВОчередьИсходящих(Источник);

	Аргументы = ЮТМетоды.МассивПараметров(Неопределено, Истина);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("ПараметрыРегистрации", Аргументы).Равно(1)
		.КоличествоВызовов("МаксРазмерПорцииРегистрации").Равно(1)
		.КоличествоВызовов("ПоместитьВОчередьИсходящих").Равно(Количество);
	Для Каждого Элемент Из Источник Цикл

		Аргументы = ЮТМетоды.МассивПараметров(
			Элемент,
			Перечисления.кфкСобытияРегистрации.Программно,
			"",
