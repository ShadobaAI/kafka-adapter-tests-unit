	ЮТест.ОжидаетЧто(Набор[0].Период = Набор[1].Период).Равно(Ложь);
	ЮТест.ОжидаетЧто(Набор[0].Строка = Набор[1].Строка).Равно(Ложь);
	Набор.Очистить();
	Набор.Записать();

КонецПроцедуры
// Разные длины простого и табличного списков не смешивают элементы.
// Параметры:
//  КоличествоЗначений - Число - длина простого списка.
//  КоличествоСтрок - Число - длина табличного списка.
Процедура ПроизвестиВыгрузкуДанных_ДваСписка_СохраняетРазнуюДлину(
		КоличествоЗначений, КоличествоСтрок) Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	Компоненты.МенеджерОбмена = ют_МенеджерОбменаXDTOДляВыбораПравил;
	Компоненты.ЗаголовкиСообщения.Вставить("ТестовоеКоличествоЗначений",
		КоличествоЗначений);
	Компоненты.ЗаголовкиСообщения.Вставить("ТестовоеКоличествоСтрок",
		КоличествоСтрок);
	ПространствоИмен = "http://v8.fsk.ru/kfk/unit/graph/1.0";
	Компоненты.XMLСхема = ПространствоИмен;
	Компоненты.БазовыеСхемыФормата.Вставить(ПространствоИмен, Истина);
	Правило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	Правило.ОбъектДанных = Неопределено;
	Правило.ОбъектФормата = "ПроверкаМассивов";
	Правило.ПространствоИмен = ПространствоИмен;
	Правило.ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, "ПроверкаМассивов");
	Правило.ЭтоСсылочныйТип = Ложь;
	Правило.СвойстваТабличныхЧастей.Очистить();
	Правило.Свойства.Очистить();
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Наименование";
	ПКС.СвойствоФормата = "name";
	Правило.ПриОтправкеДанных = "УстановитьНесовпадающиеСписки";
	Правило.ЕстьОбработчикПриОтправкеДанных = Истина;
	Источник = Новый Структура("Наименование", "Два списка");

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	ТекстОшибки = СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС);
	ЮТест.ОжидаетЧто(Результат, ТекстОшибки).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Результат["values"].Количество()).Равно(КоличествоЗначений);
	ЮТест.ОжидаетЧто(Результат["table"].Количество()).Равно(КоличествоСтрок);
	Для Номер = 1 По КоличествоЗначений Цикл
		ЮТест.ОжидаетЧто(Результат["values"][Номер - 1])
			.Равно("Значение " + Строка(Номер));
	КонецЦикла;
	Для Номер = 1 По КоличествоСтрок Цикл
		ЮТест.ОжидаетЧто(Результат["table"][Номер - 1]["name"])
			.Равно("Строка " + Строка(Номер));
	КонецЦикла;

КонецПроцедуры

