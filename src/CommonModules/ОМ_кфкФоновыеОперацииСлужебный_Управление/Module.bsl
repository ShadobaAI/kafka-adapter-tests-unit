// Проверяет обновление единой позиции при явной фиксации записи настроек.
Процедура ЗафиксироватьИзменениеНастроек_ОбновляетОбщуюМетку() Экспорт

	Идентификатор = кфкФоновыеОперацииСлужебный.ют_ИДОперацииИзмененияНастроек();
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 0);

	кфкФоновыеОперацииСлужебный.ЗафиксироватьИзменениеНастроек();

	Метка = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(Идентификатор, "");
	ЮТест.ОжидаетЧто(Метка > 0, "Фиксация настроек сохраняет ненулевую общую метку").Равно(Истина);

КонецПроцедуры
// Проверяет факт записи, включая повторное сохранение тех же значений.
// Параметры:
//  ВидНастроек - Строка - имя справочника, константы или регистра настроек.
//  Группа - Булево - проверять диспетчер задач вместо элемента справочника.
Процедура ЗаписьНастроек_ОбновляетМеткуБезИзмененияЗначений(ВидНастроек, Группа) Экспорт

	Идентификатор = кфкФоновыеОперацииСлужебный.ют_ИДОперацииИзмененияНастроек();
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 0);

	ЗаписатьНастройкиДляПроверки(ВидНастроек, Группа);
	ПерваяМетка = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(Идентификатор, "");
	ЮТест.ОжидаетЧто(ПерваяМетка > 0, "Обычная запись настроек фиксируется").Равно(Истина);

	// Старая позиция позволяет проверить повторную запись без паузы и изменения значений.
	РегистрыСведений.кфкПозицииОпераций.ОбновитьПозицию(Идентификатор, 0);
	ЗаписатьНастройкиДляПроверки(ВидНастроек, Группа);

	ПовторнаяМетка = РегистрыСведений.кфкПозицииОпераций.ПолучитьПозицию(Идентификатор, "");
	ЮТест.ОжидаетЧто(ПовторнаяМетка > 0, "Повторное сохранение тех же настроек также фиксируется")
		.Равно(Истина);

КонецПроцедуры
// Проверяет необходимость ожидания по возрасту записи и самого старого потока.
// Параметры:
//  ВозрастЗаписи - Число - секунды после последней записи.
//  ВозрастСтарогоПотока - Число - секунды после старта старого потока.
//  ВозрастНовогоПотока - Число - секунды после старта нового потока.
//  ЕстьМетка - Булево - существует ли запись настроек.
//  ЕстьПотоки - Булево - существуют ли активные потоки.
//  Ожиданий - Число - ожидаемое число обращений к границе ожидания.
Процедура ЗавершитьПотоки_УчитываетЗаписьИСамыйСтарыйПоток(
		ВозрастЗаписи, ВозрастСтарогоПотока, ВозрастНовогоПотока, ЕстьМетка, ЕстьПотоки, Ожиданий) Экспорт

	Потоки = НовыеПотокиДляПроверки(ВозрастСтарогоПотока, ВозрастНовогоПотока, ЕстьПотоки);
	ПодготовитьПроверкуПерезапуска(ВозрастЗаписи, Потоки, ЕстьМетка);

	кфкФоновыеОперацииСлужебный.ют_ЗавершитьПотокиПриНеобходимости();

	Аргументы = ЮТМетоды.МассивПараметров(Потоки); // Массив из Произвольный
	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ОжидатьЗавершенияВыполнения", Аргументы).Равно(Ожиданий);
	ЮТест.ОжидаетЧто(Константы.кфкБлокировкаИнтеграции.Получить(),
		"После проверки временная блокировка снята").Равно(Ложь);

КонецПроцедуры
// Проверяет приоритет уже установленной общей блокировки.
Процедура ЗавершитьПотоки_СохраняетУстановленнуюБлокировку() Экспорт

	// Функциональная опция читает сохраненную константу вне транзакции теста.
	Контекст = ЮТест.КонтекстТеста(); // Структура
	Контекст.Вставить("БлокировкаДоПроверки", Константы.кфкБлокировкаИнтеграции.Получить());
	Идентификатор = кфкФоновыеОперацииСлужебный.ют_ИДОперацииИзмененияНастроек();
	ПозицияДоПроверки = РегистрыСведений.кфкПозицииОпераций.СоздатьНаборЗаписей();
	ПозицияДоПроверки.Отбор.Идентификатор.Установить(Идентификатор);
	ПозицияДоПроверки.Отбор.Раздел.Установить("");
	ПозицияДоПроверки.Прочитать();
	Контекст.Вставить("ПозицияДоПроверки", ПозицияДоПроверки);

	Потоки = НовыеПотокиДляПроверки(300, 30, Истина);
	ПодготовитьПроверкуПерезапуска(120, Потоки, Истина);
	Константы.кфкБлокировкаИнтеграции.Установить(Истина);
	ОбновитьПовторноИспользуемыеЗначения();
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкБлокировкаИнтеграции")).Равно(Истина);

	кфкФоновыеОперацииСлужебный.ют_ЗавершитьПотокиПриНеобходимости();

	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ПолучитьПотоки").Равно(0);
	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ОжидатьЗавершенияВыполнения").Равно(0);
	ЮТест.ОжидаетЧто(Константы.кфкБлокировкаИнтеграции.Получить(),
		"Ранее установленная блокировка сохраняется").Равно(Истина);

КонецПроцедуры
// Проверяет снятие временной блокировки и передачу ошибки ожидания вызывающему коду.
Процедура ЗавершитьПотоки_СнимаетБлокировкуПослеОшибки() Экспорт

	Потоки = НовыеПотокиДляПроверки(300, 30, Истина);
	ПодготовитьПроверкуПерезапуска(120, Потоки, Истина);
	ТекстОшибки = "Ошибка ожидания потоков при применении настроек";
	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ПолучитьПотоки")
			.Вернуть(Потоки)
		.Когда("ОжидатьЗавершенияВыполнения")
			.ВыброситьИсключение(ТекстОшибки);
	Мокито.Прогон();

	ЮТест.ОжидаетЧто(кфкФоновыеОперацииСлужебный)
		.Метод("ют_ЗавершитьПотокиПриНеобходимости")
			.ВыбрасываетИсключение(ТекстОшибки);
	ЮТест.ОжидаетЧто(Константы.кфкБлокировкаИнтеграции.Получить(),
		"Ошибка ожидания не оставляет временную блокировку").Равно(Ложь);

КонецПроцедуры
