// Изолирует HTTPS-конструктор уведомления Telegram в стендовом тесте.
// При отсутствии тестовой настройки выполняет исходное создание соединения.
//@skip-check method-too-many-params
&Вместо("НовоеHTTPСоединение")
Функция ют_НовоеHTTPСоединениеДляУведомления(Сервер, Порт = Неопределено,
	Пользователь = Неопределено, Пароль = Неопределено, Прокси = Неопределено,
	Таймаут = Неопределено, ЗащищенноеСоединение = Неопределено,
	ИспользоватьАутентификациюОС = Неопределено)

	Контекст = ЮТест.КонтекстТеста();
	ТестоваяСессия = Неопределено; // ОбщийМодуль, Неопределено
	Если Контекст.Свойство("ют_HTTPСессияTelegram", ТестоваяСессия) Тогда
		Контекст.Вставить("ют_TelegramСервер", Сервер);
		Контекст.Вставить("ют_TelegramТаймаут", Таймаут);
		Контекст.Вставить("ют_TelegramTLS", ЗащищенноеСоединение);
		Возврат ТестоваяСессия;
	КонецЕсли;

	Возврат ПродолжитьВызов(Сервер, Порт, Пользователь, Пароль, Прокси, Таймаут,
		ЗащищенноеСоединение, ИспользоватьАутентификациюОС);

