		.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("КлючЗаписи").Равно(СтарыйКлюч));
	ЮТест.ОжидаетЧтоТаблицаБазы(ИмяТаблицы)
		.НеСодержитЗаписи(ЮТест.Предикат()
			.Реквизит("КлючЗаписи").Равно(НовыйКлюч)
			.Реквизит("МеткаИзмененияМС").Равно(СтараяМетка));

