// Возвращает транспортный пакет с явными контрольными значениями.
// Возвращаемое значение:
//  Структура:
//   * topic - Строка
//   * partition - Число
//   * offset - Число
//   * timestamp - Число
//   * message - ДвоичныеДанные
//   * headers - Массив Из Структура
//   * key - Строка
Функция НовоеСообщение()

	Заголовки = Новый Массив; // Массив Из Структура
	Заголовки.Добавить(Новый Структура("key,value", "trace-id", "трасса-17"));
	Заголовки.Добавить(Новый Структура("key,value", "content-type", "application/octet-stream"));
	Результат = Новый Структура;
	Результат.Вставить("topic", "unit-receive-" + НовыйКлюч());
	Результат.Вставить("partition", 2);
	Результат.Вставить("offset", 17);
	Результат.Вставить("timestamp", 172800000);
	Результат.Вставить("message", Base64Значение("AAECf4D/"));
	Результат.Вставить("headers", Заголовки);
	Результат.Вставить("key", "Ключ-17");
	Возврат Результат;

КонецФункции

// Настраивает единственный ответ внешнего чтения; автофиксация обязательна.
// Параметры:
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры
//  Сообщение - см. НовоеСообщение
//  ПустойПакет - Булево
//  Сессии - Соответствие Из КлючИЗначение
Процедура ПодготовитьЧтение(Консьюмер, Сообщение, ПустойПакет, Сессии)

	Сообщения = Новый Массив; // Массив Из Структура
	Если Не ПустойПакет Тогда
		Сообщения.Добавить(Сообщение);
	КонецЕсли;
	Ответ = Новый Структура("Успешно,ТекстОшибки,Сообщения", Истина, "", Сообщения);
	Мокито.Обучение(кфкИнтеграцияСлужебный)
		.Когда("ПрочитатьПакетСообщений", ЮТМетоды.МассивПараметров(Консьюмер, Истина, 2, Сессии))
			.Вернуть(Ответ);
	Мокито.Прогон();

КонецПроцедуры

// Возвращает отдельный сценарий десериализации одного ключа.
// Возвращаемое значение:
//  Структура:
//   * Выборка - Структура
//   * Очередь - РегистрСведенийНаборЗаписей.кфкВходящиеСообщения
//   * Правило - см. кфкФоновыеОперацииСлужебный.НовоеОписаниеПравилОбмена
//   * Правила - Соответствие Из КлючИЗначение
//   * Идемпотентные - Массив Из СправочникСсылка.кфкКонсьюмеры
//   * Хэши - РегистрСведенийНаборЗаписей.кфкХэшСуммыСообщений - набор сохраняемых хэшей.
//   * Кэш - Соответствие Из КлючИЗначение
//   * Момент - Структура
Функция НовыйСценарийДедупликации()

	Консьюмер = НовыйКонсьюмер();
	Данные = Новый Структура;
	Данные.Вставить("КлючЗаписи", НовыйКлюч());
	Данные.Вставить("Консьюмер", Консьюмер);
	Данные.Вставить("Топик", "unit-dedup");
	Данные.Вставить("ТекстЖурнала", "");
	Данные.Вставить("ХэшСумма", "");
	Данные.Вставить("ТелоСообщения", кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище("payload"));
	Данные.Вставить("Заголовки", кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Новый Соответствие));
	Данные.Вставить("КлючСообщения", "ключ");
	Данные.Вставить("Раздел", 2);
	Данные.Вставить("Смещение", 17);
	Данные.Вставить("ДатаЗаписи", Дата(2026, 1, 1));
	Данные.Вставить("ДатаЗагрузки", Дата(2026, 1, 1));
	Данные.Вставить("ДатаОбработки", Дата(2026, 1, 2));
	Правило = кфкФоновыеОперацииСлужебный.НовоеОписаниеПравилОбмена();
	Правило.Тип = Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик;
	Правило.ИмяМетода = "ОМ_кфкФоновыеОперацииСлужебный_ПолучениеОчистка.ют_УспешнаяДесериализация";
	Правила = Новый Соответствие;
	Правила.Вставить(НРег(XMLСтрока(Консьюмер) + "unit-dedup"), Правило);
	Идемпотентные = Новый Массив; // Массив Из СправочникСсылка.кфкКонсьюмеры
	Идемпотентные.Добавить(Консьюмер);
	Результат = Новый Структура;
	Результат.Вставить("Выборка", Данные);
	Результат.Вставить("Очередь", РегистрыСведений.кфкВходящиеСообщения.СоздатьНаборЗаписей());
	Результат.Вставить("Правило", Правило);
	Результат.Вставить("Правила", Правила);
	Результат.Вставить("Идемпотентные", Идемпотентные);
	Результат.Вставить("Хэши", РегистрыСведений.кфкХэшСуммыСообщений.СоздатьНаборЗаписей());
	Результат.Вставить("Кэш", Новый Соответствие);
	Результат.Вставить("Момент", Новый Структура("Дата,ДатаМС", Дата(2026, 1, 2), 1000000));
	Возврат Результат;

КонецФункции

// Возвращает только собственное сообщение как вход настоящего обработчика.
// Параметры:
//  Ключ - Строка
//  Метка - Число
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса
Функция ВыборкаСобственногоВходящего(Ключ, Метка)

	// Получаем поля записи и сохраненный хэш для повторной обработки.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Запрос.УстановитьПараметр("Метка", Метка);
	Запрос.Текст = "ВЫБРАТЬ
	|	Сообщения.КлючЗаписи КАК КлючЗаписи,
	|	Сообщения.ДатаЗагрузкиМС КАК ДатаЗагрузкиМС,
	|	Сообщения.Статус КАК Статус,
	|	Сообщения.Заголовки КАК Заголовки,
	|	Сообщения.ТелоСообщения КАК ТелоСообщения,
	|	Сообщения.Консьюмер КАК Консьюмер,
	|	Сообщения.Топик КАК Топик,
	|	Сообщения.Раздел КАК Раздел,
	|	Сообщения.Смещение КАК Смещение,
	|	Сообщения.КлючСообщения КАК КлючСообщения,
	|	Сообщения.ДатаЗаписи КАК ДатаЗаписи,
	|	Сообщения.ДатаЗагрузки КАК ДатаЗагрузки,
	|	Сообщения.ДатаОбработки КАК ДатаОбработки,
	|	Сообщения.ДлОбработкиМС КАК ДлОбработкиМС,
	|	Сообщения.ТекстЖурнала КАК ТекстЖурнала,
	|	Сообщения.КоличествоОбработок КАК КоличествоОбработок,
	|	Сообщения.МеткаИзмененияМС КАК МеткаИзмененияМС,
	|	ЕСТЬNULL(Хэши.ХэшСумма, """") КАК ХэшСумма
	|ИЗ
	|	РегистрСведений.кфкВходящиеСообщения КАК Сообщения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.кфкХэшСуммыСообщений КАК Хэши
	|		ПО Сообщения.КлючЗаписи = Хэши.КлючЗаписи
	|ГДЕ
	|	Сообщения.КлючЗаписи = &Ключ
	|	И Сообщения.ДатаЗагрузкиМС = &Метка";
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

#КонецОбласти
