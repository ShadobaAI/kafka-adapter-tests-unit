//  Значение - Число - проверяемая граница.
Процедура ПроизвестиВыгрузкуДанных_ПоложительноеЧисло_ПроверяетГраницу(Значение) Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	ЮТест.ОжидаетЧто(Компоненты.ЭтоМенеджерОбменКФК).Равно(Истина);
	Компоненты.МенеджерОбмена = ют_МенеджерОбменаXDTOДляВыбораПравил;
	Компоненты.ЗаголовкиСообщения.Вставить("СохранятьПустые", Истина);
	ПространствоИмен = "http://v8.fsk.ru/kfk/unit/graph/1.0";
	Компоненты.XMLСхема = ПространствоИмен;
	Компоненты.БазовыеСхемыФормата.Вставить(ПространствоИмен, Истина);
	Правило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	Правило.ОбъектДанных = Неопределено;
	Правило.ОбъектФормата = "ПроверкаОграничений";
	Правило.ПространствоИмен = ПространствоИмен;
	Правило.ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, "ПроверкаОграничений");
	Правило.ЭтоСсылочныйТип = Ложь;
	Правило.СвойстваТабличныхЧастей.Очистить();
	Правило.Свойства.Очистить();
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Наименование";
	ПКС.СвойствоФормата = "name";
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Положительное";
	ПКС.СвойствоФормата = "positive";
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Обязательное";
	ПКС.СвойствоФормата = "required";
	Источник = Новый Структура("Наименование,Положительное,Обязательное",
		"Числовая граница", Значение, "Заполнено");

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	Если Значение > 0 Тогда
		ЮТест.ОжидаетЧто(Результат, СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС))
			.ЭтоНеНеопределено();
		ЮТест.ОжидаетЧто(Результат["positive"]).Равно(Значение);
	Иначе
		Если Значение = 0 И Результат <> Неопределено Тогда
			ЗначениеPositive = Неопределено;
			ЮТест.ОжидаетЧто(Результат.Свойство("positive", ЗначениеPositive)).Равно(Истина);
			ЮТест.ОжидаетЧто(ЗначениеPositive).Равно(0);
		КонецЕсли;
		ЮТест.ОжидаетЧто(Результат).ЭтоНеопределено();
		ЮТест.ОжидаетЧто(Компоненты.ФлагОшибки).Равно(Истина);
		ТекстОшибки = СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС);
		ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "positive") > 0, ТекстОшибки).Равно(Истина);
	КонецЕсли;

КонецПроцедуры

