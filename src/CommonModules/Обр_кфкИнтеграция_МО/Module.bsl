// Проверяет влияние Base64 на тип ответа независимо от флага десериализации.
// Параметры:
//  Десериализовать - Булево - запросить разобранный ответ.
//  КодироватьВBase64 - Булево - запросить тело сообщения в Base64.
Процедура ЧитатьПакетСообщений_ВозвращаетЗапись(Знач Десериализовать, Знач КодироватьВBase64) Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "payload");
	ПодготовитьКонсьюмера(Фикстура);
	Ответ = Фикстура.Интеграция.ЧитатьПакетСообщений(
		1,
		Фикстура.Таймаут,
		КодироватьВBase64,
		Десериализовать);
	Данные = СтруктураОтвета(Ответ, Десериализовать И Не КодироватьВBase64);

	ЮТест.ОжидаетЧто(Данные.count).ИмеетТип("Число").Равно(1);
	ЮТест.ОжидаетЧто(Данные).Свойство("messages").ИмеетТип("Массив").ИмеетДлину(1);
	ОжидаемоеТело = ?(КодироватьВBase64, "cGF5bG9hZA==", "payload");
	ЮТест.ОжидаетЧто(Данные).Свойство("messages[0]").ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Данные).Свойство("messages[0].message").ИмеетТип("Строка").Равно(ОжидаемоеТело);
	ЮТест.ОжидаетЧто(Данные).Свойство("messages[0].key").ИмеетТип("Строка").Равно("key");
	ЮТест.ОжидаетЧто(Данные).Свойство("messages[0].topic").ИмеетТип("Строка").Равно(Фикстура.Топик);
	ЮТест.ОжидаетЧто(Данные).Свойство("messages[0].partition").ИмеетТип("Число").Равно(0);
	ЮТест.ОжидаетЧто(Данные).Свойство("messages[0].offset").ИмеетТип("Число").Равно(0);

КонецПроцедуры

// Проверяет точные границы новой партиции после доставки двух записей.
// Параметры:
//  Десериализовать - Булево - формат ответа.
Процедура ПолучитьГраницыПартиции_ВозвращаетСмещенияДвухЗаписей(Знач Десериализовать) Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "first");
	ОтправитьКонтрольнуюЗапись(Фикстура, "second");
	Ответ = Фикстура.Интеграция.ПолучитьГраницыПартиции(
		Фикстура.Брокеры,
		Фикстура.Топик,
		0,
		Ложь,
		Десериализовать);
	Данные = СтруктураОтвета(Ответ, Десериализовать);

	ЮТест.ОжидаетЧто(Данные.topic).ИмеетТип("Строка").Равно(Фикстура.Топик);
	ЮТест.ОжидаетЧто(Данные.partition).ИмеетТип("Строка").Равно("0");
	ЮТест.ОжидаетЧто(Данные.low_watermark).ИмеетТип("Строка").Равно("0");
	ЮТест.ОжидаетЧто(Данные.high_watermark).ИмеетТип("Строка").Равно("2");
	ЮТест.ОжидаетЧто(Данные.message_count).ИмеетТип("Строка").Равно("2");
	Количество = Фикстура.Интеграция.ПолучитьКоличествоСообщенийВПартиции(Фикстура.Брокеры, Фикстура.Топик, 0);
	ЮТест.ОжидаетЧто(Количество).ИмеетТип("Число").Равно(2);

КонецПроцедуры

