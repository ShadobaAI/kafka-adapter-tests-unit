// Проверяет передачу тела, ключа и заголовков без утечки между входящими сообщениями.
Процедура Десериализация_ДваСообщенияНеСмешиваютСвойства() Экспорт

	Сценарий = НовыйСценарийДедупликации();
	Сценарий.Идемпотентные.Очистить();
	Сценарий.Правило.ИмяМетода =
		"ОМ_кфкФоновыеОперацииСлужебный_ПолучениеОчистка.ют_ДесериализацияДвухСообщений";
	Первый = Сценарий.Выборка.КлючЗаписи;
	Второй = НовыйКлюч();
	Ключи = ЮТМетоды.МассивПараметров(Первый, Второй);
	Тела = ЮТМетоды.МассивПараметров("тело-первое", "тело-второе");
	КлючиСообщений = ЮТМетоды.МассивПараметров("key-1", "key-2");
	ЗаголовкиСообщений = ЮТМетоды.МассивПараметров("trace-1", "trace-2");
	Поток = Новый УникальныйИдентификатор;
	Для Индекс = 0 По 1 Цикл
		Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Сценарий.Выборка);
		Запись.КлючЗаписи = Ключи[Индекс];
		Запись.ДатаЗагрузкиМС = 1000000 + Индекс;
		Запись.Статус = Перечисления.кфкСтатусыСообщений.Новое;
		Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Тела[Индекс]);
		Запись.КлючСообщения = КлючиСообщений[Индекс];
		Заголовки = Новый Соответствие; // Соответствие Из Строка
		Заголовки.Вставить("trace-id", ЗаголовкиСообщений[Индекс]);
		Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Заголовки);
		Запись.Записать();
		Назначение = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
		Назначение.Ключ = Ключи[Индекс];
		Назначение.ВременнаяМетка = 1000000 + Индекс;
		Назначение.ИдентификаторПотока = Поток;
		Назначение.Записать();
	КонецЦикла;

	История = Новый Массив; // Массив Из Структура
	ЮТест.КонтекстТеста().Вставить("ют_ИсторияДесериализации", История);
	Очереди = Новый Структура;
	Очереди.Вставить("Очередь", Сценарий.Очередь);
	Очереди.Вставить("ОчередьПотока", РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей());
	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаДесериализацииВПотоке(Поток, 2);

	кфкФоновыеОперацииСлужебный.ют_ОбработатьПакетВходящих(
		Выборка, Очереди, Поток, Сценарий.Правила, Сценарий.Идемпотентные, Сценарий.Хэши);

	ЮТест.ОжидаетЧто(История).ИмеетДлину(2);
	ЮТест.ОжидаетЧто(История[0].Тело).Равно("тело-первое");
	ЮТест.ОжидаетЧто(История[0].Ключ).Равно("key-1");
	ЮТест.ОжидаетЧто(История[0].Заголовок).Равно("trace-1");
	ЮТест.ОжидаетЧто(История[1].Тело).Равно("тело-второе");
	ЮТест.ОжидаетЧто(История[1].Ключ).Равно("key-2");
	ЮТест.ОжидаетЧто(История[1].Заголовок).Равно("trace-2");
	ЮТест.ОжидаетЧто(История[1].Утечка).Равно(Неопределено);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения")
		.СодержитЗаписи(ЮТест.Предикат().Реквизит("КлючЗаписи").Равно(Первый)
			.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Обработано));
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения")
		.СодержитЗаписи(ЮТест.Предикат().Реквизит("КлючЗаписи").Равно(Второй)
			.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.ОбработкаОтменена));

КонецПроцедуры
