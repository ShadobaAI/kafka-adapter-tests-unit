	ЮТест.ОжидаетЧто(История[1].ЗаголовковДоВызова).Равно(0);
	ЮТест.ОжидаетЧто(История[1].ОшибкаДоВызова).Равно(Ложь);
	ЮТест.ОжидаетЧто(История[1].ПропускДоВызова).Равно(Ложь);

КонецПроцедуры
// Моделирует прикладное правило КД через штатный интерфейс менеджера обмена.
// Параметры:
//  КомпонентыОбмена - см. кфкОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена
//  Источник - Структура - данные сообщения либо строка регистра.
Процедура ПередКонвертацией(КомпонентыОбмена, Источник) Экспорт

	Контекст = ЮТест.КонтекстТеста();
	История = Контекст["ют_ВызовыКД"]; // Массив Из Структура
	КлючДанных = "";
	Если Не Источник.Свойство("Ключ", КлючДанных) Тогда
		КлючДанных = Источник.Идентификатор;
	КонецЕсли;
	Вызов = Новый Структура;
	Вызов.Вставить("КлючДанных", КлючДанных);
	Вызов.Вставить("КлючДоВызова", КомпонентыОбмена.КлючСообщения);
	Вызов.Вставить("ЗаголовковДоВызова", КомпонентыОбмена.ЗаголовкиСообщения.Количество());
	Вызов.Вставить("ОшибкаДоВызова", КомпонентыОбмена.ФлагОшибки);
	Вызов.Вставить("ПропускДоВызова", КомпонентыОбмена.ФлагПропустить);
	История.Добавить(Вызов);
	КомпонентыОбмена.КлючСообщения = КлючДанных;
	КомпонентыОбмена.ЗаголовкиСообщения.Вставить("Источник", КлючДанных);
	Пропустить = Контекст["ют_ПропуститьКД"]; // Булево
	КомпонентыОбмена.ФлагПропустить = Пропустить;
	КомпонентыОбмена.ФлагОшибки = Не Пропустить;
	КомпонентыОбмена.ПротоколКонвертации.Добавить("unit: прикладной исход КД");

КонецПроцедуры
