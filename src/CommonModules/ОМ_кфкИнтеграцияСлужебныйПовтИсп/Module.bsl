// Проверяет ОтбираетМенеджерыИПропускаетОшибки.
Процедура ПолучитьИменаОбщихМодулей_ОтбираетМенеджерыИПропускаетОшибки() Экспорт

	Для Каждого Модуль Из Метаданные.ОбщиеМодули Цикл

		Аргументы = ЮТМетоды.МассивПараметров(Модуль.Имя + ".ВерсияФорматаМенеджераОбмена", Неопределено);
		Если Модуль.Имя = "ОбщегоНазначения" Тогда

			Мокито.Обучение(ОбщегоНазначения)
				.Когда("ВызватьФункциюКонфигурации", Аргументы)
					.ВыброситьИсключение("Метод менеджера отсутствует");

		Иначе

			Версия = "1";
			Если Модуль.Имя = "ОМ_кфкИнтеграцияСлужебныйВызовСервера" Тогда
				Версия = "2";
			ИначеЕсли Модуль.Имя = "ОМ_кфкИнтеграцияСлужебныйПовтИсп" Тогда
				Версия = "2.КФК";
			ИначеЕсли Модуль.Имя = "кфкИнтеграцияСлужебныйПовтИсп"
				Или Модуль.Имя = "ОбщегоНазначенияКлиентСервер" Тогда

				Версия = "2";

			КонецЕсли;
			Мокито.Обучение(ОбщегоНазначения)
				.Когда("ВызватьФункциюКонфигурации", Аргументы)
					.Вернуть(Версия);

		КонецЕсли;

	КонецЦикла;
	Мокито.Прогон();

	Результат = кфкИнтеграцияСлужебныйПовтИсп.ПолучитьИменаОбщихМодулей();

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("ФиксированныйМассив");
	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Результат)
		.Содержит("ОМ_кфкИнтеграцияСлужебныйВызовСервера")
		.Содержит("ОМ_кфкИнтеграцияСлужебныйПовтИсп");
	АргументыКэша = ЮТМетоды.МассивПараметров(
		"кфкИнтеграцияСлужебныйПовтИсп.ВерсияФорматаМенеджераОбмена", Неопределено);
	Мокито.Проверить(ОбщегоНазначения)
		.КоличествоВызовов("ВызватьФункциюКонфигурации", АргументыКэша).Равно(0);
	АргументыОшибки = ЮТМетоды.МассивПараметров(
		"ОбщегоНазначения.ВерсияФорматаМенеджераОбмена", Неопределено);
	Мокито.Проверить(ОбщегоНазначения)
		.КоличествоВызовов("ВызватьФункциюКонфигурации", АргументыОшибки).Равно(1);

КонецПроцедуры

