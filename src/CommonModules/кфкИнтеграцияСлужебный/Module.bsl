#Область СлужебныеПроцедурыИФункции

// См. кфкИнтеграцияСлужебный.Отправить
&Around("Отправить")
Функция ют_Отправить(Продюсер, ИмяТопика, Сообщение, Партиция = -1, Сессии = Неопределено)

	Аргументы = Новый Массив; // Массив Из Произвольный
	Аргументы.Добавить(Продюсер);
	Аргументы.Добавить(ИмяТопика);
	Аргументы.Добавить(Сообщение);
	Аргументы.Добавить(Партиция);
	Аргументы.Добавить(Сессии);
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		кфкИнтеграцияСлужебный,
		"Отправить",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = ПродолжитьВызов(Продюсер, ИмяТопика, Сообщение, Партиция, Сессии);
	Возврат Результат;

КонецФункции

