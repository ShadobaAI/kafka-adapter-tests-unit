//  Десериализовать - Булево - формат отчета.
Процедура ОтправитьПакетСРезультатом_ВозвращаетОтчетОДоставке(Знач Десериализовать) Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	Пакет = НовыйПакетСообщений();
	Ответ = Фикстура.Интеграция.ОтправитьПакетСРезультатом(
		Пакет,
		Фикстура.Топик,
		Фикстура.Таймаут,
		Десериализовать);
	Данные = СтруктураОтвета(Ответ, Десериализовать);

	ЮТест.ОжидаетЧто(Данные.total).ИмеетТип("Строка").Равно("2");
	ЮТест.ОжидаетЧто(Данные.success_count).ИмеетТип("Строка").Равно("2");
	ЮТест.ОжидаетЧто(Данные.failed_count).ИмеетТип("Строка").Равно("0");
	ЮТест.ОжидаетЧто(Данные.results).ИмеетТип("Массив").ИмеетДлину(2);
	Для Индекс = 0 По 1 Цикл

		Доставка = Данные.results[Индекс];
		ЮТест.ОжидаетЧто(Доставка).ИмеетТип("Структура");
		ЮТест.ОжидаетЧто(Доставка.index).ИмеетТип("Строка").Равно(Строка(Индекс));
		ЮТест.ОжидаетЧто(Доставка.offset).ИмеетТип("Строка").Равно(Строка(Индекс));
		ЮТест.ОжидаетЧто(Доставка.partition).ИмеетТип("Строка").Равно("0");
		ЮТест.ОжидаетЧто(Доставка.delivered).ИмеетТип("Строка").Равно("true");
		ЮТест.ОжидаетЧто(Доставка.status).ИмеетТип("Строка").Равно("2");
		ЮТест.ОжидаетЧто(Доставка.key).ИмеетТип("Строка").Равно(Пакет[Индекс].key);
		ЮТест.ОжидаетЧто(Доставка.error).ИмеетТип("Строка").Равно("");

	КонецЦикла;
	ПроверитьПакетВKafka(Фикстура);

КонецПроцедуры

// Проверяет контракты геттеров и агрегированного ответа на одной известной записи.
Процедура ПрочитатьСообщение_ВозвращаетДанныеЗаписи() Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "payload");
	ПодготовитьКонсьюмера(Фикстура);
	ДождатьсяСообщения(Фикстура.Интеграция);

	Интеграция = Фикстура.Интеграция;
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьДанныеСообщения()).ИмеетТип("Строка").Равно("payload");
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьКлючСообщения()).ИмеетТип("Строка").Равно("key");
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьТопикСообщения()).ИмеетТип("Строка").Равно(Фикстура.Топик);
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьРазделСообщения()).ИмеетТип("Число").Равно(0);
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьСмещениеСообщения()).ИмеетТип("Число").Равно(0);
	Метка = Интеграция.ПолучитьВременнуюМеткуСообщения();
	ЮТест.ОжидаетЧто(Метка).ИмеетТип("Число").Больше(0);
	Брокер = Интеграция.ПолучитьИдентификаторБрокераСообщения();
	ЮТест.ОжидаетЧто(Брокер).ИмеетТип("Число");
	ЮТест.ОжидаетЧто(Брокер = 1 Или Брокер = 2).Равно(Истина);

	Данные = Интеграция.ДанныеПрочитанногоСообщения();
	ЮТест.ОжидаетЧто(Данные).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Данные.Тело).ИмеетТип("Строка").Равно("payload");
	ЮТест.ОжидаетЧто(Данные.Ключ).ИмеетТип("Строка").Равно("key");
	ЮТест.ОжидаетЧто(Данные.Топик).ИмеетТип("Строка").Равно(Фикстура.Топик);
	ЮТест.ОжидаетЧто(Данные.Раздел).ИмеетТип("Число").Равно(0);
	ЮТест.ОжидаетЧто(Данные.Смещение).ИмеетТип("Число").Равно(0);
	ЮТест.ОжидаетЧто(Данные.ВременнаяМетка).ИмеетТип("Число").Равно(Метка);
	ЮТест.ОжидаетЧто(Данные.ИдентификаторБрокера).ИмеетТип("Число").Равно(Брокер);

КонецПроцедуры

