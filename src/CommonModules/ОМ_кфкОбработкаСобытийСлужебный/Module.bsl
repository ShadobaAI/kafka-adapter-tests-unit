// Проверяет общий ключ строк регистра накопления одного регистратора и отличие ключа другого документа.
Процедура КлючОбъекта_ОбъединяетСтрокиОдногоРегистратора() Экспорт

	МенеджерРегистра = РегистрыНакопления.кфк_т_ТестовыйРегистрНакопления;
	ПериодДвижений = Дата(2026, 9, 10);
	Регистраторы = Новый Массив; // Массив Из ДокументСсылка.кфк_т_ТестовыйДокумент
	ИдентификаторыСтрок = Новый Массив; // Массив Из Строка
	КоличествоРегистраторов = 2;
	Для НомерРегистратора = 1 По КоличествоРегистраторов Цикл

		Документ = ЮТест.Данные().КонструкторОбъекта(Документы.кфк_т_ТестовыйДокумент)
			.Установить("Дата", ПериодДвижений)
			.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
			.Записать(Ложь, Истина); // ДокументСсылка.кфк_т_ТестовыйДокумент
		Регистраторы.Добавить(Документ);
		ИдентификаторПервойСтроки = Строка(Новый УникальныйИдентификатор);
		ИдентификаторВторойСтроки = Строка(Новый УникальныйИдентификатор);
		ИдентификаторыСтрок.Добавить(ИдентификаторПервойСтроки);
		ИдентификаторыСтрок.Добавить(ИдентификаторВторойСтроки);
		ЮТест.Данные().КонструкторДвижений(Документ, "кфк_т_ТестовыйРегистрНакопления")
			.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
			.ДобавитьСтроку()
				.Установить("Период", ПериодДвижений)
				.Установить("Идентификатор", ИдентификаторПервойСтроки)
				.Установить("Значение", 1)
			.ДобавитьСтроку()
				.Установить("Период", ПериодДвижений)
				.Установить("Идентификатор", ИдентификаторВторойСтроки)
				.Установить("Значение", 2)
			.Записать(Истина);

	КонецЦикла;

	Регистратор = Регистраторы[0];
	ПоляКлюча = Новый Структура("Регистратор,НомерСтроки", Регистратор, 1);
	ПоляКлюча.Вставить("Период", ПериодДвижений);
	ПоляКлюча.Вставить("Идентификатор", ИдентификаторыСтрок[0]);
	КлючПервойСтроки = МенеджерРегистра.СоздатьКлючЗаписи(ПоляКлюча);
	ПоляКлюча.НомерСтроки = 2;
	ПоляКлюча.Идентификатор = ИдентификаторыСтрок[1];
	КлючВторойСтроки = МенеджерРегистра.СоздатьКлючЗаписи(ПоляКлюча);

	ДвоичныйКлюч = кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючПервойСтроки, Ложь);
	СтроковыйКлюч = кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючПервойСтроки, Истина);

	ЮТест.ОжидаетЧто(ТипЗнч(ДвоичныйКлюч)).Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(ТипЗнч(СтроковыйКлюч)).Равно(Тип("Строка"));
	ДлинаХешаSHA256 = 64;
	ЮТест.ОжидаетЧто(СтрДлина(СтроковыйКлюч)).Равно(ДлинаХешаSHA256);
	ЮТест.ОжидаетЧто(СтроковыйКлюч).Равно(ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныйКлюч));
	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючВторойСтроки, Истина))
		.Равно(СтроковыйКлюч);

	ПоляКлюча.Регистратор = Регистраторы[1];
	ПоляКлюча.Идентификатор = ИдентификаторыСтрок[3];
	КлючДругогоРегистратора = МенеджерРегистра.СоздатьКлючЗаписи(ПоляКлюча);

	ЮТест.ОжидаетЧто(КлючПервойСтроки.Регистратор, "Регистратор первой строки фикстуры")
		.Равно(Регистратор);
	ЮТест.ОжидаетЧто(КлючВторойСтроки.Регистратор, "Регистратор второй строки фикстуры")
		.Равно(Регистратор);
	ЮТест.ОжидаетЧто(КлючДругогоРегистратора.Регистратор, "Другой регистратор фикстуры")
		.Равно(ПоляКлюча.Регистратор)
		.НеРавно(Регистратор);

	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючДругогоРегистратора, Истина))
		.НеРавно(СтроковыйКлюч);

КонецПроцедуры

// Параметры:
//  Значение - Произвольный - значение вне прикладных типов.
Процедура КлючОбъекта_ОтклоняетНеприкладныеЗначения(Знач Значение) Экспорт

	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный.КлючОбъекта(Значение, Ложь)).Равно(Неопределено);

КонецПроцедуры

// Проверяет зависимость ключа от периода и измерений, а также согласованность форматов хеша.
//
// Параметры:
//  ИмяПоля - Строка - поле ключа регистра.
//  НовоеЗначение - Строка, Число, Дата - значение того же типа, что и поле ключа.
Процедура КлючОбъекта_УчитываетПоляНезависимогоРегистра(Знач ИмяПоля, Знач НовоеЗначение) Экспорт

	ПоляКлюча = Новый Структура("Период,Строка,Число", Дата(2026, 9, 10), "ORDER-17", 17);
	КлючЗаписи = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьКлючЗаписи(ПоляКлюча);

	ДвоичныйКлюч = кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючЗаписи, Ложь);
	СтроковыйКлюч = кфкОбработкаСобытийСлужебный.КлючОбъекта(КлючЗаписи, Истина);

	ЮТест.ОжидаетЧто(ТипЗнч(ДвоичныйКлюч)).Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(ТипЗнч(СтроковыйКлюч)).Равно(Тип("Строка"));
	ДлинаХешаSHA256 = 64;
	ЮТест.ОжидаетЧто(СтрДлина(СтроковыйКлюч)).Равно(ДлинаХешаSHA256);
	ЮТест.ОжидаетЧто(СтроковыйКлюч).Равно(ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныйКлюч));
	ПовторныйКлюч = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьКлючЗаписи(ПоляКлюча);
	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный.КлючОбъекта(ПовторныйКлюч, Истина))
		.Равно(СтроковыйКлюч);

	ПоляКлюча.Вставить(ИмяПоля, НовоеЗначение);
	ИзмененныйКлюч = РегистрыСведений.кфк_т_ТестовыйРегистрСведений.СоздатьКлючЗаписи(ПоляКлюча);
	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный.КлючОбъекта(ИзмененныйКлюч, Истина))
		.НеРавно(СтроковыйКлюч);

КонецПроцедуры

#КонецОбласти

#Область ОчередьСообщений

// Проверяет отложенную запись и сохранение либо очистку пакетного набора.
//
// Параметры:
//  РежимОчистки - Строка - ПоУмолчанию, Сохранить или Очистить.
Процедура ЗавершитьРегистрацию_ЗаписываетПакетИОбрабатываетОчистку(Знач РежимОчистки) Экспорт

	Продюсеры = НовыеПродюсеры(2);
	Сообщение = кфкИнтеграция.ПараметрыСообщения();
	Сообщение.Ключ = XMLСтрока(Продюсеры[0]);
	Сообщение.Данные = "Заказ подтвержден";
	Сообщение.Заголовки.Вставить("correlation-id", Сообщение.Ключ);
	ТипОбъекта = "ЗаказИнтернетМагазина";
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(Продюсеры, Истина);
	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(Сообщение.Ключ)
		.Получить();
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи(Отбор);

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Сообщение,
		Перечисления.кфкСобытияРегистрации.Программно,
		ТипОбъекта,
		Ложь,
		Параметры);

	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи(Отбор);
	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(Продюсеры.Количество());
	ОчередьДоЗаписи = Параметры.ОчередьИсходящих.Выгрузить();

	Если РежимОчистки = "ПоУмолчанию" Тогда
		кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(Параметры);
	Иначе
		кфкОбработкаСобытийСлужебный.ЗавершитьРегистрацию(Параметры, РежимОчистки = "Очистить");
	КонецЕсли;

	ПроверитьЗаписанныеСообщения(Продюсеры, Сообщение.Ключ, ТипОбъекта);
	ПроверитьХранилищаЗаписанныхСообщений(Сообщение);
	Если РежимОчистки = "Очистить" Тогда
		ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(0);
	Иначе
		ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Выгрузить()).Равно(ОчередьДоЗаписи);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  ПакетныйРежим - Булево - проверять пустой набор или отсутствующую очередь.
Процедура ЗавершитьРегистрацию_ПринимаетОтсутствующуюИПустуюОчередь(Знач ПакетныйРежим) Экспорт

	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(Неопределено, ПакетныйРежим);

	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный)
		.Метод("ЗавершитьРегистрацию", ЮТМетоды.МассивПараметров(Параметры))
		.НеВыбрасываетИсключение();

КонецПроцедуры

// Проверяет немедленную запись готового сообщения всем адресатам.
Процедура ПоместитьВОчередьИсходящих_ЗаписываетБезПакетнойОчереди() Экспорт

	Продюсеры = НовыеПродюсеры(2);
	Сообщение = кфкИнтеграция.ПараметрыСообщения();
	Сообщение.Ключ = XMLСтрока(Продюсеры[0]);
	Сообщение.Данные = "Заказ подтвержден";
	Сообщение.Заголовки.Вставить("correlation-id", Сообщение.Ключ);
	ТипОбъекта = "ЗаказИнтернетМагазина";
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(Продюсеры);
	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(Сообщение.Ключ);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи(Отбор);

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Сообщение,
		Перечисления.кфкСобытияРегистрации.Программно,
		ТипОбъекта,
		Ложь,
		Параметры);

	ПроверитьЗаписанныеСообщения(Продюсеры, Сообщение.Ключ, ТипОбъекта);
	ПроверитьХранилищаЗаписанныхСообщений(Сообщение);
	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих).ЭтоНеопределено();

КонецПроцедуры

// Проверяет выбор адресатов из настроек и добавление второй записи с сохранением первой.
//
// Параметры:
//  КоличествоПродюсеров - Число - число подходящих адресатов.
//  ВерхнийРегистр - Булево - передать тип сообщения в другом регистре букв.
Процедура ПоместитьВОчередьИсходящих_ЗаписываетБезПараметров(Знач КоличествоПродюсеров, Знач ВерхнийРегистр) Экспорт

	ТипОбъекта = "ЗаказИнтернетМагазина_" + Строка(Новый УникальныйИдентификатор);
	Продюсеры = Новый Массив; // Массив Из СправочникСсылка.кфкПродюсеры
	Для Номер = 1 По КоличествоПродюсеров Цикл
		Продюсеры.Добавить(НовыйПродюсерДляРегистрации(ТипОбъекта));
	КонецЦикла;
	НовыйПродюсерДляРегистрации(ТипОбъекта, Истина);
	НовыйПродюсерДляРегистрации(ТипОбъекта, Ложь, Истина);
	НовыйПродюсерДляРегистрации(ТипОбъекта + "_Другой");
	ОбновитьПовторноИспользуемыеЗначения();
	Если ВерхнийРегистр Тогда
		ТипОбъекта = ВРег(ТипОбъекта);
	КонецЕсли;
	ПервоеСообщение = кфкИнтеграция.ПараметрыСообщения();
	ПервоеСообщение.Ключ = Строка(Новый УникальныйИдентификатор);
	ПервоеСообщение.Данные = "Первый заказ";
	ПервоеСообщение.Заголовки.Вставить("correlation-id", ПервоеСообщение.Ключ);
	ВтороеСообщение = кфкИнтеграция.ПараметрыСообщения();
	ВтороеСообщение.Ключ = Строка(Новый УникальныйИдентификатор);
	ВтороеСообщение.Данные = "Второй заказ";
	ВтороеСообщение.Заголовки.Вставить("correlation-id", ВтороеСообщение.Ключ);

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		ПервоеСообщение, Перечисления.кфкСобытияРегистрации.Программно, ТипОбъекта);
	ПроверитьЗаписанныеСообщения(Продюсеры, ПервоеСообщение.Ключ, ТипОбъекта);
	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		ВтороеСообщение, Перечисления.кфкСобытияРегистрации.Программно, ТипОбъекта);

	ПроверитьЗаписанныеСообщения(Продюсеры, ПервоеСообщение.Ключ, ТипОбъекта);
	ПроверитьЗаписанныеСообщения(Продюсеры, ВтороеСообщение.Ключ, ТипОбъекта);
	ПроверитьХранилищаЗаписанныхСообщений(ПервоеСообщение);
	ПроверитьХранилищаЗаписанныхСообщений(ВтороеСообщение);

КонецПроцедуры

// Проверяет отсутствие записей при отсутствии доступного адресата.
//
// Параметры:
//  Режим - Строка - НетНастройки, Заблокирован или Помечен.
Процедура ПоместитьВОчередьИсходящих_НеЗаписываетБезАдресатов(Знач Режим) Экспорт

	ТипОбъекта = "ЗаказИнтернетМагазина_" + Строка(Новый УникальныйИдентификатор);
	Если Режим <> "НетНастройки" Тогда

		НовыйПродюсерДляРегистрации(ТипОбъекта, Режим = "Заблокирован", Режим = "Помечен");

	КонецЕсли;
	ОбновитьПовторноИспользуемыеЗначения();
	Сообщение = кфкИнтеграция.ПараметрыСообщения();
	Сообщение.Ключ = Строка(Новый УникальныйИдентификатор);
	Сообщение.Данные = "Заказ без адресата";

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Сообщение, Перечисления.кфкСобытияРегистрации.Программно, ТипОбъекта);

	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(Сообщение.Ключ);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи(Отбор);

КонецПроцедуры

Процедура ПоместитьВОчередьИсходящих_ОтклоняетНеподдерживаемоеТело() Экспорт

	Сообщение = кфкИнтеграция.ПараметрыСообщения();
	Сообщение.Данные = Неопределено;
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(1), Истина);
	Аргументы = ЮТМетоды.МассивПараметров(
		Сообщение,
		Перечисления.кфкСобытияРегистрации.Программно,
		"ЗаказИнтернетМагазина",
		Ложь,
		Параметры);

	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный)
		.Метод("ПоместитьВОчередьИсходящих", Аргументы)
		.ВыбрасываетИсключение("Неподдерживаемый тип передачи данных!");
	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(0);

КонецПроцедуры

// Параметры:
//  Значение - Произвольный - значение вне прикладных типов.
Процедура ПоместитьВОчередьИсходящих_ПропускаетНеприкладныеЗначения(Знач Значение) Экспорт

	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(1), Истина);
	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Значение,
		Перечисления.кфкСобытияРегистрации.Программно,
		"",
		Ложь,
		Параметры);

	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(0);

КонецПроцедуры

Процедура ПоместитьВОчередьИсходящих_ТребуетТипПроизвольногоСообщения() Экспорт

	Сообщение = Новый Структура("Заказ", "ORDER-17");
	Аргументы = ЮТМетоды.МассивПараметров(Сообщение, Перечисления.кфкСобытияРегистрации.Программно);

	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный)
		.Метод("ПоместитьВОчередьИсходящих", Аргументы)
		.ВыбрасываетИсключение("В произвольном режиме необходимо явно указать тип объекта!");

КонецПроцедуры

// Параметры:
//  ЯвныйКлюч - Булево - сообщение с заданным ключом или ключом по телу.
Процедура ПоместитьВОчередьИсходящих_ФормируетГотовоеСообщение(Знач ЯвныйКлюч) Экспорт

	Сообщение = кфкИнтеграция.ПараметрыСообщения();
	Сообщение.Данные = "ORDER-17";
	Сообщение.Ключ = ?(ЯвныйКлюч, "order-17", "");
	Сообщение.Заголовки.Вставить("correlation-id", "registration-17");
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(2), Истина);
	ТипОбъекта = "ЗаказИнтернетМагазина";

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Сообщение,
		Перечисления.кфкСобытияРегистрации.Программно,
		ТипОбъекта,
		Ложь,
		Параметры);

	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(2);
	Для Каждого Запись Из Параметры.ОчередьИсходящих Цикл

		ПроверитьОбщиеПоляОчереди(Запись, ТипОбъекта);
		ЮТест.ОжидаетЧто(Запись.Статус).Равно(Перечисления.кфкСтатусыСообщений.Обработано);
		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ТелоСообщения))
			.Равно(Сообщение.Данные);
		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.Заголовки))
			.Равно(Сообщение.Заголовки);
		Если ЯвныйКлюч Тогда
			ЮТест.ОжидаетЧто(Запись.КлючОбъекта).Равно(Сообщение.Ключ);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Параметры:
//  КоличествоПродюсеров - Число - число адресатов сообщения.
Процедура ПоместитьВОчередьИсходящих_ФормируетОчередьПроизвольногоСообщения(Знач КоличествоПродюсеров) Экспорт

	Сообщение = Новый Структура("Заказ", "ORDER-17");
	Параметры = кфкОбработкаСобытийСлужебный.ПараметрыРегистрации(НовыеПродюсеры(КоличествоПродюсеров), Истина);
	ТипОбъекта = "ЗаказИнтернетМагазина";

	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Сообщение,
		Перечисления.кфкСобытияРегистрации.Программно,
		ТипОбъекта,
		Ложь,
		Параметры);

	ЮТест.ОжидаетЧто(Параметры.ОчередьИсходящих.Количество()).Равно(КоличествоПродюсеров);
	Для Каждого Запись Из Параметры.ОчередьИсходящих Цикл

		ПроверитьОбщиеПоляОчереди(Запись, ТипОбъекта);
		ЮТест.ОжидаетЧто(Параметры.Продюсеры).Содержит(Запись.Продюсер);
		ЮТест.ОжидаетЧто(Запись.Статус).Равно(Перечисления.кфкСтатусыСообщений.Новое);
		ЮТест.ОжидаетЧто(Запись.ТипИсходныхДанных).Равно("Структура");
		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные))
			.Равно(Сообщение);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает незаписанные ссылки: формирование очереди не требует записей продюсеров.
//
// Параметры:
//  КоличествоПродюсеров - Число - число адресатов.
//
// Возвращаемое значение:
//  Массив Из СправочникСсылка.кфкПродюсеры
Функция НовыеПродюсеры(Знач КоличествоПродюсеров)

	Результат = Новый Массив; // Массив Из СправочникСсылка.кфкПродюсеры
	Для Номер = 1 По КоличествоПродюсеров Цикл
		Результат.Добавить(Справочники.кфкПродюсеры.ПолучитьСсылку(Новый УникальныйИдентификатор));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создает отдельного продюсера по схеме существующей фикстуры тестового справочника.
//
// Параметры:
//  ТипОбъекта - Строка - тип регистрируемого сообщения.
//  Блокировать - Булево - исключить продюсера из регистрации.
//  ПометкаУдаления - Булево - исключить помеченного продюсера.
//
// Возвращаемое значение:
//  СправочникСсылка.кфкПродюсеры
Функция НовыйПродюсерДляРегистрации(Знач ТипОбъекта, Знач Блокировать = Ложь, Знач ПометкаУдаления = Ложь)

	Результат = ЮТест.Данные().КонструкторОбъекта(Справочники.кфкПродюсеры)
		.Установить("Наименование", "Проверка регистрации " + Строка(Новый УникальныйИдентификатор))
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Установить("БлокироватьРегистрацию", Блокировать)
		.Установить("ПометкаУдаления", ПометкаУдаления)
		.ТабличнаяЧасть("ОбъектыМетаданных")
			.ДобавитьСтроку()
				.Установить("ТипОбъект", ТипОбъекта)
				.Установить("ИмяТопика", "yaxunit.event-registration")
		.Записать(Ложь, Истина); // СправочникСсылка.кфкПродюсеры

	Возврат Результат;

КонецФункции

// Проверяет записанные сообщения каждого адресата по уникальному ключу сценария.
// 
// Параметры:
//  Продюсеры - Массив Из СправочникСсылка.кфкПродюсеры
//  КлючСообщения - Строка - уникальный ключ готового сообщения.
//  ТипОбъекта - Строка - тип сообщения.
Процедура ПроверитьЗаписанныеСообщения(Знач Продюсеры, Знач КлючСообщения, Знач ТипОбъекта)

	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(КлючСообщения);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитНесколькоЗаписей(Продюсеры.Количество(), Отбор);

	Для Каждого Продюсер Из Продюсеры Цикл

		ПоляЗаписи = ЮТест.Предикат()
			.Реквизит("КлючОбъекта").Равно(КлючСообщения)
			.Реквизит("Продюсер").Равно(Продюсер)
			.Реквизит("ТипОбъект").Равно(ТипОбъекта)
			.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Обработано)
			.Реквизит("СобытиеРегистрации").Равно(Перечисления.кфкСобытияРегистрации.Программно)
			.Реквизит("ДатаРегистрацииМС").Больше(0);
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.СодержитНесколькоЗаписей(1, ПоляЗаписи);

	КонецЦикла;

КонецПроцедуры

// Подготавливает объект и проверяет сообщения, созданные одним вызовом подписки.
//
// Параметры:
//  ЭтоУдаление - Булево - вызвать подписку удаления.
//  ПричинаПропуска - Строка - условие запрета регистрации или пустая строка.
Процедура ПроверитьЗаписиПодписки(Знач ЭтоУдаление, Знач ПричинаПропуска)

	Источник = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "Проверка подписки")
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина); // СправочникОбъект.кфк_т_ТестовыйСправочник
	Источник.ДополнительныеСвойства.Удалить("кфкПропуститьРегистрацию");
	Ссылка = Источник.Ссылка;
	Отказ = ПричинаПропуска = "Отказ";
	Если ПричинаПропуска = "НетПродюсера" Тогда

		Продюсер = кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника().ПолучитьОбъект();
		Продюсер.БлокироватьРегистрацию = Истина;
		Продюсер.ОбменДанными.Загрузка = Истина;
		Продюсер.Записать();

	ИначеЕсли ПричинаПропуска <> ""
		И ПричинаПропуска <> "Отказ"
		И ПричинаПропуска <> "ИнтеграцияВыключена" Тогда

		// Запрет определяется наличием свойства, даже если его значение равно Ложь.
		Источник.ДополнительныеСвойства.Вставить(ПричинаПропуска, Ложь);

	КонецЕсли;
	ОбновитьПовторноИспользуемыеЗначения();

	Если ЭтоУдаление Тогда
		кфкОбработкаСобытийСлужебный.ЗарегистрироватьИзмененияПередУдалением(Источник, Отказ);
	Иначе
		кфкОбработкаСобытийСлужебный.ЗарегистрироватьИзмененияПриЗаписи(Источник, Отказ);
	КонецЕсли;

	ЮТест.ОжидаетЧто(Отказ).Равно(ПричинаПропуска = "Отказ");
	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(XMLСтрока(Ссылка));
	Если ПричинаПропуска <> "" Тогда

		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.НеСодержитЗаписи(Отбор);
		Возврат;

	КонецЕсли;
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитНесколькоЗаписей(1, Отбор);
	ПоляЗаписи = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(XMLСтрока(Ссылка))
		.Реквизит("Продюсер").Равно(кфк_т_ТестовыеДанные.СсылкаПродюсераСправочника())
		.Реквизит("ЭтоУдаление").Равно(ЭтоУдаление)
		.Реквизит("СобытиеРегистрации").Равно(Перечисления.кфкСобытияРегистрации.ПриЗаписи)
		.Реквизит("Статус").Равно(Перечисления.кфкСтатусыСообщений.Новое);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитНесколькоЗаписей(1, ПоляЗаписи);

КонецПроцедуры

// Параметры:
//  Запись - РегистрСведенийЗапись.кфкИсходящиеСообщения - результат регистрации.
//  ТипОбъекта - Строка - тип сообщения.
Процедура ПроверитьОбщиеПоляОчереди(Знач Запись, Знач ТипОбъекта)

	ЮТест.ОжидаетЧто(Запись.ТипОбъект).Равно(ТипОбъекта);
	ЮТест.ОжидаетЧто(Запись.СобытиеРегистрации).Равно(Перечисления.кфкСобытияРегистрации.Программно);
	ЮТест.ОжидаетЧто(Запись.ДатаРегистрацииМС > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Запись.МеткаИзмененияМС).Равно(Запись.ДатаРегистрацииМС);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Запись.ДатаРегистрации)).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрДлина(Запись.КлючЗаписи)).Равно(64);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Запись.КлючОбъекта)).Равно(Истина);

КонецПроцедуры

// Изолирует записи подписки, сохраняя возможность изменить опцию до транзакции.
//
// Параметры:
//  ЭтоУдаление - Булево - вызвать подписку удаления.
//  ПричинаПропуска - Строка - условие запрета регистрации или пустая строка.
Процедура ПроверитьПодпискуВОткатываемойТранзакции(Знач ЭтоУдаление, Знач ПричинаПропуска)

	НачатьТранзакцию();
	Попытка

		ПроверитьЗаписиПодписки(ЭтоУдаление, ПричинаПропуска);

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;
	ОтменитьТранзакцию();

КонецПроцедуры

// Проверяет результат подписки по уникальной ссылке записанного тестового объекта.
//
// Параметры:
//  ЭтоУдаление - Булево - вызвать подписку удаления.
//  ПричинаПропуска - Строка - условие запрета регистрации или пустая строка.
Процедура ПроверитьРегистрациюПодписки(Знач ЭтоУдаление, Знач ПричинаПропуска)

	ИсходнаяОпция = Константы.кфкИспользоватьИнтеграцию.Получить();
	Попытка

		// Функциональная опция должна увидеть зафиксированное значение константы.
		Константы.кфкИспользоватьИнтеграцию.Установить(ПричинаПропуска <> "ИнтеграцияВыключена");
		ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию"))
			.Равно(ПричинаПропуска <> "ИнтеграцияВыключена");
		ПроверитьПодпискуВОткатываемойТранзакции(ЭтоУдаление, ПричинаПропуска);

	Исключение

		Константы.кфкИспользоватьИнтеграцию.Установить(ИсходнаяОпция);
		ВызватьИсключение;

	КонецПопытки;
	Константы.кфкИспользоватьИнтеграцию.Установить(ИсходнаяОпция);

КонецПроцедуры

// Проверяет содержимое хранилищ после чтения сообщений из базы.
// Количество строк и адресаты проверяются в ПроверитьЗаписанныеСообщения.
//
// Параметры:
//  Сообщение - см. кфкИнтеграция.ПараметрыСообщения
Процедура ПроверитьХранилищаЗаписанныхСообщений(Знач Сообщение)

	Отбор = ЮТест.Предикат()
		.Реквизит("КлючОбъекта").Равно(Сообщение.Ключ);
	// Утверждения таблицы базы не распаковывают хранилища в условиях запроса.
	Записи = ЮТЗапросы.Записи("РегистрСведений.кфкИсходящиеСообщения", Отбор);
	Для Каждого Запись Из Записи Цикл

		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ТелоСообщения))
			.Равно(Сообщение.Данные);
		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.Заголовки))
			.Равно(Сообщение.Заголовки);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
