		.Установить("Наименование", "Проверка UUID")
		.Установить("Перечисление", Перечисления.кфк_т_ТестовоеПеречисление.Значение1)
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина);
	Идентификатор = Строка(Источник.Ссылка.УникальныйИдентификатор());
	Если Вариант = "Длина" Тогда
		НедопустимоеЗначение = Лев(Идентификатор, 35);
	Иначе
		НедопустимоеЗначение = "g" + Сред(Идентификатор, 2);
	КонецЕсли;
	Компоненты.ЗаголовкиСообщения.Вставить("ТестовоеЗначение", НедопустимоеЗначение);

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	ЮТест.ОжидаетЧто(Результат).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Компоненты.ФлагОшибки).Равно(Истина);
	ТекстОшибки = СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "ref") > 0, ТекстОшибки).Равно(Истина);

КонецПроцедуры

