// Проверяет владельца, статус, метку, занятость, порядок и лимит входящей выборки.
Процедура ВыборкаДесериализации_ОтбираетСвободныеВПорядкеМетки() Экспорт

	СвойКонсьюмер = НовыйКонсьюмер();
	ЧужойКонсьюмер = НовыйКонсьюмер();
	НовыйСтатус = Перечисления.кфкСтатусыСообщений.Новое;
	Первый = НовыйКлюч();
	Второй = НовыйКлюч();
	Третий = НовыйКлюч();
	Ранний = НовыйКлюч();
	Чужой = НовыйКлюч();
	Завершенный = НовыйКлюч();
	Занятый = НовыйКлюч();
	ЗаписатьВходящееДляВыборки(СвойКонсьюмер, Первый, 1000000, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(СвойКонсьюмер, Второй, 1000001, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(СвойКонсьюмер, Третий, 1000002, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(СвойКонсьюмер, Ранний, 999999, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(ЧужойКонсьюмер, Чужой, 1000000, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(СвойКонсьюмер, Завершенный, 1000000,
		Перечисления.кфкСтатусыСообщений.Обработано);
	ЗаписатьВходящееДляВыборки(СвойКонсьюмер, Занятый, 1000000, НовыйСтатус);
	ЗаписатьНазначение(Занятый);
	Консьюмеры = ЮТМетоды.МассивПараметров(СвойКонсьюмер);

	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаДесериализации(
		Консьюмеры, 2, 1000000);
	ЮТест.ОжидаетЧто(КлючиВыборки(Выборка)).Равно(ЮТМетоды.МассивПараметров(Первый, Второй));
	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаДесериализации(
		Консьюмеры, 3, 1000000);
	ЮТест.ОжидаетЧто(КлючиВыборки(Выборка)).Равно(ЮТМетоды.МассивПараметров(Первый, Второй, Третий));
	Для Каждого Ключ Из ЮТМетоды.МассивПараметров(Ранний, Чужой, Завершенный, Занятый) Цикл
		ПроверитьНаличиеЗаписи(Истина, Ключ);
	КонецЦикла;

КонецПроцедуры
// Проверяет связь назначения с полным ключом записи и UUID потока.
Процедура ВыборкаДесериализацииВПотоке_УчитываетКлючДатуИПоток() Экспорт

	Консьюмер = НовыйКонсьюмер();
	НовыйСтатус = Перечисления.кфкСтатусыСообщений.Новое;
	Поток = Новый УникальныйИдентификатор;
	ЧужойПоток = Новый УникальныйИдентификатор;
	Первый = НовыйКлюч();
	Второй = НовыйКлюч();
	Чужой = НовыйКлюч();
	ЗаписатьВходящееДляВыборки(Консьюмер, Первый, 999999, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(Консьюмер, Первый, 1000000, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(Консьюмер, Второй, 1000001, НовыйСтатус);
	ЗаписатьВходящееДляВыборки(Консьюмер, Чужой, 1000000, НовыйСтатус);
	Для Каждого Пара Из ЮТМетоды.МассивПараметров(
		Новый Структура("Ключ,Метка,Поток", Первый, 1000000, Поток),
		Новый Структура("Ключ,Метка,Поток", Второй, 1000001, Поток),
		Новый Структура("Ключ,Метка,Поток", Чужой, 1000000, ЧужойПоток)) Цикл
		Назначение = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
		Назначение.Ключ = Пара.Ключ;
		Назначение.ВременнаяМетка = Пара.Метка;
		Назначение.ИдентификаторПотока = Пара.Поток;
		Назначение.Записать();
	КонецЦикла;

	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаДесериализацииВПотоке(Поток, 1);
	ЮТест.ОжидаетЧто(Выборка.Следующий()).Равно(Истина);
	ЮТест.ОжидаетЧто(Выборка.КлючЗаписи).Равно(Первый);
	ЮТест.ОжидаетЧто(Выборка.ДатаЗагрузкиМС).Равно(1000000);
	ЮТест.ОжидаетЧто(Выборка.Следующий()).Равно(Ложь);
	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаДесериализацииВПотоке(Поток, 2);
	ЮТест.ОжидаетЧто(КлючиВыборки(Выборка)).Равно(ЮТМетоды.МассивПараметров(Первый, Второй));
	ПроверитьНаличиеЗаписи(Истина, Чужой);

КонецПроцедуры
// Проверяет сохранность данных при выполнении операции.
Процедура ДобавитьВходящееСообщениеВОчередь_СохраняетПолезнуюНагрузку() Экспорт

	Сообщение = НовоеСообщение();
	Консьюмер = НовыйКонсьюмер();
	Очередь = РегистрыСведений.кфкВходящиеСообщения.СоздатьНаборЗаписей();
	ДатаЗагрузки = Дата(2026, 1, 2, 3, 4, 5);

	кфкФоновыеОперацииСлужебный.ют_ДобавитьВходящееСообщение(
		Очередь, Консьюмер, Сообщение, ДатаЗагрузки, 1000000, 1);

	ЮТест.ОжидаетЧто(Очередь.Количество()).Равно(1);
	Запись = Очередь[0];
	ЮТест.ОжидаетЧто(Запись.Консьюмер).Равно(Консьюмер);
	ЮТест.ОжидаетЧто(Запись.Топик).Равно(Сообщение.topic);
	ЮТест.ОжидаетЧто(Запись.Раздел).Равно(2);
	ЮТест.ОжидаетЧто(Запись.Смещение).Равно(17);
	ЮТест.ОжидаетЧто(Запись.КлючСообщения).Равно("Ключ-17");
	ЮТест.ОжидаетЧто(Запись.ДатаЗаписи).Равно(МестноеВремя(Дата(1970, 1, 3)));
	ЮТест.ОжидаетЧто(Запись.ДатаЗагрузки).Равно(ДатаЗагрузки);
	ЮТест.ОжидаетЧто(Запись.ДатаЗагрузкиМС).Равно(1000000.0001);
	ЮТест.ОжидаетЧто(Запись.МеткаИзмененияМС).Равно(1000000);
	Тело = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ТелоСообщения); // ДвоичныеДанные
	ЮТест.ОжидаетЧто(ТипЗнч(Тело)).Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(Base64Строка(Тело)).Равно("AAECf4D/");
	Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.Заголовки); // Соответствие
	ЮТест.ОжидаетЧто(Заголовки.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Заголовки.Получить("trace-id")).Равно("трасса-17");
	ЮТест.ОжидаетЧто(Заголовки.Получить("content-type")).Равно("application/octet-stream");
	ЮТест.ОжидаетЧто(Запись.Статус).Равно(Перечисления.кфкСтатусыСообщений.Новое);

КонецПроцедуры

