	ПроверитьНазначение(Своя, Поток, Истина);

КонецПроцедуры
// Проверяет связь назначения с UUID и датой исходной регистрации.
Процедура ВыборкаОтправкиВПотоке_УчитываетПолныйКлюч() Экспорт

	Продюсер = НовыйПродюсер();
	Поток = Новый УникальныйИдентификатор;
	Своя = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 1000);
	Чужая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 1001);
	Старая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 1002);
	НазначитьСообщение(Своя, Поток);
	НазначитьСообщение(Чужая, Новый УникальныйИдентификатор);
