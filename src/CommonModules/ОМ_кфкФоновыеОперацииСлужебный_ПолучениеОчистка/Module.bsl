// Проверяет удаление только до порога нужного направления.
// Параметры:
//  Входящие - Булево
Процедура ВыборкаУстаревшихСообщений_СохраняетГраницуИЧужойСтатус(Входящие) Экспорт

	Параметры = НовыеПараметрыОчистки();
	ЗаписатьПозицииЛогов();
	Если Входящие Тогда
		Параметры.СрокХраненияОбработанных = -2;
		Порог = 2000000;
		Статус = Перечисления.кфкСтатусыСообщений.Обработано;
	Иначе
		Параметры.СрокХраненияОтправленных = -2;
		Порог = 1000000;
		Статус = Перечисления.кфкСтатусыСообщений.Выгружено;
	КонецЕсли;
	ДоПорога = НоваяЗаписьОчереди(Входящие, Порог - 1, Статус);
	НаПороге = НоваяЗаписьОчереди(Входящие, Порог, Статус);
	ПослеПорога = НоваяЗаписьОчереди(Входящие, Порог + 1, Статус);
	Незавершенная = НоваяЗаписьОчереди(Входящие, Порог - 2, Перечисления.кфкСтатусыСообщений.Новое);
	ЧужойСтатус = НоваяЗаписьОчереди(Входящие, Порог - 3, Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);

	Выборка = ВыборкаОчистки(Входящие, Параметры, 1000);
	Ключи = КлючиВыборки(Выборка);
	ЮТест.ОжидаетЧто(Ключи.Найти(ДоПорога)).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Ключи.Найти(НаПороге)).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Ключи.Найти(ПослеПорога)).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Ключи.Найти(Незавершенная)).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Ключи.Найти(ЧужойСтатус)).Равно(Неопределено);

	ПроверитьНаличиеЗаписи(Входящие, НаПороге);
	ПроверитьНаличиеЗаписи(Входящие, ПослеПорога);
	ПроверитьНаличиеЗаписи(Входящие, Незавершенная);
	ПроверитьНаличиеЗаписи(Входящие, ЧужойСтатус);

КонецПроцедуры

