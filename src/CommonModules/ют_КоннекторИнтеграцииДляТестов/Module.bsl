#Область СлужебныеПроцедурыИФункции

// Параметры:
//  Метод - Строка - имя метода внешнего API.
//  Параметры - Массив Из Произвольный - фактически полученные аргументы.
// Возвращаемое значение:
//  Произвольный - ответ сценария.
Функция ОтветНаВызов(Знач Метод, Знач Параметры)

	Состояние = ЮТест.КонтекстТеста()["ют_КоннекторИнтеграции"]; // см. НовоеСостояние
	Вызов = Новый Структура("Метод,Параметры", Метод, Параметры);
	Состояние.Вызовы.Добавить(Вызов);
	Если Метод = "ПолучитьСообщениеОбОшибке" Тогда
		Возврат Состояние.Ошибка;
	КонецЕсли;

	Результат = Состояние.Ответ;
	Возврат Результат;

КонецФункции

#КонецОбласти
