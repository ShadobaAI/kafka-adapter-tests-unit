	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		кфкФоновыеОперацииСлужебный, "ОграничениеУказательПередВыгрузкойЛогов",
		Аргументы, ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат ПродолжитьВызов();

КонецФункции
// Изолирует запуск потоков при проверке опций регламентного задания.
&Вместо("ЗапуститьПотоки")
Процедура ют_ПерехватЗапускаПотоков()

	ПрерватьВыполнение = Ложь;
	МокитоПерехват.АнализВызова(кфкФоновыеОперацииСлужебный,
		"ЗапуститьПотоки", Новый Массив, ПрерватьВыполнение);
	Если Не ПрерватьВыполнение Тогда
		ПродолжитьВызов();
	КонецЕсли;

КонецПроцедуры
// Изолирует платформенный запуск в тесте диспетчера, сохраняя реальный запуск без мока.
// Параметры:
//  Ключ - Строка - Ключ задания.
//  ИмяМетода - Строка - Точка входа.
//  Наименование - Строка - Представление.
//  Параметры - Неопределено, Массив Из Произвольный - Параметры задания.
// Возвращаемое значение:
//  Неопределено, ФоновоеЗадание - Реальное задание или ответ границы теста.
&Вместо("ЗапуститьФЗ")
Функция ют_ПерехватЗапускаФЗ(Ключ, ИмяМетода, Наименование, Параметры = Неопределено)

	Аргументы = ЮТМетоды.МассивПараметров(Ключ, ИмяМетода, Наименование, Параметры);
	Аргументы = ЮТКоллекции.СкопироватьРекурсивно(Аргументы);
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(кфкФоновыеОперацииСлужебный,
		"ЗапуститьФЗ", Аргументы, ПрерватьВыполнение);
	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат ПродолжитьВызов(Ключ, ИмяМетода, Наименование, Параметры);

КонецФункции

#КонецОбласти
