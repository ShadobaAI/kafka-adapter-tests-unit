// Обязательное поле не допускает отсутствия и Null; nullable допускает явный Null.
// Параметры:
//  Вариант - Строка - вариант отсутствия или Null.
Процедура ПроизвестиВыгрузкуДанных_ОбязательностьИНулевоеЗначение_СоблюдаетСхему(Вариант) Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	Компоненты.ОтключитьПреобразованиеВNull = Истина;
	ПространствоИмен = "http://v8.fsk.ru/kfk/unit/graph/1.0";
	Компоненты.XMLСхема = ПространствоИмен;
	Компоненты.БазовыеСхемыФормата.Вставить(ПространствоИмен, Истина);
	Правило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	Правило.ОбъектДанных = Неопределено;
	Правило.ОбъектФормата = "ПроверкаОграничений";
	Правило.ПространствоИмен = ПространствоИмен;
	Правило.ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, "ПроверкаОграничений");
	Правило.ЭтоСсылочныйТип = Ложь;
	Правило.СвойстваТабличныхЧастей.Очистить();
	Правило.Свойства.Очистить();
	ПКС = Правило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Наименование";
	ПКС.СвойствоФормата = "name";
	Источник = Новый Структура("Наименование", "Обязательность");
	Если Вариант <> "НетОбязательного" Тогда
		ПКС = Правило.Свойства.Добавить();
		ПКС.СвойствоКонфигурации = "Обязательное";
		ПКС.СвойствоФормата = "required";
		Источник.Вставить("Обязательное",
			?(Вариант = "NullВОбязательном", Null, "Заполнено"));
	КонецЕсли;
	Если Вариант = "NullВNullable" Тогда
		ПКС = Правило.Свойства.Добавить();
		ПКС.СвойствоКонфигурации = "ДопустимоеNull";
		ПКС.СвойствоФормата = "nullable";
		Источник.Вставить("ДопустимоеNull", Null);
	КонецЕсли;

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	Если Вариант = "NullВNullable" Тогда
		ЮТест.ОжидаетЧто(Результат, СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС))
			.ЭтоНеНеопределено();
		ЮТест.ОжидаетЧто(Результат["nullable"]).Равно(Неопределено);
		ТелоJSON = кфкОбщегоНазначенияСлужебный.ЗначениеВJSON(Результат);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоJSON);
		ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
		ЮТест.ОжидаетЧто(ТипЗнч(ДанныеJSON)).Равно(Тип("Структура"));
		ДопустимоеNull = Неопределено;
		ЮТест.ОжидаетЧто(ДанныеJSON.Свойство("nullable", ДопустимоеNull)).Равно(Истина);
		ЮТест.ОжидаетЧто(ДопустимоеNull).Равно(Неопределено);
		ЮТест.ОжидаетЧто(СтрНайти(ТелоJSON, """nullable"":null") > 0, ТелоJSON).Равно(Истина);
	Иначе
		ЮТест.ОжидаетЧто(Результат).ЭтоНеопределено();
		ЮТест.ОжидаетЧто(Компоненты.ФлагОшибки).Равно(Истина);
		ТекстОшибки = СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС);
		ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "required") > 0, ТекстОшибки).Равно(Истина);
	КонецЕсли;

КонецПроцедуры

