// Проверяет наличие записи и флаг загрузки после ответа транспорта.
// Параметры:
//  ПустойПакет - Булево
Процедура ОбработчикЗагрузкиПакетСообщений_СогласуетПризнакЗагрузки(ПустойПакет) Экспорт

	Консьюмер = НовыйКонсьюмер();
	Сообщение = НовоеСообщение();
	Сессии = Новый Соответствие;
	ПодготовитьЧтение(Консьюмер, Сообщение, ПустойПакет, Сессии);
	Очередь = РегистрыСведений.кфкВходящиеСообщения.СоздатьНаборЗаписей();
	Консьюмеры = Новый Массив; // Массив Из СправочникСсылка.кфкКонсьюмеры
	Консьюмеры.Добавить(Консьюмер);
	Загружено = Истина;

	кфкФоновыеОперацииСлужебный.ют_ЗагрузитьПакет(Консьюмеры, Сессии, Очередь, 2, Загружено);

	ЮТест.ОжидаетЧто(Загружено).Равно(Не ПустойПакет);
	Предикат = ЮТест.Предикат().Реквизит("Консьюмер").Равно(Консьюмер)
		.Реквизит("Топик").Равно(Сообщение.topic);
	Если ПустойПакет Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения").НеСодержитЗаписи(Предикат);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения").СодержитЗаписи(Предикат);
	КонецЕсли;

