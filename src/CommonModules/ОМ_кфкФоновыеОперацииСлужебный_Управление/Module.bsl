// Проверяет точный состав закрываемых сессий на границе транспорта.
// Параметры:
//  СохранитьПервый - Булево - Нужен ли первый консьюмер.
//  СохранитьВторой - Булево - Нужен ли второй консьюмер.
Процедура ЗакрытьСессииКонсьюмераПараллельногоПотока_ЗакрываетТолькоУдаленные(
		СохранитьПервый, СохранитьВторой) Экспорт

	Первый = НоваяСсылкаКонсьюмера();
	Второй = НоваяСсылкаКонсьюмера();
	Сессии = Новый Соответствие;
	Сессии.Вставить(Первый, Неопределено);
	Сессии.Вставить(Второй, Неопределено);
	Консьюмеры = Новый Массив; // Массив Из СправочникСсылка.кфкКонсьюмеры
	Ожидаемые = Новый Соответствие;
	Если СохранитьПервый Тогда
		Консьюмеры.Добавить(Первый);
	Иначе
		Ожидаемые.Вставить(Первый, Неопределено);
	КонецЕсли;
	Если СохранитьВторой Тогда
		Консьюмеры.Добавить(Второй);
	Иначе
		Ожидаемые.Вставить(Второй, Неопределено);
	КонецЕсли;
	Мокито.Обучение(кфкИнтеграцияСлужебный);
	МокитоОбучение.Когда("ЗакрытьСессииКонсьюмера");
	МокитоОбучение.Вернуть(Неопределено);
	Мокито.Прогон();

	кфкФоновыеОперацииСлужебный.ют_ЗакрытьНенужныеСессииКонсьюмера(Сессии, Консьюмеры);

	ЮТест.ОжидаетЧто(Сессии.Количество()).Равно(Консьюмеры.Количество());
	Для Каждого Сессия Из Сессии Цикл
		ЮТест.ОжидаетЧто(Консьюмеры.Найти(Сессия.Ключ) <> Неопределено).Равно(Истина);
	КонецЦикла;
	Мокито.Проверить(кфкИнтеграцияСлужебный);
	МокитоПроверки.КоличествоВызовов("ЗакрытьСессииКонсьюмера", ЮТМетоды.МассивПараметров(Ожидаемые));
	МокитоПроверки.Равно(1);

КонецПроцедуры

