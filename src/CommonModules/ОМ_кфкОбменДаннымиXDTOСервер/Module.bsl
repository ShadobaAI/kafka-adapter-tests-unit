// Неверная длина или лексический шаблон UUID указывают поле в протоколе.
// Параметры:
//  Вариант - Строка - вид неверного UUID.
Процедура ПроизвестиВыгрузкуДанных_НеверныйUUID_СообщаетОПоле(Вариант) Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	Компоненты.МенеджерОбмена = ют_МенеджерОбменаXDTOДляВыбораПравил;
	Компоненты.ЗаголовкиСообщения.Вставить("ТестовоеПоле", "ref");
