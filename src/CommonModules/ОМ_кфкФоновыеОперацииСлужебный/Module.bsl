// Восстанавливает настройки внешних зависимостей после каждого теста.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();
	Контекст = ЮТест.КонтекстТеста();
	Если Контекст.Свойство("ют_HTTPСессияTelegram") Тогда
		Контекст.Удалить("ют_HTTPСессияTelegram");
		Контекст.Удалить("ют_TelegramСервер");
		Контекст.Удалить("ют_TelegramТаймаут");
		Контекст.Удалить("ют_TelegramTLS");
	КонецЕсли;

КонецПроцедуры

#Область ПозицииОпераций

// Проверяет раздел операции на двух разных сохраненных настройках без повторения алгоритма хеширования.
Процедура ПолучитьРазделОперации_НеЗависитОтПорядка() Экспорт

	Первый = НовыйПродюсер("Первый");
	Второй = НовыйПродюсер("Второй");

	Исходный = кфкФоновыеОперацииСлужебный.ют_РазделОперации(НастройкиОперации(Первый, Второй));
	Переставленный = кфкФоновыеОперацииСлужебный.ют_РазделОперации(НастройкиОперации(Второй, Первый));

	ЮТест.ОжидаетЧто(Исходный.Значение, "раздел не зависит от порядка настроек")
		.Равно(Переставленный.Значение);
	ЮТест.ОжидаетЧто(Исходный.Значение, "раздел двух настроек заполнен").НеРавно("");

КонецПроцедуры

// Проверяет раздел операции при замене одного элемента состава без вычисления ожидаемой хеш-суммы.
Процедура ПолучитьРазделОперации_РазличаетСостав() Экспорт

	Первый = НовыйПродюсер("Первый");
	Второй = НовыйПродюсер("Второй");
	Третий = НовыйПродюсер("Третий");

	Исходный = кфкФоновыеОперацииСлужебный.ют_РазделОперации(НастройкиОперации(Первый, Второй));
	Измененный = кфкФоновыеОперацииСлужебный.ют_РазделОперации(НастройкиОперации(Первый, Третий));

	ЮТест.ОжидаетЧто(Исходный.Значение, "разные составы настроек имеют разные разделы")
		.НеРавно(Измененный.Значение);

КонецПроцедуры
// Проверяет только непрерывно завершенные пакеты разрешают продвижение.
//
// Параметры:
//  ПервыйЗавершен - Число - статус первого пакета: 0 или 1.
//  ВторойЗавершен - Число - статус второго пакета: 0 или 1.
//  ОжидаемаяПозиция - Число - независимо заданная граница в миллисекундах.
//  ОсталосьПакетов - Число - число неучтенных пакетов.
Процедура ОбновитьУказательНачалаВыборки_УчитываетПрефикс(
	ПервыйЗавершен, ВторойЗавершен, ОжидаемаяПозиция, ОсталосьПакетов) Экспорт

	Сценарий = НовыйСценарийПозиции(ПервыйЗавершен, ВторойЗавершен);
	Позиция = Сценарий.Позиция;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
		Позиция, Сценарий.Указатели, 4000000, Сценарий.Потоки, Сценарий.Операция, Сценарий.Раздел);
	Сценарий.Позиция = Позиция;

	ПроверитьСценарийПозиции(Сценарий, ОжидаемаяПозиция, ОсталосьПакетов);

КонецПроцедуры
// Проверяет обратное завершение не подтверждает необработанный первый пакет.
Процедура ОбновитьУказательНачалаВыборки_ЖдетПервыйПакет() Экспорт

	Сценарий = НовыйСценарийПозиции(0, 1);
	Позиция = Сценарий.Позиция;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
		Позиция, Сценарий.Указатели, 4000000, Сценарий.Потоки, Сценарий.Операция, Сценарий.Раздел);
	Сценарий.Позиция = Позиция;

	ПроверитьСценарийПозиции(Сценарий, 1000000, 2);
	Сценарий.Указатели[0].СтатусПотока = 1;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
		Позиция, Сценарий.Указатели, 4000000, Сценарий.Потоки, Сценарий.Операция, Сценарий.Раздел);
	Сценарий.Позиция = Позиция;

	ПроверитьСценарийПозиции(Сценарий, 2100000, 0);

КонецПроцедуры
// Проверяет порядок строк указателей не меняет границу завершенного префикса.
Процедура ОбновитьУказательНачалаВыборки_СортируетПакеты() Экспорт

	Сценарий = НовыйСценарийПозиции(1, 0);
	Сценарий.Указатели.Сортировать("ВременнаяМетка Убыв");
	Позиция = Сценарий.Позиция;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
		Позиция, Сценарий.Указатели, 4000000, Сценарий.Потоки, Сценарий.Операция, Сценарий.Раздел);
	Сценарий.Позиция = Позиция;

	ПроверитьСценарийПозиции(Сценарий, 1100000, 1);
	ЮТест.ОжидаетЧто(Сценарий.Указатели[0].ВременнаяМетка,
		"незавершенный второй пакет остается назначенным").Равно(3000000);

КонецПроцедуры
// Проверяет исчезновение первого потока не подтверждает завершенный хвост.
Процедура ОбновитьУказательНачалаВыборки_ИсчезнувшийПотокУдерживаетПозицию() Экспорт

	Сценарий = НовыйСценарийПозиции(0, 1);
	Сценарий.Потоки.Удалить(0);
	Позиция = Сценарий.Позиция;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
		Позиция, Сценарий.Указатели, 4000000, Сценарий.Потоки, Сценарий.Операция, Сценарий.Раздел);
	Сценарий.Позиция = Позиция;

	ПроверитьСценарийПозиции(Сценарий, 1000000, 1);
	ЮТест.ОжидаетЧто(Сценарий.Указатели[0].ИдентификаторПотока,
		"завершенный хвост не потерян").Равно(Сценарий.Потоки[0]);

КонецПроцедуры
// Проверяет равная временная метка не позволяет подтвердить незавершенный пакет.
Процедура ОбновитьУказательНачалаВыборки_РавныеМеткиНеСкрываютНезавершенныйПакет() Экспорт

	Сценарий = НовыйСценарийПозиции(0, 1);
	Сценарий.Указатели[1].ВременнаяМетка = 2000000;
	Позиция = Сценарий.Позиция;

	кфкФоновыеОперацииСлужебный.ют_ОбновитьУказательНачалаВыборки(
		Позиция, Сценарий.Указатели, 4000000, Сценарий.Потоки, Сценарий.Операция, Сценарий.Раздел);
	Сценарий.Позиция = Позиция;

	ПроверитьСценарийПозиции(Сценарий, 1000000, 2);

КонецПроцедуры
// Проверяет пустая выборка продвигает позицию только вперед.
//
// Параметры:
//  ПустаяВыборка - Число - новая граница в миллисекундах.
//  ОжидаемаяПозиция - Число - независимый эталон результата.
Процедура ОбновитьУказательНачалаВыборки_ПустаяВыборкаНеОткатываетПозицию(
	ПустаяВыборка, ОжидаемаяПозиция) Экспорт

	Сценарий = НовыйСценарийПозиции(0, 0);
	Сценарий.Указатели.Очистить();
	Сценарий.Потоки.Очистить();
	Позиция = Сценарий.Позиция;

