// Проверки реального цикла обработки входящих в фоновом задании.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ВТранзакции(Ложь)
		.После("ПослеКаждогоТеста")
		.ДобавитьТестовыйНабор("Фоновый цикл входящих сообщений")
			.Тег("Модульные").Тег("кфкФоновыеОперацииСлужебный").Тег("Стендовые")
			.Тег("ЦиклДесериализации")
			.ДобавитьСерверныйТест("ЦиклДесериализации_УчитываетБлокировкуИПоступление")
				.Тег("УчитываетБлокировкуИПоступление")
				.СПараметрами("до")
				.СПараметрами("между")
				.СПараметрами("поступление")
			.ДобавитьСерверныйТест("ЦиклДесериализации_ПустойПотокЗавершаетсяПоТаймауту")
				.Тег("ПустойПотокЗавершаетсяПоТаймауту");

КонецПроцедуры

// Освобождает только ресурсы текущего стендового запуска.
Процедура ПослеКаждогоТеста() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Ресурсы = Неопределено; // Структура, Неопределено
	Если Не Контекст.Свойство("ют_РесурсыФоновогоЦикла", Ресурсы) Тогда
		Возврат;
	КонецЕсли;
	Константы.кфкБлокировкаИнтеграции.Установить(Истина);
	ОбновитьПовторноИспользуемыеЗначения();
	Если Ресурсы.Задание <> Неопределено Тогда
		Задание = Ресурсы.Задание.ОжидатьЗавершенияВыполнения(1);
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Задание.Отменить();
			Задание = Задание.ОжидатьЗавершенияВыполнения(10);
		КонецЕсли;
		ЮТест.ОжидаетЧто(Задание.Состояние = СостояниеФоновогоЗадания.Активно,
			"Тестовое фоновое задание остановлено").Равно(Ложь);
	КонецЕсли;
	Для Каждого Ключ Из ЮТМетоды.МассивПараметров(Ресурсы.Первый, Ресурсы.Второй) Цикл
		Назначение = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
		Назначение.Ключ = Ключ;
		Назначение.Удалить();
	КонецЦикла;
	Для Индекс = 0 По 1 Цикл
		Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
		Запись.КлючЗаписи = ?(Индекс = 0, Ресурсы.Первый, Ресурсы.Второй);
		Запись.ДатаЗагрузкиМС = 1000000 + Индекс;
		Запись.Удалить();
	КонецЦикла;
	Константы.кфкБлокировкаИнтеграции.Установить(Ресурсы.Блокировка);
	ОбновитьПовторноИспользуемыеЗначения();
	Контекст.Удалить("ют_РесурсыФоновогоЦикла");

КонецПроцедуры

#Область ЦиклДесериализации

// Проверяет состояние двух сообщений при блокировке до и между порциями.
// Параметры:
//  Режим - Строка - до, между или поступление.
Процедура ЦиклДесериализации_УчитываетБлокировкуИПоступление(Режим) Экспорт

	ЮТест.ОжидаетЧто(СтрНайти(СтрокаСоединенияИнформационнойБазы(), "Srvr=") > 0,
		"Для фонового задания требуется серверная ИБ").Равно(Истина);
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Первый = "ют-фоновый-цикл-first-" + Идентификатор;
	Второй = "ют-фоновый-цикл-second-" + Идентификатор;
	Консьюмер = ЮТест.Данные().КонструкторОбъекта(Справочники.кфкКонсьюмеры)
		.Установить("Наименование", "Фоновый цикл " + Идентификатор)
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Записать(Ложь, Истина);
	ПрежняяБлокировка = Константы.кфкБлокировкаИнтеграции.Получить();
	Ресурсы = Новый Структура("Первый,Второй,Блокировка", Первый, Второй, ПрежняяБлокировка);
	Ресурсы.Вставить("Задание", Неопределено);
	ЮТест.КонтекстТеста().Вставить("ют_РесурсыФоновогоЦикла", Ресурсы);
	Константы.кфкБлокировкаИнтеграции.Установить(Режим = "до");
	ОбновитьПовторноИспользуемыеЗначения();

	Параметры = ЮТМетоды.МассивПараметров(Консьюмер, Первый, Второй, Режим);
	Ресурсы.Задание = кфкФоновыеОперацииСлужебный.ют_ЗапуститьФЗ(
		"ют-фоновый-цикл-" + Идентификатор,
		"ОМ_кфкФоновыеОперацииСлужебный_Стенд.ют_РабочийПоток",
		"Проверка фонового цикла", Параметры);
	Завершенное = Ресурсы.Задание.ОжидатьЗавершенияВыполнения(30);
	ЮТест.ОжидаетЧто(Завершенное.Состояние, "Завершение тестового фонового задания")
		.Равно(СостояниеФоновогоЗадания.Завершено);
	ПервыйСтатус = ?(Режим = "до", Перечисления.кфкСтатусыСообщений.Новое,
		Перечисления.кфкСтатусыСообщений.Обработано);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения")
		.СодержитЗаписи(ЮТест.Предикат()
			.Реквизит("КлючЗаписи").Равно(Первый)
			.Реквизит("Статус").Равно(ПервыйСтатус));
	Если Режим = "до" Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения")
			.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("КлючЗаписи").Равно(Второй));
	Иначе
		ВторойСтатус = ?(Режим = "между", Перечисления.кфкСтатусыСообщений.Новое,
			Перечисления.кфкСтатусыСообщений.Обработано);
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения")
			.СодержитЗаписи(ЮТест.Предикат()
				.Реквизит("КлючЗаписи").Равно(Второй)
				.Реквизит("Статус").Равно(ВторойСтатус));
	КонецЕсли;
	Для Каждого Ключ Из ЮТМетоды.МассивПараметров(Первый, Второй) Цикл
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков")
			.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Ключ").Равно(Ключ));
	КонецЦикла;

КонецПроцедуры

// Проверяет завершение пустого фонового потока после управляемого срока простоя.
Процедура ЦиклДесериализации_ПустойПотокЗавершаетсяПоТаймауту() Экспорт

	ЮТест.ОжидаетЧто(СтрНайти(СтрокаСоединенияИнформационнойБазы(), "Srvr=") > 0,
		"Для фонового задания требуется серверная ИБ").Равно(Истина);
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	ПрежняяБлокировка = Константы.кфкБлокировкаИнтеграции.Получить();
	Ресурсы = Новый Структура("Первый,Второй,Блокировка",
		"ют-фоновый-цикл-empty-first-" + Идентификатор,
		"ют-фоновый-цикл-empty-second-" + Идентификатор,
		ПрежняяБлокировка);
	Ресурсы.Вставить("Задание", Неопределено);
	ЮТест.КонтекстТеста().Вставить("ют_РесурсыФоновогоЦикла", Ресурсы);
	Константы.кфкБлокировкаИнтеграции.Установить(Ложь);
	ОбновитьПовторноИспользуемыеЗначения();

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ресурсы.Задание = кфкФоновыеОперацииСлужебный.ют_ЗапуститьФЗ(
		"ют-фоновый-цикл-timeout-" + Идентификатор,
		"ОМ_кфкФоновыеОперацииСлужебный_Стенд.ют_ПустойПоток",
		"Проверка таймаута фонового цикла", Новый Массив);
	Завершенное = Ресурсы.Задание.ОжидатьЗавершенияВыполнения(30);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	ЮТест.ОжидаетЧто(Завершенное.Состояние,
		Строка(Завершенное.ИнформацияОбОшибке)).Равно(СостояниеФоновогоЗадания.Завершено);
	ЮТест.ОжидаетЧто(Длительность >= 4000, "Цикл дождался таймаута после пустой выборки")
		.Равно(Истина);
	ЮТест.ОжидаетЧто(Длительность < 30000, "Поток завершился после таймаута")
		.Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиТестов

// Выполняется в настоящем фоновом задании и создаёт первую назначенную запись.
// Параметры:
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры
//  Первый - Строка
//  Второй - Строка
//  Режим - Строка
Процедура ют_РабочийПоток(Консьюмер, Первый, Второй, Режим) Экспорт

	Поток = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание().УникальныйИдентификатор;
	ЗаписатьСообщениеСтенда(Консьюмер, Первый, 1000000, Режим + "|" + Второй, Поток);
	Правило = кфкФоновыеОперацииСлужебный.НовоеОписаниеПравилОбмена();
	Правило.Тип = Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик;
	Правило.ИмяМетода = "ОМ_кфкФоновыеОперацииСлужебный_Стенд.ют_ПослеСообщения";
	Правила = Новый Соответствие;
	Правила.Вставить(НРег(XMLСтрока(Консьюмер) + "unit-background-cycle"), Правило);
	кфкФоновыеОперацииСлужебный.ДесериализацияСообщенийВПотоке(Правила, Новый Массив);

КонецПроцедуры
// Вызывает исходный цикл без назначенных записей внутри тестового фонового задания.
Процедура ют_ПустойПоток() Экспорт

	кфкФоновыеОперацииСлужебный.ДесериализацияСообщенийВПотоке(
		Новый Соответствие, Новый Массив);

КонецПроцедуры


// После первой порции создаёт вторую; после второй завершает цикл блокировкой.
// Параметры:
//  Тело - Строка
//  Свойства - Структура
//  Журнал - Строка
//  Отказ - Булево
Процедура ют_ПослеСообщения(Тело, Свойства, Журнал, Отказ) Экспорт

	Если Тело = "second" Тогда
		Константы.кфкБлокировкаИнтеграции.Установить(Истина);
		ОбновитьПовторноИспользуемыеЗначения();
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(Тело, "|");
	Второй = Части[1];
	Поток = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание().УникальныйИдентификатор;
	ЗаписатьСообщениеСтенда(Свойства.Консьюмер, Второй, 1000001, "second", Поток);
	Если Части[0] = "между" Тогда
		Константы.кфкБлокировкаИнтеграции.Установить(Истина);
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт отдельную входящую запись и назначение текущему заданию.
// Параметры:
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры
//  Ключ - Строка
//  Метка - Число
//  Тело - Строка
//  Поток - УникальныйИдентификатор
Процедура ЗаписатьСообщениеСтенда(Консьюмер, Ключ, Метка, Тело, Поток)

	Запись = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
	Запись.КлючЗаписи = Ключ;
	Запись.Консьюмер = Консьюмер;
	Запись.Топик = "unit-background-cycle";
	Запись.ДатаЗагрузкиМС = Метка;
	Запись.МеткаИзмененияМС = Метка;
	Запись.Статус = Перечисления.кфкСтатусыСообщений.Новое;
	Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Тело);
	Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Новый Соответствие);
	Запись.Записать();
	Назначение = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
	Назначение.Ключ = Ключ;
	Назначение.ВременнаяМетка = Метка;
	Назначение.ИдентификаторПотока = Поток;
	Назначение.Записать();

КонецПроцедуры

#КонецОбласти
