				.СПараметрами(Ложь, Истина, Ложь, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Истина, Ложь, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Истина, Истина, Истина, Ложь, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Истина, Истина, Ложь, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Истина, Истина, Истина, Ложь)
				.СПараметрами(Истина, Ложь, Истина, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Истина, Истина, Истина, Истина, Ложь)
				.СПараметрами(Истина, Истина, Истина, Истина, Истина, Ложь)
				.СПараметрами(Ложь, Ложь, Ложь, Ложь, Ложь, Ложь)
				.СПараметрами(Ложь, Истина, Ложь, Ложь, Ложь, Ложь)
				.СПараметрами(Ложь, Ложь, Ложь, Ложь, Истина, Истина)
				.СПараметрами(Истина, Истина, Истина, Истина, Истина, Истина);

