	ПравилоОбработки = Компоненты.ПравилаОбработкиДанных.Найти("TestCatalog_Получение", "Имя");
	ПравилоОбработки.ОбъектВыборкиФормат = "ПроверкаСтруктурED";
	ГлавноеПравило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	ГлавноеПравило.ОбъектФормата = "ПроверкаСтруктурED";
	ГлавноеПравило.ПространствоИмен = ПространствоИмен;
	ГлавноеПравило.ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, "ПроверкаСтруктурED");
	ГлавноеПравило.СвойстваТабличныхЧастей.Очистить();
	ГлавноеПравило.Свойства.Очистить();
	ПКС = ГлавноеПравило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Наименование";
	ПКС.СвойствоФормата = "name";
	ПКС = ГлавноеПравило.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "СвязаннаяГруппа";
	ПКС.СвойствоФормата = "key";
	ПКС.ПравилоКонвертацииСвойства = "ГруппаПоИмени";
	ПравилоГруппы = кфкОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(
		Компоненты.ПравилаКонвертацииОбъектов);
	ЗаполнитьЗначенияСвойств(ПравилоГруппы, ГлавноеПравило);
	ПравилоГруппы.Свойства = кфкОбменДаннымиXDTOСервер.ИнициализироватьТаблицуСвойствДляПравилаКонвертации();
	ПравилоГруппы.ИмяПКО = "ГруппаПоИмени";
	ПравилоГруппы.ОбъектФормата = "КлючевыеСвойстваПроверки";
	ПравилоГруппы.ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, "КлючевыеСвойстваПроверки");
	ПравилоГруппы.ПравилоДляГруппыСправочника = Ложь;
	ПравилоГруппы.ВариантИдентификации = "ПоПолямПоиска";
	ПравилоГруппы.ПоляПоиска = Новый Массив;
	ПравилоГруппы.ПоляПоиска.Добавить("Наименование");
	ПКС = ПравилоГруппы.Свойства.Добавить();
	ПКС.СвойствоКонфигурации = "Наименование";
	ПКС.СвойствоФормата = "name";
	ПКС.ОбработкаПоисковогоСвойства = Истина;
	МетаданныеПриемника = Метаданные.Справочники.кфк_т_ПриемникОбменаXDTO;
	Для Каждого Правило Из Компоненты.ПравилаКонвертацииОбъектов Цикл
		Если Правило <> ГлавноеПравило И Правило <> ПравилоГруппы Тогда
			Продолжить;
		КонецЕсли;
		Правило.ОбъектДанных = МетаданныеПриемника;
		Правило.ПолноеИмя = МетаданныеПриемника.ПолноеИмя();
		Правило.МенеджерОбъекта = Справочники.кфк_т_ПриемникОбменаXDTO;
		Правило.ТипДанных = Тип("СправочникСсылка.кфк_т_ПриемникОбменаXDTO");
		Правило.ИмяТаблицыПолученныхДанных = Правило.ПолноеИмя;
		Правило.РеквизитыШапкиПолученныхДанных = Новый Массив;
		Правило.РеквизитыШапкиПолученныхДанных.Добавить("Наименование");
		Правило.РеквизитыШапкиПолученныхДанных.Добавить("СвязаннаяГруппа");
	КонецЦикла;
	Возврат Компоненты;

