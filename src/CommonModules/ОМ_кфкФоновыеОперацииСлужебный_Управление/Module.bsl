// Проверяет сохранение назначения после аварии или отмены и его завершение при повторном запуске.
// Параметры:
//  Авария - Булево - Завершить первое задание исключением вместо отмены.
Процедура ЗапуститьФЗ_ПерезапускаетПослеПрерывания(Авария) Экспорт

	Сигнал = Новый УникальныйИдентификатор;
	Задания = Новый Массив; // Массив Из ФоновоеЗадание
	Сигналы = ЮТМетоды.МассивПараметров(Сигнал);
	Попытка
		Первое = ЗапуститьТестовоеЗадание(Сигнал, Авария);
		Задания.Добавить(Первое);
		ОжидатьСигнал(Сигнал, "ют_Старт", Первое);
		Указатели = кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков();
		ДобавитьНазначениеСтенда(Первое, Указатели, 2000000);

		ПовторАктивного = ЗапуститьТестовоеЗадание(Сигнал, Авария);
		ЮТест.ОжидаетЧто(ПовторАктивного.УникальныйИдентификатор).Равно(Первое.УникальныйИдентификатор);
		Если Авария Тогда
			ЗаписатьСигнал(Сигнал, "ют_Разрешение");
		Иначе
			Первое.Отменить();
		КонецЕсли;
		Первое = Первое.ОжидатьЗавершенияВыполнения(10);

		ОжидаемыйСтатус = ?(Авария, СостояниеФоновогоЗадания.ЗавершеноАварийно, СостояниеФоновогоЗадания.Отменено);
		ЮТест.ОжидаетЧто(Первое.Состояние).Равно(ОжидаемыйСтатус);
		ПроверитьНазначениеСтенда(Первое.УникальныйИдентификатор, Истина);
		СброситьСигналы(Сигнал);

		Второе = ЗапуститьТестовоеЗадание(Сигнал, Ложь, Первое.УникальныйИдентификатор);
		Задания.Добавить(Второе);
		ОжидатьСигнал(Сигнал, "ют_Старт", Второе);
		ЮТест.ОжидаетЧто(Второе.УникальныйИдентификатор).НеРавно(Первое.УникальныйИдентификатор);
		ЗаписатьСигнал(Сигнал, "ют_Разрешение");
		ОжидатьСигнал(Сигнал, "ют_Завершение", Второе);

		ПроверитьНазначениеСтенда(Первое.УникальныйИдентификатор, Ложь);
		Повтор = Второе.ОжидатьЗавершенияВыполнения(10);
		ЮТест.ОжидаетЧто(Повтор.Состояние).Равно(СостояниеФоновогоЗадания.Завершено);
	Исключение
		ОчиститьСтендЗаданий(Задания, Сигналы);
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьСтендЗаданий(Задания, Сигналы);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиТестов

// Исполняет тестовое задание по межсеансовому сигналу; не регистрируется как тест.
// Параметры:
//  Сигнал - УникальныйИдентификатор - Собственный идентификатор барьера.
//  Авария - Булево - Внедрить аварийное завершение до удаления назначения.
//  ПрежнийПоток - Неопределено, УникальныйИдентификатор - Остаток отменённого задания.
Процедура ют_ЗавершитьНазначениеПоСигналу(Сигнал, Авария, ПрежнийПоток) Экспорт

	ЗаписатьСигнал(Сигнал, "ют_Старт");
	ОжидатьСигнал(Сигнал, "ют_Разрешение");
	Если Авария Тогда
		ВызватьИсключение "Управляемая авария тестового фонового задания";
	КонецЕсли;
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Поток = Задание.УникальныйИдентификатор;
	Если ПрежнийПоток <> Неопределено Тогда
		Поток = ПрежнийПоток;
	КонецЕсли;
	УдалитьНазначенияСтенда(Поток);
	ЗаписатьСигнал(Сигнал, "ют_Завершение");

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает независимые флаги запуска.
// Параметры:
//  Сериализация - Булево - Флаг сериализации.
//  Десериализация - Булево - Флаг десериализации.
//  Выгрузка - Булево - Флаг отправки.
//  Загрузка - Булево - Флаг чтения.
// Возвращаемое значение:
//  Структура:
//   * Сериализация - Булево
//   * Десериализация - Булево
//   * Выгрузка - Булево
//   * Загрузка - Булево
Функция ФактЗапуска(Сериализация, Десериализация, Выгрузка, Загрузка)

	Результат = Новый Структура;
	Результат.Вставить("Сериализация", Сериализация);
	Результат.Вставить("Десериализация", Десериализация);
	Результат.Вставить("Выгрузка", Выгрузка);
	Результат.Вставить("Загрузка", Загрузка);
	Возврат Результат;

КонецФункции

// Параметры:
//  Операции - СписокЗначений Из Строка - Проверяемый состав.
//  Ожидаемые - Строка - Имена операций через точку с запятой.
Процедура ПроверитьОперации(Операции, Ожидаемые)

	Эталон = СтрРазделить(Ожидаемые, ";");
	ЮТест.ОжидаетЧто(Операции.Количество()).Равно(Эталон.Количество());
	Для Индекс = 0 По Эталон.ВГраница() Цикл
		ЮТест.ОжидаетЧто(Операции[Индекс].Значение).Равно(Эталон[Индекс]);
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  СправочникСсылка.кфкКонсьюмеры - Собственный идентификатор для алгоритма в памяти.
Функция НоваяСсылкаКонсьюмера()

	Возврат Справочники.кфкКонсьюмеры.ПолучитьСсылку(Новый УникальныйИдентификатор);

КонецФункции
// Возвращает таблицу адресатов и независимых блокировок.
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Ссылка - СправочникСсылка - Диспетчер выбранного направления.
//   * Настройка - СправочникСсылка - Конкретная настройка направления.
//   * БлокироватьОбработку - Булево
//   * БлокироватьТранспорт - Булево
Функция НоваяТаблицаНастроекДиспетчера()

	Результат = Новый ТаблицаЗначений;
	ТипНастройки = Новый ОписаниеТипов("СправочникСсылка.кфкПродюсеры,СправочникСсылка.кфкКонсьюмеры");
	Результат.Колонки.Добавить("Ссылка", ТипНастройки);
	Результат.Колонки.Добавить("Настройка", ТипНастройки);
	Результат.Колонки.Добавить("БлокироватьОбработку", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("БлокироватьТранспорт", Новый ОписаниеТипов("Булево"));
	Возврат Результат;

КонецФункции
// Возвращает собственные назначения двух консьюмеров.
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Консьюмер - СправочникСсылка.кфкКонсьюмеры - Получатель.
//   * НомерПотока - Число - Индекс активного потока.
Функция НовоеРаспределениеКонсьюмеров()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Консьюмер", Новый ОписаниеТипов("СправочникСсылка.кфкКонсьюмеры"));
	Результат.Колонки.Добавить("НомерПотока", Новый ОписаниеТипов("Число"));
	Возврат Результат;

КонецФункции
// Параметры:
//  Поток - УникальныйИдентификатор - Владелец назначения.
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры - Ключ настройки.
//  ЕстьНазначение - Булево - Ожидаемое наличие.
Процедура ПроверитьКонсьюмераВОчереди(Поток, Консьюмер, ЕстьНазначение)

	Предикат = ЮТест.Предикат()
		.Реквизит("ИдентификаторПотока").Равно(Поток)
		.Реквизит("Ключ").Равно(XMLСтрока(Консьюмер));
	Если ЕстьНазначение Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").СодержитЗаписи(Предикат);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);
	КонецЕсли;

КонецПроцедуры
// Возвращает типизированный идентификатор настройки для алгоритма без чтения объекта.
// Параметры:
//  Продюсер - Булево - Исходящее направление.
//  Идентификатор - УникальныйИдентификатор - Собственный идентификатор.
// Возвращаемое значение:
//  СправочникСсылка - Ссылка настройки выбранного направления.
Функция СсылкаНастройкиНаправления(Продюсер, Идентификатор)

	Если Продюсер Тогда
		Возврат Справочники.кфкПродюсеры.ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Возврат Справочники.кфкКонсьюмеры.ПолучитьСсылку(Идентификатор);

КонецФункции

// Параметры:
//  Статистика - см. кфкФоновыеОперацииСлужебный.ют_НоваяСтатистикаРаспределенияЧтения
//  Консьюмер - СправочникСсылка.кфкКонсьюмеры - Владелец нагрузки.
//  СреднийРазмер - Число - Нагрузка на партицию.
//  Партиций - Число - Число партиций.
Процедура ДобавитьНагрузку(Статистика, Консьюмер, СреднийРазмер, Партиций)

	СтрокаСтатистики = Статистика.Добавить();
	СтрокаСтатистики.Консьюмер = Консьюмер;
	СтрокаСтатистики.Партиций = Партиций;
	СтрокаСтатистики.СредРазмер = СреднийРазмер;
	СтрокаСтатистики.РазмерОчереди = СреднийРазмер * Партиций;

КонецПроцедуры
// Возвращает реальное задание с собственным ключом тестового запуска.
// Параметры:
//  Сигнал - УникальныйИдентификатор - Ключ барьера.
//  Авария - Булево - Сбой после разрешения.
//  ПрежнийПоток - Неопределено, УникальныйИдентификатор - Остаток прерванного задания.
// Возвращаемое значение:
//  ФоновоеЗадание - Реальный worker.
Функция ЗапуститьТестовоеЗадание(Сигнал, Авария, ПрежнийПоток = Неопределено)

	Аргументы = ЮТМетоды.МассивПараметров(Сигнал, Авария, ПрежнийПоток);
	Возврат кфкФоновыеОперацииСлужебный.ют_ЗапуститьФЗ(
		"ют_" + Строка(Сигнал),
		"ОМ_кфкФоновыеОперацииСлужебный_Управление.ют_ЗавершитьНазначениеПоСигналу",
		"Проверка жизненного цикла фонового задания", Аргументы);

КонецФункции
// Параметры:
//  Сигнал - УникальныйИдентификатор - UUID текущего теста.
//  Раздел - Строка - Имя сигнала с префиксом ют_.
Процедура ЗаписатьСигнал(Сигнал, Раздел)

	Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Сигнал;
	Запись.Раздел = Раздел;
	Запись.РазделПредставление = "Межсеансовый барьер теста";
	Запись.ВременнаяМетка = 1;
	Запись.Записать();

КонецПроцедуры
// Ожидает конкретный барьер с конечным сроком, не подменяя порядок случайной паузой.
// Параметры:
//  Сигнал - УникальныйИдентификатор - UUID текущего теста.
//  Раздел - Строка - Ожидаемый этап worker.
//  Задание - Неопределено, ФоновоеЗадание - Задание, сигнал которого ожидает тестовый сеанс.
Процедура ОжидатьСигнал(Сигнал, Раздел, Задание = Неопределено)

	Срок = ТекущаяУниверсальнаяДата() + 30;
	Запись = РегистрыСведений.кфкПозицииОпераций.СоздатьМенеджерЗаписи();
	Пока ТекущаяУниверсальнаяДата() < Срок Цикл

		Запись.Идентификатор = Сигнал;
		Запись.Раздел = Раздел;
		Запись.Прочитать();
		Если Запись.ВременнаяМетка = 1 Тогда
			Возврат;
		КонецЕсли;
		Если Задание = Неопределено Тогда
			кфкОбщегоНазначенияСлужебный.Пауза(100);
		Иначе
			Задание = Задание.ОжидатьЗавершенияВыполнения(1);
			Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	Если Задание <> Неопределено Тогда
		ЮТест.ОжидаетЧто(Задание.Состояние, "Фоновое задание не передало сигнал " + Раздел)
			.Равно(СостояниеФоновогоЗадания.Активно);
	КонецЕсли;
	ВызватьИсключение "Не получен межсеансовый сигнал теста: " + Раздел;

КонецПроцедуры
// Параметры:
//  Сигнал - УникальныйИдентификатор - Собственный UUID тестового запуска.
Процедура СброситьСигналы(Сигнал)

	Набор = РегистрыСведений.кфкПозицииОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.Идентификатор.Установить(Сигнал);
	Набор.Записать();

КонецПроцедуры
// Параметры:
//  Задание - ФоновоеЗадание - Получатель пакета.
//  Указатели - см. кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков
//  Метка - Число - Временная метка пакета.
Процедура ДобавитьНазначениеСтенда(Задание, Указатели, Метка)

	Запись = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторПотока = Задание.УникальныйИдентификатор;
	Запись.Ключ = "ют_" + Строка(Задание.УникальныйИдентификатор);
	Запись.ВременнаяМетка = Метка;
	Запись.Записать();
	Указатель = Указатели.Добавить();
	Указатель.ИдентификаторПотока = Задание.УникальныйИдентификатор;
	Указатель.СтатусПотока = 0;
	Указатель.ВременнаяМетка = Метка;

КонецПроцедуры
// Параметры:
//  Поток - УникальныйИдентификатор - Собственный worker.
Процедура УдалитьНазначенияСтенда(Поток)

	Набор = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторПотока.Установить(Поток);
	Набор.Записать();

КонецПроцедуры
// Параметры:
//  Поток - УникальныйИдентификатор - Владелец назначения.
//  ЕстьНазначение - Булево - Ожидаемое наличие остатка.
Процедура ПроверитьНазначениеСтенда(Поток, ЕстьНазначение)

	Предикат = ЮТест.Предикат().Реквизит("ИдентификаторПотока").Равно(Поток);
	Если ЕстьНазначение Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").СодержитЗаписи(Предикат);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Предикат);
	КонецЕсли;

КонецПроцедуры
// Параметры:
//  Операция - УникальныйИдентификатор - UUID позиции.
//  Позиция - Число - Ожидаемая сохранённая граница.
Процедура ПроверитьПозициюСтенда(Операция, Позиция)

	Предикат = ЮТест.Предикат()
		.Реквизит("Идентификатор").Равно(Операция)
		.Реквизит("Раздел").Равно("ют_ПозицияСтенда")
		.Реквизит("ВременнаяМетка").Равно(Позиция);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкПозицииОпераций").СодержитЗаписи(Предикат);

КонецПроцедуры
// Останавливает собственные задания до удаления их очереди и сигналов.
// Параметры:
//  Задания - Массив Из ФоновоеЗадание - Workers текущего теста.
//  Сигналы - Массив Из УникальныйИдентификатор - Собственные UUID сигналов и позиции.
Процедура ОчиститьСтендЗаданий(Задания, Сигналы)

	Для Каждого Задание Из Задания Цикл
		Текущее = Задание.ОжидатьЗавершенияВыполнения(1);
		Если Текущее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Текущее.Отменить();
			Текущее = Текущее.ОжидатьЗавершенияВыполнения(10);
		КонецЕсли;
		Если Текущее.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ВызватьИсключение "Тестовое фоновое задание не остановилось; очистка остановлена";
		КонецЕсли;
		УдалитьНазначенияСтенда(Текущее.УникальныйИдентификатор);
	КонецЦикла;
	Для Каждого Сигнал Из Сигналы Цикл
		СброситьСигналы(Сигнал);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
