// Параметры:
//  Ответ - Строка - пакет компоненты.
//  Количество - Число - ожидаемое число сообщений.
//  СохранятьСессию - Булево - не закрывать коннектор автоматически.
Процедура ПрочитатьПакетСообщений_ВозвращаетПакет(
		Знач Ответ, Знач Количество, Знач СохранятьСессию) Экспорт

	Компонента = НоваяКомпонента();
	Компонента.НастроитьОтвет("ЧитатьПакетСообщений", Ответ);
	Консьюмер = кфк_т_ТестовыеДанные.СсылкаКонсьюмераСправочника();
	Настройки = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмера(Консьюмер);
	Сессии = Новый Соответствие;
	Если СохранятьСессию Тогда

		Результат = кфкИнтеграцияСлужебный.ПрочитатьПакетСообщений(Консьюмер, Ложь, 7, Сессии);

	Иначе

		Результат = кфкИнтеграцияСлужебный.ПрочитатьПакетСообщений(Консьюмер, Истина);

	КонецЕсли;

	ЮТест.ОжидаетЧто(Результат.Успешно).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Сообщения).ИмеетДлину(Количество);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Равно("ошибка компоненты");
	Если Количество > 0 Тогда
		ЮТест.ОжидаетЧто(Результат.Сообщения[0].message).Равно("данные");
	КонецЕсли;
	Параметры = ЮТМетоды.МассивПараметров(?(СохранятьСессию, 7, 100), Настройки.ТаймаутОжидания, Ложь);
	ПроверитьВызовы(Компонента, "ЧитатьПакетСообщений", 1, Параметры);
	ПроверитьВызовы(Компонента, "ПолучитьСообщениеОбОшибке", 1);
	ПроверитьВызовы(Компонента, "ОстановитьКонсьюмера", ?(СохранятьСессию, 0, 1));
	Если СохранятьСессию Тогда
		кфкИнтеграцияСлужебный.ЗакрытьСессииКонсьюмера(Сессии);
	КонецЕсли;

КонецПроцедуры

