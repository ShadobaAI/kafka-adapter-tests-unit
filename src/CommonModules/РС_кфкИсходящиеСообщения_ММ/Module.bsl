#Область ПрограммныйИнтерфейс

// Регистрирует серверные сценарии проверки модуля и их теги для запуска YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкИсходящиеСообщения. Модуль менеджера. СброситьСтатусОшибки()")
			.Тег("CI")
			.Тег("РегистрСведений")
			.Тег("Модульные")
			.Тег("кфкИсходящиеСообщения")
			.Тег("СброситьСтатусОшибки")
			.ДобавитьСерверныйТест("СброситьСтатусОшибки_ВосстанавливаетСтатусы",
				"СброситьСтатусОшибки(). Восстанавливает статусы обработки и выгрузки")
				.Тег("ВосстанавливаетСтатусы")
			.ДобавитьСерверныйТест("СброситьСтатусОшибки_СохраняетДанныеИМетки")
				.Тег("СохраняетДанныеИМетки")
				.СПараметрами(Перечисления.кфкСтатусыСообщений.ОшибкаОбработки,
					Перечисления.кфкСтатусыСообщений.Новое)
				.СПараметрами(Перечисления.кфкСтатусыСообщений.ОшибкаВыгрузки,
					Перечисления.кфкСтатусыСообщений.Обработано)
				.СПараметрами(Перечисления.кфкСтатусыСообщений.Новое,
					Перечисления.кфкСтатусыСообщений.Новое)
				.СПараметрами(Перечисления.кфкСтатусыСообщений.Обработано,
					Перечисления.кфкСтатусыСообщений.Обработано)
				.СПараметрами(Перечисления.кфкСтатусыСообщений.Выгружено,
					Перечисления.кфкСтатусыСообщений.Выгружено)
				.СПараметрами(Перечисления.кфкСтатусыСообщений.ОбработкаОтменена,
					Перечисления.кфкСтатусыСообщений.ОбработкаОтменена)
				.СПараметрами(Перечисления.кфкСтатусыСообщений.ВыгрузкаОтменена,
					Перечисления.кфкСтатусыСообщений.ВыгрузкаОтменена)
			.ДобавитьСерверныйТест("СброситьСтатусОшибки_ОбрабатываетНесколькоМеток")
				.Тег("ОбрабатываетНесколькоМеток")
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкИсходящиеСообщения. Модуль менеджера. УдалитьСообщения()")
			.Тег("CI")
			.Тег("РегистрСведений")
			.Тег("Модульные")
			.Тег("кфкИсходящиеСообщения")
			.Тег("УдалитьСообщения")
			.ДобавитьСерверныйТест("УдалитьСообщения_УдаляетПереданныеКлючи",
				"УдалитьСообщения(). Удаляет записи по массиву ключей")
				.Тег("УдаляетПереданныеКлючи")
			.ДобавитьСерверныйТест("УдалитьСообщения_УдаляетПоЗапросу",
				"УдалитьСообщения(). Удаляет записи по описанию запроса")
				.Тег("УдаляетПоЗапросу")
			.ДобавитьСерверныйТест("УдалитьСообщения_ПустаяВыборкаСохраняетДанные")
				.Тег("ПустаяВыборкаСохраняетДанные")
				.СПараметрами(Ложь)
				.СПараметрами(Истина)
		.ДобавитьТестовыйНабор(
			"Регистр сведений кфкИсходящиеСообщения. Модуль менеджера. ОчиститьРегистр()")
			.Тег("CI")
			.Тег("РегистрСведений")
			.Тег("Модульные")
			.Тег("кфкИсходящиеСообщения")
			.Тег("ОчиститьРегистр")
			.ДобавитьСерверныйТест("ОчиститьРегистр_УдаляетВсеСообщения",
				"ОчиститьРегистр(). Удаляет все записи")
				.Тег("УдаляетВсеСообщения");
	
КонецПроцедуры



// Проверяет восстановление статусов после ошибок обработки и выгрузки, сохраняя новые сообщения.
Процедура СброситьСтатусОшибки_ВосстанавливаетСтатусы() Экспорт
	
	КлючОшибкиОбработки = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);
	КлючОшибкиВыгрузки = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.ОшибкаВыгрузки);
	КлючНового = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);
	
	Ключи = Новый Массив;
	Ключи.Добавить(КлючОшибкиОбработки);
	Ключи.Добавить(КлючОшибкиВыгрузки);
	Ключи.Добавить(КлючНового);
	РегистрыСведений.кфкИсходящиеСообщения.СброситьСтатусОшибки(Ключи);
	
	ПроверитьСтатус(КлючОшибкиОбработки, Перечисления.кфкСтатусыСообщений.Новое);
	ПроверитьСтатус(КлючОшибкиВыгрузки, Перечисления.кфкСтатусыСообщений.Обработано);
	ПроверитьСтатус(КлючНового, Перечисления.кфкСтатусыСообщений.Новое);
	
КонецПроцедуры

// Проверяет, что полный ключ удаляет одну метку, сохраняя другую и чужой ключ.
Процедура УдалитьСообщения_УдаляетПереданныеКлючи() Экспорт

	КлючКУдалению = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);
	ДругаяМетка = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое, КлючКУдалению.КлючЗаписи);
	СохраняемыйКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);

	Ключи = Новый Массив; // Массив Из РегистрСведенийКлючЗаписи.кфкИсходящиеСообщения
	Ключи.Добавить(КлючКУдалению);
	РегистрыСведений.кфкИсходящиеСообщения.УдалитьСообщения(Ключи);

	ПроверитьОтсутствиеЗаписи(КлючКУдалению);
	ПроверитьСтатус(ДругаяМетка, Перечисления.кфкСтатусыСообщений.Новое);
	ПроверитьСтатус(СохраняемыйКлюч, Перечисления.кфкСтатусыСообщений.Новое);

КонецПроцедуры

// Проверяет удаление всех меток выбранного ключа с сохранением записи вне отбора.
Процедура УдалитьСообщения_УдаляетПоЗапросу() Экспорт

	КлючКУдалению = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);
	ДругаяМетка = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое, КлючКУдалению.КлючЗаписи);
	СохраняемыйКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);
	ОписаниеЗапроса = НовоеОписаниеЗапросаУдаления(КлючКУдалению.КлючЗаписи);

	РегистрыСведений.кфкИсходящиеСообщения.УдалитьСообщения(ОписаниеЗапроса);

	ПроверитьОтсутствиеЗаписи(КлючКУдалению);
	ПроверитьОтсутствиеЗаписи(ДругаяМетка);
	ПроверитьСтатус(СохраняемыйКлюч, Перечисления.кфкСтатусыСообщений.Новое);

КонецПроцедуры

// Проверяет переход статуса, сохранность данных и независимость другой метки того же ключа.
//
// Параметры:
//  ИсходныйСтатус - ПеречислениеСсылка.кфкСтатусыСообщений.
//  ОжидаемыйСтатус - ПеречислениеСсылка.кфкСтатусыСообщений.
Процедура СброситьСтатусОшибки_СохраняетДанныеИМетки(ИсходныйСтатус, ОжидаемыйСтатус) Экспорт

	Ключ = ДобавитьСообщение(ИсходныйСтатус);
	ДругаяМетка = ДобавитьСообщение(ИсходныйСтатус, Ключ.КлючЗаписи);
	ЧужойКлюч = ДобавитьСообщение(ИсходныйСтатус);
	Ключи = Новый Массив; // Массив Из РегистрСведенийКлючЗаписи.кфкИсходящиеСообщения
	Ключи.Добавить(Ключ);

	РегистрыСведений.кфкИсходящиеСообщения.СброситьСтатусОшибки(Ключи);

	ПроверитьСтатус(Ключ, ОжидаемыйСтатус);
	ПроверитьСтатус(ДругаяМетка, ИсходныйСтатус);
	ПроверитьСтатус(ЧужойКлюч, ИсходныйСтатус);
	Предикат = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Ключ.КлючЗаписи)
		.Реквизит("МеткаРегистрации").Равно(Ключ.МеткаРегистрации)
		.Реквизит("КлючСообщения").Равно(Ключ.КлючЗаписи)
		.Реквизит("КоличествоОбработок").Равно(3)
		.Реквизит("ДатаОбработки").Равно(Дата(2026, 1, 1, 10, 0, 2))
		.Реквизит("ДлОбработкиМС").Равно(125)
		.Реквизит("ТекстЖурнала").Равно("исходный журнал")
		.Реквизит("ЭтоУдаление").Равно(Истина)
		.Реквизит("КоличествоВыгрузок").Равно(2)
		.Реквизит("ДатаРегистрации").Равно(Дата(2026, 1, 1, 10, 0, 0))
		.Реквизит("ДатаВыгрузки").Равно(Дата(2026, 1, 1, 10, 0, 3));
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитЗаписи(Предикат);

	Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, Ключ);
	Запись.Прочитать();
	ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ТелоСообщения))
		.Равно(Ключ.КлючЗаписи);
	ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ИсходныеДанные))
		.Равно(Ключ.КлючЗаписи);

	Если ИсходныйСтатус = ОжидаемыйСтатус Тогда
		ЮТест.ОжидаетЧто(Запись.МеткаИзменения).Равно(Ключ.МеткаРегистрации);
	Иначе
		ЮТест.ОжидаетЧто(Запись.МеткаИзменения).НеРавно(Ключ.МеткаРегистрации);
	КонецЕсли;

	ПредикатСоседнейМетки = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(ДругаяМетка.КлючЗаписи)
		.Реквизит("МеткаРегистрации").Равно(ДругаяМетка.МеткаРегистрации)
		.Реквизит("МеткаИзменения").Равно(ДругаяМетка.МеткаРегистрации);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитЗаписи(ПредикатСоседнейМетки);

КонецПроцедуры
// Проверяет обработку обеих переданных меток без сброса сообщения вне массива ключей.
Процедура СброситьСтатусОшибки_ОбрабатываетНесколькоМеток() Экспорт

	ПервыйКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);
	ВторойКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.ОшибкаВыгрузки,
		ПервыйКлюч.КлючЗаписи);
	ЧужойКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);
	Ключи = Новый Массив; // Массив Из РегистрСведенийКлючЗаписи.кфкИсходящиеСообщения
	Ключи.Добавить(ПервыйКлюч);
	Ключи.Добавить(ВторойКлюч);

	РегистрыСведений.кфкИсходящиеСообщения.СброситьСтатусОшибки(Ключи);

	ПроверитьСтатус(ПервыйКлюч, Перечисления.кфкСтатусыСообщений.Новое);
	ПроверитьСтатус(ВторойКлюч, Перечисления.кфкСтатусыСообщений.Обработано);
	ПроверитьСтатус(ЧужойКлюч, Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);

КонецПроцедуры
// Проверяет отсутствие изменений при пустом массиве или запросе без подходящих записей.
//
// Параметры:
//  ПоЗапросу - Булево - Истина проверяет пустой результат запроса, Ложь - пустой массив.
Процедура УдалитьСообщения_ПустаяВыборкаСохраняетДанные(ПоЗапросу) Экспорт

	ПервыйКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);
	ВторойКлюч = ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое, ПервыйКлюч.КлючЗаписи);

	Если ПоЗапросу Тогда

		НесуществующийКлюч = "yaxunit-" + Строка(Новый УникальныйИдентификатор);
		ОписаниеЗапроса = НовоеОписаниеЗапросаУдаления(НесуществующийКлюч);
		РегистрыСведений.кфкИсходящиеСообщения.УдалитьСообщения(ОписаниеЗапроса);

	Иначе

		Ключи = Новый Массив; // Массив Из РегистрСведенийКлючЗаписи.кфкИсходящиеСообщения
		РегистрыСведений.кфкИсходящиеСообщения.УдалитьСообщения(Ключи);

	КонецЕсли;

	ПроверитьСтатус(ПервыйКлюч, Перечисления.кфкСтатусыСообщений.Новое);
	ПроверитьСтатус(ВторойКлюч, Перечисления.кфкСтатусыСообщений.Новое);

КонецПроцедуры
// Проверяет отсутствие записей после очистки непустого регистра.
Процедура ОчиститьРегистр_УдаляетВсеСообщения() Экспорт
	
	ДобавитьСообщение(Перечисления.кфкСтатусыСообщений.Новое);
	
	РегистрыСведений.кфкИсходящиеСообщения.ОчиститьРегистр();
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает описание удаления всех меток собственного ключа.
//
// Параметры:
//  КлючЗаписи - Строка.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - запрос ключей сообщений.
//   * Параметры - Структура:
//    ** КлючЗаписи - Строка - ключ сценария.
Функция НовоеОписаниеЗапросаУдаления(КлючЗаписи)

	ОписаниеЗапроса = Новый Структура;
	ОписаниеЗапроса.Вставить("Текст",
		"ВЫБРАТЬ
		|	Сообщения.КлючЗаписи КАК КлючЗаписи,
		|	Сообщения.МеткаРегистрации КАК МеткаРегистрации
		|ИЗ
		|	РегистрСведений.кфкИсходящиеСообщения КАК Сообщения
		|ГДЕ
		|	Сообщения.КлючЗаписи = &КлючЗаписи");
	ОписаниеЗапроса.Вставить("Параметры", Новый Структура("КлючЗаписи", КлючЗаписи));
	Возврат ОписаниеЗапроса;

КонецФункции
// Создает собственное сообщение; переданный ключ позволяет проверить независимость его меток.
//
// Параметры:
//  Статус - ПеречислениеСсылка.кфкСтатусыСообщений.
//  КлючЗаписи - Строка, Неопределено - при отсутствии создается уникальный ключ.
//
// Возвращаемое значение:
//  РегистрСведенийКлючЗаписи.кфкИсходящиеСообщения.
Функция ДобавитьСообщение(Статус, Знач КлючЗаписи = Неопределено)

	Если КлючЗаписи = Неопределено Тогда
		КлючЗаписи = "yaxunit-" + Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	МеткаРегистрации = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();

	Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
	Запись.КлючЗаписи = КлючЗаписи;
	Запись.МеткаРегистрации = МеткаРегистрации;
	Запись.МеткаИзменения = МеткаРегистрации;
	Запись.Статус = Статус;
	Запись.КлючСообщения = КлючЗаписи;
	Запись.КоличествоОбработок = 3;
	Запись.ДатаОбработки = Дата(2026, 1, 1, 10, 0, 2);
	Запись.ДлОбработкиМС = 125;
	Запись.ТекстЖурнала = "исходный журнал";
	Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(КлючЗаписи);
	Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(КлючЗаписи);
	Запись.ЭтоУдаление = Истина;
	Запись.КоличествоВыгрузок = 2;
	Запись.ДатаРегистрации = Дата(2026, 1, 1, 10, 0, 0);
	Запись.ДатаВыгрузки = Дата(2026, 1, 1, 10, 0, 3);
	Запись.Записать();

	ЗначенияКлюча = Новый Структура("КлючЗаписи,МеткаРегистрации", КлючЗаписи, МеткаРегистрации);
	Возврат РегистрыСведений.кфкИсходящиеСообщения.СоздатьКлючЗаписи(ЗначенияКлюча);

КонецФункции

Процедура ПроверитьСтатус(Ключ, ОжидаемыйСтатус)
	
	Предикат = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Ключ.КлючЗаписи)
		.Реквизит("МеткаРегистрации").Равно(Ключ.МеткаРегистрации)
		.Реквизит("Статус").Равно(ОжидаемыйСтатус);
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.СодержитЗаписи(Предикат);
	
КонецПроцедуры

Процедура ПроверитьОтсутствиеЗаписи(Ключ)
	
	Предикат = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Ключ.КлючЗаписи)
		.Реквизит("МеткаРегистрации").Равно(Ключ.МеткаРегистрации);
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи(Предикат);
	
КонецПроцедуры

#КонецОбласти
