// Возвращает настроенный результат через разрешенную прикладную границу.
// Параметры:
//  Данные - см. ДанныеСериализации
//  СвойстваСообщений - Структура - свойства исходного сообщения.
//  ТекстЖурнала - Строка - выходной журнал.
//  Отказ - Булево - выходной флаг.
// Возвращаемое значение:
//  см. кфкИнтеграция.ПараметрыСообщения
Функция ют_Сериализовать(Данные, СвойстваСообщений, ТекстЖурнала, Отказ) Экспорт

	ЮТест.ОжидаетЧто(СвойстваСообщений.ТипОбъект).Равно("Справочник.кфкПродюсеры");
	ТекстЖурнала = "результат " + Данные.Ключ;
	Отказ = Данные.Исход = "Отказ";
	Если Данные.Исход = "Исключение" Тогда
		ВызватьИсключение "unit: ошибка сериализации";
	КонецЕсли;
	Тело = ?(Данные.Исход = "НетТела", Неопределено, Данные.Тело);
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Тело);
	Сообщение.Ключ = Данные.Ключ;
	Сообщение.Заголовки.Вставить("Источник", Данные.Ключ);

	Возврат Сообщение;

КонецФункции

