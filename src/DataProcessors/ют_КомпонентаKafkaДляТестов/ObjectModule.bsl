// Сохраняет завершение сессии, не обращаясь к Kafka.
// Возвращаемое значение:
//  Булево - успешное завершение тестовой сессии.
Функция ОстановитьПродюсера() Экспорт

	Параметры = Новый Массив;
	ВызовыКомпоненты.Добавить(Новый Структура("Метод,Параметры", "ОстановитьПродюсера", Параметры));
	ЗаписатьФайлыЖурнала();
	Возврат Истина;

КонецФункции

