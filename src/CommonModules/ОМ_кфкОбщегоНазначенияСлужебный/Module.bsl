// Проверяет: сохраняет двоичные данные.
//
// Параметры:
//  ДанныеBase64 - Строка - параметр сценария.
Процедура ЗаписатьGZip_СохраняетДвоичныеДанные(Знач ДанныеBase64) Экспорт

	Данные = Base64Значение(ДанныеBase64);
	Архив = кфкОбщегоНазначенияСлужебный.ЗаписатьGZip(Данные);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Архив);

	ЮТест.ОжидаетЧто(Буфер[0]).Равно(31);
	ЮТест.ОжидаетЧто(Буфер[1]).Равно(139);
	ЮТест.ОжидаетЧто(Буфер[2]).Равно(8);
	Результат = кфкОбщегоНазначенияСлужебный.ПрочитатьGZip(Архив);
	ЮТест.ОжидаетЧто(Base64Строка(Результат)).Равно(Base64Строка(Данные));

