#Область СлужебныйПрограммныйИнтерфейс

// Регистрирует компонентные контракты исходящих сообщений.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ВТранзакции()
		.После("ПослеКаждогоТеста")
		.ДобавитьТестовыйНабор("ОбщийМодуль кфкФоновыеОперацииСлужебный. Исходящие сообщения")
			.Тег("Модульные")
			.Тег("кфкФоновыеОперацииСлужебный")
			.Тег("Отправка")
			.Тег("Критичные")
			.ДобавитьСерверныйТест("ВыборкаИсходящих_ОтбираетДопустимыеЗаписи")
				.Тег("ОтбираетДопустимыеЗаписи")
				.СПараметрами(Истина)
				.СПараметрами(Ложь)
			.ДобавитьСерверныйТест("ВыборкаОтправки_СоблюдаетПорядокИЛимит")
				.Тег("СоблюдаетПорядокИЛимит")
				.СПараметрами(1)
				.СПараметрами(2)
			.ДобавитьСерверныйТест("ВыборкаСериализацииВПотоке_УчитываетПолныйКлюч")
				.Тег("УчитываетПолныйКлюч")
			.ДобавитьСерверныйТест("ВыборкаОтправкиВПотоке_УчитываетПолныйКлюч")
				.Тег("УчитываетПолныйКлюч")
			.ДобавитьСерверныйТест("Сериализация_СохраняетСогласованныйИсход")
				.Тег("СохраняетСогласованныйИсход")
				.СПараметрами("Успех", Перечисления.кфкСтатусыСообщений.Обработано)
				.СПараметрами("Отказ", Перечисления.кфкСтатусыСообщений.ОбработкаОтменена)
				.СПараметрами("Исключение", Перечисления.кфкСтатусыСообщений.ОшибкаОбработки)
				.СПараметрами("НетТела", Перечисления.кфкСтатусыСообщений.ОшибкаОбработки)
				.СПараметрами("НетПравила", Перечисления.кфкСтатусыСообщений.ОшибкаОбработки)
				.СПараметрами("НетМетода", Перечисления.кфкСтатусыСообщений.ОшибкаОбработки)
			.ДобавитьСерверныйТест("Сериализация_НеПереноситДанныеМеждуСообщениями")
				.Тег("НеПереноситДанныеМеждуСообщениями")
			.ДобавитьСерверныйТест("СериализацияКД_ИзолируетСообщенияИУчитываетФлаги")
				.Тег("ИзолируетСообщенияИУчитываетФлаги")
				.СПараметрами(Истина, Перечисления.кфкСтатусыСообщений.ОбработкаОтменена)
				.СПараметрами(Ложь, Перечисления.кфкСтатусыСообщений.ОшибкаОбработки)
			.ДобавитьСерверныйТест("СериализацияКД_ПрерываетРегистрПриОшибке")
				.Тег("ПрерываетРегистрПриОшибке")
			.ДобавитьСерверныйТест("Отправка_СопоставляетОшибкуПослеПропуска")
				.Тег("СопоставляетОшибкуПослеПропуска")
			.ДобавитьСерверныйТест("Отправка_РазрешаетПовторПослеОшибки")
				.Тег("РазрешаетПовторПослеОшибки")
			.ДобавитьСерверныйТест("Отправка_ЧастичнаяОшибкаНеПодтверждаетХэш")
				.Тег("ЧастичнаяОшибкаНеПодтверждаетХэш")
			.ДобавитьСерверныйТест("Отправка_ПодавляетУспешныйДубль")
				.Тег("ПодавляетУспешныйДубль")
				.СПараметрами(Истина)
				.СПараметрами(Ложь)
			.ДобавитьСерверныйТест("Отправка_ИсключениеНеПодтверждаетСообщение")
				.Тег("ИсключениеНеПодтверждаетСообщение")
			.ДобавитьСерверныйТест("Отправка_ОшибкаСохраненияНеПодтверждаетЗавершение")
				.ВТранзакции(Ложь)
				.Тег("ОшибкаСохраненияНеПодтверждаетЗавершение")
			.ДобавитьСерверныйТест("ПакетKafka_СохраняетАдресациюИТело")
				.Тег("СохраняетАдресациюИТело")
				.СПараметрами("", "объект")
				.СПараметрами("заданный", "заданный")
			.ДобавитьСерверныйТест("ПакетKafka_ОтклоняетОтсутствующийТопик")
				.Тег("ОтклоняетОтсутствующийТопик");

КонецПроцедуры

// Освобождает внешнюю границу и контролируемый отказ независимо от результата теста.
Процедура ПослеКаждогоТеста() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Контекст.Удалить("ют_ОшибкаЗаписиИсходящих");
	Контекст.Удалить("ют_ВызовыКД");
	Контекст.Удалить("ют_ПропуститьКД");
	Контекст.Удалить("ют_КомпонентаKafka");
	Контекст.Удалить("ют_ВызовыФабрикиKafka");
	Мокито.Сбросить();

	Ключ = Неопределено; // Строка, Неопределено
	Если Не Контекст.Свойство("ют_КлючОчисткиПослеСбоя", Ключ) Тогда
		Возврат;
	КонецЕсли;

	Исходящие = РегистрыСведений.кфкИсходящиеСообщения.СоздатьНаборЗаписей();
	Исходящие.Отбор.КлючЗаписи.Установить(Ключ);
	Исходящие.Записать();
	Назначения = РегистрыСведений.кфкОчередьПотоков.СоздатьНаборЗаписей();
	Назначения.Отбор.Ключ.Установить(Ключ);
	Назначения.Записать();
	Хэши = РегистрыСведений.кфкХэшСуммыСообщений.СоздатьНаборЗаписей();
	Хэши.Отбор.КлючЗаписи.Установить(Ключ);
	Хэши.Записать();
	Контекст.Удалить("ют_КлючОчисткиПослеСбоя");

КонецПроцедуры

#Область ВыборкиИсходящих

// Проверяет независимые ограничения общей выборки.
// Параметры:
//  Сериализация - Булево
Процедура ВыборкаИсходящих_ОтбираетДопустимыеЗаписи(Сериализация) Экспорт

	Продюсер = НовыйПродюсер();
	Статус = ?(Сериализация, Перечисления.кфкСтатусыСообщений.Новое,
		Перечисления.кфкСтатусыСообщений.Обработано);
	ДоГраницы = НовоеСообщение(Продюсер, Статус, 999);
	НаГранице = НовоеСообщение(Продюсер, Статус, 1000);
	ПослеГраницы = НовоеСообщение(Продюсер, Статус, 1001);
	Чужое = НовоеСообщение(НовыйПродюсер(), Статус, 1000);
	ДругойСтатус = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Выгружено, 1000);
	Старая = НовоеСообщение(Продюсер, Статус, 1002);
	Новая = НовоеСообщение(Продюсер, Статус, 1003, Старая.КлючЗаписи);
	Занятая = НовоеСообщение(Продюсер, Статус, 1004);
	НазначитьСообщение(Занятая, Новый УникальныйИдентификатор, 777);
	Продюсеры = ЮТМетоды.МассивПараметров(Продюсер);

	Если Сериализация Тогда
		Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаСериализации(Продюсеры, 100, 1000);
	Иначе
		Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаОтправки(Продюсеры, 100, 1000);
	КонецЕсли;

	Ожидаемые = ЮТМетоды.МассивПараметров(НаГранице.КлючЗаписи, ПослеГраницы.КлючЗаписи, Новая.КлючЗаписи);
	ЮТест.ОжидаетЧто(КлючиВыборки(Выборка)).Равно(Ожидаемые);
	ПроверитьИсходящее(ДоГраницы, Статус, 3);
	ПроверитьИсходящее(Чужое, Статус, 3);
	ПроверитьИсходящее(ДругойСтатус, Перечисления.кфкСтатусыСообщений.Выгружено, 3);
	ПроверитьИсходящее(Занятая, Статус, 3);

КонецПроцедуры

// Проверяет точный лимит и порядок исходных SQL-результатов.
// Параметры:
//  Лимит - Число
Процедура ВыборкаОтправки_СоблюдаетПорядокИЛимит(Лимит) Экспорт

	Продюсер = НовыйПродюсер();
	Поздняя = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 2000);
	Ранняя = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Обработано, 1000);
	Продюсеры = ЮТМетоды.МассивПараметров(Продюсер);

	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаОтправки(Продюсеры, Лимит, 1000);

	Ожидаемые = ЮТМетоды.МассивПараметров(Ранняя.КлючЗаписи);
	Если Лимит = 2 Тогда
		Ожидаемые.Добавить(Поздняя.КлючЗаписи);
	КонецЕсли;
	ЮТест.ОжидаетЧто(КлючиВыборки(Выборка)).Равно(Ожидаемые);

КонецПроцедуры

// Проверяет связь назначения с UUID и датой исходной регистрации.
Процедура ВыборкаСериализацииВПотоке_УчитываетПолныйКлюч() Экспорт

	Продюсер = НовыйПродюсер();
	Поток = Новый УникальныйИдентификатор;
	Своя = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1000);
	Чужая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1001);
	Старая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1002);
	НазначитьСообщение(Своя, Поток);
	НазначитьСообщение(Чужая, Новый УникальныйИдентификатор);
