#Область ИсчезновениеРабочегоПотока

// Проверяет сохранение исходящего сообщения, когда рабочий поток исчезает до отправки.
Процедура ОтправкаСообщенийВКафку_НеТеряетСообщениеПриИсчезновенииПотока() Экспорт

	ПодготовитьИсчезновениеРабочегоПотока();
	Продюсер = ЮТест.Данные().КонструкторОбъекта(Справочники.кфкПродюсеры)
		.Установить("Наименование", "Продюсер проверки остановки")
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Записать(Ложь, Истина); // СправочникСсылка.кфкПродюсеры
	Настройки = Новый Массив; // Массив Из СправочникСсылка.кфкПродюсеры
	Настройки.Добавить(Продюсер);

	Ключ = Строка(Новый УникальныйИдентификатор);
	Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
	Статус = Перечисления.кфкСтатусыСообщений.Обработано;
	Исходящее = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
	Исходящее.КлючЗаписи = Ключ;
	Исходящее.МеткаРегистрации = Метка;
	Исходящее.МеткаИзменения = Метка;
	Исходящее.Продюсер = Продюсер;
	Исходящее.Статус = Статус;
	Исходящее.Записать();

	Операция = НовоеОписаниеДиспетчера("кфкФоновыеОперацииСлужебный.ОтправкаСообщенийВКафку");
	кфкФоновыеОперацииСлужебный.ОтправкаСообщенийВКафку(Операция, Настройки, 1, Истина);

	Предикат = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Ключ)
		.Реквизит("МеткаРегистрации").Равно(Метка)
		.Реквизит("Статус").Равно(Статус);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения").СодержитЗаписи(Предикат);
	Раздел = кфкФоновыеОперацииСлужебный.ют_РазделОперации(Настройки);
	ПроверитьНезавершеннуюРаботуДиспетчера(Ключ, Раздел.Значение);

КонецПроцедуры

// Проверяет доступность входящего сообщения для следующего запуска после потери рабочего потока.
Процедура ДесериализацияСообщений_НеТеряетСообщениеПриИсчезновенииПотока() Экспорт

	ПодготовитьИсчезновениеРабочегоПотока();
	Консьюмер = ЮТест.Данные().КонструкторОбъекта(Справочники.кфкКонсьюмеры)
		.Установить("Наименование", "Консьюмер проверки остановки")
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Записать(Ложь, Истина); // СправочникСсылка.кфкКонсьюмеры
	Настройки = Новый Массив; // Массив Из СправочникСсылка.кфкКонсьюмеры
	Настройки.Добавить(Консьюмер);

	Ключ = Строка(Новый УникальныйИдентификатор);
	Метка = кфкОбщегоНазначенияСлужебный.НоваяКомбинированнаяМетка();
	Статус = Перечисления.кфкСтатусыСообщений.Новое;
	Входящее = РегистрыСведений.кфкВходящиеСообщения.СоздатьМенеджерЗаписи();
	Входящее.КлючЗаписи = Ключ;
	Входящее.МеткаЗагрузки = Метка;
	Входящее.МеткаИзменения = Метка;
	Входящее.Консьюмер = Консьюмер;
	Входящее.Статус = Статус;
	Входящее.Записать();

	Операция = НовоеОписаниеДиспетчера("кфкФоновыеОперацииСлужебный.ДесериализацияСообщений");
	кфкФоновыеОперацииСлужебный.ДесериализацияСообщений(Операция, Настройки, 1, Истина);

	Предикат = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Ключ)
		.Реквизит("МеткаЗагрузки").Равно(Метка)
		.Реквизит("Статус").Равно(Статус);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкВходящиеСообщения").СодержитЗаписи(Предикат);
	Раздел = кфкФоновыеОперацииСлужебный.ют_РазделОперации(Настройки);
	ПроверитьНезавершеннуюРаботуДиспетчера(Ключ, Раздел.Значение);

КонецПроцедуры

