// Создает упорядоченную выборку с дублями без обращения к данным базы.
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - поля Значение и ДругаяКолонка содержат строки.
Функция НоваяВыборкаДляКолонки()

	// Константные строки позволяют проверить порядок независимо от содержимого базы.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	1 КАК Порядок,
		|	""А"" КАК Значение,
		|	""Б"" КАК ДругаяКолонка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2,
		|	""А"",
		|	""А""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3,
		|	""Б"",
		|	""Б""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";

	Результат = Запрос.Выполнить().Выбрать();
	Возврат Результат;

КонецФункции

