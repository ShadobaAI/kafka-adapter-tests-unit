// Параметры:
//  Десериализовать - Булево - формат ответов описания и удаления.
Процедура ACL_СоздаетОписываетИУдаляетТестовоеРазрешение(Знач Десериализовать) Экспорт

	Интеграция = Обработки.кфкИнтеграция.Создать();
	Ресурс = "yaxunit-acl-" + Строка(Новый УникальныйИдентификатор);
	ЮТест.КонтекстТеста().Вставить("РесурсACL", Ресурс);
	Создана = Интеграция.ДобавитьACL(АдресаБрокеров(), "TOPIC", Ресурс, "LITERAL", "User:yaxunit", "*", "READ", "ALLOW");
	ЮТест.ОжидаетЧто(Создана).ИмеетТип("Булево").Равно(Истина);
	Для ПопыткаОписания = 1 По 20 Цикл
		Ответ = Интеграция.ОписатьACL(
			АдресаБрокеров(), "TOPIC", Ресурс, "LITERAL", "User:yaxunit", "*", "READ", "ALLOW", 10000, Десериализовать);
		Данные = СтруктураОтвета(Ответ, Десериализовать);
		Количество = "";
		Данные.Свойство("count", Количество);
		Если Количество = "1" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Данные).Свойство("count").ИмеетТип("Строка").Равно("1");
	ЮТест.ОжидаетЧто(Данные).Свойство("acls").ИмеетТип("Массив").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Данные).Свойство("acls[0].resource_name").ИмеетТип("Строка").Равно(Ресурс);
	ЮТест.ОжидаетЧто(Данные).Свойство("acls[0].resource_type").ИмеетТип("Строка").Равно("TOPIC");
	ЮТест.ОжидаетЧто(Данные).Свойство("acls[0].principal").ИмеетТип("Строка").Равно("User:yaxunit");
	ЮТест.ОжидаетЧто(Данные).Свойство("acls[0].operation").ИмеетТип("Строка").Равно("READ");
	ЮТест.ОжидаетЧто(Данные).Свойство("acls[0].permission_type").ИмеетТип("Строка").Равно("ALLOW");
	ОтветУдаления = Интеграция.УдалитьACL(
		АдресаБрокеров(), "TOPIC", Ресурс, "LITERAL", "User:yaxunit", "*", "READ", "ALLOW", 10000, Десериализовать);
	Удаленные = СтруктураОтвета(ОтветУдаления, Десериализовать);
	ЮТест.ОжидаетЧто(Удаленные).Свойство("deleted_count").ИмеетТип("Строка").Равно("1");
	ЮТест.ОжидаетЧто(Удаленные).Свойство("deleted_acls").ИмеетТип("Массив").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Удаленные).Свойство("deleted_acls[0].resource_name").ИмеетТип("Строка").Равно(Ресурс);
	Для ПопыткаОписания = 1 По 20 Цикл
		ПослеУдаления = Интеграция.ОписатьACL(
			АдресаБрокеров(), "TOPIC", Ресурс, "LITERAL", "User:yaxunit", "*", "READ", "ALLOW");
		ЮТест.ОжидаетЧто(ПослеУдаления).ИмеетТип("Структура");
		Количество = "";
		ПослеУдаления.Свойство("count", Количество);
		Если Количество = "0" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ПослеУдаления).Свойство("count").ИмеетТип("Строка").Равно("0");

