// Параметры:
//  УстаревшийМетод - Булево - проверить одиночный либо пакетный интерфейс позиций.
Процедура УстановитьПозицииЧтения_НачинаетСоВторойЗаписи(Знач УстаревшийМетод) Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "first");
	ОтправитьКонтрольнуюЗапись(Фикстура, "second");
	Интеграция = Фикстура.Интеграция;
	// Коннектор подключает обработчик позиций при инициализации, если позиции уже заданы.
	Если УстаревшийМетод Тогда
		Результат = Интеграция.УстановитьПозициюЧтения(Фикстура.Топик, 1, 0, Фикстура.Брокеры);
	Иначе
		Позиции = Новый Массив; // Массив Из Структура
		Позиции.Добавить(Новый Структура("topic,offset,partition", Фикстура.Топик, 1, 0));
		Результат = Интеграция.УстановитьПозицииЧтения(Позиции, Фикстура.Брокеры);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Булево").Равно(Истина);
	Интеграция.УстановитьПараметр("group.id", Фикстура.Группа);
	Интеграция.УстановитьПараметр("enable.auto.commit", "false");
	Запущен = Интеграция.ИнициализироватьКонсьюмера(Фикстура.Брокеры);
	Фикстура.КонсьюмерЗапущен = Запущен;
	ЮТест.ОжидаетЧто(Запущен).ИмеетТип("Булево").Равно(Истина);
	Подписан = Интеграция.Подписаться(Фикстура.Топик);
	Фикстура.ГруппаЗафиксирована = Подписан;
	ЮТест.ОжидаетЧто(Подписан).ИмеетТип("Булево").Равно(Истина);
	ДождатьсяСообщения(Интеграция);
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьДанныеСообщения()).ИмеетТип("Строка").Равно("second");
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьСмещениеСообщения()).ИмеетТип("Число").Равно(1);

КонецПроцедуры

