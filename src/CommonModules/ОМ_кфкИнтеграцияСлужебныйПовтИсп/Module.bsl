КонецПроцедуры

// Удаляет подмены и результаты, закэшированные при выполнении сценария.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Проверяет КэшируетОтветМенеджера.
Процедура ОбъектыИнтеграции_КэшируетОтветМенеджера() Экспорт

	Исходное = Новый Соответствие; // Соответствие Из Строка, ФиксированныйМассив
	Исходное.Вставить("справочник.кфкБрокеры", Новый ФиксированныйМассив(Новый Массив));
	Ожидается = Новый ФиксированноеСоответствие(Исходное);
	Мокито.Обучение(Справочники.кфкПродюсеры)
		.Когда("ОбъектыИнтеграции")
			.Вернуть(Ожидается);
	Мокито.Прогон();

	Первый = кфкИнтеграцияСлужебныйПовтИсп.ОбъектыИнтеграции();
	Второй = кфкИнтеграцияСлужебныйПовтИсп.ОбъектыИнтеграции();

	ЮТест.ОжидаетЧто(Первый).ИмеетТип("ФиксированноеСоответствие").Равно(Ожидается);
	ЮТест.ОжидаетЧто(Второй).Равно(Ожидается);
	Мокито.Проверить(Справочники.кфкПродюсеры).КоличествоВызовов("ОбъектыИнтеграции").Равно(1);
	ОбновитьПовторноИспользуемыеЗначения();
	ПослеСброса = кфкИнтеграцияСлужебныйПовтИсп.ОбъектыИнтеграции();
	ЮТест.ОжидаетЧто(ПослеСброса).Равно(Ожидается);
	Мокито.Проверить(Справочники.кфкПродюсеры).КоличествоВызовов("ОбъектыИнтеграции").Равно(2);

КонецПроцедуры

// Проверяет СохраняетОтветМенеджера.
// Параметры:
//  ПустойОтвет - Булево - вернуть пустую коллекцию.
Процедура ИменаОбъектовИнтеграции_СохраняетОтветМенеджера(Знач ПустойОтвет) Экспорт

	Имена = СтрРазделить(?(ПустойОтвет, "", "справочник.кфкБрокеры,документ.Пример"), ",", Ложь);
	Ожидается = Новый ФиксированныйМассив(Имена);
	Мокито.Обучение(Справочники.кфкПродюсеры)
		.Когда("ИменаОбъектовИнтеграции")
			.Вернуть(Ожидается);
	Мокито.Прогон();

	Первый = кфкИнтеграцияСлужебныйПовтИсп.ИменаОбъектовИнтеграции();
	Второй = кфкИнтеграцияСлужебныйПовтИсп.ИменаОбъектовИнтеграции();

	ЮТест.ОжидаетЧто(Первый).ИмеетТип("ФиксированныйМассив").Равно(Ожидается);
	ЮТест.ОжидаетЧто(Второй).Равно(Ожидается);
	Мокито.Проверить(Справочники.кфкПродюсеры).КоличествоВызовов("ИменаОбъектовИнтеграции").Равно(1);

КонецПроцедуры

// Проверяет ОбрабатываетИменаИОшибкиТипа.
Процедура ТипыОбъектовИнтеграции_ОбрабатываетИменаИОшибкиТипа() Экспорт

	Имена = СтрРазделить("справочник.кфкПродюсеры,Несуществующий.Объект,Справочник.кфкБрокеры", ",");
	Мокито.Обучение(Справочники.кфкПродюсеры)
		.Когда("ИменаОбъектовИнтеграции")
			.Вернуть(Новый ФиксированныйМассив(Имена));
	Мокито.Прогон();

	Результат = кфкИнтеграцияСлужебныйПовтИсп.ТипыОбъектовИнтеграции();

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("ОписаниеТипов");
	ЮТест.ОжидаетЧто(Результат.Типы().Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.СодержитТип(Тип("СправочникСсылка.кфкБрокеры"))).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.СодержитТип(Тип("СправочникСсылка.кфкПродюсеры"))).Равно(Ложь);
	Мокито.Проверить(Справочники.кфкПродюсеры).КоличествоВызовов("ИменаОбъектовИнтеграции").Равно(1);

КонецПроцедуры

// Проверяет ВозвращаетПустоеОписание.
Процедура ТипыОбъектовИнтеграции_ВозвращаетПустоеОписание() Экспорт

	Мокито.Обучение(Справочники.кфкПродюсеры)
		.Когда("ИменаОбъектовИнтеграции")
			.Вернуть(Новый ФиксированныйМассив(Новый Массив));
	Мокито.Прогон();

	Результат = кфкИнтеграцияСлужебныйПовтИсп.ТипыОбъектовИнтеграции();

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("ОписаниеТипов");
	ЮТест.ОжидаетЧто(Результат.Типы().Количество()).Равно(0);

КонецПроцедуры

// Проверяет ЧитаетКонстантыИКэширует.
// Параметры:
//  КаталогЛогов - Строка - тестовое значение константы, каталог не создается.
//  ФорматИмени - Строка - тестовая маска имени файла.
Процедура ПараметрыЛогированияКомпоненты_ЧитаетКонстантыИКэширует(Знач КаталогЛогов, Знач ФорматИмени) Экспорт

	Константы.кфкКаталогЛогированияКомпоненты.Установить(КаталогЛогов);
	Константы.кфкФорматИмениФайловЛогированияКомпоненты.Установить(ФорматИмени);

	Первый = кфкИнтеграцияСлужебныйПовтИсп.ПараметрыЛогированияКомпоненты();
	Константы.кфкКаталогЛогированияКомпоненты.Установить("C:\KafkaUnitChanged");
	Второй = кфкИнтеграцияСлужебныйПовтИсп.ПараметрыЛогированияКомпоненты();

	ЮТест.ОжидаетЧто(Первый.КаталогЛогов).Равно(КаталогЛогов);
	ЮТест.ОжидаетЧто(Первый.ФорматИмениФайлов).Равно(ФорматИмени);
	ЮТест.ОжидаетЧто(Второй.КаталогЛогов).Равно(КаталогЛогов);
	ОбновитьПовторноИспользуемыеЗначения();
	ПослеСброса = кфкИнтеграцияСлужебныйПовтИсп.ПараметрыЛогированияКомпоненты();
	ЮТест.ОжидаетЧто(ПослеСброса.КаталогЛогов).Равно("C:\KafkaUnitChanged");
	ЮТест.ОжидаетЧто(ПослеСброса.ФорматИмениФайлов).Равно(ФорматИмени);

КонецПроцедуры

// Проверяет КэшируетВерсиюЗависимости.
Процедура ВерсияКомпоненты_КэшируетВерсиюЗависимости() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_ВерсияКомпоненты", "1.2.3-unit");
	Контекст.Вставить("ют_ЧислоЗапросовВерсии", 0);
	Состояние = ют_КоннекторИнтеграцииДляТестов.НовоеСостояние("");

	Первый = кфкИнтеграцияСлужебныйПовтИсп.ВерсияКомпоненты();
	Контекст["ют_ВерсияКомпоненты"] = "2.3.4-unit";
	Второй = кфкИнтеграцияСлужебныйПовтИсп.ВерсияКомпоненты();

	ЮТест.ОжидаетЧто(Первый).Равно("1.2.3-unit");
	ЮТест.ОжидаетЧто(Второй).Равно("1.2.3-unit");
	ЮТест.ОжидаетЧто(Контекст["ют_ЧислоЗапросовВерсии"]).Равно(1);
	ЮТест.ОжидаетЧто(Состояние.ПараметрыПодключения[0]).Равно("simpleKafka1C");
	ОбновитьПовторноИспользуемыеЗначения();
	ПослеСброса = кфкИнтеграцияСлужебныйПовтИсп.ВерсияКомпоненты();
	ЮТест.ОжидаетЧто(ПослеСброса).Равно("2.3.4-unit");
	ЮТест.ОжидаетЧто(Контекст["ют_ЧислоЗапросовВерсии"]).Равно(2);

КонецПроцедуры

// Проверяет ОтклоняетНеизвестныйРаздел.
// Параметры:
//  Раздел - Строка - недопустимое обозначение раздела.
Процедура СвойстваLibrdKafka_ОтклоняетНеизвестныйРаздел(Знач Раздел) Экспорт

	Аргументы = ЮТМетоды.МассивПараметров(Раздел);

	ЮТест.ОжидаетЧто(кфкИнтеграцияСлужебныйПовтИсп)
		.Метод("СвойстваLibrdKafka", Аргументы)
		.ВыбрасываетИсключение("Недопустимое значение раздела");

КонецПроцедуры

// Проверяет РазделяетРазделыИКэширует.
Процедура СвойстваLibrdKafka_РазделяетРазделыИКэширует() Экспорт

	Общие = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("*");
	Продюсер = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("P");
	Консьюмер = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("C");
	Повторно = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("*");

	ЮТест.ОжидаетЧто(Общие).ИмеетТип("ФиксированноеСоответствие");
	ЮТест.ОжидаетЧто(Общие = Повторно).Равно(Истина);
	ЮТест.ОжидаетЧто(Общие.Количество() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Продюсер.Количество() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Консьюмер.Количество() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Продюсер.Получить("client.id")).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Консьюмер.Получить("client.id")).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Общие.Получить("group.id")).Равно(Неопределено);

КонецПроцедуры

// Проверяет ПреобразуетСтроковыеИБулевыЗначения.
Процедура СвойстваLibrdKafka_ПреобразуетСтроковыеИБулевыЗначения() Экспорт

	Общие = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("*");
	Консьюмер = кфкИнтеграцияСлужебныйПовтИсп.СвойстваLibrdKafka("C");
	Клиент = Общие.Получить("client.id");
	АвтоФиксация = Консьюмер.Получить("enable.auto.commit");

	ЮТест.ОжидаетЧто(Клиент).ИмеетТип("ФиксированнаяСтруктура");
	ЮТест.ОжидаетЧто(Клиент.ТипЗначения).Равно("string");
