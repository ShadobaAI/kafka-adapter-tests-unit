// Проверяет, что ошибка сериализации сообщения не отменяет запись исходного объекта.
Процедура ЗарегистрироватьИзмененияПриЗаписи_НеПрерываетЗаписьПриОшибкеСериализации() Экспорт

	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("кфкИспользоватьИнтеграцию")).Равно(Истина);
	Источник = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "До ошибки регистрации")
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина); // СправочникОбъект.кфк_т_ТестовыйСправочник
	Источник.ДополнительныеСвойства.Удалить("кфкПропуститьРегистрацию");
	Источник.ОбменДанными.Загрузка = Ложь;
	КодНедопустимогоСимволаXML = 1;
	Источник.ДополнительныеСвойства.Вставить("НекорректныйXML", Символ(КодНедопустимогоСимволаXML));
	Источник.Наименование = "После ошибки регистрации";
	Продюсер = НовыйПродюсерДляРегистрации(Источник.Метаданные().ПолноеИмя());
	ОбновитьПовторноИспользуемыеЗначения();
	Аргументы = ЮТМетоды.МассивПараметров(Источник, Перечисления.кфкСобытияРегистрации.ПриЗаписи);

	ЮТест.ОжидаетЧто(кфкОбработкаСобытийСлужебный)
		.Метод("ПоместитьВОчередьИсходящих", Аргументы)
		.ВыбрасываетИсключение("XML");

	Источник.Записать();

	ОтборИсточника = ЮТест.Предикат()
		.Реквизит("Ссылка").Равно(Источник.Ссылка)
		.Реквизит("Наименование").Равно("После ошибки регистрации");
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.кфк_т_ТестовыйСправочник")
		.СодержитНесколькоЗаписей(1, ОтборИсточника);
	ОтборОчереди = ЮТест.Предикат()
		.Реквизит("Продюсер").Равно(Продюсер)
		.Реквизит("КлючОбъекта").Равно(XMLСтрока(Источник.Ссылка));
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
		.НеСодержитЗаписи(ОтборОчереди);

