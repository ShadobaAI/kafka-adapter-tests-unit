// Публичное чтение принимает тело JSON; оболочка #value создается внутри продукта.
// Параметры:
//  Вариант - Строка - вариант входного JSON.
Процедура ПроизвестиЧтениеДанных_ВходнойJSON_РазличаетТелоИОболочку(Вариант) Экспорт

	Источник = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "Исходное имя")
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина);
	НовоеИмя = "Кириллица ""цитата"" и обратная косая черта \\";
	Тело = ТелоКаталогаДляЧтения(Источник.Ссылка, НовоеИмя, 17, Истина, "Строка с переводом" + Символы.ПС);
	Компоненты = КомпонентыДляПроверкиВыбораПравил("Получение");
	ТипXDTO = ФабрикаXDTO.Тип(Компоненты.XMLСхема, "TestCatalog");
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрЗаменить("{""#value"":null}", "null", Тело));
	ЮТест.ОжидаетЧто(ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON, ТипXDTO))
		.ЭтоНеНеопределено();
	Если Вариант = "Тело" Тогда
		ВходнойJSON = Тело;
	ИначеЕсли Вариант = "Оболочка" Тогда
		ВходнойJSON = СтрЗаменить("{""#value"":null}", "null", Тело);
	ИначеЕсли Вариант = "Синтаксис" Тогда
		ВходнойJSON = "{""name"":";
	Иначе
		ВходнойJSON = "42";
	КонецЕсли;

	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиЧтениеДанных(
		Компоненты, ВходнойJSON, "TestCatalog_Получение");

	Если Вариант = "Тело" Тогда
		ТекстОшибки = СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС);
