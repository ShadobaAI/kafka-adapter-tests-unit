	Компоненты.БазовыеСхемыФормата.Вставить(ПространствоИмен, Истина);
	Правило = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	Правило.ОбъектДанных = Неопределено;
	Правило.ОбъектФормата = "ПроверкаСтруктурED";
	Правило.ПространствоИмен = ПространствоИмен;
