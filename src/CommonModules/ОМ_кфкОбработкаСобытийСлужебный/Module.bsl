// Проверяет ключи для каждого настроенного продюсера по фактически записанным сообщениям.
Процедура КлючЗаписиИсходящихСообщений_СоответствуетЗаписаннымСообщениям() Экспорт

	Источник = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Новый УникальныйИдентификатор);
	НовыйПродюсерДляРегистрации("Справочник.кфк_т_ТестовыйСправочник");
	ОбновитьПовторноИспользуемыеЗначения();
	кфкОбработкаСобытийСлужебный.ПоместитьВОчередьИсходящих(
		Источник, Перечисления.кфкСобытияРегистрации.Программно);

	Ключи = кфкОбработкаСобытийСлужебный.КлючЗаписиИсходящихСообщений(Источник);
	ЮТест.ОжидаетЧто(Ключи).ИмеетДлину(2);
	ЮТест.ОжидаетЧто(Ключи[0]).НеРавно(Ключи[1]);
	Для Каждого Ключ Из Ключи Цикл

		Отбор = ЮТест.Предикат()
			.Реквизит("КлючОбъекта").Равно(XMLСтрока(Источник))
			.Реквизит("КлючЗаписи").Равно(Ключ);
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения")
			.СодержитНесколькоЗаписей(1, Отбор);

	КонецЦикла;
	ДругойИсточник = Справочники.кфк_т_ТестовыйСправочник.ПолучитьСсылку(Новый УникальныйИдентификатор);
