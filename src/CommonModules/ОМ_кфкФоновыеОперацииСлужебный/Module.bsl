// Тестовая HTTP-сессия: сохраняет запрос и возвращает управляемый исход.
// Параметры:
//  Метод - Строка - HTTP-метод.
//  Запрос - HTTPЗапрос - сформированный запрос.
// Возвращаемое значение:
//  Структура - ответ тестовой сессии:
//   * КодСостояния - Число - заданный код ответа.
Функция ВызватьHTTPМетод(Метод, Запрос) Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_HTTPМетод", Метод);
	Контекст.Вставить("ют_HTTPЗапрос", Запрос);
	Если Контекст.Свойство("ют_HTTPИсключение") И Контекст.ют_HTTPИсключение Тогда
		ВызватьИсключение "unit: разрыв HTTP-соединения";
	КонецЕсли;
	Код = 200;
	Если Контекст.Свойство("ют_HTTPКод") Тогда
		Код = Контекст.ют_HTTPКод;
	КонецЕсли;

	Возврат Новый Структура("КодСостояния", Код);

КонецФункции

#КонецОбласти

#КонецОбласти

