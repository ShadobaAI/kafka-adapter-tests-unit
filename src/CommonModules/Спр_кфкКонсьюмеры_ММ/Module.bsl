#Область ПрограммныйИнтерфейс

// Регистрирует серверные сценарии проверки модуля и их теги для запуска YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ОписаниеКонсьюмера()")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ОписаниеКонсьюмера")
			.ДобавитьСерверныйТест("ОписаниеКонсьюмера_ВозвращаетПодготовленныеНастройки",
				"ОписаниеКонсьюмера(). Возвращает подготовленные настройки")
				.Тег("ВозвращаетПодготовленныеНастройки")
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ОписаниеКонсьюмеров()")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ОписаниеКонсьюмеров")
			.ДобавитьСерверныйТест("ОписаниеКонсьюмеров_ВозвращаетОписанияПереданныхКонсьюмеров",
				"ОписаниеКонсьюмеров(). Возвращает описания переданных консьюмеров")
				.Тег("ВозвращаетОписанияПереданныхКонсьюмеров")
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ПравилаДесериализации()")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ПравилаДесериализации")
			.ДобавитьСерверныйТест("ПравилаДесериализации_ВозвращаетПодготовленноеПравило",
				"ПравилаДесериализации(). Возвращает подготовленное правило")
				.Тег("ВозвращаетПодготовленноеПравило")
		.ДобавитьТестовыйНабор("Справочник кфкКонсьюмеры. Модуль менеджера. ИдемпотентнаяОбработка()")
			.Тег("Модульные")
			.Тег("кфкКонсьюмеры")
			.Тег("ИдемпотентнаяОбработка")
			.ДобавитьСерверныйТест("ИдемпотентнаяОбработка_ВозвращаетТолькоКонсьюмеровСВключеннымФлагом",
				"ИдемпотентнаяОбработка(). Возвращает только консьюмеров с включенным флагом")
				.Тег("ВозвращаетТолькоКонсьюмеровСВключеннымФлагом");
	
КонецПроцедуры

// Проверяет адреса, топики и параметры подключения консьюмера из тестовых данных.
Процедура ОписаниеКонсьюмера_ВозвращаетПодготовленныеНастройки() Экспорт
	
	Консьюмер = КонсьюмерСправочника();
	
	Описание = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмера(Консьюмер);
	
	ОжидаемыеСвойства = Новый Структура;
	ОжидаемыеСвойства.Вставить("Ссылка", Консьюмер);
	ОжидаемыеСвойства.Вставить("Наименование", "Консьюмер: ТестовыйСправочник");
	ОжидаемыеСвойства.Вставить("АдресБрокера", "localhost:29091,localhost:29092");
	ОжидаемыеСвойства.Вставить("Идентификатор", "1c-test");
	ОжидаемыеСвойства.Вставить("ТаймаутОжидания", 5000);
	ОжидаемыеСвойства.Вставить("ДвоичныеДанные", Ложь);
	
	ЮТест.ОжидаетЧто(Описание, "Описание консьюмера")
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	ЮТест.ОжидаетЧто(Описание.Топики, "Топики консьюмера")
		.ИмеетДлину(1)
		.Содержит("1c.test-catalog");
	ЮТест.ОжидаетЧто(
		Описание.ПараметрыПодключения.Получить("auto.offset.reset"),
		"Параметр auto.offset.reset")
		.Равно("earliest");
	
КонецПроцедуры

// Проверяет наличие отдельных описаний для двух переданных ссылок консьюмеров.
Процедура ОписаниеКонсьюмеров_ВозвращаетОписанияПереданныхКонсьюмеров() Экспорт
	
	КонсьюмерСправочника = КонсьюмерСправочника();
	КонсьюмерРегистра = КонсьюмерРегистра();
	Консьюмеры = Новый Массив;
	Консьюмеры.Добавить(КонсьюмерСправочника);
	Консьюмеры.Добавить(КонсьюмерРегистра);
	
	Описания = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмеров(Консьюмеры);
	
	ЮТест.ОжидаетЧто(Описания, "Описания консьюмеров")
		.ИмеетДлину(2);
	ЮТест.ОжидаетЧто(Описания.Получить(КонсьюмерСправочника))
		.ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Описания.Получить(КонсьюмерРегистра))
		.ЭтоНеНеопределено();
	
КонецПроцедуры

// Проверяет состав правила десериализации и его поиск по консьюмеру и топику.
Процедура ПравилаДесериализации_ВозвращаетПодготовленноеПравило() Экспорт
	
	Консьюмер = КонсьюмерСправочника();
	Консьюмеры = Новый Массив;
	Консьюмеры.Добавить(Консьюмер);
	
	Правила = Справочники.кфкКонсьюмеры.ПравилаДесериализации(Консьюмеры);
	КлючПравила = НРег(XMLСтрока(Консьюмер) + "1c.test-catalog");
	Правило = Правила.Получить(КлючПравила);
	
	ОжидаемыеСвойства = Новый Структура;
	ОжидаемыеСвойства.Вставить(
		"Тип", Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	ОжидаемыеСвойства.Вставить(
		"ИмяМетода", "Справочники.кфк_т_ТестовыйСправочник.Десериализация");
	ОжидаемыеСвойства.Вставить(
		"ИмяМодуля", "кфк_т_МенеджерОбменаЧерезУниверсальныйФормат");
	ОжидаемыеСвойства.Вставить("ИмяПОД", "testCatalog_Получение");
	ОжидаемыеСвойства.Вставить("Формат", "http://v8.fsk.ru/kfk/test/1.0");
	
	ЮТест.ОжидаетЧто(Правила, "Правила десериализации")
		.ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Правило, "Правило десериализации тестового справочника")
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	
КонецПроцедуры

// Проверяет отбор консьюмеров по флагу идемпотентной обработки.
Процедура ИдемпотентнаяОбработка_ВозвращаетТолькоКонсьюмеровСВключеннымФлагом() Экспорт
	
	ИдемпотентныйКонсьюмер = КонсьюмерСправочника();
	ОбычныйКонсьюмер = КонсьюмерРегистра();
	
	Объект = ИдемпотентныйКонсьюмер.ПолучитьОбъект();
	Объект.ИдемпотентнаяОбработка = Истина;
	Объект.Записать();
	
	Консьюмеры = Новый Массив;
	Консьюмеры.Добавить(ИдемпотентныйКонсьюмер);
	Консьюмеры.Добавить(ОбычныйКонсьюмер);
	
	Результат = Справочники.кфкКонсьюмеры.ИдемпотентнаяОбработка(Консьюмеры);
	
	ЮТест.ОжидаетЧто(Результат, "Идемпотентные консьюмеры")
		.ИмеетДлину(1)
		.Содержит(ИдемпотентныйКонсьюмер);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонсьюмерСправочника()
	Возврат кфк_т_ТестовыеДанные.СсылкаКонсьюмераСправочника();
КонецФункции

Функция КонсьюмерРегистра()
	Возврат кфк_т_ТестовыеДанные.СсылкаКонсьюмераРегистра();
КонецФункции

#КонецОбласти
