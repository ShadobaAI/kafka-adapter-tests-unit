// Возвращает собственного владельца сообщений.
// Возвращаемое значение:
//  СправочникСсылка.кфкПродюсеры
Функция НовыйПродюсер()

	Результат = ЮТест.Данные().КонструкторОбъекта(Справочники.кфкПродюсеры)
		.Установить("Наименование", "unit: отправка")
		.Установить("Брокер", кфк_т_ТестовыеДанные.СсылкаБрокераПоУмолчанию())
		.Записать(Ложь, Истина); // СправочникСсылка.кфкПродюсеры

	Возврат Справочники.кфкПродюсеры.ПолучитьСсылку(Результат.УникальныйИдентификатор());

КонецФункции

// Создает собственную строку без выполнения проверяемой операции.
// Параметры:
//  Продюсер - СправочникСсылка.кфкПродюсеры
//  Статус - ПеречислениеСсылка.кфкСтатусыСообщений
//  Метка - Число - миллисекунды регистрации и изменения.
//  Ключ - Строка
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
Функция НовоеСообщение(Продюсер, Статус, Метка, Ключ = "")

	Запись = РегистрыСведений.кфкИсходящиеСообщения.СоздатьМенеджерЗаписи();
	Запись.КлючЗаписи = ?(ПустаяСтрока(Ключ), Строка(Новый УникальныйИдентификатор), Ключ);
	Запись.ДатаРегистрацииМС = Метка;
	Запись.МеткаИзмененияМС = Метка;
	Запись.Продюсер = Продюсер;
	Запись.Статус = Статус;
	Запись.ТипОбъект = "Справочник.кфкПродюсеры";
	Запись.ТипИсходныхДанных = "CatalogRef.кфкПродюсеры";
	Запись.КлючОбъекта = "объект";
	Запись.ТелоСообщения = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище("payload");
	Запись.Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(Новый Соответствие);
	Запись.ДатаРегистрации = Дата(2026, 1, 1);
	Запись.ТекстЖурнала = "исходный журнал";
	Запись.КоличествоОбработок = 2;
	Запись.КоличествоВыгрузок = 3;
	Запись.Записать();

	Возврат Запись;

КонецФункции

// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
//  Поток - УникальныйИдентификатор
//  Метка - Число, Неопределено
Процедура НазначитьСообщение(Запись, Поток, Метка = Неопределено)

	Назначение = РегистрыСведений.кфкОчередьПотоков.СоздатьМенеджерЗаписи();
	Назначение.Ключ = Запись.КлючЗаписи;
	Назначение.ВременнаяМетка = ?(Метка = Неопределено, Запись.ДатаРегистрацииМС, Метка);
	Назначение.ИдентификаторПотока = Поток;
	Назначение.Записать();

КонецПроцедуры

// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса
// Возвращаемое значение:
//  Массив Из Строка
Функция КлючиВыборки(Выборка)

	Результат = Новый Массив; // Массив Из Строка
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.КлючЗаписи);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
//  Статус - ПеречислениеСсылка.кфкСтатусыСообщений
//  Попыток - Число
Процедура ПроверитьИсходящее(Запись, Статус, Попыток)

	Условие = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Запись.КлючЗаписи)
		.Реквизит("ДатаРегистрацииМС").Равно(Запись.ДатаРегистрацииМС)
		.Реквизит("Статус").Равно(Статус)
		.Реквизит("КоличествоВыгрузок").Равно(Попыток);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения").СодержитЗаписи(Условие);

КонецПроцедуры

// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
//  Поток - УникальныйИдентификатор
//  Существует - Булево
Процедура ПроверитьНазначение(Запись, Поток, Существует)

	Условие = ЮТест.Предикат()
		.Реквизит("Ключ").Равно(Запись.КлючЗаписи)
		.Реквизит("ВременнаяМетка").Равно(Запись.ДатаРегистрацииМС)
		.Реквизит("ИдентификаторПотока").Равно(Поток);
	Если Существует Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").СодержитЗаписи(Условие);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкОчередьПотоков").НеСодержитЗаписи(Условие);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.кфкИсходящиеСообщения
//  Существует - Булево
Процедура ПроверитьХэш(Запись, Существует)

	Условие = ЮТест.Предикат().Реквизит("КлючЗаписи").Равно(Запись.КлючЗаписи);
	Если Существует Тогда
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкХэшСуммыСообщений").СодержитЗаписи(Условие);
	Иначе
		ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкХэшСуммыСообщений").НеСодержитЗаписи(Условие);
	КонецЕсли;

КонецПроцедуры

// Возвращает состояние одного изолированного пакета.
// Возвращаемое значение:
//  Структура:
//   * Продюсер - СправочникСсылка.кфкПродюсеры
//   * Поток - УникальныйИдентификатор
//   * Сессии - Соответствие Из КлючИЗначение
//   * Компонента - ОбработкаОбъект.ют_КомпонентаKafkaДляТестов
//   * Хэши - РегистрСведенийНаборЗаписей.кфкХэшСуммыСообщений
Функция НовыйПакет()

	Результат = Новый Структура;
	Продюсер = НовыйПродюсер(); // СправочникСсылка.кфкПродюсеры
	Результат.Вставить("Продюсер", Продюсер);
	Результат.Вставить("Поток", Новый УникальныйИдентификатор);
	Результат.Вставить("Сессии", Новый Соответствие);
	Результат.Вставить("Компонента", Обработки.ют_КомпонентаKafkaДляТестов.Создать());
	Результат.Вставить("Хэши", РегистрыСведений.кфкХэшСуммыСообщений.СоздатьНаборЗаписей());
	Результат.Компонента.НастроитьОтвет("ПолучитьСообщениеОбОшибке", "unit: отказ транспорта");
	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_КомпонентаKafka", Результат.Компонента);
	Контекст.Вставить("ют_ВызовыФабрикиKafka", Новый Массив);
	Результат.Сессии.Вставить(Результат.Продюсер, Обработки.кфкИнтеграция.Создать());

	Возврат Результат;

КонецФункции

// Параметры:
//  Пакет - см. НовыйПакет
//  Топик - Строка
//  ИспользоватьХэши - Булево
Процедура ОтправитьПакет(Пакет, Топик = "unit-topic", ИспользоватьХэши = Истина)

	Группы = кфкФоновыеОперацииСлужебный.ют_ВыборкаОтправкиВПотоке(Пакет.Поток, 100);
	ЮТест.ОжидаетЧто(Группы.Следующий()).Равно(Истина);
	Типы = Группы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЮТест.ОжидаетЧто(Типы.Следующий()).Равно(Истина);
	Выборка = Типы.Выбрать();
	Хэши = ?(ИспользоватьХэши, Пакет.Хэши, Неопределено);
	Очереди = кфкФоновыеОперацииСлужебный.ют_ОчередиИсходящих();

	кфкФоновыеОперацииСлужебный.ют_ОтправитьПакет(
		Выборка, Пакет.Сессии, Очереди, Пакет.Поток, Пакет.Продюсер, Топик, Хэши);

КонецПроцедуры

// Параметры:
//  Пакет - см. НовыйПакет
// Возвращаемое значение:
//  Массив Из Структура - фактические обращения к внешнему компоненту.
Функция ВызовыОтправки(Пакет)

	Результат = Новый Массив; // Массив Из Структура
	Для Каждого Вызов Из Пакет.Компонента.ИсторияВызовов() Цикл
		Если Вызов.Метод = "ОтправитьПакетСРезультатом" Тогда
			Результат.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

