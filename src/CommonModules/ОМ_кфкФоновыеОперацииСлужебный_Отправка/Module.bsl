// Возвращает данные управляемого прикладного сериализатора.
// Параметры:
//  Исход - Строка
//  Ключ - Строка
// Возвращаемое значение:
//  Структура:
//   * Исход - Строка
//   * Ключ - Строка
//   * Заголовки - Структура
//   * Тело - Строка
Функция ДанныеСериализации(Исход, Ключ)

	Результат = Новый Структура;
	Результат.Вставить("Исход", Исход);
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Заголовки", Новый Структура("Источник", Ключ));
	Результат.Вставить("Тело", "тело " + Ключ);

	Возврат Результат;

КонецФункции

// Параметры:
//  Продюсер - СправочникСсылка.кфкПродюсеры
//  Исход - Строка
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение
Функция ПравилаСериализации(Продюсер, Исход)

	Результат = Новый Соответствие;
	Если Исход = "НетПравила" Тогда
		Возврат Результат;
	КонецЕсли;
	Правило = Новый Структура;
	Правило.Вставить("Тип", Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	Правило.Вставить("ИмяМетода", "ОМ_кфкФоновыеОперацииСлужебный_Отправка.ют_Сериализовать");
	Если Исход = "НетМетода" Тогда
		Правило.ИмяМетода = "";
	КонецЕсли;
	Результат.Вставить(НРег(XMLСтрока(Продюсер) + "Справочник.кфкПродюсеры"), Правило);

	Возврат Результат;

КонецФункции

