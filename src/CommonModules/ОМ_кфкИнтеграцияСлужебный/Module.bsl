КонецПроцедуры

// Освобождает двойник и журнал фабрики после каждого сценария.
Процедура ПослеКаждогоТеста() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	КаталогПроверки = "";
	Если Контекст.Свойство("ют_КаталогПроверкиKafka", КаталогПроверки) Тогда

		ФайловаяСистема.УдалитьВременныйКаталог(КаталогПроверки);
		Контекст.Удалить("ют_КаталогПроверкиKafka");

	КонецЕсли;

	Компонента = Неопределено; // ОбработкаОбъект.ют_КомпонентаKafkaДляТестов, Неопределено
	Если Контекст.Свойство("ют_КомпонентаKafka", Компонента) Тогда
		Компонента.ОчиститьИсторию();
	КонецЕсли;
	Контекст.Удалить("ют_КомпонентаKafka");
	Контекст.Удалить("ют_ВызовыФабрикиKafka");
	Паузы = Неопределено; // Массив Из Число, Неопределено
	ПроверитьПаузу = Контекст.Свойство("ют_ПаузыKafka", Паузы);
	Контекст.Удалить("ют_ПаузыKafka");
	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

	Если ПроверитьПаузу Тогда
		ЮТест.ОжидаетЧто(Паузы).Равно(ЮТМетоды.МассивПараметров(5500));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ПреобразованиеСообщений

// Проверяет передачу строки без сериализации.
// Параметры:
//  Данные - Строка - исходное тело.
Процедура ТелоСообщения_СохраняетСтроку(Знач Данные) Экспорт

	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);
	ТекстОшибки = "";

	Результат = кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение, ТекстОшибки);

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Строка").Равно(Данные);
	ЮТест.ОжидаетЧто(ТекстОшибки).Равно("");
	ЮТест.ОжидаетЧто(кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение)).Равно(Данные);

КонецПроцедуры

