// Проверяет сохранение следующей позиции после подтверждения транзакции.
Процедура ОтправитьОфсетыВТранзакцию_СохраняетПозициюГруппы() Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьТранзакцию(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "transactional");
	ПодготовитьКонсьюмера(Фикстура);
	Позиции = Новый Массив; // Массив Из Структура
	Позиции.Добавить(Новый Структура("topic,partition,offset", Фикстура.Топик, 0, 1));
	Данные = Новый Структура("offsets", Позиции);
	Отправлены = Фикстура.Интеграция.ОтправитьОфсетыВТранзакцию(Данные, Фикстура.Группа);
	ЮТест.ОжидаетЧто(Отправлены).ИмеетТип("Булево").Равно(Истина);
	Подтверждена = Фикстура.Интеграция.ЗафиксироватьТранзакциюKafka();
	Фикстура.ТранзакцияОткрыта = Не Подтверждена;
	Фикстура.ГруппаЗафиксирована = Подтверждена;
	ЮТест.ОжидаетЧто(Подтверждена).ИмеетТип("Булево").Равно(Истина);
	ПроверитьСмещениеГруппы(Фикстура, "1");

КонецПроцедуры

// Параметры:
//  Формат - Строка - AVRO или Protobuf.
//  Асинхронно - Булево - отправить без ожидания подтверждения.
Процедура ДвоичныеФорматы_СохраняютИПередаютДанные(Знач Формат, Знач Асинхронно) Экспорт

	Фикстура = НоваяФикстураKafka();
	Интеграция = Фикстура.Интеграция;
	ПодготовитьПродюсера(Фикстура);
	Интеграция.УстановитьРежимАсинх(Асинхронно);
	ИмяСхемы = "YaxunitRecord";
	СхемаAVRO = "{""type"":""record"",""name"":""YaxunitRecord"",""fields"":[{""name"":""value"",""type"":""string""}]}";
	Если Формат = "AVRO" Тогда
		Сохранена = Интеграция.СохранитьСхемуAVRO(ИмяСхемы, СхемаAVRO);
		ДанныеJSON = "{""value"":""payload""}";
	Иначе
		СхемаProto = "syntax = ""proto3""; message YaxunitRecord { string value = 1; }";
		Сохранена = Интеграция.СохранитьСхемуProtobuf(ИмяСхемы, СхемаProto);
		ДанныеJSON = "{""value"":""payload""}";
	КонецЕсли;
	ЮТест.ОжидаетЧто(Сохранена, Интеграция.ПолучитьСообщениеОбОшибке()).ИмеетТип("Булево").Равно(Истина);
	Если Формат = "AVRO" Тогда
		Преобразованы = Интеграция.ПреобразоватьВФорматAVRO(ДанныеJSON, ИмяСхемы);
	Иначе
		Преобразованы = Интеграция.ПреобразоватьВФорматProtobuf(ДанныеJSON, ИмяСхемы);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Преобразованы, Интеграция.ПолучитьСообщениеОбОшибке()).ИмеетТип("Булево").Равно(Истина);

	ИмяФайла = ПолучитьИмяВременногоФайла("bin");
	ЮТест.КонтекстТеста().Вставить("ВременныйФайл", ИмяФайла);
	Если Формат = "AVRO" Тогда
		ФайлСохранен = Интеграция.СохранитьФайлAVRO(ИмяФайла);
	Иначе
		ФайлСохранен = Интеграция.СохранитьФайлProtobuf(ИмяФайла);
	КонецЕсли;
	ЮТест.ОжидаетЧто(ФайлСохранен).ИмеетТип("Булево").Равно(Истина);
	ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Base64Строка(ДанныеФайла))).Равно(Ложь);

	Заголовки = Новый Структура("format", Формат);
	Если Формат = "AVRO" Тогда
		Отправлено = Интеграция.ОтправитьСообщениеAVRO(Фикстура.Топик, 0, "binary-key", Заголовки);
	Иначе
		Отправлено = Интеграция.ОтправитьСообщениеProtobuf(Фикстура.Топик, 0, "binary-key", Заголовки);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Отправлено).ИмеетТип("Число").Равно(?(Асинхронно, 0, 1));
	ПодготовитьКонсьюмера(Фикстура);
	Интеграция.УстановитьРежимЧтенияДвоичныхДанных(Истина);
	ДождатьсяСообщения(Интеграция);
	ДанныеСообщения = Интеграция.ПолучитьДанныеСообщения();
	ЮТест.ОжидаетЧто(ТипЗнч(ДанныеСообщения)).Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(Base64Строка(ДанныеСообщения)).Равно(Base64Строка(ДанныеФайла));
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьКлючСообщения()).ИмеетТип("Строка").Равно("binary-key");

	Если Формат = "AVRO" Тогда
		СхемаИзФайла = Интеграция.ПолучитьСхемуAVRO(ДанныеСообщения);
		ЮТест.ОжидаетЧто(СхемаИзФайла).ИмеетТип("Строка");
		ЮТест.ОжидаетЧто(ОбщегоНазначения.JSONВЗначение(СхемаИзФайла))
			.Равно(ОбщегоНазначения.JSONВЗначение(СхемаAVRO));
		Декодированы = Интеграция.ДекодироватьСообщениеAVRO(ДанныеСообщения, "", Истина);
		ДвоичныйОтвет = Интеграция.ДекодироватьСообщениеAVRO(ДанныеСообщения, "", Ложь);
	Иначе
		Декодированы = Интеграция.ДекодироватьСообщениеProtobuf(ДанныеСообщения, ИмяСхемы, Истина);
		ДвоичныйОтвет = Интеграция.ДекодироватьСообщениеProtobuf(ДанныеСообщения, ИмяСхемы, Ложь);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Декодированы).ИмеетТип("Строка");
	ЮТест.ОжидаетЧто(ОбщегоНазначения.JSONВЗначение(Декодированы))
		.Равно(ОбщегоНазначения.JSONВЗначение(ДанныеJSON));
	// Проверка типа не включает сырые байты в сообщение, передаваемое клиенту через XDTO.
	ЮТест.ОжидаетЧто(ТипЗнч(ДвоичныйОтвет), "Тип двоичного результата декодирования")
		.Равно(Тип("ДвоичныеДанные"));
	ОжидаемыеБайты = ?(Формат = "AVRO", "DnBheWxvYWQ=", Base64Строка(ДанныеСообщения));
	ЮТест.ОжидаетЧто(Base64Строка(ДвоичныйОтвет)).Равно(ОжидаемыеБайты);

КонецПроцедуры

// Проверяет формат байтов в Kafka и тип и значение результата декодирования.
// Параметры:
//  Формат - Строка - формат контейнера, включая поддерживаемые обозначения OCF.
//  ЭтоBase64 - Булево - передавать декодеру Base64 вместо двоичных данных.
//  ВозвращатьJSON - Булево - ожидать JSON либо двоичные данные записи.
Процедура AVRO_ПередаетФорматИДекодируетЗапись(
		Знач Формат, Знач ЭтоBase64, Знач ВозвращатьJSON) Экспорт

	Фикстура = НоваяФикстураKafka();
	Интеграция = Фикстура.Интеграция;
	ПодготовитьПродюсера(Фикстура);
	ИмяСхемы = "YaxunitRecord";
	Схема = ОбщегоНазначения.JSONВЗначение(
		"{""type"":""record"",""name"":""YaxunitRecord"",""fields"":[{""name"":""value"",""type"":""string""}]}", , Ложь);
	Сохранена = Интеграция.СохранитьСхемуAVRO(ИмяСхемы, Схема);
	ЮТест.ОжидаетЧто(Сохранена).ИмеетТип("Булево").Равно(Истина);
	Данные = Новый Структура("value", "payload");
	// 66051 = 0x00010203: разные байты позволяют проверить порядок байтов schema ID.
	Преобразованы = Интеграция.ПреобразоватьВФорматAVRO(Данные, ИмяСхемы, Формат, 66051);
	ЮТест.ОжидаетЧто(Преобразованы, Интеграция.ПолучитьСообщениеОбОшибке()).ИмеетТип("Булево").Равно(Истина);
	Отправлено = Интеграция.ОтправитьСообщениеAVRO(Фикстура.Топик, 0, "avro-key");
	ЮТест.ОжидаетЧто(Отправлено).ИмеетТип("Число").Равно(1);
	ПодготовитьКонсьюмера(Фикстура);
	Интеграция.УстановитьРежимЧтенияДвоичныхДанных(Истина);
	ДождатьсяСообщения(Интеграция);
	Сообщение = Интеграция.ПолучитьДанныеСообщения();
	ЮТест.ОжидаетЧто(ТипЗнч(Сообщение)).Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(Интеграция.ПолучитьКлючСообщения()).ИмеетТип("Строка").Равно("avro-key");
	Представление = Base64Строка(Сообщение);
	ФорматБезРегистра = НРег(Формат);
	Если ФорматБезРегистра = "raw" Тогда
		ЮТест.ОжидаетЧто(Представление).ИмеетТип("Строка").Равно("DnBheWxvYWQ=");
	ИначеЕсли ФорматБезРегистра = "confluent" Тогда
		ЮТест.ОжидаетЧто(Представление).ИмеетТип("Строка").Равно("AAABAgMOcGF5bG9hZA==");
	Иначе
		ИмяСхемы = "";
	КонецЕсли;
	ВходДекодера = ?(ЭтоBase64, Представление, Сообщение); // Строка, ДвоичныеДанные
	Если ИмяСхемы = "" Тогда
		Если ЭтоBase64 Тогда
			// Без явного флага Base64 не должен распознаваться автоматически.
			СхемаБезФлага = Интеграция.ПолучитьСхемуAVRO(Представление);
			ЮТест.ОжидаетЧто(СхемаБезФлага).ИмеетТип("Строка").Равно("");
			ОтветБезФлага = Интеграция.ДекодироватьСообщениеAVRO(Представление);
			ЮТест.ОжидаетЧто(ОтветБезФлага).ИмеетТип("Строка").Равно("");
		КонецЕсли;
		СхемаИзСообщения = Интеграция.ПолучитьСхемуAVRO(ВходДекодера, ЭтоBase64);
		ЮТест.ОжидаетЧто(СхемаИзСообщения).ИмеетТип("Строка");
		ЮТест.ОжидаетЧто(ОбщегоНазначения.JSONВЗначение(СхемаИзСообщения, , Ложь)).Равно(Схема);
	КонецЕсли;
	Ответ = Интеграция.ДекодироватьСообщениеAVRO(ВходДекодера, ИмяСхемы, ВозвращатьJSON, ЭтоBase64);
	// Тип проверяется отдельно: управляющие символы не должны попадать в отчет XDTO.
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ), Интеграция.ПолучитьСообщениеОбОшибке())
		.Равно(Тип(?(ВозвращатьJSON, "Строка", "ДвоичныеДанные")));
	Если ВозвращатьJSON Тогда
		ЮТест.ОжидаетЧто(ОбщегоНазначения.JSONВЗначение(Ответ, , Ложь)).Равно(Данные);
	Иначе
		ЮТест.ОжидаетЧто(Base64Строка(Ответ)).Равно("DnBheWxvYWQ=");
	КонецЕсли;

КонецПроцедуры

// Проверяет замену ранее сохраненной схемы и сериализацию массива записей.
// Параметры:
//  Структурой - Булево - передавать новую схему структурой либо строкой JSON.
Процедура СохранитьСхемуAVRO_ОбновляетСхемуСПовторнымИменем(Знач Структурой) Экспорт

	Фикстура = НоваяФикстураKafka();
	Интеграция = Фикстура.Интеграция;
	ПодготовитьПродюсера(Фикстура);
	ИмяСхемы = "YaxunitUpdated";
	СтараяСхема = "{""type"":""record"",""name"":""YaxunitUpdated"",""fields"":[{""name"":""old"",""type"":""string""}]}";
	Сохранена = Интеграция.СохранитьСхемуAVRO(ИмяСхемы, СтараяСхема);
	ЮТест.ОжидаетЧто(Сохранена).ИмеетТип("Булево").Равно(Истина);
	НоваяСхема = "{""type"":""record"",""name"":""YaxunitUpdated"",""fields"":[{""name"":""value"",""type"":""int""}]}";
	Схема = ?(Структурой, ОбщегоНазначения.JSONВЗначение(НоваяСхема, , Ложь), НоваяСхема); // Строка, Структура
	Обновлена = Интеграция.СохранитьСхемуAVRO(ИмяСхемы, Схема);
	ЮТест.ОжидаетЧто(Обновлена).ИмеетТип("Булево").Равно(Истина);
	Записи = Новый Массив; // Массив Из Структура
	Записи.Добавить(Новый Структура("value", 7));
	Записи.Добавить(Новый Структура("value", 9));
	Преобразованы = Интеграция.ПреобразоватьВФорматAVRO(Записи, ИмяСхемы);
	ЮТест.ОжидаетЧто(Преобразованы, Интеграция.ПолучитьСообщениеОбОшибке()).ИмеетТип("Булево").Равно(Истина);
	Отправлено = Интеграция.ОтправитьСообщениеAVRO(Фикстура.Топик);
	ЮТест.ОжидаетЧто(Отправлено).ИмеетТип("Число").Равно(1);
	ПодготовитьКонсьюмера(Фикстура);
	Интеграция.УстановитьРежимЧтенияДвоичныхДанных(Истина);
	ДождатьсяСообщения(Интеграция);
	Сообщение = Интеграция.ПолучитьДанныеСообщения();
	ЮТест.ОжидаетЧто(ТипЗнч(Сообщение)).Равно(Тип("ДвоичныеДанные"));
	СхемаИзСообщения = Интеграция.ПолучитьСхемуAVRO(Сообщение);
	ЮТест.ОжидаетЧто(СхемаИзСообщения).ИмеетТип("Строка");
	ЮТест.ОжидаетЧто(ОбщегоНазначения.JSONВЗначение(СхемаИзСообщения, , Ложь))
		.Равно(ОбщегоНазначения.JSONВЗначение(НоваяСхема, , Ложь));
	Ответ = Интеграция.ДекодироватьСообщениеAVRO(Сообщение);
	ЮТест.ОжидаетЧто(Ответ).ИмеетТип("Строка");
	ЮТест.ОжидаетЧто(ОбщегоНазначения.JSONВЗначение(Ответ, , Ложь)).ИмеетТип("Массив").Равно(Записи);

КонецПроцедуры

// Параметры:
//  Операция - Строка - Схема, JSON или ДвоичныеДанные.
//  Данные - Строка, Булево - некорректный вход декодера.
//  ЭтоBase64 - Булево - декодировать вход из Base64.
//  ОжидаемаяОшибка - Строка - текст ошибки коннектора.
Процедура AVRO_ОтклоняетНекорректныеДанные(
		Знач Операция, Знач Данные, Знач ЭтоBase64, Знач ОжидаемаяОшибка) Экспорт

	Интеграция = Обработки.кфкИнтеграция.Создать();
	Если Операция = "Схема" Тогда
		Ответ = Интеграция.ПолучитьСхемуAVRO(Данные, ЭтоBase64);
	Иначе
		Ответ = Интеграция.ДекодироватьСообщениеAVRO(Данные, "", Операция = "JSON", ЭтоBase64);
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(Ответ).Равно("");
	Ошибка = Интеграция.ПолучитьСообщениеОбОшибке();
	ЮТест.ОжидаетЧто(Ошибка).ИмеетТип("Строка").Равно(ОжидаемаяОшибка);

КонецПроцедуры

// Проверяет нормализацию каталога и сохранение формата имени логов.
Процедура УстановитьКаталогЛогов_СохраняетПутьИФормат() Экспорт

	Интеграция = Обработки.кфкИнтеграция.Создать();
	Каталог = ПолучитьИмяВременногоФайла();
	ЮТест.КонтекстТеста().Вставить("ВременныйФайл", Каталог);
	Интеграция.УстановитьКаталогЛогов(Каталог, "%Y");
	Интеграция.УстановитьКаталогЛогов("");
	Состояние = Интеграция.ют_СостояниеДляТестирования();
	ЮТест.ОжидаетЧто(Состояние).Свойство("Коннектор.КаталогЛогов")
		.ИмеетТип("Строка").Равно(Каталог + ПолучитьРазделительПути());
	ЮТест.ОжидаетЧто(Состояние).Свойство("Коннектор.ФорматИмениФайловЛога").ИмеетТип("Строка").Равно("%Y");

КонецПроцедуры

// Параметры:
//  Десериализовать - Булево - формат ответа заголовков.
Процедура ПолучитьЗаголовкиСообщения_ВозвращаетЗаголовкиЗаписи(Знач Десериализовать) Экспорт

	Фикстура = НоваяФикстураKafka();
	Интеграция = Фикстура.Интеграция;
	ПодготовитьПродюсера(Фикстура);
	Заголовки = Новый Структура("event", "test");
	Отправлено = Интеграция.ОтправитьСообщение("payload", Фикстура.Топик, 0, "key", Заголовки);
	ЮТест.ОжидаетЧто(Отправлено).ИмеетТип("Число").Равно(1);
	ПодготовитьКонсьюмера(Фикстура);
	ДождатьсяСообщения(Интеграция);
	Ответ = Интеграция.ПолучитьЗаголовкиСообщения(Десериализовать);
	ЮТест.ОжидаетЧто(Ответ).ИмеетТип(?(Десериализовать, "Массив", "Строка"));
	ПолученныеЗаголовки = ?(Десериализовать, Ответ, ОбщегоНазначения.JSONВЗначение(Ответ)); // Массив
	ОжидаемыеЗаголовки = ОбщегоНазначения.JSONВЗначение("[{""key"":""event"",""value"":""test""}]");
	ЮТест.ОжидаетЧто(ПолученныеЗаголовки).Равно(ОжидаемыеЗаголовки);

КонецПроцедуры

// Проверяет согласованность Unix timestamp в миллисекундах и представления ISO.
Процедура ВременныеМетки_СоответствуютПрочитаннойЗаписи() Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "timestamp");
	ПодготовитьКонсьюмера(Фикстура);
	Интеграция = Фикстура.Интеграция;
	ДождатьсяСообщения(Интеграция);
	Метка = Интеграция.ПолучитьВременнуюМеткуСообщения();
	МеткаISO = Интеграция.ПолучитьВременнуюМеткуСообщенияISO();
	ЮТест.ОжидаетЧто(Метка).ИмеетТип("Число").Больше(0);
	ЮТест.ОжидаетЧто(МеткаISO).ИмеетТип("Строка");
	ДатаUTC = Дата(1970, 1, 1) + Цел(Метка / 1000);
	ЮТест.ОжидаетЧто(Лев(МеткаISO, 19)).Равно(XMLСтрока(ДатаUTC));
	ЮТест.ОжидаетЧто(Прав(МеткаISO, 1)).Равно("Z");

КонецПроцедуры

// Проверяет выбор сообщения по его временной метке.
Процедура ПерейтиКВременнойМетке_ПовторноЧитаетЗапись() Экспорт

	Фикстура = НоваяФикстураKafka();
	ПодготовитьПродюсера(Фикстура);
	Метка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОтправитьКонтрольнуюЗапись(Фикстура, "timestamp");
	ПодготовитьКонсьюмера(Фикстура);
	Интеграция = Фикстура.Интеграция;
	ДождатьсяСообщения(Интеграция);
	Результат = Интеграция.ПерейтиКВременнойМетке(Фикстура.Топик, 0, Метка);
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Булево").Равно(Истина);
	ДождатьсяСообщения(Интеграция);
