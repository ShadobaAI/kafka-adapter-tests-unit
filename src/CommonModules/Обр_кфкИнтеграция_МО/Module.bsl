КонецПроцедуры

// Освобождает ресурсы каждого теста, в том числе после неуспешного утверждения.
Процедура ПослеКаждогоТеста() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст.Свойство("ВременныйФайл") Тогда
		ВременныйФайл = Контекст["ВременныйФайл"]; // Строка
		ФайловаяСистема.УдалитьВременныйФайл(ВременныйФайл);
	КонецЕсли;
	Если Контекст.Свойство("РеестрСхем") Тогда
		Реестр = Контекст["РеестрСхем"]; // см. НоваяФикстураРеестра
		Если Реестр.Создан Тогда
			УдаленаСхема = Реестр.Интеграция.УдалитьСхему(Реестр.URL, Реестр.Субъект, "latest");
			ЮТест.ОжидаетЧто(УдаленаСхема, "Удаление тестовой схемы").ИмеетТип("Булево").Равно(Истина);
		КонецЕсли;
	КонецЕсли;
	Если Контекст.Свойство("РесурсACL") Тогда
		РесурсACL = Контекст["РесурсACL"]; // Строка
		АдминистраторACL = Обработки.кфкИнтеграция.Создать();
		УдаленныеACL = АдминистраторACL.УдалитьACL(
			АдресаБрокеров(), "TOPIC", РесурсACL, "LITERAL", "User:yaxunit", "*", "READ", "ALLOW");
		ЮТест.ОжидаетЧто(УдаленныеACL, "Очистка тестовых ACL").ИмеетТип("Структура");
	КонецЕсли;
	Если Не Контекст.Свойство("Kafka") Тогда
		Возврат;
	КонецЕсли;

	Фикстура = Контекст["Kafka"]; // см. НоваяФикстураKafka
	ТранзакцияЗакрыта = Истина;
	ПродюсерОстановлен = Истина;
	ГруппаУдалена = Истина;
	ТопикУдален = Истина;

	Если Фикстура.ТранзакцияОткрыта Тогда
		ТранзакцияЗакрыта = Фикстура.Интеграция.ОтменитьТранзакциюKafka();
	КонецЕсли;
	Если Фикстура.КонсьюмерЗапущен Тогда
		Фикстура.Интеграция.ОстановитьКонсьюмера();
	КонецЕсли;
	Если Фикстура.ПродюсерЗапущен Тогда
		ПродюсерОстановлен = Фикстура.Интеграция.ОстановитьПродюсера();
	КонецЕсли;
	Если Фикстура.ТопикСоздан Тогда
		ТопикУдален = Фикстура.Интеграция.УдалитьТопик(Фикстура.Брокеры, Фикстура.Топик);
	КонецЕсли;
	Если Фикстура.ГруппаЗафиксирована Тогда
		// У группы нет активных участников и смещений других топиков.
		// Удаление ее единственного топика удаляет последние смещения и саму группу.
		Администратор = Обработки.кфкИнтеграция.Создать();
		Для ПопыткаОчистки = 1 По 20 Цикл
			Список = Администратор.ПолучитьСписокГруппКонсьюмеров(Фикстура.Брокеры, Фикстура.Таймаут);
			ЮТест.ОжидаетЧто(Список).ИмеетТип("Структура");
			ЮТест.ОжидаетЧто(Список).Свойство("groups_count").ИмеетТип("Строка");
			ГруппаУдалена = Истина;
			Если Список["groups_count"] <> "0" Тогда
				ЮТест.ОжидаетЧто(Список).Свойство("groups").ИмеетТип("Массив");
				Группы = Список["groups"]; // Массив Из Структура
				Для Каждого Группа Из Группы Цикл
					Идентификатор = "";
					Группа.Свойство("group_id", Идентификатор);
					Если Идентификатор = Фикстура.Группа Тогда
						ГруппаУдалена = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если ГруппаУдалена Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ЮТест.ОжидаетЧто(ТранзакцияЗакрыта, "Завершение тестовой транзакции").ИмеетТип("Булево").Равно(Истина);
	ЮТест.ОжидаетЧто(ПродюсерОстановлен, "Остановка тестового продюсера").ИмеетТип("Булево").Равно(Истина);
	ЮТест.ОжидаетЧто(ГруппаУдалена, "Удаление тестовой группы").ИмеетТип("Булево").Равно(Истина);
	ЮТест.ОжидаетЧто(ТопикУдален, "Удаление тестового топика").ИмеетТип("Булево").Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  Данные - Структура - ответ с массивом configs.
//  Имя - Строка - имя настройки.
//  Значение - Строка - ожидаемое значение.
Процедура ПроверитьНастройку(Знач Данные, Знач Имя, Знач Значение)

	ЮТест.ОжидаетЧто(Данные).Свойство("configs").ИмеетТип("Массив");
	Настройки = Данные["configs"]; // Массив Из Структура
	Найдено = 0;
	Для Каждого Настройка Из Настройки Цикл
		ИмяНастройки = "";
		Настройка.Свойство("name", ИмяНастройки);
		Если ИмяНастройки = Имя Тогда
			ЮТест.ОжидаетЧто(Настройка).Свойство("name").ИмеетТип("Строка").Равно(Имя);
			ЮТест.ОжидаетЧто(Настройка).Свойство("value").ИмеетТип("Строка").Равно(Значение);
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено).Равно(1);

КонецПроцедуры

// Создает группу с двумя записями и зафиксированной позицией 1.
// Параметры:
//  Фикстура - см. НоваяФикстураKafka.
Процедура ПодготовитьГруппу(Знач Фикстура)

	ПодготовитьПродюсера(Фикстура);
	ОтправитьКонтрольнуюЗапись(Фикстура, "first");
	ОтправитьКонтрольнуюЗапись(Фикстура, "second");
	ПодготовитьКонсьюмера(Фикстура);
	Зафиксирована = Фикстура.Интеграция.ЗафиксироватьСмещение(Фикстура.Топик, 1, 0);
	Фикстура.ГруппаЗафиксирована = Зафиксирована;
	ЮТест.ОжидаетЧто(Зафиксирована).ИмеетТип("Булево").Равно(Истина);

КонецПроцедуры

// Параметры:
//  Фикстура - см. НоваяФикстураKafka.
//  ОжидаемоеСмещение - Строка - позиция партиции 0.
Процедура ПроверитьСмещениеГруппы(Знач Фикстура, Знач ОжидаемоеСмещение)

	Ответ = Фикстура.Интеграция.ПолучитьСмещенияГруппыКонсьюмеров(Фикстура.Брокеры);
	ЮТест.ОжидаетЧто(Ответ).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Ответ).Свойство("metadata").ИмеетТип("Массив");
	Позиции = Ответ["metadata"]; // Массив Из Структура
	Найдено = 0;
	Для Каждого Позиция Из Позиции Цикл
		Топик = "";
		Партиция = "";
		Позиция.Свойство("topic", Топик);
		Позиция.Свойство("partition", Партиция);
		Если Топик = Фикстура.Топик И Партиция = "0" Тогда
			ЮТест.ОжидаетЧто(Позиция).Свойство("offset").ИмеетТип("Строка").Равно(ОжидаемоеСмещение);
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено).Равно(1);

КонецПроцедуры

// Возвращает адреса внешних listener двух узлов из tools/kafka/docker-compose.yml.
// Возвращаемое значение:
//  Строка - bootstrap.servers для запуска 1С на хосте Docker.
Функция АдресаБрокеров()

	Результат = "localhost:29091,localhost:29092";
	Возврат Результат;

КонецФункции

// Создает отдельный субъект для каждого теста Schema Registry.
// Возвращаемое значение:
//  Структура:
//   * Интеграция - ОбработкаОбъект.кфкИнтеграция - экземпляр компоненты.
//   * URL - Строка - адрес реестра.
//   * Субъект - Строка - уникальное имя субъекта.
//   * Схема - Строка - исходная схема Avro.
//   * Идентификатор - Число - идентификатор зарегистрированной схемы.
//   * Создан - Булево - требуется удаление схемы.
Функция НоваяФикстураРеестра()

	Результат = Новый Структура("Интеграция,URL,Субъект",
		Обработки.кфкИнтеграция.Создать(),
		"http://localhost:38081",
		"yaxunit-schema-" + Строка(Новый УникальныйИдентификатор));
	Результат.Вставить("Схема",
		"{""type"":""record"",""name"":""YaxunitRecord"",""fields"":[{""name"":""value"",""type"":""string""}]}");
	Результат.Вставить("Идентификатор", 0);
	Результат.Вставить("Создан", Ложь);
	ЮТест.КонтекстТеста().Вставить("РеестрСхем", Результат);
	Ответ = Результат.Интеграция.ЗарегистрироватьСхему(Результат.URL, Результат.Субъект, Результат.Схема);
	Результат.Создан = Ответ <> Неопределено;
	ЮТест.ОжидаетЧто(Ответ).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Ответ).Свойство("id").ИмеетТип("Число").Больше(0);
	ИдентификаторСхемы = Ответ["id"]; // Число
	Результат.Идентификатор = ИдентификаторСхемы;
	Возврат Результат;

КонецФункции

// Создает изолированный топик и сохраняет ресурсы до первой операции с Kafka.
// Возвращаемое значение:
//  Структура:
//   * Интеграция - ОбработкаОбъект.кфкИнтеграция - экземпляр внешней компоненты.
//   * Брокеры - Строка - адреса стенда.
//   * Топик - Строка - уникальный топик текущего теста.
//   * Группа - Строка - уникальная группа текущего теста.
//   * Таймаут - Число - предельное время сетевых операций в миллисекундах.
//   * ТопикСоздан - Булево - требуется удаление топика.
//   * ПродюсерЗапущен - Булево - требуется остановка продюсера.
//   * КонсьюмерЗапущен - Булево - требуется остановка консьюмера.
//   * ГруппаЗафиксирована - Булево - требуется удаление сохраненных смещений.
//   * ТранзакцияОткрыта - Булево - требуется отмена незавершенной транзакции.
Функция НоваяФикстураKafka()

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Результат = Новый Структура("Интеграция,Брокеры,Топик",
		Обработки.кфкИнтеграция.Создать(),
		АдресаБрокеров(),
		"yaxunit-integration-" + Идентификатор);
	Результат.Вставить("Группа", "yaxunit-group-" + Идентификатор);
	Результат.Вставить("Таймаут", 10000);
	Результат.Вставить("ТопикСоздан", Ложь);
	Результат.Вставить("ПродюсерЗапущен", Ложь);
	Результат.Вставить("КонсьюмерЗапущен", Ложь);
	Результат.Вставить("ГруппаЗафиксирована", Ложь);
	Результат.Вставить("ТранзакцияОткрыта", Ложь);
	ЮТест.КонтекстТеста().Вставить("Kafka", Результат);

	КоличествоПартиций = 2;
	ФакторРепликации = 2;
	Создан = Результат.Интеграция.СоздатьТопик(
		Результат.Брокеры,
		Результат.Топик,
		КоличествоПартиций,
		ФакторРепликации);
	Результат.ТопикСоздан = Создан;
	ЮТест.ОжидаетЧто(Создан, "Создание изолированного топика").ИмеетТип("Булево").Равно(Истина);
	Готов = Ложь;
	Для ПопыткаМетаданных = 1 По 20 Цикл
		ОписаниеТопика = Результат.Интеграция.ПолучитьМетаданныеТопика(Результат.Брокеры, Результат.Топик);
		ЮТест.ОжидаетЧто(ОписаниеТопика).ИмеетТип("Структура");
		Готов = ОписаниеТопика.Свойство("partitions_count");
		Если Готов Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Готов, "Готовность метаданных нового топика").Равно(Истина);
	Возврат Результат;

КонецФункции

// Параметры:
//  Фикстура - см. НоваяФикстураKafka
Процедура ПодготовитьПродюсера(Знач Фикстура)

	Фикстура.Интеграция.УстановитьПараметр("acks", "all");
	Фикстура.Интеграция.УстановитьРежимАсинх(Ложь);
	Запущен = Фикстура.Интеграция.ИнициализироватьПродюсера(Фикстура.Брокеры);
	Фикстура.ПродюсерЗапущен = Запущен;
	ЮТест.ОжидаетЧто(Запущен).ИмеетТип("Булево").Равно(Истина);

КонецПроцедуры

// Параметры:
//  Фикстура - см. НоваяФикстураKafka
Процедура ПодготовитьКонсьюмера(Знач Фикстура)

	Интеграция = Фикстура.Интеграция;
	Интеграция.УстановитьПараметр("group.id", Фикстура.Группа);
	Интеграция.УстановитьПараметр("enable.auto.commit", "false");
	Интеграция.УстановитьПараметр("enable.auto.offset.store", "false");
	Интеграция.УстановитьПараметр("enable.partition.eof", "false");
	Интеграция.УстановитьПараметр("isolation.level", "read_committed");
	Запущен = Интеграция.ИнициализироватьКонсьюмера(Фикстура.Брокеры);
	Фикстура.КонсьюмерЗапущен = Запущен;
	ЮТест.ОжидаетЧто(Запущен).ИмеетТип("Булево").Равно(Истина);

	ТаймаутЧтения = 500;
	Установлен = Интеграция.УстановитьТаймаутОжидания(ТаймаутЧтения);
	ЮТест.ОжидаетЧто(Установлен).ИмеетТип("Булево").Равно(Истина);
	Партиции = Новый Массив; // Массив Из Структура
	Партиции.Добавить(Новый Структура("topic,partition,offset", Фикстура.Топик, 0, 0));
	Назначены = Интеграция.НазначитьПартиции(Партиции);
	ЮТест.ОжидаетЧто(Назначены).ИмеетТип("Булево").Равно(Истина);

КонецПроцедуры

// Параметры:
//  Фикстура - см. НоваяФикстураKafka
Процедура ПодготовитьТранзакцию(Знач Фикстура)

	Запущен = Фикстура.Интеграция.ИнициализироватьТранзакционногоПродюсера(Фикстура.Брокеры, Фикстура.Группа);
	Фикстура.ПродюсерЗапущен = Запущен;
	ЮТест.ОжидаетЧто(Запущен).ИмеетТип("Булево").Равно(Истина);
	Начата = Фикстура.Интеграция.НачатьТранзакциюKafka();
	Фикстура.ТранзакцияОткрыта = Начата;
	ЮТест.ОжидаетЧто(Начата).ИмеетТип("Булево").Равно(Истина);

КонецПроцедуры

// Параметры:
//  Фикстура - см. НоваяФикстураKafka
//  Тело - Строка - содержимое известной записи.
Процедура ОтправитьКонтрольнуюЗапись(Знач Фикстура, Знач Тело)

	Результат = Фикстура.Интеграция.ОтправитьСообщение(Тело, Фикстура.Топик, 0, "key");
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Число").Равно(1);

КонецПроцедуры

// Параметры:
//  Интеграция - ОбработкаОбъект.кфкИнтеграция - настроенный консьюмер.
Процедура ДождатьсяСообщения(Знач Интеграция)

	Прочитано = Ложь;
	МаксимумПопыток = 20;
	Для ПопыткаЧтения = 1 По МаксимумПопыток Цикл

		Прочитано = Интеграция.ПрочитатьСообщение();
		ЮТест.ОжидаетЧто(Прочитано).ИмеетТип("Булево");
		Если Прочитано Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;
	ЮТест.ОжидаетЧто(Прочитано, "Запись должна быть получена за 10 секунд").Равно(Истина);

КонецПроцедуры

// Проверяет формат до разбора JSON, чтобы не скрыть ошибку типа преобразованием.
// Параметры:
//  Ответ - Строка, Структура - результат проверяемого метода.
//  Десериализован - Булево - ожидается структура.
// Возвращаемое значение:
//  Структура - проверенный JSON-объект произвольного состава.
Функция СтруктураОтвета(Знач Ответ, Знач Десериализован)

	Если Десериализован Тогда

		ЮТест.ОжидаетЧто(Ответ).ИмеетТип("Структура");
		Возврат Ответ;

	КонецЕсли;

	ЮТест.ОжидаетЧто(Ответ).ИмеетТип("Строка");
	Результат = ОбщегоНазначения.JSONВЗначение(Ответ, , Ложь); // Структура
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Структура");
	Возврат Результат;

КонецФункции

// Проверяет внешнюю запись без приведения типов полей.
// Параметры:
//  Данные - Произвольный - ответ Kafka, тип структуры проверяется первым утверждением.
//  Топик - Строка - ожидаемый топик.
//  Тело - Строка - ожидаемая полезная нагрузка.
//  Ключ - Строка - ожидаемый ключ.
//  Смещение - Строка - ожидаемое смещение в JSON.
Процедура ПроверитьЗапись(Знач Данные, Знач Топик, Знач Тело, Знач Ключ, Знач Смещение)

	ЮТест.ОжидаетЧто(Данные).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Данные).Свойство("message").ИмеетТип("Строка").Равно(Тело);
	ЮТест.ОжидаетЧто(Данные).Свойство("key").ИмеетТип("Строка").Равно(Ключ);
	ЮТест.ОжидаетЧто(Данные).Свойство("topic").ИмеетТип("Строка").Равно(Топик);
	ЮТест.ОжидаетЧто(Данные).Свойство("partition").ИмеетТип("Число").Равно(0);
	ЮТест.ОжидаетЧто(Данные).Свойство("offset").ИмеетТип("Число").Равно(Число(Смещение));

КонецПроцедуры

// Возвращает упорядоченный пакет для одной партиции.
// Возвращаемое значение:
//  Массив Из Структура:
//   * message - Строка - тело записи.
//   * key - Строка - ключ записи.
//   * partition - Число - номер партиции.
Функция НовыйПакетСообщений()

	Результат = Новый Массив; // Массив Из Структура
	Результат.Добавить(Новый Структура("message,key,partition", "first", "key-0", 0));
	Результат.Добавить(Новый Структура("message,key,partition", "second", "key-1", 0));
	Возврат Результат;

КонецФункции

// Параметры:
//  Фикстура - см. НоваяФикстураKafka
Процедура ПроверитьПакетВKafka(Знач Фикстура)

	Пакет = НовыйПакетСообщений();
	Для Индекс = 0 По 1 Цикл

		Запись = Фикстура.Интеграция.ПрочитатьСообщениеПоСмещению(
			Фикстура.Брокеры,
			Фикстура.Топик,
			0,
			Индекс,
			Фикстура.Таймаут);
		ПроверитьЗапись(Запись, Фикстура.Топик, Пакет[Индекс].message, Пакет[Индекс].key, Строка(Индекс));

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
