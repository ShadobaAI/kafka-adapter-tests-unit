//@strict-types

#Область СлужебныеПроцедурыИФункции

// См. кфкОбщегоНазначенияСлужебный.ПодсистемаДоступна
&Around("ПодсистемаДоступна")
Функция ют_ПодсистемаДоступна()

	Аргументы = Новый Массив; // Массив Из Произвольный
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		кфкОбщегоНазначенияСлужебный,
		"ПодсистемаДоступна",
		Аргументы,
		ПрерватьВыполнение);

	Если ПрерватьВыполнение Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = ПродолжитьВызов();
	Возврат Результат;

КонецФункции

// Исключает ожидание времени только в явно настроенной проверке журналов Kafka.
// Параметры:
//  Интервал - Число - длительность паузы в миллисекундах.
&Around("Пауза")
Процедура ют_Пауза(Интервал)

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст <> Неопределено И Контекст.Свойство("ют_ПаузыKafka") Тогда

		Паузы = Контекст["ют_ПаузыKafka"]; // Массив Из Число
		Паузы.Добавить(Интервал);
		Компонента = Контекст["ют_КомпонентаKafka"]; // ОбработкаОбъект.ют_КомпонентаKafkaДляТестов
		Контекст.Вставить("ют_КаталогПроверкиKafka", Компонента.КаталогЛогов);
		Возврат;

	КонецЕсли;

	ПродолжитьВызов(Интервал);

КонецПроцедуры

#КонецОбласти
