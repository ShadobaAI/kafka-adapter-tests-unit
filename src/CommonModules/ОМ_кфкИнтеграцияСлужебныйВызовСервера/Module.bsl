#Область ПрограммныйИнтерфейс

// Регистрирует изолированные проверки исходного кода общего модуля.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.Перед("ПередКаждымТестом")
		.После("ПослеКаждогоТеста")
		.ДобавитьТестовыйНабор("Общий модуль кфкИнтеграцияСлужебныйВызовСервера. КлючиЗаписейИсходящихСообщений()")
			.Тег("Модульные")
			.Тег("кфкИнтеграцияСлужебныйВызовСервера")
			.Тег("КлючиЗаписейИсходящихСообщений")
			.ДобавитьСерверныйТест("КлючиЗаписейИсходящихСообщений_ПередаетДанныеИРезультат",
				"КлючиЗаписейИсходящихСообщений(). ПередаетДанныеИРезультат")
				.Тег("ПередаетДанныеИРезультат")
			.ДобавитьСерверныйТест("КлючиЗаписейИсходящихСообщений_СохраняетНеопределенныйРезультат",
				"КлючиЗаписейИсходящихСообщений(). СохраняетНеопределенныйРезультат")
				.Тег("СохраняетНеопределенныйРезультат")
		.ДобавитьТестовыйНабор("Общий модуль кфкИнтеграцияСлужебныйВызовСервера. ДоступныеТопики()")
			.Тег("Модульные")
			.Тег("кфкИнтеграцияСлужебныйВызовСервера")
			.Тег("ДоступныеТопики")
			.ДобавитьСерверныйТест("ДоступныеТопики_ЗапускаетФоновуюОперацию",
				"ДоступныеТопики(). ЗапускаетФоновуюОперацию")
				.Тег("ЗапускаетФоновуюОперацию")
				.СПараметрами(Ложь)
				.СПараметрами(Истина)
			.ДобавитьСерверныйТест("ДоступныеТопики_ВозвращаетКэшИСохраняетФлаг",
				"ДоступныеТопики(). ВозвращаетКэшИСохраняетФлаг")
				.Тег("ВозвращаетКэшИСохраняетФлаг")
				.СПараметрами(Ложь, Ложь)
				.СПараметрами(Истина, Ложь)
				.СПараметрами(Ложь, Истина)
				.СПараметрами(Истина, Истина)
		.ДобавитьТестовыйНабор("Общий модуль кфкИнтеграцияСлужебныйВызовСервера. ОбновитьКЭШДоступныхТопиков()")
			.Тег("Модульные")
			.Тег("кфкИнтеграцияСлужебныйВызовСервера")
			.Тег("ОбновитьКЭШДоступныхТопиков")
			.ДобавитьСерверныйТест("ОбновитьКЭШДоступныхТопиков_ЗаменяетСнимокОдногоБрокера",
				"ОбновитьКЭШДоступныхТопиков(). ЗаменяетСнимокОдногоБрокера")
				.Тег("ЗаменяетСнимокОдногоБрокера")
		.ДобавитьТестовыйНабор("Общий модуль кфкИнтеграцияСлужебныйВызовСервера. РедакторJSON()")
			.Тег("Модульные")
			.Тег("кфкИнтеграцияСлужебныйВызовСервера")
			.Тег("РедакторJSON")
			.ДобавитьСерверныйТест("РедакторJSON_ВозвращаетДвоичныйМакет",
				"РедакторJSON(). ВозвращаетДвоичныйМакет")
				.Тег("ВозвращаетДвоичныйМакет")
		.ДобавитьТестовыйНабор("Общий модуль кфкИнтеграцияСлужебныйВызовСервера. ЭтоТемнаяТема()")
			.Тег("Модульные")
			.Тег("кфкИнтеграцияСлужебныйВызовСервера")
			.Тег("ЭтоТемнаяТема")
			.ДобавитьСерверныйТест("ЭтоТемнаяТема_ВозвращаетРезультатИсходногоПовтИсп",
				"ЭтоТемнаяТема(). ВозвращаетРезультатИсходногоПовтИсп")
				.Тег("ВозвращаетРезультатИсходногоПовтИсп")
				.СПараметрами(-1, Ложь)
				.СПараметрами(0, Истина)
				.СПараметрами(1, Ложь);

КонецПроцедуры

// Исключает использование результатов и подмен предыдущего сценария.
Процедура ПередКаждымТестом() Экспорт

	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Удаляет подмены и результаты, закэшированные при выполнении сценария.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Проверяет ПередаетДанныеИРезультат.
Процедура КлючиЗаписейИсходящихСообщений_ПередаетДанныеИРезультат() Экспорт

	Данные = Справочники.кфкПродюсеры.ПустаяСсылка();
	Ожидается = Новый ФиксированныйМассив(СтрРазделить("ключ-1,ключ-2", ","));
	Аргументы = ЮТМетоды.МассивПараметров(Данные);
	Мокито.Обучение(кфкОбработкаСобытийСлужебный)
		.Когда("КлючЗаписиИсходящихСообщений", Аргументы)
			.Вернуть(Ожидается);
	Мокито.Прогон();

	Результат = кфкИнтеграцияСлужебныйВызовСервера.КлючиЗаписейИсходящихСообщений(Данные);

	ЮТест.ОжидаетЧто(Результат).Равно(Ожидается);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("КлючЗаписиИсходящихСообщений", Аргументы).Равно(1);

КонецПроцедуры

// Проверяет СохраняетНеопределенныйРезультат.
Процедура КлючиЗаписейИсходящихСообщений_СохраняетНеопределенныйРезультат() Экспорт

	Аргументы = ЮТМетоды.МассивПараметров(Неопределено);
	Мокито.Обучение(кфкОбработкаСобытийСлужебный)
		.Когда("КлючЗаписиИсходящихСообщений", Аргументы)
			.Вернуть(Неопределено);
	Мокито.Прогон();

	Результат = кфкИнтеграцияСлужебныйВызовСервера.КлючиЗаписейИсходящихСообщений(Неопределено);

	ЮТест.ОжидаетЧто(Результат).Равно(Неопределено);
	Мокито.Проверить(кфкОбработкаСобытийСлужебный)
		.КоличествоВызовов("КлючЗаписиИсходящихСообщений", Аргументы).Равно(1);

КонецПроцедуры

// Проверяет ЗапускаетФоновуюОперацию.
// Параметры:
//  ИсходныйФлаг - Булево - исходное значение выходного параметра.
Процедура ДоступныеТопики_ЗапускаетФоновуюОперацию(Знач ИсходныйФлаг) Экспорт

	Брокер = Справочники.кфкБрокеры.ПустаяСсылка();
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	Ожидается = Новый Структура("АдресРезультата", "результат-фоновой-операции");
	АргументыФона = ЮТМетоды.МассивПараметров(
		ПараметрыФона,
		"кфкИнтеграцияСлужебный.ДоступныеТопики",
		Брокер,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено);
	Мокито.Обучение(ДлительныеОперации)
		.Когда("ВыполнитьФункцию", АргументыФона)
			.Вернуть(Ожидается);
	Мокито.Прогон();
	ОтложенноеЗаполнение = ИсходныйФлаг;

	Результат = кфкИнтеграцияСлужебныйВызовСервера.ДоступныеТопики(
		Брокер, ИдентификаторФормы, ОтложенноеЗаполнение);

	ЮТест.ОжидаетЧто(Результат).Равно(Ожидается);
	ЮТест.ОжидаетЧто(ОтложенноеЗаполнение).Равно(Истина);
	Мокито.Проверить(ДлительныеОперации)
		.КоличествоВызовов("ВыполнитьФункцию", АргументыФона).Равно(1);

КонецПроцедуры

// Проверяет ВозвращаетКэшИСохраняетФлаг.
// Параметры:
//  ИсходныйФлаг - Булево - исходное значение выходного параметра.
//  ПустыеТопики - Булево - проверять закэшированный пустой список.
Процедура ДоступныеТопики_ВозвращаетКэшИСохраняетФлаг(Знач ИсходныйФлаг, Знач ПустыеТопики) Экспорт

	Брокер = Справочники.кфкБрокеры.ПустаяСсылка();
	Топики = СтрРазделить(?(ПустыеТопики, "", "топик-1,топик-2"), ",", Ложь);
	Ожидается = Новый ФиксированныйМассив(Топики);
	кфкИнтеграцияСлужебныйВызовСервера.ОбновитьКЭШДоступныхТопиков(Брокер, Топики);
	Мокито.Обучение(ДлительныеОперации)
		.Когда("ВыполнитьФункцию")
			.ВыброситьИсключение("Попадание в кэш не должно запускать фон");
	Мокито.Прогон();
	ОтложенноеЗаполнение = ИсходныйФлаг;

	Результат = кфкИнтеграцияСлужебныйВызовСервера.ДоступныеТопики(
		Брокер, Новый УникальныйИдентификатор, ОтложенноеЗаполнение);

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("ФиксированныйМассив").Равно(Ожидается);
	ЮТест.ОжидаетЧто(ОтложенноеЗаполнение).Равно(ИсходныйФлаг);
	Мокито.Проверить(ДлительныеОперации)
		.КоличествоВызовов("ВыполнитьФункцию").Равно(0);

КонецПроцедуры

// Проверяет ЗаменяетСнимокОдногоБрокера.
Процедура ОбновитьКЭШДоступныхТопиков_ЗаменяетСнимокОдногоБрокера() Экспорт

	ПервыйБрокер = Справочники.кфкБрокеры.ПустаяСсылка();
	ВторойБрокер = Справочники.кфкБрокеры.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ИсходныеТопики = СтрРазделить("старый-топик", ",");
	НовыеТопики = СтрРазделить("новый-топик", ",");
	кфкИнтеграцияСлужебныйВызовСервера.ОбновитьКЭШДоступныхТопиков(ПервыйБрокер, ИсходныеТопики);
	кфкИнтеграцияСлужебныйВызовСервера.ОбновитьКЭШДоступныхТопиков(ВторойБрокер, ИсходныеТопики);

	кфкИнтеграцияСлужебныйВызовСервера.ОбновитьКЭШДоступныхТопиков(ПервыйБрокер, НовыеТопики);
	НовыеТопики.Добавить("последующее-изменение-источника");

	Кэш = кфкИнтеграцияСлужебныйПовтИсп.ДоступныеТопики();
	Ожидается = Новый ФиксированныйМассив(СтрРазделить("новый-топик", ","));
	ЮТест.ОжидаетЧто(Кэш.Получить(ПервыйБрокер)).Равно(Ожидается);
	ЮТест.ОжидаетЧто(Кэш.Получить(ВторойБрокер))
		.Равно(Новый ФиксированныйМассив(ИсходныеТопики));
	ЮТест.ОжидаетЧто(Кэш.Количество()).Равно(2);

КонецПроцедуры

// Проверяет ВозвращаетДвоичныйМакет.
Процедура РедакторJSON_ВозвращаетДвоичныйМакет() Экспорт

	Результат = кфкИнтеграцияСлужебныйВызовСервера.РедакторJSON();

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("ДвоичныеДанные");
	ЮТест.ОжидаетЧто(Результат.Размер() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Base64Строка(Результат))
		.Равно(Base64Строка(ПолучитьОбщийМакет("кфкJSONEditor")));

КонецПроцедуры

// Проверяет ВозвращаетРезультатИсходногоПовтИсп.
// Параметры:
//  СравнениеВерсий - Число - ответ зависимости сравнения версий.
//  Ожидается - Булево - ожидаемый признак темы.
Процедура ЭтоТемнаяТема_ВозвращаетРезультатИсходногоПовтИсп(Знач СравнениеВерсий, Знач Ожидается) Экспорт

	Мокито.Обучение(ОбщегоНазначенияКлиентСервер)
		.Когда("СравнитьВерсии")
			.Вернуть(СравнениеВерсий);
	Мокито.Обучение(ОбщегоНазначения)
		.Когда("ВычислитьВБезопасномРежиме")
			.Вернуть(Ожидается);
	Мокито.Прогон();

	Результат = кфкИнтеграцияСлужебныйВызовСервера.ЭтоТемнаяТема();

	ЮТест.ОжидаетЧто(Результат).Равно(Ожидается);
	Мокито.Проверить(ОбщегоНазначенияКлиентСервер)
		.КоличествоВызовов("СравнитьВерсии").Равно(1);
	Мокито.Проверить(ОбщегоНазначения)
		.КоличествоВызовов("ВычислитьВБезопасномРежиме").Равно(?(СравнениеВерсий < 0, 0, 1));

КонецПроцедуры

#КонецОбласти
