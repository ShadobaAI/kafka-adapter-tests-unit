#КонецОбласти

#Область Сериализация

// Проверяет согласованный результат обработки и освобождение собственного назначения.
// Параметры:
//  Исход - Строка
//  Статус - ПеречислениеСсылка.кфкСтатусыСообщений
Процедура Сериализация_СохраняетСогласованныйИсход(Исход, Статус) Экспорт

	Продюсер = НовыйПродюсер();
	Поток = Новый УникальныйИдентификатор;
	Запись = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1000);
	Запись.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(ДанныеСериализации(Исход, "ключ-1"));
	Запись.Записать();
	НазначитьСообщение(Запись, Поток);
	Чужая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1001);
	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаСериализацииВПотоке(Поток, 100);

	кфкФоновыеОперацииСлужебный.ют_СериализоватьПакет(
		Выборка, кфкФоновыеОперацииСлужебный.ют_ОчередиИсходящих(),
		Поток, ПравилаСериализации(Продюсер, Исход));

	ПроверитьИсходящее(Запись, Статус, 3);
	ПроверитьНазначение(Запись, Поток, Ложь);
	ПроверитьИсходящее(Чужая, Перечисления.кфкСтатусыСообщений.Новое, 3);
	Условие = ЮТест.Предикат()
		.Реквизит("КлючЗаписи").Равно(Запись.КлючЗаписи)
		.Реквизит("КоличествоОбработок").Равно(3);
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфкИсходящиеСообщения").СодержитЗаписи(Условие);
	Запись.Прочитать();
	ЮТест.ОжидаетЧто(СтрНайти(Запись.ТекстЖурнала, "исходный журнал") > 0).Равно(Истина);
	Если Исход = "Успех" Тогда
		ЮТест.ОжидаетЧто(Запись.КлючСообщения).Равно("ключ-1");
		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ТелоСообщения)).Равно("тело ключ-1");
		Заголовки = кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.Заголовки); // Соответствие Из КлючИЗначение
		ЮТест.ОжидаетЧто(Заголовки.Получить("Источник")).Равно("ключ-1");
	Иначе
		ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Запись.ТелоСообщения))
			.Равно(Неопределено);
	КонецЕсли;

КонецПроцедуры

// Проверяет передачу данных между двумя вызовами прикладного сериализатора.
Процедура Сериализация_НеПереноситДанныеМеждуСообщениями() Экспорт

	Продюсер = НовыйПродюсер();
	Поток = Новый УникальныйИдентификатор;
	Первая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1000);
	Вторая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1001);
	Первая.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(ДанныеСериализации("Успех", "первый"));
	Вторая.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(ДанныеСериализации("Успех", "второй"));
	Первая.Записать();
	Вторая.Записать();
	НазначитьСообщение(Первая, Поток);
	НазначитьСообщение(Вторая, Поток);
	Выборка = кфкФоновыеОперацииСлужебный.ют_ВыборкаСериализацииВПотоке(Поток, 100);

	кфкФоновыеОперацииСлужебный.ют_СериализоватьПакет(
		Выборка, кфкФоновыеОперацииСлужебный.ют_ОчередиИсходящих(),
		Поток, ПравилаСериализации(Продюсер, "Успех"));

	Первая.Прочитать();
	Вторая.Прочитать();
	ЮТест.ОжидаетЧто(Первая.КлючСообщения).Равно("первый");
	ЮТест.ОжидаетЧто(Вторая.КлючСообщения).Равно("второй");
	ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Первая.ТелоСообщения)).Равно("тело первый");
	ЮТест.ОжидаетЧто(кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Вторая.ТелоСообщения)).Равно("тело второй");
	ЗаголовкиПервой =
		кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Первая.Заголовки); // Соответствие Из КлючИЗначение
	ЮТест.ОжидаетЧто(ЗаголовкиПервой.Получить("Источник")).Равно("первый");
	ЗаголовкиВторой =
		кфкОбщегоНазначенияСлужебный.ЗначениеИзХранилища(Вторая.Заголовки); // Соответствие Из КлючИЗначение
	ЮТест.ОжидаетЧто(ЗаголовкиВторой.Получить("Источник")).Равно("второй");
	ПроверитьНазначение(Первая, Поток, Ложь);
	ПроверитьНазначение(Вторая, Поток, Ложь);

КонецПроцедуры

// Проверяет сброс состояния КД и передачу флагов при повторном использовании компонентов.
// Параметры:
//  Пропустить - Булево
//  Статус - ПеречислениеСсылка.кфкСтатусыСообщений
Процедура СериализацияКД_ИзолируетСообщенияИУчитываетФлаги(Пропустить, Статус) Экспорт

	Продюсер = НовыйПродюсер();
	Поток = Новый УникальныйИдентификатор;
	Первая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1000);
	Вторая = НовоеСообщение(Продюсер, Перечисления.кфкСтатусыСообщений.Новое, 1001);
	Первая.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(ДанныеСериализации("КД", "первый"));
	Вторая.ИсходныеДанные = кфкОбщегоНазначенияСлужебный.ЗначениеВХранилище(ДанныеСериализации("КД", "второй"));
	Первая.Записать();
	Вторая.Записать();
	НазначитьСообщение(Первая, Поток);
