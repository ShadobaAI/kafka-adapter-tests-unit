// Задает ответ внешней границы в пределах одного экземпляра двойника.
// Параметры:
//  Метод - Строка - имя операции компоненты.
//  Ответ - Произвольный - возвращаемое значение.
Процедура НастроитьОтвет(Знач Метод, Знач Ответ) Экспорт

	ОтветыКомпоненты.Вставить(Метод, Ответ);
	Если Метод = "ФайлыЖурнала" Тогда
		ЮТест.КонтекстТеста().Вставить("ют_ПаузыKafka", Новый Массив);
	КонецЕсли;

КонецПроцедуры

