#Область ПрограммныйИнтерфейс

// Создает изолированное состояние ответов и вызовов компоненты.
// Параметры:
//  Ответ - Произвольный - результат, который должна вернуть компонента.
//  Ошибка - Строка - исходное описание ошибки компоненты.
// Возвращаемое значение:
//  Структура:
//   * Ответ - Произвольный - настроенный результат.
//   * Ошибка - Строка - описание отказа.
//   * Вызовы - Массив Из Структура:
//    ** Метод - Строка - имя вызванного метода.
//    ** Параметры - Массив Из Произвольный - аргументы внешнего API.
//   * ПодключениеОтказано - Булево - фабрика возвращает Неопределено.
//   * ПараметрыПодключения - Массив Из Произвольный - аргументы фабрики.
Функция НовоеСостояние(Знач Ответ, Знач Ошибка = "") Экспорт

	Результат = Новый Структура("Ответ,Ошибка,Вызовы", Ответ, Ошибка, Новый Массив);
	Результат.Вставить("ПодключениеОтказано", Ложь);
	Результат.Вставить("ПараметрыПодключения", Новый Массив);
	ЮТест.КонтекстТеста().Вставить("ют_КоннекторИнтеграции", Результат);
	Возврат Результат;

КонецФункции

