// Проверяет повторный запуск после прерывания и отсутствие дубля активного задания.
// Параметры:
//  Авария - Булево - Прежнее задание завершилось аварийно, иначе отменено.
Процедура ЗапуститьФЗ_ПерезапускаетПрерванноеЗаданиеБезСеанса(Авария) Экспорт

	СостояниеПрежнего = ?(Авария, СостояниеФоновогоЗадания.ЗавершеноАварийно, СостояниеФоновогоЗадания.Отменено);
	Первое = НовыйСнимокФоновогоЗадания(СостояниеПрежнего);
	Второе = НовыйСнимокФоновогоЗадания(СостояниеФоновогоЗадания.Активно);
	Ключ = "ют_" + Строка(Первое.УникальныйИдентификатор);
	ИмяМетода = "ОМ_кфкФоновыеОперацииСлужебный_Управление.ют_ЗавершитьНазначениеПоСигналу";
	Наименование = "Проверка повторного запуска";
	Параметры = ЮТМетоды.МассивПараметров(Новый УникальныйИдентификатор, Авария,
		Первое.УникальныйИдентификатор); // Массив Из Произвольный
	АктивныеЗадания = Новый Массив; // Массив Из Структура
	Если Первое.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		АктивныеЗадания.Добавить(Первое);
	КонецЕсли;
	ОжидаемыйОтбор = Новый Структура("Ключ,Состояние", Ключ, СостояниеФоновогоЗадания.Активно);

	Мокито.Сбросить();
	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ют_ПолучитьФоновыеЗадания")
			.Вернуть(АктивныеЗадания)
		.Когда("ют_ВыполнитьФоновоеЗадание")
			.Вернуть(Второе);
	Мокито.Прогон();

	Повтор = кфкФоновыеОперацииСлужебный.ют_ЗапуститьФЗ(Ключ, ИмяМетода, Наименование, Параметры);

	ЮТест.ОжидаетЧто(Повтор.УникальныйИдентификатор).Равно(Второе.УникальныйИдентификатор);
	ЮТест.ОжидаетЧто(Повтор.УникальныйИдентификатор).НеРавно(Первое.УникальныйИдентификатор);
	АргументыОтбора = ЮТМетоды.МассивПараметров(ОжидаемыйОтбор); // Массив Из Произвольный
	АргументыЗапуска = ЮТМетоды.МассивПараметров(
		ИмяМетода, Параметры, Ключ, Наименование); // Массив Из Произвольный
	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ют_ПолучитьФоновыеЗадания", АргументыОтбора).Равно(1);
	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ют_ВыполнитьФоновоеЗадание", АргументыЗапуска).Равно(1);

	АктивныеЗадания.Добавить(Второе);
	Мокито.Сбросить();
	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ют_ПолучитьФоновыеЗадания")
			.Вернуть(АктивныеЗадания)
		.Когда("ют_ВыполнитьФоновоеЗадание")
			.Вернуть(Первое);
	Мокито.Прогон();

	ПовторАктивного = кфкФоновыеОперацииСлужебный.ют_ЗапуститьФЗ(Ключ, ИмяМетода, Наименование, Параметры);

	ЮТест.ОжидаетЧто(ПовторАктивного.УникальныйИдентификатор).Равно(Второе.УникальныйИдентификатор);
	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ют_ПолучитьФоновыеЗадания", АргументыОтбора).Равно(1);
	Мокито.Проверить(кфкФоновыеОперацииСлужебный)
		.КоличествоВызовов("ют_ВыполнитьФоновоеЗадание").Равно(0);
	Мокито.Сбросить();

КонецПроцедуры

// Проверяет сохранение назначения после аварии или отмены и его завершение при повторном запуске.
// Параметры:
//  Авария - Булево - Завершить первое задание исключением вместо отмены.
Процедура ЗапуститьФЗ_ПерезапускаетПослеПрерывания(Авария) Экспорт

	Сигнал = Новый УникальныйИдентификатор;
	Задания = Новый Массив; // Массив Из ФоновоеЗадание
	Сигналы = ЮТМетоды.МассивПараметров(Сигнал);
	ТаймаутЗавершения = 60;
	Попытка
		Первое = ЗапуститьТестовоеЗадание(Сигнал, Авария);
		Задания.Добавить(Первое);
		ОжидатьСигнал(Сигнал, "ют_Старт", Первое);
		Указатели = кфкФоновыеОперацииСлужебный.ют_НовыеУказателиПотоков();
		ДобавитьНазначениеСтенда(Первое, Указатели, 2000000);

		ПовторАктивного = ЗапуститьТестовоеЗадание(Сигнал, Авария);
		ЮТест.ОжидаетЧто(ПовторАктивного.УникальныйИдентификатор).Равно(Первое.УникальныйИдентификатор);
		Если Авария Тогда
			ЗаписатьСигнал(Сигнал, "ют_Разрешение");
		Иначе
			Первое.Отменить();
		КонецЕсли;
		Первое = Первое.ОжидатьЗавершенияВыполнения(ТаймаутЗавершения);

		ОжидаемыйСтатус = ?(Авария, СостояниеФоновогоЗадания.ЗавершеноАварийно, СостояниеФоновогоЗадания.Отменено);
		ЮТест.ОжидаетЧто(Первое.Состояние).Равно(ОжидаемыйСтатус);
		ПроверитьНазначениеСтенда(Первое.УникальныйИдентификатор, Истина);
		СброситьСигналы(Сигнал);

		Второе = ЗапуститьТестовоеЗадание(Сигнал, Ложь, Первое.УникальныйИдентификатор);
		Задания.Добавить(Второе);
		ОжидатьСигнал(Сигнал, "ют_Старт", Второе);
		ЮТест.ОжидаетЧто(Второе.УникальныйИдентификатор).НеРавно(Первое.УникальныйИдентификатор);
		ЗаписатьСигнал(Сигнал, "ют_Разрешение");
		ОжидатьСигнал(Сигнал, "ют_Завершение", Второе);

		ПроверитьНазначениеСтенда(Первое.УникальныйИдентификатор, Ложь);
		Повтор = Второе.ОжидатьЗавершенияВыполнения(ТаймаутЗавершения);
		ЮТест.ОжидаетЧто(Повтор.Состояние).Равно(СостояниеФоновогоЗадания.Завершено);
	Исключение
		ТекстИсходнойОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			ОчиститьСтендЗаданий(Задания, Сигналы);
		Исключение
			ВызватьИсключение ТекстИсходнойОшибки + Символы.ПС + "Ошибка очистки тестового стенда:"
				+ Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьСтендЗаданий(Задания, Сигналы);

КонецПроцедуры



