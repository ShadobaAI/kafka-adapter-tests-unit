	СтарыйКлюч = Строка(Новый УникальныйИдентификатор);
	НовыйКлюч = Строка(Новый УникальныйИдентификатор);
	СтараяМетка = 987654321;
	Буфер.Отбор.КлючЗаписи.Установить(СтарыйКлюч);
	СтараяСтрока = Буфер.Добавить();
	СтараяСтрока.КлючЗаписи = СтарыйКлюч;
	СтараяСтрока.МеткаИзмененияМС = СтараяМетка;

	Повторный = кфкФоновыеОперацииСлужебный.ют_НоваяОчередь(Очереди);

	ЮТест.ОжидаетЧто(Повторный.Количество(), "старые строки очищены").Равно(0);
	ЮТест.ОжидаетЧто(Повторный.Отбор.КлючЗаписи.Использование, "старый отбор сброшен").Равно(Ложь);
	НоваяСтрока = Повторный.Добавить();
	НоваяСтрока.КлючЗаписи = НовыйКлюч;
	ЮТест.ОжидаетЧто(НоваяСтрока.МеткаИзмененияМС,
		"новая строка не наследует старую метку").Равно(0);
	Повторный.Записать(РежимЗамещения.Добавление);
	ИмяТаблицы = ?(Входящие, "РегистрСведений.кфкВходящиеСообщения",
		"РегистрСведений.кфкИсходящиеСообщения");
	ЮТест.ОжидаетЧтоТаблицаБазы(ИмяТаблицы)
		.СодержитТолькоОднуЗапись(ЮТест.Предикат()
			.Реквизит("КлючЗаписи").Равно(НовыйКлюч)
			.Реквизит("МеткаИзмененияМС").Равно(0));
