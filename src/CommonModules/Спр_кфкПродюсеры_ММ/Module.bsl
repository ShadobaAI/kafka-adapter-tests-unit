// Регистрирует серверные сценарии проверки модуля и их теги для запуска YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ВТранзакции()
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. Модуль менеджера. ОписаниеПродюсера()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("ОписаниеПродюсера")
			.ДобавитьСерверныйТест("ОписаниеПродюсера_ВозвращаетПодготовленныеНастройки",
				"ОписаниеПродюсера(). Возвращает подготовленные настройки")
				.Тег("ВозвращаетПодготовленныеНастройки")
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. Модуль менеджера. ОбъектыИнтеграции()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("ОбъектыИнтеграции")
			.ДобавитьСерверныйТест("ОбъектыИнтеграции_ГруппируетПродюсеровПоТипамОбъектов",
				"ОбъектыИнтеграции(). Группирует продюсеров по типам объектов")
				.Тег("ГруппируетПродюсеровПоТипамОбъектов")
			.ДобавитьСерверныйТест("ОбъектыИнтеграции_НеВозвращаетЗаблокированногоПродюсера",
				"ОбъектыИнтеграции(). Не возвращает заблокированного продюсера")
				.Тег("НеВозвращаетЗаблокированногоПродюсера")
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. Модуль менеджера. ИменаОбъектовИнтеграции()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("ИменаОбъектовИнтеграции")
			.ДобавитьСерверныйТест("ИменаОбъектовИнтеграции_ВозвращаетПодготовленныеТипыОбъектов",
				"ИменаОбъектовИнтеграции(). Возвращает подготовленные типы объектов")
				.Тег("ВозвращаетПодготовленныеТипыОбъектов")
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. Модуль менеджера. ПравилаСериализации()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("ПравилаСериализации")
			.ДобавитьСерверныйТест("ПравилаСериализации_ВозвращаетПодготовленноеПравило",
				"ПравилаСериализации(). Возвращает подготовленное правило")
				.Тег("ВозвращаетПодготовленноеПравило")
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. Модуль менеджера. Топики()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("Топики")
			.ДобавитьСерверныйТест("Топики_ВозвращаетПодготовленныйТопик",
				"Топики(). Возвращает подготовленный топик")
				.Тег("ВозвращаетПодготовленныйТопик")
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. Модуль менеджера. ИдемпотентнаяОтправка()")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("ИдемпотентнаяОтправка")
			.ДобавитьСерверныйТест("ИдемпотентнаяОтправка_ВозвращаетТолькоПродюсеровСВключеннымФлагом",
				"ИдемпотентнаяОтправка(). Возвращает только продюсеров с включенным флагом")
				.Тег("ВозвращаетТолькоПродюсеровСВключеннымФлагом");
	

	ЮТТесты
		.ДобавитьТестовыйНабор("Справочник кфкПродюсеры. ПравилаСериализации(). По умолчанию")
			.Тег("CI")
			.Тег("Справочник")
			.Тег("Модульные")
			.Тег("кфкПродюсеры")
			.Тег("ПравилаСериализации")
			.Перед("ОчиститьПодменуПространствИменXDTO")
			.После("ОчиститьПодменуПространствИменXDTO")
			.ДобавитьСерверныйТест("ПравилаСериализации_ПрименяетНастройкиПоПолям",
				"ПравилаСериализации(). Приоритет полей и сохранность строки")
