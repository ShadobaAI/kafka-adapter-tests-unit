// Возвращает отдельный двойник внешней компоненты для текущего сценария.
// Возвращаемое значение:
//  ОбработкаОбъект.ют_КомпонентаKafkaДляТестов - настроенная компонента.
Функция НоваяКомпонента()

	Результат = Обработки.ют_КомпонентаKafkaДляТестов.Создать();
	Результат.НастроитьОтвет("ПолучитьСообщениеОбОшибке", "ошибка компоненты");
	Результат.НастроитьОтвет("ИнициализироватьПродюсера", Истина);
	Результат.НастроитьОтвет("ИнициализироватьКонсьюмера", Истина);
	Результат.НастроитьОтвет("Подписаться", Истина);
	Результат.НастроитьОтвет("УстановитьТаймаутОжидания", Истина);
	Результат.НастроитьОтвет("УстановитьПараметр", Истина);
	Результат.НастроитьОтвет("ПрочитатьСообщение", Ложь);
	Результат.НастроитьОтвет("ПолучитьДанныеСообщения", "данные");
	Результат.НастроитьОтвет("ПолучитьКлючСообщения", "ключ");
	Результат.НастроитьОтвет("ПолучитьЗаголовкиСообщения", "[]");
	Результат.НастроитьОтвет("ПолучитьТопикСообщения", "unit-topic");
	Результат.НастроитьОтвет("ПолучитьИдентификаторБрокераСообщения", 1);
	Результат.НастроитьОтвет("ПолучитьВременнуюМеткуСообщения", 1700000000);
	Результат.НастроитьОтвет("ПолучитьРазделСообщения", 3);
	Результат.НастроитьОтвет("ПолучитьСмещениеСообщения", 41);
	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ют_КомпонентаKafka", Результат);
	Контекст.Вставить("ют_ВызовыФабрикиKafka", Новый Массив);
	Возврат Результат;

КонецФункции

// Параметры:
//  Компонента - ОбработкаОбъект.ют_КомпонентаKafkaДляТестов - двойник.
//  Метод - Строка - имя операции.
//  Количество - Число - ожидаемая кратность.
//  Параметры - Массив Из Произвольный, Неопределено - ожидаемые аргументы.
Процедура ПроверитьВызовы(Знач Компонента, Знач Метод, Знач Количество, Знач Параметры = Неопределено)

	Найдено = 0;
	Для Каждого Вызов Из Компонента.ИсторияВызовов() Цикл

		Если Вызов.Метод <> Метод Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		Если Параметры <> Неопределено Тогда
			ЮТест.ОжидаетЧто(Вызов.Параметры, Метод).Равно(Параметры);
		КонецЕсли;

	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено, Метод).Равно(Количество);

КонецПроцедуры

// Параметры:
//  Количество - Число - ожидаемое количество подключений компоненты.
Процедура ПроверитьФабрику(Знач Количество)

	Вызовы = ЮТест.КонтекстТеста()["ют_ВызовыФабрикиKafka"]; // Массив Из Массив Из Произвольный
	ЮТест.ОжидаетЧто(Вызовы).ИмеетДлину(Количество);
	Для Каждого Параметры Из Вызовы Цикл

		ЮТест.ОжидаетЧто(Параметры[0]).Равно("simpleKafka1C");
		ЮТест.ОжидаетЧто(Параметры[1]).Равно("ОбщийМакет.кфкАдаптерKafka");
		ЮТест.ОжидаетЧто(Параметры[2]).Равно(Истина);

	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Компонента - ОбработкаОбъект.ют_КомпонентаKafkaДляТестов - двойник.
//  Имя - Строка - имя параметра.
//  Значение - Строка - ожидаемое значение.
Процедура ПроверитьПараметрКомпоненты(Знач Компонента, Знач Имя, Знач Значение)

	Количество = 0;
	Для Каждого Вызов Из Компонента.ИсторияВызовов() Цикл

		Если Вызов.Метод = "УстановитьПараметр"
			И Вызов.Параметры[0] = Имя Тогда

			Количество = Количество + 1;
			ЮТест.ОжидаетЧто(Вызов.Параметры[1], Имя).Равно(Значение);

		КонецЕсли;

	КонецЦикла;
	ЮТест.ОжидаетЧто(Количество, Имя).Равно(1);

КонецПроцедуры

// Параметры:
//  Количество - Число - размер пакета.
// Возвращаемое значение:
//  Массив Из Структура:
//   * message - Строка - тело сообщения.
Функция НовыеПакетныеСообщения(Знач Количество)

	Результат = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Результат.Добавить(Новый Структура("message", "данные"));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Параметры:
//  ИмяТипа - Строка - изменяемый тип коллекции.
//  Фиксировать - Булево - создать неизменяемую коллекцию.
// Возвращаемое значение:
//  - Массив - пустая изменяемая коллекция элементов.
//  - ФиксированныйМассив - пустая неизменяемая коллекция элементов.
//  - Структура - пустая изменяемая коллекция свойств.
//  - ФиксированнаяСтруктура - пустая неизменяемая коллекция свойств.
//  - Соответствие - пустая изменяемая коллекция пар ключ-значение.
//  - ФиксированноеСоответствие - пустая неизменяемая коллекция пар ключ-значение.
Функция НоваяКоллекцияСообщения(Знач ИмяТипа, Знач Фиксировать)

	Результат = Новый (ИмяТипа);
	Если Не Фиксировать Тогда
		Возврат Результат;
	КонецЕсли;
	Если ИмяТипа = "Массив" Тогда
		Возврат Новый ФиксированныйМассив(Результат);
	КонецЕсли;
	Если ИмяТипа = "Структура" Тогда
		Возврат Новый ФиксированнаяСтруктура(Результат);
	КонецЕсли;
	Возврат Новый ФиксированноеСоответствие(Результат);

КонецФункции

// Возвращает компоненту с двумя файлами каждого вида без зависимости от порядка обхода.
// Параметры:
//  Статистика - Строка - содержимое файлов статистики.
// Возвращаемое значение:
//  ОбработкаОбъект.ют_КомпонентаKafkaДляТестов - внешняя граница с заданными файлами.
Функция КомпонентаСЖурналами(Знач Статистика)

	Результат = НоваяКомпонента();
	Файлы = Новый Соответствие; // Соответствие Из КлючИЗначение: Ключ - Строка, Значение - Строка
	Файлы.Вставить("producer_first_.log", "producer log");
	Файлы.Вставить("producer_second_.log", "producer log");
	Файлы.Вставить("statistics_first_.log", Статистика);
	Файлы.Вставить("statistics_second_.log", Статистика);
	Файлы.Вставить("ignored.log", "not statistics");
	Результат.НастроитьОтвет("ФайлыЖурнала", Файлы);
	Возврат Результат;

КонецФункции

// Возвращает одну строку статистики с обычным узлом и служебным координатором.
// Параметры:
//  ИдентификаторУзла - Число - идентификатор Kafka.
//  Источник - Строка - источник узла.
// Возвращаемое значение:
//  Строка - JSON внешней компоненты.
Функция НоваяСтрокаСтатистики(Знач ИдентификаторУзла, Знач Источник)

	Шаблон = "{""brokers"":{""node1"":{""nodename"":""node1:9092"",""nodeid"":%1,""source"":""%2""},"
		+ """GroupCoordinator"":{}}}";
	Результат = СтрШаблон(Шаблон, ИдентификаторУзла, Источник);
	Возврат Результат;

КонецФункции

#КонецОбласти
