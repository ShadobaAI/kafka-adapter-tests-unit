// Проверяет повтор одного сообщения после успешной либо ошибочной обработки.
// Параметры:
//  ПервыйУспешен - Булево
Процедура ОбработатьВходящееСообщение_ХэшПоявляетсяТолькоПослеУспеха(ПервыйУспешен) Экспорт

	Сценарий = НовыйСценарийДедупликации();
	Сценарий.Правило.ИмяМетода = ?(ПервыйУспешен,
		"ОМ_кфкФоновыеОперацииСлужебный_ПолучениеОчистка.ют_УспешнаяДесериализация",
		"ОМ_кфкФоновыеОперацииСлужебный_ПолучениеОчистка.ют_ОшибкаДесериализации");
	Первая = Сценарий.Очередь.Добавить();

	кфкФоновыеОперацииСлужебный.ют_ОбработатьВходящее(
		Сценарий.Выборка, Первая, Сценарий.Правила, Сценарий.Идемпотентные,
		Сценарий.Хэши, Сценарий.Кэш, Сценарий.Момент);

	ОжидаемыйСтатус = ?(ПервыйУспешен, Перечисления.кфкСтатусыСообщений.Обработано,
		Перечисления.кфкСтатусыСообщений.ОшибкаОбработки);
	ЮТест.ОжидаетЧто(Первая.Статус).Равно(ОжидаемыйСтатус);
	ЮТест.ОжидаетЧто(Сценарий.Хэши.Количество()).Равно(?(ПервыйУспешен, 1, 0));
	ЮТест.ОжидаетЧто(Сценарий.Кэш.Количество()).Равно(?(ПервыйУспешен, 1, 0));
	Сценарий.Правило.ИмяМетода = "ОМ_кфкФоновыеОперацииСлужебный_ПолучениеОчистка.ют_УспешнаяДесериализация";
	Вторая = Сценарий.Очередь.Добавить();

	кфкФоновыеОперацииСлужебный.ют_ОбработатьВходящее(
		Сценарий.Выборка, Вторая, Сценарий.Правила, Сценарий.Идемпотентные,
		Сценарий.Хэши, Сценарий.Кэш, Сценарий.Момент);

	ОжидаемыйСтатус = ?(ПервыйУспешен, Перечисления.кфкСтатусыСообщений.ОбработкаОтменена,
		Перечисления.кфкСтатусыСообщений.Обработано);
