// Проверяет выбор ПКПД по типу значения при одном, нуле и двух правилах.
// Параметры:
//  КоличествоПравил - Число - количество подходящих правил ПКПД.
//  ОжидаемыйФрагмент - Строка - часть ожидаемого сообщения об ошибке.
Процедура ПроизвестиВыгрузкуДанных_ПКПДПоТипу_ВыбираетИлиСообщаетОбОшибке(
	КоличествоПравил, ОжидаемыйФрагмент) Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	ПравилоОбъекта = Компоненты.ПравилаКонвертацииОбъектов.Найти(
		"Справочник_ТестовыйСправочник", "ИмяПКО");
	ПравилоСвойства = ПравилоОбъекта.Свойства.Найти("Перечисление", "СвойствоКонфигурации");
	ПравилоСвойства.ПравилоКонвертацииСвойства = "";
	Правила = Компоненты.ПравилаКонвертацииПредопределенныхДанных;
	Правила[0].ТипXDTO = ПравилоОбъекта.ТипXDTO.Свойства.Получить("enum").Тип;
	Если КоличествоПравил = 0 Тогда
		Правила.Очистить();
	ИначеЕсли КоличествоПравил = 2 Тогда
		Второе = Правила.Добавить();
		ЗаполнитьЗначенияСвойств(Второе, Правила[0]);
	КонецЕсли;

	Источник = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "Проверка выбора ПКПД")
		.Установить("Перечисление", Перечисления.кфк_т_ТестовоеПеречисление.Значение1)
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина);
	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, "Справочник_ТестовыйСправочник_Отправка");

	Если КоличествоПравил = 1 Тогда
		ЮТест.ОжидаетЧто(Результат).ЭтоНеНеопределено();
		ЮТест.ОжидаетЧто(Компоненты.ФлагОшибки).Равно(Ложь);
	Иначе
		ПроверитьОшибкуВыбораПравила(Компоненты, Результат, ОжидаемыйФрагмент);
	КонецЕсли;

КонецПроцедуры

// Обработчик отключает первое ПКО, и публичный цикл выбирает следующее.
Процедура ПроизвестиВыгрузкуДанных_ПервоеПКООтключено_ВыбираетСледующее() Экспорт

	Компоненты = КомпонентыДляПроверкиВыбораПравил();
	ПравилоОбработки = Компоненты.ПравилаОбработкиДанных.Найти(
		"Справочник_ТестовыйСправочник_Отправка", "Имя");
	ПравилоОбработки.ИспользуемыеПКО.Очистить();
	ПравилоОбработки.ИспользуемыеПКО.Добавить("ПервоеПКО");
	ПравилоОбработки.ИспользуемыеПКО.Добавить("ВтороеПКО");
	ПравилоОбработки.ПриОбработке = "ОтключитьПервоеПКО";

	ПравилаОбъектов = Компоненты.ПравилаКонвертацииОбъектов;
	Второе = ПравилаОбъектов.Найти("Справочник_ТестовыйСправочник", "ИмяПКО");
	Второе.ИмяПКО = "ВтороеПКО";
	Первое = ПравилаОбъектов.Добавить();
	ЗаполнитьЗначенияСвойств(Первое, Второе);
	Первое.ИмяПКО = "ПервоеПКО";
	Первое.ТипXDTO = Неопределено;
	Компоненты.МенеджерОбмена = ют_МенеджерОбменаXDTOДляВыбораПравил;

	Источник = ЮТест.Данные().КонструкторОбъекта(Справочники.кфк_т_ТестовыйСправочник)
		.Установить("Наименование", "Проверка отключения первого ПКО")
		.УстановитьДополнительноеСвойство("кфкПропуститьРегистрацию", Истина)
		.Записать(Истина, Истина);
	Результат = кфкОбменДаннымиXDTOСервер.ПроизвестиВыгрузкуДанных(
		Компоненты, Источник, ПравилоОбработки.Имя);

	ЮТест.ОжидаетЧто(Результат, СтрСоединить(Компоненты.ПротоколКонвертации, Символы.ПС))
		.ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Компоненты.ФлагОшибки).Равно(Ложь);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.Свойство("ТестовыйОбработчикДо")).Равно(Истина);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.Свойство("ТестовыйОбработчикПосле")).Равно(Истина);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.ТестовоеКоличествоДо).Равно(1);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.ТестовоеКоличествоПосле).Равно(1);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.ТестовыйИсточникДо.Ссылка).Равно(Источник.Ссылка);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.ТестовыйИсточникПосле.Ссылка).Равно(Источник.Ссылка);
	ЮТест.ОжидаетЧто(Компоненты.СвойстваСообщения.ТестовыйРезультатПосле).Равно(Результат);

КонецПроцедуры

