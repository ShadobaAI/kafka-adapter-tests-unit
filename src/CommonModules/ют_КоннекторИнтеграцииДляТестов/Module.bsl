//  Сообщение - Произвольный - аргумент внешнего API с тем же именем.
//  Топик - Произвольный - аргумент внешнего API с тем же именем.
//  Партиция - Произвольный - аргумент внешнего API с тем же именем.
//  Ключ - Произвольный - аргумент внешнего API с тем же именем.
//  Заголовки - Произвольный - аргумент внешнего API с тем же именем.
// Возвращаемое значение:
//  Произвольный - настроенный результат компоненты.
Функция ОтправитьСообщение(
		Знач Сообщение,
		Знач Топик,
		Знач Партиция,
		Знач Ключ,
		Знач Заголовки) Экспорт

	Параметры = ЮТМетоды.МассивПараметров(
		Сообщение,
		Топик,
		Партиция,
		Ключ,
		Заголовки);
	Результат = ОтветНаВызов("ОтправитьСообщение", Параметры);
	Возврат Результат;

КонецФункции

