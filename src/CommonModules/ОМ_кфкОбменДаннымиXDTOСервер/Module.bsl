#Область ПроверкиКомпонентовИПравил

// Проверяет исходные поля и независимость изменяемых коллекций двух вызовов.
//
// Параметры:
//  НаправлениеОбмена - Строка - Отправка или Получение.
Процедура ИнициализироватьКомпонентыОбмена_СоздаетНезависимыеКомпоненты(НаправлениеОбмена) Экспорт

	Первый = кфкОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена(НаправлениеОбмена);
	Второй = кфкОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена(НаправлениеОбмена);

	ЮТест.ОжидаетЧто(Первый.НаправлениеОбмена).Равно(НаправлениеОбмена);
	ЮТест.ОжидаетЧто(Первый.ВерсияФорматаОбмена).Равно("");
	ЮТест.ОжидаетЧто(Первый.XMLСхема).Равно("");
	ЮТест.ОжидаетЧто(Первый.ЭтоEnterpriseData).Равно(Ложь);
	ЮТест.ОжидаетЧто(Первый.МенеджерОбмена).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Первый.ФлагОшибки).Равно(Ложь);
	ЮТест.ОжидаетЧто(Первый.ФлагПропустить).Равно(Ложь);
	ЮТест.ОжидаетЧто(Первый.ОтключитьПреобразованиеВNull).Равно(Ложь);
	ЮТест.ОжидаетЧто(Первый.ИспользоватьТранзакции).Равно(Истина);
	ЮТест.ОжидаетЧто(Первый.ОбменДаннымиЗагрузка).Равно(Истина);
	ЮТест.ОжидаетЧто(Первый.ОтключитьМеханизмРегистрации).Равно(Истина);
	ЮТест.ОжидаетЧто(Первый.НавигационнаяСсылка).Равно(Истина);

	Первый.БазовыеСхемыФормата.Вставить("test", Истина);
	Первый.СвойстваСообщения.Вставить("test", "value");
	Первый.ЗаголовкиСообщения.Вставить("test", "value");
	Первый.ПротоколКонвертации.Добавить("test");
	Первый.ОбъектыВыборкиФормата.Вставить("test", "value");
	Первый.ОбъектыФормата.Вставить("test", "value");

	ЮТест.ОжидаетЧто(Второй.БазовыеСхемыФормата.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Второй.СвойстваСообщения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Второй.ЗаголовкиСообщения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Второй.ПротоколКонвертации.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Второй.ОбъектыВыборкиФормата.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Второй.ОбъектыФормата.Количество()).Равно(0);

КонецПроцедуры

// Проверяет значимые колонки, индексы и независимость таблиц правил свойств.
Процедура ИнициализироватьТаблицуСвойствДляПравилаКонвертации_СоздаетНезависимыеТаблицы() Экспорт

	Первая = кфкОбменДаннымиXDTOСервер.ИнициализироватьТаблицуСвойствДляПравилаКонвертации();
	Вторая = кфкОбменДаннымиXDTOСервер.ИнициализироватьТаблицуСвойствДляПравилаКонвертации();

	ЮТест.ОжидаетЧто(Первая.Колонки.Количество()).Равно(8);
	ЮТест.ОжидаетЧто(Первая.Индексы.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Первая.Колонки.Найти("СвойствоКонфигурации")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Первая.Колонки.Найти("СвойствоФормата")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Первая.Колонки.Найти("ОбработкаКлючевогоСвойства")).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Первая.Колонки.Найти("ПространствоИмен")).ЭтоНеНеопределено();

	СтрокаСвойства = Первая.Добавить();
