Процедура ТелоСообщения_ОтклоняетНеподдерживаемыйТип(Знач Данные) Экспорт

	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);
	ТекстОшибки = "";

	Результат = кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение, ТекстОшибки);

	ЮТест.ОжидаетЧто(Результат).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(ТекстОшибки).Равно("Неподдерживаемый тип передачи данных!");

КонецПроцедуры

// Проверяет реальную сериализацию структуры без обучения зависимостей.
Процедура ТелоСообщения_СериализуетСтруктуру() Экспорт

	Данные = Новый Структура("Ключ", "значение");
	Сообщение = кфкИнтеграция.ПараметрыСообщения(Данные);
	ТекстОшибки = "";

	Результат = кфкИнтеграцияСлужебный.ТелоСообщения(Сообщение, ТекстОшибки);

	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Строка");
	ПрочитанныеДанные = ОбщегоНазначения.JSONВЗначение(Результат); // Соответствие
	ЮТест.ОжидаетЧто(ПрочитанныеДанные.Получить("Ключ")).Равно("значение");
	ЮТест.ОжидаетЧто(ТекстОшибки).Равно("");

КонецПроцедуры

// Проверяет пустую коллекцию заголовков.
Процедура ЗаголовкиПакетногоСообщения_ВозвращаетПустуюСтроку() Экспорт

	Заголовки = Новый Соответствие;
	Результат = кфкИнтеграцияСлужебный.ЗаголовкиПакетногоСообщения(Заголовки);
	ЮТест.ОжидаетЧто(Результат).Равно("");

КонецПроцедуры

// Проверяет XML-представление значений и разделители нескольких заголовков.
