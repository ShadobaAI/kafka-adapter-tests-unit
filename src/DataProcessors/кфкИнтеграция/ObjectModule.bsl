#Область ПрограммныйИнтерфейс

// Вызывает исходное подключение на созданном объекте для проверки отказа фабрики компоненты.
Процедура ют_ПодключитьКомпонентуДляТестирования() Экспорт

	ПодключитьКомпоненту();

КонецПроцедуры

// Возвращает состояние объекта исключительно для модульных тестов.
// Возвращаемое значение:
//  Структура:
//   * Коннектор - ОбъектВнешнейКомпоненты - подключенная компонента.
//   * РежимЧтенияДвоичныхДанных - Булево - режим чтения.
//   * РежимАсинхроннойОтправки - Булево - режим отправки.
//   * ТаймаутОжиданияОтвета - Число - ожидание в миллисекундах.
Функция ют_СостояниеДляТестирования() Экспорт

	Компонента = Коннектор; // ОбъектВнешнейКомпоненты
	ДвоичныеДанные = РежимЧтенияДвоичныхДанных; // Булево
	АсинхроннаяОтправка = РежимАсинхроннойОтправки; // Булево
	Таймаут = ТаймаутОжиданияОтвета; // Число
	Состояние = Новый Структура;
	Состояние.Вставить("Коннектор", Компонента);
	Состояние.Вставить("РежимЧтенияДвоичныхДанных", ДвоичныеДанные);
	Состояние.Вставить("РежимАсинхроннойОтправки", АсинхроннаяОтправка);
	Состояние.Вставить("ТаймаутОжиданияОтвета", Таймаут);
	Возврат Состояние;

КонецФункции

#КонецОбласти

