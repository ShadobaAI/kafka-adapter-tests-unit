#Область ПрограммныйИнтерфейс

// Регистрирует серверные сценарии проверки модуля и их теги для запуска YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.После("ПослеКаждогоТеста")
		.ДобавитьТестовыйНабор("Обработка кфкПанельАдминистрирования. Модуль менеджера. ФоновыеЗадания()")
			.Тег("CI")
			.Тег("Обработка")
			.Тег("Модульные")
			.Тег("кфкПанельАдминистрирования")
			.Тег("ФоновыеЗадания")
			.ДобавитьСерверныйТест("ФоновыеЗадания_ВозвращаетМассив",
				"ФоновыеЗадания(). Возвращает массив описаний фоновых заданий")
				.Тег("ВозвращаетМассив")
			.ДобавитьСерверныйТест("ФоновыеЗадания_ПоказываетОшибкуПодпотока",
				"ФоновыеЗадания(). Ошибка подпотока видна на основном потоке")
			.ДобавитьСерверныйТест("ФоновыеЗадания_ГруппируетСлужебныеОперации",
				"ФоновыеЗадания(). Служебное задание показано в своей группе");
	
КонецПроцедуры

// Проверяет тип результата получения описаний фоновых заданий панели администрирования.
Процедура ФоновыеЗадания_ВозвращаетМассив() Экспорт
	
	ОписанияЗаданий = Обработки.кфкПанельАдминистрирования.ФоновыеЗадания();
	
	ЮТест.ОжидаетЧто(ОписанияЗаданий, "Описания фоновых заданий")
		.ИмеетТип("Массив");
	
КонецПроцедуры

// Проверяет отображение ошибки дочернего потока в дереве заданий.
Процедура ФоновыеЗадания_ПоказываетОшибкуПодпотока() Экспорт

	Начало = Дата(2026, 1, 2, 10, 0, 0);
	ОсновнойПоток = НовоеОписаниеФоновогоЗадания("Выгрузка", "Выгрузка сообщений",
		СостояниеФоновогоЗадания.Активно, Начало, Дата(1, 1, 1));
	Подпоток = НовоеОписаниеФоновогоЗадания("Выгрузка_1", "Выгрузка сообщений (1)",
		СостояниеФоновогоЗадания.ЗавершеноАварийно, Начало + 1, Дата(2026, 1, 2, 10, 0, 2));
	Задания = ЮТМетоды.МассивПараметров(ОсновнойПоток, Подпоток);

	ДеревоЗаданий = ПолучитьДеревоЗаданий(Задания);

	ЮТест.ОжидаетЧто(ДеревоЗаданий, "Верхний уровень дерева").ИмеетДлину(1);
	Корень = ДеревоЗаданий[0];
	ЮТест.ОжидаетЧто(Корень.Ключ, "Ключ основного потока").Равно(ОсновнойПоток.Ключ);
	ЮТест.ОжидаетЧто(Корень.Состояние, "Авария подпотока видна на основном потоке").Равно("Ошибка");
	ЮТест.ОжидаетЧто(Корень.ВложенныеПотоки, "Подпотоки выгрузки").ИмеетДлину(1);
	ОписаниеПодпотока = Корень.ВложенныеПотоки[0];
	ЮТест.ОжидаетЧто(ОписаниеПодпотока.Ключ, "Ключ вложенного потока").Равно(Подпоток.Ключ);
	ЮТест.ОжидаетЧто(ОписаниеПодпотока.Состояние, "Состояние вложенного потока").Равно("Ошибка");

КонецПроцедуры

// Проверяет отдельную группу служебных операций.
Процедура ФоновыеЗадания_ГруппируетСлужебныеОперации() Экспорт

	КлючиСлужебныхОпераций = кфкФоновыеОперацииСлужебный.КлючиСлужебныхОпераций();
	Начало = Дата(2026, 1, 2, 10, 0, 0);
	Операция = НовоеОписаниеФоновогоЗадания(КлючиСлужебныхОпераций[0], "Служебное задание",
		СостояниеФоновогоЗадания.Завершено, Начало, Начало + 1);
	Задания = ЮТМетоды.МассивПараметров(Операция);

	ДеревоЗаданий = ПолучитьДеревоЗаданий(Задания);

	ЮТест.ОжидаетЧто(ДеревоЗаданий, "Группы служебных заданий").ИмеетДлину(1);
	Группа = ДеревоЗаданий[0];
	ЮТест.ОжидаетЧто(Группа.Наименование, "Наименование группы").Равно("Служебные операции");
	ЮТест.ОжидаетЧто(Группа.ВложенныеПотоки, "Служебные задания группы").ИмеетДлину(1);
	Задание = Группа.ВложенныеПотоки[0];
	ЮТест.ОжидаетЧто(Задание.Ключ, "Ключ служебного задания").Равно(Операция.Ключ);
	ЮТест.ОжидаетЧто(Задание.Состояние, "Состояние служебного задания").Равно("Завершено");

КонецПроцедуры

// Сбрасывает подмену получения фоновых заданий.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует дескриптор фонового задания для подмены платформенного списка.
//
// Параметры:
//	Ключ - Строка - Ключ фонового задания.
//	Наименование - Строка - Наименование задания.
//	Состояние - СостояниеФоновогоЗадания - Состояние задания.
//	Начало - Дата - Время начала.
//	Конец - Дата - Время завершения, пустая дата для активного задания.
//
// Возвращаемое значение:
//	Структура - Дескриптор фонового задания:
// * Ключ - Строка - Ключ задания.
// * Наименование - Строка - Представление задания.
// * Состояние - СостояниеФоновогоЗадания - Состояние задания.
// * Начало - Дата - Время начала.
// * Конец - Дата - Время окончания.
// * УникальныйИдентификатор - УникальныйИдентификатор - Идентификатор задания.
// * ИнформацияОбОшибке - Неопределено - Подробности для этих проверок не требуются.
Функция НовоеОписаниеФоновогоЗадания(Ключ, Наименование, Состояние, Начало, Конец)

	Описание = Новый Структура("Ключ,Наименование", Ключ, Наименование);
	Описание.Вставить("Состояние", Состояние);
	Описание.Вставить("Начало", Начало);
	Описание.Вставить("Конец", Конец);
	Описание.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
	Описание.Вставить("ИнформацияОбОшибке", Неопределено);
	Возврат Описание;

КонецФункции

// Возвращает дерево заданий по подготовленным дескрипторам.
//
// Параметры:
//	Задания - Массив Из См. НовоеОписаниеФоновогоЗадания
//
// Возвращаемое значение:
//	Массив Из Структура - Дерево заданий для панели администрирования.
Функция ПолучитьДеревоЗаданий(Задания)

	Мокито.Обучение(кфкФоновыеОперацииСлужебный)
		.Когда("ПолучитьПотоки")
			.Вернуть(Задания);
	Мокито.Прогон();

	Возврат Обработки.кфкПанельАдминистрирования.ФоновыеЗадания();

КонецФункции

#КонецОбласти
