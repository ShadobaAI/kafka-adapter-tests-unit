	Условие = ЮТест.Предикат().Реквизит("Регистратор").Равно(Регистратор)
		.Реквизит("Идентификатор").Равно("строка 2");
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.кфк_т_ТестовыйРегистрСведенийПР").СодержитЗаписи(Условие);

