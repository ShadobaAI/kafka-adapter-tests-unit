КонецПроцедуры

#Область СлужебныеОперации

// Проверяет точный состав операций для независимых флагов.
// Параметры:
//  Сериализация - Булево - Факт запуска сериализации.
//  Десериализация - Булево - Факт запуска десериализации.
//  Выгрузка - Булево - Факт запуска отправки.
//  Загрузка - Булево - Факт запуска чтения.
//  Ожидаемые - Строка - Имена операций через точку с запятой.
Процедура СписокСлужебныхОпераций_УчитываетНезависимыеФлаги(
		Сериализация, Десериализация, Выгрузка, Загрузка, Ожидаемые) Экспорт

	Факт = ФактЗапуска(Сериализация, Десериализация, Выгрузка, Загрузка);

	Результат = кфкФоновыеОперацииСлужебный.ют_СлужебныеОперации(Факт, Истина);

	ПроверитьОперации(Результат, Ожидаемые);

КонецПроцедуры

// Проверяет независимое влияние внешнего логирования и контроля.
// Параметры:
//  Логирование - Булево - Состояние опции логирования.
//  Контроль - Булево - Состояние опции контроля интеграции.
Процедура СписокСлужебныхОпераций_УчитываетОпции(Логирование, Контроль) Экспорт

	ПрежнееЛогирование = РегистрыСведений.кфкПараметрыЛогирования.СоздатьНаборЗаписей();
	ПрежнееЛогирование.Прочитать();
	ПрежнийКонтроль = Константы.кфкИспользоватьКонтрольИнтеграции.Получить();
	Попытка
		Настройки = РегистрыСведений.кфкПараметрыЛогирования.СоздатьМенеджерЗаписи();
		Настройки.Прочитать();
		Настройки.Использовать = Логирование;
		Настройки.Записать();
		Константы.кфкИспользоватьКонтрольИнтеграции.Установить(Контроль);
		ОбновитьПовторноИспользуемыеЗначения();
		Факт = ФактЗапуска(Истина, Истина, Истина, Истина);

		Результат = кфкФоновыеОперацииСлужебный.ют_СлужебныеОперации(Факт, Ложь);

		Ожидаемые = "УдалениеДублейОчереди;ВозвратВОчередь;УдалениеУстаревшихИсходящихСообщений;"
			+ "УдалениеУстаревшихВходящихСообщений;ОчисткаСлужебныхТаблиц";
		Если Логирование Тогда
			Ожидаемые = Ожидаемые + ";ВыгрузкаЛоговИсходящихСообщений;ВыгрузкаЛоговВходящихСообщений";
		КонецЕсли;
		Если Контроль Тогда
			Ожидаемые = Ожидаемые + ";КонтрольИнтеграции";
		КонецЕсли;
		ПроверитьОперации(Результат, Ожидаемые);
	Исключение
		ПрежнееЛогирование.Записать();
		Константы.кфкИспользоватьКонтрольИнтеграции.Установить(ПрежнийКонтроль);
		ОбновитьПовторноИспользуемыеЗначения();
		ВызватьИсключение;
	КонецПопытки;
	ПрежнееЛогирование.Записать();
	Константы.кфкИспользоватьКонтрольИнтеграции.Установить(ПрежнийКонтроль);
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры
// Проверяет независимое влияние включения интеграции и блокировки запуска.
// Параметры:
//  Использовать - Булево - Включена интеграция.
//  Блокировка - Булево - Установлена блокировка.
//  Запусков - Число - Ожидаемое число обращений к границе запуска.
Процедура ЗапуститьРегламентноеЗадание_УчитываетОпции(Использовать, Блокировка, Запусков) Экспорт

	ПрежнееИспользование = Константы.кфкИспользоватьИнтеграцию.Получить();
	ПрежняяБлокировка = Константы.кфкБлокировкаИнтеграции.Получить();
	Попытка
		Константы.кфкИспользоватьИнтеграцию.Установить(Использовать);
		Константы.кфкБлокировкаИнтеграции.Установить(Блокировка);
		ОбновитьПовторноИспользуемыеЗначения();
		Мокито.Сбросить();
		Мокито.Обучение(кфкФоновыеОперацииСлужебный);
		МокитоОбучение.Когда("ЗапуститьПотоки");
		МокитоОбучение.Вернуть(Неопределено);
		Мокито.Прогон();

		кфкФоновыеОперацииСлужебный.ЗапуститьРегламентноеЗадание();

		Мокито.Проверить(кфкФоновыеОперацииСлужебный);
		МокитоПроверки.КоличествоВызовов("ЗапуститьПотоки");
		МокитоПроверки.Равно(Запусков);
	Исключение
		Константы.кфкИспользоватьИнтеграцию.Установить(ПрежнееИспользование);
		Константы.кфкБлокировкаИнтеграции.Установить(ПрежняяБлокировка);
		ОбновитьПовторноИспользуемыеЗначения();
		ВызватьИсключение;
	КонецПопытки;
	Константы.кфкИспользоватьИнтеграцию.Установить(ПрежнееИспользование);
	Константы.кфкБлокировкаИнтеграции.Установить(ПрежняяБлокировка);
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры
// Проверяет адресата, назначение и независимые лимиты двух видов операций.
// Параметры:
//  Продюсер - Булево - Исходящее направление вместо входящего.
//  БлокироватьОбработку - Булево - Запрет обработки.
//  БлокироватьТранспорт - Булево - Запрет транспорта.
Процедура ОбработатьДиспетчерЗадач_ПередаетНастройкиИЛимиты(
		Продюсер, БлокироватьОбработку, БлокироватьТранспорт) Экспорт

	Идентификатор = Новый УникальныйИдентификатор("12345678-1234-1234-1234-123456789012");
	Ссылка = СсылкаНастройкиНаправления(Продюсер, Идентификатор);
	Настройка = СсылкаНастройкиНаправления(Продюсер, Новый УникальныйИдентификатор);
	Диспетчер = Новый Структура;
	Диспетчер.Вставить("Ссылка", Ссылка);
	Диспетчер.Вставить("Представление", "Тестовый диспетчер");
	Диспетчер.Вставить("ПодпотокиОбработки", 2);
	Диспетчер.Вставить("ПодпотокиТранспорта", 3);
	Таблица = НоваяТаблицаНастроекДиспетчера();
	СтрокаНастройки = Таблица.Добавить();
	СтрокаНастройки.Ссылка = Ссылка;
	СтрокаНастройки.Настройка = Настройка;
	СтрокаНастройки.БлокироватьОбработку = БлокироватьОбработку;
	СтрокаНастройки.БлокироватьТранспорт = БлокироватьТранспорт;
	Факт = ФактЗапуска(Ложь, Ложь, Ложь, Ложь);
	Мокито.Сбросить();
	Мокито.Обучение(кфкФоновыеОперацииСлужебный);
	МокитоОбучение.Когда("ЗапуститьФЗ");
	МокитоОбучение.Вернуть(Неопределено);
	Мокито.Прогон();

	кфкФоновыеОперацииСлужебный.ют_ОбработатьДиспетчерЗадач(Диспетчер, Таблица, Факт);

	Мокито.Проверить(кфкФоновыеОперацииСлужебный);
	Вызовы = МокитоПроверки.Вызовы("ЗапуститьФЗ");
	Количество = ?(БлокироватьОбработку, 0, 1) + ?(БлокироватьТранспорт, 0, 1);
	ЮТест.ОжидаетЧто(Вызовы.Количество()).Равно(Количество);
	ИмяОбработки = ?(Продюсер, "СериализацияСообщений", "ДесериализацияСообщений");
	ИмяТранспорта = ?(Продюсер, "ОтправкаСообщенийВКафку", "ЗагрузкаСообщенийИзКафки");
	Для Каждого Вызов Из Вызовы Цикл
		Аргументы = Вызов.Параметры; // Массив Из Произвольный
		ЭтоОбработка = Аргументы[1] = "кфкФоновыеОперацииСлужебный." + ИмяОбработки;
		Имя = ?(ЭтоОбработка, ИмяОбработки, ИмяТранспорта);
		ЮТест.ОжидаетЧто(Аргументы[0]).Равно("кфк" + Имя + "_12345678");
		ЮТест.ОжидаетЧто(Аргументы[1]).Равно("кфкФоновыеОперацииСлужебный." + Имя);
		ПараметрыЗадания = Аргументы[3]; // Массив Из Произвольный
		Настройки = ПараметрыЗадания[1]; // Массив Из СправочникСсылка
		ЮТест.ОжидаетЧто(Настройки.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Настройки[0]).Равно(Настройка);
		ЮТест.ОжидаетЧто(ПараметрыЗадания[2]).Равно(?(ЭтоОбработка, 2, 3));
		ЮТест.ОжидаетЧто(ПараметрыЗадания[3]).Равно(Ложь);
	КонецЦикла;
	Если Продюсер Тогда
		ЮТест.ОжидаетЧто(Факт.Сериализация).Равно(Не БлокироватьОбработку);
		ЮТест.ОжидаетЧто(Факт.Выгрузка).Равно(Не БлокироватьТранспорт);
		ЮТест.ОжидаетЧто(Факт.Десериализация Или Факт.Загрузка).Равно(Ложь);
	Иначе
		ЮТест.ОжидаетЧто(Факт.Десериализация).Равно(Не БлокироватьОбработку);
		ЮТест.ОжидаетЧто(Факт.Загрузка).Равно(Не БлокироватьТранспорт);
		ЮТест.ОжидаетЧто(Факт.Сериализация Или Факт.Выгрузка).Равно(Ложь);
	КонецЕсли;

КонецПроцедуры

