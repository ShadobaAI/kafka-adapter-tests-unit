// Проверяет адреса, топики и параметры подключения консьюмера из тестовых данных.
Процедура ОписаниеКонсьюмера_ВозвращаетПодготовленныеНастройки() Экспорт
	
	Консьюмер = КонсьюмерСправочника();
	
	Описание = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмера(Консьюмер);
	
	ОжидаемыеСвойства = Новый Структура;
	ОжидаемыеСвойства.Вставить("Ссылка", Консьюмер);
	ОжидаемыеСвойства.Вставить("Наименование", "Консьюмер: ТестовыйСправочник");
	ОжидаемыеСвойства.Вставить("АдресБрокера", "localhost:29091,localhost:29092");
	ОжидаемыеСвойства.Вставить("Идентификатор", "1c-test");
	ОжидаемыеСвойства.Вставить("ТаймаутОжидания", 5000);
	ОжидаемыеСвойства.Вставить("ДвоичныеДанные", Ложь);
	
	ЮТест.ОжидаетЧто(Описание, "Описание консьюмера")
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	ЮТест.ОжидаетЧто(Описание.Топики, "Топики консьюмера")
		.ИмеетДлину(1)
		.Содержит("1c.test-catalogs");
	ЮТест.ОжидаетЧто(
		Описание.ПараметрыПодключения.Получить("auto.offset.reset"),
		"Параметр auto.offset.reset")
		.Равно("earliest");
	
КонецПроцедуры

// Проверяет наличие отдельных описаний для двух переданных ссылок консьюмеров.
Процедура ОписаниеКонсьюмеров_ВозвращаетОписанияПереданныхКонсьюмеров() Экспорт
	
	КонсьюмерСправочника = КонсьюмерСправочника();
	КонсьюмерРегистра = КонсьюмерРегистра();
	Консьюмеры = Новый Массив;
	Консьюмеры.Добавить(КонсьюмерСправочника);
	Консьюмеры.Добавить(КонсьюмерРегистра);
	
	Описания = Справочники.кфкКонсьюмеры.ОписаниеКонсьюмеров(Консьюмеры);
	
	ЮТест.ОжидаетЧто(Описания, "Описания консьюмеров")
		.ИмеетДлину(2);
	ЮТест.ОжидаетЧто(Описания.Получить(КонсьюмерСправочника))
		.ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(Описания.Получить(КонсьюмерРегистра))
		.ЭтоНеНеопределено();
	
КонецПроцедуры

// Исключает влияние подмен и кэша списка пакетов на следующий сценарий.
Процедура ОчиститьПодменуПространствИменXDTO() Экспорт

	Мокито.Сбросить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры
// Проверяет независимый приоритет каждого поля и отсутствие физического заполнения строки.
// Параметры:
//  ТипВСтроке - Булево - переопределить тип обработчика в строке.
//  МетодВСтроке - Булево - переопределить метод в строке.
//  МодульВСтроке - Булево - переопределить менеджер обмена в строке.
//  ФорматВСтроке - Булево - переопределить формат в строке.
//  ЕстьНастройкиПоУмолчанию - Булево - заполнить общие настройки.
//  ИспользоватьМаску - Булево - подобрать URI из маски заполненного поля формата.
Процедура ПравилаДесериализации_ПрименяетНастройкиПоПолям(
	ТипВСтроке, МетодВСтроке, МодульВСтроке, ФорматВСтроке,
	ЕстьНастройкиПоУмолчанию, ИспользоватьМаску) Экспорт

	Ссылка = КонсьюмерСправочника();
	Объект = Ссылка.ПолучитьОбъект();
	СтрокаНастроек = Объект.Топики[0];
	Объект.ТипДесериализации = Перечисления.кфкТипыОбработчиков.ПустаяСсылка();
	Объект.ИмяМетодаДесериализации = "";
	Объект.ИмяМодуляДесериализации = "";
	Объект.ФорматДесериализации = "";

	ФорматПоУмолчанию = "http://v8.fsk.ru/kfk/test/1.2.10";
	ФорматСтроки = "http://v8.fsk.ru/kfk/row/2.0";
	Если ЕстьНастройкиПоУмолчанию Тогда

		Объект.ТипДесериализации = Перечисления.кфкТипыОбработчиков.КонвертацияДанных;
		Объект.ИмяМетодаДесериализации = "кфк_т_ОбработчикиСообщений.Десериализация";
		Объект.ИмяМодуляДесериализации = "кфк_т_МенеджерОбменаЧерезУниверсальныйФормат";
		Объект.ФорматДесериализации = ?(ИспользоватьМаску, "http://v8.fsk.ru/kfk/test/*", ФорматПоУмолчанию);

	КонецЕсли;

	СтрокаНастроек.ТипДесериализации = ?(ТипВСтроке,
		Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик,
		Перечисления.кфкТипыОбработчиков.ПустаяСсылка());
	СтрокаНастроек.ИмяМетодаДесериализации = ?(МетодВСтроке,
		"Справочники.кфк_т_ТестовыйСправочник.Десериализация", "");
	СтрокаНастроек.ИмяМодуляДесериализации = ?(МодульВСтроке, "ют_МенеджерОбменаXDTOДляВыбораПравил", "");
	СтрокаНастроек.ФорматДесериализации = "";
	Если ФорматВСтроке Тогда
		СтрокаНастроек.ФорматДесериализации = ?(ИспользоватьМаску, "http://v8.fsk.ru/kfk/row/*", ФорматСтроки);
	КонецЕсли;

	ОжидаемыеСвойства = кфкФоновыеОперацииСлужебный.НовоеОписаниеПравилОбмена();
	ОжидаемыеСвойства.Тип = ?(ТипВСтроке, СтрокаНастроек.ТипДесериализации, Объект.ТипДесериализации);
	ОжидаемыеСвойства.ИмяМетода = ?(МетодВСтроке,
		СтрокаНастроек.ИмяМетодаДесериализации, Объект.ИмяМетодаДесериализации);
	ОжидаемыеСвойства.ИмяМодуля = ?(МодульВСтроке,
		СтрокаНастроек.ИмяМодуляДесериализации, Объект.ИмяМодуляДесериализации);
	ОжидаемыеСвойства.ИмяПОД = СтрокаНастроек.ИмяПОДДесериализации;
	ОжидаемыеСвойства.Формат = "";
	Если ФорматВСтроке Тогда
		ОжидаемыеСвойства.Формат = ФорматСтроки;
	ИначеЕсли ЕстьНастройкиПоУмолчанию Тогда
		ОжидаемыеСвойства.Формат = ФорматПоУмолчанию;
	КонецЕсли;

	НеизмененнаяСтрока = ЮТест.Предикат()
		.Реквизит("Ссылка").Равно(Ссылка)
		.Реквизит("Топик").Равно(СтрокаНастроек.Топик)
		.Реквизит("ТипДесериализации").Равно(СтрокаНастроек.ТипДесериализации)
		.Реквизит("ИмяМетодаДесериализации").Равно(СтрокаНастроек.ИмяМетодаДесериализации)
		.Реквизит("ИмяМодуляДесериализации").Равно(СтрокаНастроек.ИмяМодуляДесериализации)
		.Реквизит("ФорматДесериализации").Равно(СтрокаНастроек.ФорматДесериализации)
		.Реквизит("ИмяПОДДесериализации").Равно(СтрокаНастроек.ИмяПОДДесериализации);
	КлючПравила = НРег(XMLСтрока(Ссылка) + СтрокаНастроек.Топик);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

	ПространстваИмен = СтрРазделить(
		"http://v8.fsk.ru/kfk/test/1.2.2,http://v8.fsk.ru/kfk/test/1.2.10,"
		+ "http://v8.fsk.ru/kfk/row/1.0,http://v8.fsk.ru/kfk/row/2.0", ",");
	Мокито.Обучение(кфкИнтеграцияСлужебныйПовтИсп, Ложь)
		.Когда("ПространстваИменПакетовXDTO")
			.Вернуть(Новый ФиксированныйМассив(ПространстваИмен));
	Мокито.Прогон();

	Правила = Справочники.кфкКонсьюмеры.ПравилаДесериализации(ЮТМетоды.МассивПараметров(Ссылка));

	ЮТест.ОжидаетЧто(Правила).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Правила.Получить(КлючПравила))
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.кфкКонсьюмеры.Топики")
		.СодержитЗаписи(НеизмененнаяСтрока);

КонецПроцедуры
// Проверяет состав правила десериализации и его поиск по консьюмеру и топику.
Процедура ПравилаДесериализации_ВозвращаетПодготовленноеПравило() Экспорт
	
	Консьюмер = КонсьюмерСправочника();
	Консьюмеры = Новый Массив;
	Консьюмеры.Добавить(Консьюмер);
	
	Правила = Справочники.кфкКонсьюмеры.ПравилаДесериализации(Консьюмеры);
	КлючПравила = НРег(XMLСтрока(Консьюмер) + "1c.test-catalogs");
	Правило = Правила.Получить(КлючПравила);
	
	ОжидаемыеСвойства = Новый Структура;
	ОжидаемыеСвойства.Вставить(
		"Тип", Перечисления.кфкТипыОбработчиков.ПроизвольныйОбработчик);
	ОжидаемыеСвойства.Вставить(
		"ИмяМетода", "Справочники.кфк_т_ТестовыйСправочник.Десериализация");
	ОжидаемыеСвойства.Вставить(
		"ИмяМодуля", "кфк_т_МенеджерОбменаЧерезУниверсальныйФормат");
	ОжидаемыеСвойства.Вставить("ИмяПОД", "TestCatalogs_Получение");
	ОжидаемыеСвойства.Вставить("Формат", "http://v8.fsk.ru/kfk/test/1.0");
	
	ЮТест.ОжидаетЧто(Правила, "Правила десериализации")
		.ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Правило, "Правило десериализации тестового справочника")
		.ИмеетСвойстваРавные(ОжидаемыеСвойства);
	
КонецПроцедуры

// Проверяет отбор консьюмеров по флагу идемпотентной обработки.
Процедура ИдемпотентнаяОбработка_ВозвращаетТолькоКонсьюмеровСВключеннымФлагом() Экспорт
	
	ИдемпотентныйКонсьюмер = КонсьюмерСправочника();
	ОбычныйКонсьюмер = КонсьюмерРегистра();
	
	Объект = ИдемпотентныйКонсьюмер.ПолучитьОбъект();
	Объект.ИдемпотентнаяОбработка = Истина;
	Объект.Записать();
	
	Консьюмеры = Новый Массив;
	Консьюмеры.Добавить(ИдемпотентныйКонсьюмер);
	Консьюмеры.Добавить(ОбычныйКонсьюмер);
	
	Результат = Справочники.кфкКонсьюмеры.ИдемпотентнаяОбработка(Консьюмеры);
	
	ЮТест.ОжидаетЧто(Результат, "Идемпотентные консьюмеры")
		.ИмеетДлину(1)
		.Содержит(ИдемпотентныйКонсьюмер);
	
КонецПроцедуры

